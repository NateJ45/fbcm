---
// scaffold-file: journal
// Safe to edit by hand
// The door beside the index's opener (journal pass, 2026-09-22, "I1 Register").
// The old "This week" band still called a January preview "this week" in
// September. The door says only what the dates can prove:
//
//   fresh   the newest sermon preview, while its Sunday has not passed:
//           "This Sunday, <Month D>" + title + reading + author + excerpt
//   latest  otherwise the newest post of any kind:
//           "Latest · <Month D>" + a hung 4:3 plate + title + excerpt
//
// "Fresh" is decided at BUILD time (freshPreview in blog-derive.ts), and a
// static page can outlive its Sunday. So both doors are rendered, the latest
// one `hidden`, and the inline script below re-checks against the visitor's
// clock, in the church's time zone, and swaps them once the Sunday has gone.
// Without JavaScript the build's answer stands.
//
// The church identity pass (2026-09-24): the door stands on the opener's
// indigo band, so its inks are the band's (gold label, cream title, taupe
// meta), and each door shows its post's FEATURED image in a door arch (a
// building glyph when there is none), with the gold mould. Never an author
// portrait, never a caption.
import ArchFrame from '@/components/church/ArchFrame.astro';
import { localDay, sundayOf, formatDay, isoDay, readingOf, CHURCH_TZ } from '@/lib/sermon-derive';
import type { RegisterEntry } from '@/lib/blog-derive';

interface Props {
  fresh: RegisterEntry | null;
  latest: RegisterEntry | null;
}
const { fresh, latest } = Astro.props as Props;

const hrefOf = (e: RegisterEntry) => (e.slug?.current ? `/post/${e.slug.current}` : '#');
const monthDay = (d: Date | null) => (d ? formatDay(d, { month: 'long', day: 'numeric' }) : '');

const freshSunday = fresh ? sundayOf(fresh.publishedAt) : null;
const freshMeta = fresh
  ? [readingOf(fresh.opening), (fresh.author ?? '').trim()].filter(Boolean).join(' · ')
  : '';
const latestDay = latest ? localDay(latest.publishedAt) : null;
---

{
  fresh && freshSunday && (
    <div class="door" data-door-fresh={isoDay(freshSunday)}>
      <p class="lbl font-ui text-ui font-medium">This Sunday, {monthDay(freshSunday)}</p>
      <div class="dw">
        <ArchFrame
          image={fresh.coverImage as any}
          glyph="door"
          shape="door"
          width={440}
          sizes="150px"
          alt=""
          loading="eager"
          reveal={false}
        />
      </div>
      <a class="dt" href={hrefOf(fresh)}>
        <b>{fresh.title}</b>
      </a>
      {freshMeta && <p class="meta oldstyle">{freshMeta}</p>}
      {fresh.excerpt && <p class="ex">{fresh.excerpt}</p>}
    </div>
  )
}
{
  latest && (
    <div class="door" data-door-latest hidden={fresh && freshSunday ? true : undefined}>
      <p class="lbl font-ui text-ui font-medium">
        Latest{latestDay && <> &middot; {monthDay(latestDay)}</>}
      </p>
      <div class="dw">
        <ArchFrame
          image={latest.coverImage as any}
          glyph="door"
          shape="door"
          width={440}
          sizes="150px"
          alt=""
          loading={fresh ? 'lazy' : 'eager'}
          reveal={false}
        />
      </div>
      <a class="dt" href={hrefOf(latest)}>
        <b>{latest.title}</b>
      </a>
      {latest.excerpt && <p class="ex">{latest.excerpt}</p>}
    </div>
  )
}
{/* Does nothing unless the fresh door was rendered. */}
<script is:inline define:vars={{ tz: CHURCH_TZ }}>
  (function () {
    try {
      var fresh = document.querySelector('[data-door-fresh]');
      var latest = document.querySelector('[data-door-latest]');
      if (!fresh || !latest) return;
      // en-CA formats as YYYY-MM-DD, so the two days compare as strings.
      var today = new Intl.DateTimeFormat('en-CA', {
        timeZone: tz,
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
      }).format(new Date());
      if (today > fresh.getAttribute('data-door-fresh')) {
        fresh.hidden = true;
        latest.hidden = false;
      }
    } catch (_e) {
      /* Leave the build's answer in place. */
    }
  })();
</script>

<style>
  .door {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    column-gap: 26px;
    align-items: start;
    border-top: 1px solid color-mix(in srgb, var(--color-gold) 55%, transparent);
    padding-top: 16px;
  }
  .door[hidden] {
    display: none;
  }
  .door > :not(.dw) {
    grid-column: 2;
  }
  .lbl {
    grid-column: 1 / -1 !important;
    color: var(--color-gold);
    margin-bottom: 20px;
  }
  /* The arch, 9px inside its column so the mould has room. */
  .dw {
    grid-column: 1;
    grid-row: 2 / span 4;
    padding: 9px 9px 0;
  }
  .dt {
    display: block;
    text-decoration: none;
    color: #fff;
  }
  .dt b {
    font-weight: 400;
    font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2.125rem);
    line-height: 1.12;
    overflow-wrap: break-word;
    background: linear-gradient(var(--color-gold), var(--color-gold)) 0 100% / 0 2px no-repeat;
    display: inline;
    transition: background-size 0.3s;
  }
  .dt:hover b,
  .dt:focus-visible b {
    background-size: 100% 2px;
  }
  .dt:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 4px;
  }
  .meta {
    margin-top: 10px;
    font-family: var(--font-ui);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-band-taupe);
  }
  .ex {
    margin-top: 10px;
    color: var(--color-band-taupe);
    font-size: 1.0625rem;
    line-height: 1.5;
    overflow-wrap: break-word;
  }
  @media (max-width: 480px) {
    .door {
      grid-template-columns: 96px minmax(0, 1fr);
      column-gap: 18px;
    }
    .dw {
      padding: 6px 6px 0;
    }
  }
</style>
