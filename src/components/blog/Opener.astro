---
// scaffold-file: journal
// Safe to edit by hand
// The opener every journal list starts with (journal pass, 2026-09-22, "I1
// Register"): eyebrow, h1 and lede in cols 1 to 7, and whatever the page puts
// in the default slot (the index's door) in cols 9 to 12. The filter row goes
// in the `filters` slot, under both, on the same left edge (CLAUDE.md rule 17).
//
// The church identity pass (2026-09-24) laid the opener on the indigo band,
// as every page's opener now is (Who We Are, Home, Visit): cream heading, a
// gold eyebrow, the lede in taupe. The band holds its colour in both themes
// (--color-band-indigo is redeclared under .dark). The filters sit under it on
// the page's own paper, where the register they filter begins.
import { headlineScale, headlineClass } from '@/lib/headline-scale';

interface Props {
  eyebrow?: string;
  heading: string;
  lede?: string;
  headingId?: string;
}
const { eyebrow, heading, lede, headingId = 'blog-heading' } = Astro.props as Props;
const hasAside = Astro.slots.has('default');
// The heading is sized by its own length, like every hero headline
// (src/lib/headline-scale.ts). A category or tag name is usually a poster;
// a long one steps down rather than breaking a word.
const scale = headlineScale(heading, { tall: false });
---

<div class="bg-band-indigo text-white">
  <div class="mx-auto max-w-content px-gutter">
    <div class="ix-open">
      <div class="l">
        {eyebrow && <p class="font-ui text-ui font-medium text-gold">{eyebrow}</p>}
        <h1 id={headingId} class:list={['mt-5 text-white', headlineClass(scale, { tall: false })]}>
          {heading}
        </h1>
        {lede && <p class="mt-6 max-w-[34em] font-body text-lede text-band-taupe italic">{lede}</p>}
      </div>
      {
        hasAside && (
          <div class="r">
            <slot />
          </div>
        )
      }
    </div>
  </div>
</div>
{
  Astro.slots.has('filters') && (
    <div class="bg-background">
      <div class="mx-auto max-w-content px-gutter pt-8">
        <slot name="filters" />
      </div>
    </div>
  )
}

<style>
  .ix-open {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(16px, 2.5vw, 40px);
    row-gap: 44px;
    align-items: end;
    padding-top: var(--spacing-section-lg);
    padding-bottom: clamp(56px, 6vw, 96px);
  }
  .l {
    grid-column: 1 / 8;
    min-width: 0;
  }
  .r {
    grid-column: 9 / 13;
    min-width: 0;
  }
  @media (max-width: 1023px) {
    .l,
    .r {
      grid-column: 1 / -1;
    }
  }
</style>
