---
// scaffold-file: journal
// Safe to edit by hand
// The register (journal pass, 2026-09-22, variant "I1 Register"; brought
// into the church identity 2026-09-24). A page of posts grouped by the year
// they were published in Muncie, the year hung in the left columns in the
// display face, and every post drawn as the SAME row the home page's Church
// Blog band draws (PostRow.astro, paper tone):
//
//   year | date | featured image in a lancet | title + excerpt | byline + meta
//
// The byline and meta are derived (registerMeta in blog-derive.ts): a sermon
// preview names its Sunday and its reading, anything else its category and
// author. Until the identity pass the picture was a 4:3 "recognition plate";
// it is now the lancet every journal row uses, with a building glyph when a
// post has no featured image.
//
// Phone (< 1024px): the year sits above its rows, and the row is the home
// page's phone row (lancet left, date, title, byline).
import PostRow from '@/components/blog/PostRow.astro';
import { groupByYear, registerMeta, clean, type RegisterEntry } from '@/lib/blog-derive';

interface Props {
  entries: RegisterEntry[];
  emptyMessage?: string;
}
const { entries, emptyMessage = 'Nothing here yet.' } = Astro.props as Props;
const groups = groupByYear(entries ?? []);
---

{
  entries.length === 0 ? (
    <p class="max-w-[62ch] text-body text-brown-ink">{emptyMessage}</p>
  ) : (
    <div class="reg">
      {groups.map((g) => (
        <div class="yr">
          {g.year !== null && <h3 class="yr-h font-display">{g.year}</h3>}
          <ol class="rows">
            {g.items.map((entry) => {
              const m = registerMeta(entry);
              const author = clean(entry.author).trim();
              return (
                <PostRow
                  href={entry.slug?.current ? `/post/${entry.slug.current}` : '#'}
                  title={entry.title ?? ''}
                  dateLabel={m.day}
                  datetime={m.iso || undefined}
                  image={entry.coverImage}
                  excerpt={entry.excerpt}
                  byline={m.preview ? m.key : author || m.key}
                  meta={m.preview ? m.value : author ? m.key : ''}
                  tone="paper"
                  level={g.year !== null ? 'h4' : 'h3'}
                />
              );
            })}
          </ol>
        </div>
      ))}
    </div>
  )
}

<style>
  .yr {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(16px, 2.5vw, 40px);
    border-top: 2px solid var(--color-gold);
    padding-top: 18px;
    margin-top: clamp(40px, 5vw, 64px);
  }
  .yr:first-child {
    margin-top: 0;
  }
  .yr-h {
    grid-column: 1 / 3;
    margin: 0;
    font-weight: 400;
    font-size: var(--text-h2);
    line-height: 1;
    font-variant-numeric: lining-nums;
    color: var(--color-indigo);
  }
  .rows {
    grid-column: 3 / 13;
    min-width: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* The first row of a year sits on the gold rule, not under a second hair. */
  .rows > :global(li:first-child) {
    padding-top: 6px;
  }
  .rows > :global(li:last-child) {
    border-bottom: 0;
  }

  @media (max-width: 1279px) {
    .yr {
      display: block;
    }
    .yr-h {
      margin-bottom: 4px;
      font-size: var(--text-h3);
    }
  }
</style>
