---
// scaffold-file: journal
// Safe to edit by hand
// The thin state (journal pass, 2026-09-22, "I1 Register"). A tag page with one
// post used to be a heading, one card and the closing CTA: a dead end. Under
// four posts the list now offers the next step: the other tags and categories
// on those same posts, most frequent first, at most eight (thinStateTags in
// blog-derive.ts, whose hrefs are only routes the build makes), then the whole
// archive.
//
// The church identity pass (2026-09-24) closes it with the gold "All posts"
// plate, the same button the home page's Church Blog band ends on.
import CtaLink from '@/components/CtaLink.astro';
import { slugify } from '@/lib/slugify';
import { thinStateTags, type BlogEntry } from '@/lib/blog-derive';

interface Props {
  /** The whole list this archive shows. */
  list: BlogEntry[];
  /** This page's own tag or category (label or slug), left out of the line. */
  exclude?: string;
}
const { list, exclude } = Astro.props as Props;
const thin = (list ?? []).length < 4;
const links = thin ? thinStateTags(list, exclude, slugify, 8) : [];
---

{
  thin && (
    <div class="thin">
      {links.length > 0 && (
        <>
          <p class="lbl font-ui text-ui font-medium">Also filed under</p>
          <p class="line font-ui">
            {links.map((l, i) => (
              <>
                <a href={l.href}>{l.label}</a>
                {i < links.length - 1 ? ', ' : '.'}
              </>
            ))}
          </p>
        </>
      )}
      <div class="act">
        <CtaLink variant="gold" fallbackHref="/blog/" fallbackLabel="All posts" />
      </div>
    </div>
  )
}

<style>
  .thin {
    margin-top: clamp(40px, 5vw, 64px);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(16px, 2.5vw, 40px);
    border-top: 2px solid var(--color-gold);
    padding-top: 16px;
  }
  .lbl {
    grid-column: 1 / 3;
    color: var(--color-gold-ink);
  }
  .line {
    grid-column: 3 / 13;
    min-width: 0;
    font-size: 0.9375rem;
    letter-spacing: 0.02em;
    line-height: 1.6;
    overflow-wrap: break-word;
  }
  a {
    color: var(--color-indigo);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-brown-ink) 60%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }
  a:hover,
  a:focus-visible {
    text-decoration-color: var(--color-gold);
    color: var(--color-gold-ink);
  }
  .act {
    grid-column: 3 / 13;
    margin-top: 24px;
  }
  @media (max-width: 1023px) {
    .lbl,
    .line,
    .act {
      grid-column: 1 / -1;
    }
    .line {
      margin-top: 8px;
    }
  }
</style>
