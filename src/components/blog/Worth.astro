---
// scaffold-file: journal
// Safe to edit by hand
// "Worth coming back for" on /blog page 1 (journal pass, 2026-09-22, "I1
// Register"): four durable posts that are NOT already in the register below
// (worthComingBackFor in blog-derive.ts). The old Featured grid repeated five
// of its six cards eight inches lower.
//
// The church identity pass (2026-09-24) set it as the home page's Church Blog
// band: the fixed taupe ground, the heading in the one band grammar
// (H2_DISPLAY), and the same rows (PostRow.astro, taupe tone), so the band a
// visitor clicked "All posts" on is the first thing /blog shows them again.
import PostRow from '@/components/blog/PostRow.astro';
import { H2_DISPLAY } from '@/lib/heading-grammar';
import { rowDate, rowDateTime, clean, type RegisterEntry } from '@/lib/blog-derive';

interface Props {
  entries: RegisterEntry[];
}
const { entries } = Astro.props as Props;
---

{
  entries.length > 0 && (
    <section class="bg-band-taupe text-band-ink" aria-labelledby="blog-worth-heading">
      <div class="mx-auto max-w-content px-gutter py-section-lg">
        <h2
          id="blog-worth-heading"
          class:list={[H2_DISPLAY, 'mb-[clamp(36px,4vw,60px)] text-band-indigo']}
        >
          Worth coming back for
        </h2>
        <ol class="m-0 list-none border-t border-band-brown/40 p-0">
          {entries.map((entry) => (
            <PostRow
              href={entry.slug?.current ? `/post/${entry.slug.current}` : '#'}
              title={entry.title ?? ''}
              dateLabel={rowDate(entry.publishedAt)}
              datetime={rowDateTime(entry.publishedAt)}
              image={entry.coverImage}
              excerpt={entry.excerpt}
              byline={entry.author}
              meta={
                (entry.categories ?? []).map((c) => clean(c?.title).trim()).find(Boolean) ?? null
              }
              tone="taupe"
            />
          ))}
        </ol>
      </div>
    </section>
  )
}
