---
// scaffold-file: journal
// Safe to edit by hand
// The body of every blog list that is not the index: /blog/page/N, a category,
// a category's page N, and a tag (journal pass, 2026-09-22, "I1 Register").
// Opener (no door), filters, register, pager, then the thin state when the
// list holds fewer than four posts. No closing CTA: the footer follows.
//
// The index has more on it (the door and the publications list), so it composes the same partials itself rather than
// using this shell.
import Opener from '@/components/blog/Opener.astro';
import Filters from '@/components/blog/Filters.astro';
import Register from '@/components/blog/Register.astro';
import Pager from '@/components/blog/Pager.astro';
import ThinState from '@/components/blog/ThinState.astro';
import { paginate, PER_PAGE, type RegisterEntry } from '@/lib/blog-derive';

interface Props {
  eyebrow: string;
  heading: string;
  /** One plain sentence under the heading. Optional. */
  intro?: string;
  /** The WHOLE list (the pager's year spans and the thin state need all of it). */
  list: RegisterEntry[];
  /** Every post on the site, for the filter counts. */
  allEntries: RegisterEntry[];
  page: number;
  /** false on a tag page: the whole list is one page, however long. */
  paged?: boolean;
  basePath: string;
  /** The category being shown. */
  activeSlug?: string;
  /** "All posts" is the list being shown (/blog/page/N). */
  allCurrent?: boolean;
  /** This page's own tag or category, left out of the thin state's line. */
  exclude?: string;
  emptyMessage?: string;
}
const {
  eyebrow,
  heading,
  intro,
  list,
  allEntries,
  page,
  paged = true,
  basePath,
  activeSlug,
  allCurrent = false,
  exclude,
  emptyMessage,
} = Astro.props as Props;

const items = paged ? paginate(list, PER_PAGE, page).items : list;
---

<Opener {eyebrow} heading={heading} lede={intro} headingId="blog-archive-heading">
  <Filters slot="filters" entries={allEntries} {activeSlug} {allCurrent} />
</Opener>

<section class="bg-background" aria-labelledby="blog-archive-posts">
  <div class="mx-auto max-w-content px-gutter pt-section-md pb-section-lg">
    {
      /* The page heading above is the h1 and every year in the register is an
        h3, so without this the heading order jumps h1 -> h3 and axe fails the
        route. */
    }
    <h2 id="blog-archive-posts" class="sr-only">Posts</h2>
    <Register entries={items} {emptyMessage} />
    {paged && <Pager list={list} page={page} basePath={basePath} />}
    <ThinState list={list} exclude={exclude} />
  </div>
</section>
