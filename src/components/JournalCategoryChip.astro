---
// Safe to edit by hand
// Small category pill. Used on journal cards and at the top of post pages.
// When `href` is provided, renders as a link; otherwise as a static badge.
// Since plan 2b task 15 the category routes exist (/blog/category/<slug>/), so
// the chips on /blog are real links and one of them is the page you are on.
//
// THE PILL IS GONE (art-direction pass, 2026-09-20, task 11). It was a filled,
// rounded, bordered capsule at 0.7rem with 0.18em tracking, one of four chip
// shapes the site had. What is left is a square-cornered box drawn in a single
// hairline, set in the UI face at the shared label size, which is the same
// rule-and-label grammar the ruled bands and the pager use. The chip for the
// list on screen inverts to ink-on-paper rather than taking a gold fill: gold
// carries the eyebrows on this site, and a gold chip beside a gold eyebrow
// reads as two of the same thing.

interface Props {
  title?: string;
  href?: string;
  tooltip?: string;
  /**
   * "default" draws the hairline box on the page's own paper; "inverse" draws
   * it in paper ink for a dark ground (a hero overlay, the indigo bands).
   */
  tone?: 'default' | 'inverse';
  /**
   * The chip for the list currently on screen. It inverts to ink-on-paper and
   * gains `aria-current="page"`, so the state is announced and not only
   * coloured (colour alone is not a state a screen reader hears).
   */
  active?: boolean;
}

const { title, href, tooltip, tone = 'default', active = false } = Astro.props as Props;
if (!title) return null;

const base = 'inline-flex items-center font-ui text-ui px-3 py-2 rounded-sm border';
// Ink-on-paper for the chip you are standing on, a hairline box for the rest.
const toneClass = active
  ? 'bg-foreground text-background border-foreground'
  : tone === 'inverse'
    ? 'border-bg/30 text-bg'
    : 'border-hair text-foreground/80';
---

{
  href ? (
    <a
      href={href}
      class:list={[
        base,
        toneClass,
        active ? '' : 'transition-colors hover:border-gold hover:text-foreground',
      ]}
      title={tooltip}
      aria-current={active ? 'page' : undefined}
    >
      {title}
    </a>
  ) : (
    <span class:list={[base, toneClass]} title={tooltip}>
      {title}
    </span>
  )
}
