---
// Safe to edit by hand
// Small category pill. Used on journal cards and at the top of post pages.
// When `href` is provided, renders as a link; otherwise as a static badge.
// Since plan 2b task 15 the category routes exist (/blog/category/<slug>/), so
// the chips on /blog are real links and one of them is the page you are on.

interface Props {
  title?: string;
  href?: string;
  tooltip?: string;
  /** "default" (soft Cream pill) or "inverse" (used on dark hero overlays). */
  tone?: 'default' | 'inverse';
  /**
   * The chip for the list currently on screen. It keeps the same pill shape and
   * gains the gold fill plus `aria-current="page"`, so the state is announced
   * and not only coloured (colour alone is not a state a screen reader hears).
   */
  active?: boolean;
}

const { title, href, tooltip, tone = 'default', active = false } = Astro.props as Props;
if (!title) return null;

const base =
  'inline-flex items-center px-s py-1 text-[0.7rem] font-semibold uppercase tracking-[0.18em] rounded-full';
// Gold fill + navy text for the active chip, never gold text on cream: gold is
// a fill colour in this design system (see the --color-gold note in globals.css
// and the contrast assertions in theme-tokens.test.ts).
const toneClass = active
  ? 'bg-gold text-primary border border-gold'
  : tone === 'inverse'
    ? 'bg-bg/15 text-bg border border-bg/25'
    : 'bg-muted text-foreground/80 border border-border-soft';
---

{
  href ? (
    <a
      href={href}
      class:list={[
        base,
        toneClass,
        active ? '' : 'transition-colors hover:bg-accent hover:text-foreground',
      ]}
      title={tooltip}
      aria-current={active ? 'page' : undefined}
    >
      {title}
    </a>
  ) : (
    <span class:list={[base, toneClass]} title={tooltip}>
      {title}
    </span>
  )
}
