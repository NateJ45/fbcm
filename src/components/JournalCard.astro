---
// scaffold-file: journal
// Safe to edit by hand
// Card for the /blog index grid. Cover image on top, then the category in
// gold, the title and the date. Whole card is clickable.
//
// `featured` style: the wide two-column variant, asked for by the caller (the
// index uses it for "this week").
//
// `preview` style: a weekly sermon preview. The category line becomes the
// "week of" eyebrow, and the date under the title goes with it, because on a
// preview the two would say the same thing twice. The caller DERIVES it from
// the category (blog-derive.ts); the card never reads journalEntry.featured.

import SanityImage from '@/components/SanityImage.astro';
import { weekOfEyebrow } from '@/lib/blog-derive';

interface Props {
  entry: {
    title?: string;
    slug?: { current?: string };
    excerpt?: string;
    publishedAt?: string;
    coverImage?: any;
    categories?: Array<{ title?: string; slug?: { current?: string }; description?: string }>;
  };
  featured?: boolean;
  /**
   * This entry is one of the weekly sermon previews. The caller derives it (see
   * entryIsSermonPreview in src/lib/blog-derive.ts) rather than the card reading
   * a stored flag, and it swaps the category chip for the "week of" eyebrow,
   * which is the one thing a reader wants off a preview card: which Sunday.
   */
  preview?: boolean;
}

const { entry, featured = false, preview = false } = Astro.props as Props;
const href = entry.slug?.current ? `/post/${entry.slug.current}` : '#';
const primaryCategory = entry.categories?.[0];

function formatDate(d?: string): string {
  if (!d) return '';
  const date = new Date(d);
  if (Number.isNaN(date.getTime())) return '';
  return date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
}
const dateLabel = formatDate(entry.publishedAt);

// THE PLATE IS GONE (art-direction pass, 2026-09-20, task 8). The card was a
// bordered, rounded, shadowed panel with a 2px gold bar across the top and a
// tint wash over the photograph: five devices doing the work of one. What is
// left is the photograph, the category in gold, the title and the date, with
// the whole thing still one link. The grid's own gaps are what separate the
// cards now, which is the same division the ruled bands use.
//
// The hover survives, because it is the one thing that told a reader the card
// was clickable: the title goes gold-ink and the photograph takes a slow 1.02
// scale.
const wrapperClass = featured ? 'group block lg:col-span-2' : 'group block';
const aspectClass = featured ? 'aspect-[16/9]' : 'aspect-[4/3]';
const titleClass = featured ? 'font-body text-h2 font-normal' : 'font-body text-h3 font-normal';
---

<a href={href} class:list={[wrapperClass]}>
  <div class:list={[aspectClass, 'overflow-hidden bg-muted']}>
    {
      entry.coverImage?.asset ? (
        <SanityImage
          source={entry.coverImage}
          width={featured ? 1400 : 800}
          sizes={
            featured
              ? '(min-width: 1024px) 66vw, 100vw'
              : '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw'
          }
          class="h-full w-full object-cover transition-transform duration-[1200ms] group-hover:scale-[1.02]"
        />
      ) : (
        <div class="h-full w-full" aria-hidden="true" />
      )
    }
  </div>

  {
    /* A sermon preview says which week it is for, and nothing else: the
      category chip would read "Sermon Preview" on all 106 of them, and the
      bare date does not tell a reader what the date is FOR. Everything else
      says its category, then its date, on two quiet lines. */
  }
  {
    preview ? (
      <p class="mt-4 font-ui text-ui text-gold-ink">
        <time datetime={entry.publishedAt}>{weekOfEyebrow(entry.publishedAt)}</time>
      </p>
    ) : (
      primaryCategory?.title && (
        <p class="mt-4 font-ui text-ui text-gold-ink">{primaryCategory.title}</p>
      )
    )
  }

  <h3 class:list={[titleClass, 'mt-2 text-foreground transition-colors group-hover:text-gold-ink']}>
    {entry.title}
  </h3>

  {
    !preview && dateLabel && (
      <time
        datetime={entry.publishedAt}
        class="mt-2 block font-ui text-[0.8125rem] text-muted-foreground"
      >
        {dateLabel}
      </time>
    )
  }

  {
    entry.excerpt && (
      <p class:list={[featured ? 'mt-m text-base' : 'mt-s text-sm', 'text-muted-foreground']}>
        {entry.excerpt}
      </p>
    )
  }
</a>
