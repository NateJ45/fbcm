---
// scaffold-file: journal
// Safe to edit by hand
// Card for the /blog index grid. Cover image on top, primary category +
// date eyebrow, title, excerpt. Whole card is clickable.
//
// `featured` style: the wide two-column variant, asked for by the caller (the
// index uses it for "this week").
//
// `preview` style: a weekly sermon preview. The chip+date line becomes the
// "week of" eyebrow. The caller DERIVES that from the category (blog-derive.ts);
// the card never reads journalEntry.featured for it.

import SanityImage from '@/components/SanityImage.astro';
import JournalCategoryChip from '@/components/JournalCategoryChip.astro';
import { weekOfEyebrow } from '@/lib/blog-derive';

interface Props {
  entry: {
    title?: string;
    slug?: { current?: string };
    excerpt?: string;
    publishedAt?: string;
    coverImage?: any;
    categories?: Array<{ title?: string; slug?: { current?: string }; description?: string }>;
  };
  featured?: boolean;
  /**
   * This entry is one of the weekly sermon previews. The caller derives it (see
   * entryIsSermonPreview in src/lib/blog-derive.ts) rather than the card reading
   * a stored flag, and it swaps the category chip for the "week of" eyebrow,
   * which is the one thing a reader wants off a preview card: which Sunday.
   */
  preview?: boolean;
}

const { entry, featured = false, preview = false } = Astro.props as Props;
const href = entry.slug?.current ? `/post/${entry.slug.current}` : '#';
const primaryCategory = entry.categories?.[0];

function formatDate(d?: string): string {
  if (!d) return '';
  const date = new Date(d);
  if (Number.isNaN(date.getTime())) return '';
  return date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
}
const dateLabel = formatDate(entry.publishedAt);

// Featured card spans 2 columns on lg and uses a wider hero aspect.
// Resting shadow matches the rest of the card grammar (ProjectCard) —
// soft warm 4px ambient depth.
const wrapperClass = featured
  ? 'card-lift card-lift-slow group block bg-card border border-border-soft rounded-md overflow-hidden hover:border-primary/40 transition-colors lg:col-span-2 shadow-[0_4px_18px_-14px_rgba(61,61,61,0.18)]'
  : 'card-lift card-lift-slow group block bg-card border border-border-soft rounded-md overflow-hidden hover:border-primary/40 transition-colors shadow-[0_4px_18px_-14px_rgba(61,61,61,0.18)]';
const aspectClass = featured ? 'aspect-[16/9]' : 'aspect-[4/3]';
const titleClass = featured
  ? 'font-display text-h2 text-foreground'
  : 'font-display text-h3 text-foreground';
---

<a href={href} class:list={[wrapperClass]}>
  {/* Brand accent stripe — matches every other marketing card. */}
  <div class="h-0.5 bg-primary" aria-hidden="true"></div>

  <div class:list={[aspectClass, 'img-zoom relative overflow-hidden bg-muted']}>
    {
      entry.coverImage?.asset ? (
        <SanityImage
          source={entry.coverImage}
          width={featured ? 1400 : 800}
          sizes={
            featured
              ? '(min-width: 1024px) 66vw, 100vw'
              : '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw'
          }
          class="h-full w-full object-cover"
        />
      ) : (
        <div class="h-full w-full" aria-hidden="true" />
      )
    }
    <div class="img-tint img-tint-light" aria-hidden="true"></div>
  </div>
  <div class:list={[featured ? 'p-section-md' : 'p-l']}>
    <div class="flex flex-wrap items-center gap-x-m gap-y-xs">
      {
        /* A sermon preview says which week it is for, and nothing else: the
          category chip would read "Sermon Preview" on all 106 of them, and the
          bare date does not tell a reader what the date is FOR. Everything
          else keeps the chip + date it always had. */
      }
      {
        preview ? (
          <p class="text-xs tracking-widest text-brown-mid uppercase dark:text-gold">
            <time datetime={entry.publishedAt}>{weekOfEyebrow(entry.publishedAt)}</time>
          </p>
        ) : (
          <>
            {primaryCategory?.title && (
              <JournalCategoryChip
                title={primaryCategory.title}
                tooltip={primaryCategory.description}
              />
            )}
            {dateLabel && (
              <time
                datetime={entry.publishedAt}
                class="text-xs tracking-widest text-foreground/80 uppercase"
              >
                {dateLabel}
              </time>
            )}
          </>
        )
      }
    </div>
    <h3 class:list={[titleClass, 'mt-s transition-colors group-hover:text-primary-dark']}>
      {entry.title}
    </h3>
    {
      entry.excerpt && (
        <p
          class:list={[
            featured ? 'mt-m text-base' : 'mt-s text-sm',
            'leading-relaxed text-foreground/80',
          ]}
        >
          {entry.excerpt}
        </p>
      )
    }
  </div>
</a>
