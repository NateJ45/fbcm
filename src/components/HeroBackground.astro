---
// Safe to edit by hand
// The hero background layer. With 0-1 images it renders a single static photo
// exactly as the hero always has. With 2-6 images it renders a slow
// cross-fading slideshow with a subtle Ken Burns zoom, driven ENTIRELY by CSS
// (see the .hero-fade / .hero-frame / hero-crossfade rules in globals.css) --
// there is no interval timer advancing slides any more. Each frame gets its
// own animation-delay from frameAnimationDelays() in src/lib/hero-frames.ts,
// so the delay alone staggers the frames into a cross-fade.
//
// The first slide is the LCP image (eager + high priority) and carries its alt,
// like the single-image hero; the additional slides use empty alt so they are
// decorative. Reduced-motion users get a single static image (the CSS
// animation is disabled in that media query).
//
// There is NO script in this file any more. The pause button and the dot
// indicators went with the art-direction pass (plan 3 task 6): the hero is a
// photograph under a gradient, not a carousel with controls. Hovering or
// focusing inside the frame still pauses both animations, and reduced-motion
// visitors still get one static frame.

import SanityImage from '@/components/SanityImage.astro';
import { frameAnimationDelays } from '@/lib/hero-frames';

import type { SanityImageObject } from '@/lib/pageBuilder.types';

interface Props {
  images: SanityImageObject[];
}

const { images } = Astro.props as Props;
const slides = (images ?? []).filter((img) => !!img?.asset);
const isSlideshow = slides.length >= 2;
const first = slides[0];

// One frame every 8 seconds, per the brief. frameAnimationDelays() also
// guards frame count to at least 1, though the schema already caps at 6.
const SECONDS_PER_FRAME = 8;
const delays = frameAnimationDelays(slides.length, SECONDS_PER_FRAME);

// Which crossfade keyframe a hero's frames use. Fixed keyframe percentages
// (calc() is not allowed in a keyframe selector) cannot serve the whole 2-6
// frame range without either a visible gap at 2-3 frames or a blurry overlap
// at 4-6, so there are two keyframes (globals.css) and this is the choice
// between them: `few-frames` picks the wider hold/fade-out tuned for 2-3.
const fewFrames = slides.length <= 3;
---

{first && (
  <>
    {isSlideshow ? (
      <div class:list={['hero-fade', { 'few-frames': fewFrames }]} data-hero-fade>
        {slides.map((img, i) => (
          <SanityImage
            source={img}
            width={2400}
            sizes="100vw"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'low'}
            quality={70}
            alt={i === 0 ? undefined : ''}
            class="hero-frame"
            style={`--frames:${slides.length}; --frame-s:${SECONDS_PER_FRAME}; animation-delay:${delays[i]}s`}
          />
        ))}
      </div>
    ) : (
      <SanityImage
        source={first}
        width={2400}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        quality={70}
        class="absolute inset-0 w-full h-full object-cover"
      />
    )}

    {/* ONE overlay, two gradients (plan 3 task 6, the prototype's hero).
        Bottom-up it reaches 94% ink where the words sit and is clear by 80% of
        the way up, so the sky stays sky; left-right it adds 55% at the left
        edge and nothing past the middle, which is where the headline and the
        lede live. The flat 25% scrim that used to sit under this is gone: a
        uniform wash greys the whole photograph to buy contrast the gradient
        already buys only where it is needed. */}
    <div
      class="absolute inset-0"
      style="background: linear-gradient(to top, rgba(23,21,31,.94) 0%, rgba(23,21,31,.62) 34%, rgba(23,21,31,.12) 62%, rgba(23,21,31,0) 80%), linear-gradient(to right, rgba(23,21,31,.55) 0%, rgba(23,21,31,0) 55%);"
      aria-hidden="true"
    ></div>
  </>
)}
