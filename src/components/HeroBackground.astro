---
// Safe to edit by hand
// The hero background layer. With 0-1 images it renders a single static photo
// exactly as the hero always has. With 2-12 it renders a moving slideshow
// (2026-09-27, `feat/hero-motion`):
//
//   - THE BEAT. Each frame holds for a long (5 s) or a short (3 s) beat and
//     dissolves into the next over 0.7 s. frameBeats() in src/lib/hero-frames.ts
//     is the plan (unit-tested); each frame carries its hold as `--hold`.
//   - THE MOVE. Every frame's picture moves the whole time it is on screen: a
//     push-in, a drift left, a pull-out or a drift right, lasting hold +
//     dissolve and zooming towards the editor's hotspot (the .kb-* rules in
//     globals.css).
//   - THE SEQUENCER is the one script below. It moves `is-current` along the
//     frames on their holds; the dissolve is a CSS transition. Frames 2..n
//     wait in a <template> and are inserted ONE AHEAD (frame 2 after window
//     load, frame k+1 when frame k comes up), and a frame is shown only once
//     its image has loaded and decoded, so a slow connection lengthens a hold
//     instead of dissolving into an empty frame.
//   - THE PARALLAX is CSS only: .hero-fade drifts down at a third of the
//     scroll speed as the hero leaves the screen (a scroll-driven animation in
//     globals.css), on the wrapper, never on the moving frames.
//
// Frame 1 is the LCP image: eager, high priority, server-rendered `is-current`
// (opaque from the first paint, with no JavaScript), and its move runs from
// CSS alone. It carries the alt; the later frames have empty alt, since they
// are decorative. Without JavaScript the visitor gets frame 1 and its one
// move. Under reduced motion: frame 1, still, no sequencing, the template is
// never inflated, and the Pause button is hidden.
//
// ONE PHOTO (2026-09-28, `feat/motion-openers`): the single photograph makes
// ONE slow push-in on load, towards its hotspot (--kb-origin, the same point
// as its object-position; the centre with none), and then stays put:
// .hero-still in globals.css, scale 1 to 1.05 over 5 s, eased out, forwards,
// inside `prefers-reduced-motion: no-preference`. Five seconds, not the
// twelve first proposed, so it needs no Pause control: WCAG 2.2.2 asks for
// one when motion that starts by itself lasts MORE than five seconds beside
// other content. It stays the eager, high-priority LCP image, and the
// section's overflow: clip crops the enlarged edge.
//
// THE PAUSE CONTROL STAYS, and it is a WCAG requirement (2.2.2 Pause, Stop,
// Hide): the slideshow moves for far longer than five seconds beside other
// content. It pauses the sequencer AND every move (`.is-paused` sets
// animation-play-state on the frames), and Play resumes both where they were.
// Hovering or focusing the hero no longer pauses it (2026-09-27): a resting
// desktop cursor over a full-screen hero froze it. It is drawn as the `link`
// CTA variant is (a rule under the label, no box) on the hero's bottom-right
// gutter, and renders only when there is more than one frame.

import SanityImage from '@/components/SanityImage.astro';
import { frameBeats, heroFrameStyle, heroObjectPosition, heroSizes } from '@/lib/hero-frames';
import { photoAspect } from '@/lib/photo-shape';

import type { SanityImageObject } from '@/lib/pageBuilder.types';

interface Props {
  images: SanityImageObject[];
  /** The frame's height as a fraction of the viewport: 1 for the tall home
      hero (min-h-[100svh]), 0.72 for an interior one (min-h-[72svh]). Only
      the `sizes` attribute reads it. */
  heightFraction?: number;
}

const { images, heightFraction = 1 } = Astro.props as Props;
const slides = (images ?? []).filter((img) => !!img?.asset);
const isSlideshow = slides.length >= 2;
const first = slides[0];
const beats = frameBeats(slides.length);

// FOCAL POINT AND SIZES, PER FRAME (2026-09-24, the hero people pass).
// Each frame is cropped by object-fit: cover, so it honours its own Sanity
// hotspot through object-position (the centre with none), and the same point
// is its move's transform-origin. Its `sizes` is the width cover actually
// draws it at, which on a portrait phone is the frame height times the
// photograph's aspect, not 100vw. All pure and unit-tested in
// src/lib/hero-frames.test.ts; the hotspot is numbers only, so stega never
// touches it.
const position = (img: SanityImageObject) => heroObjectPosition(img.hotspot, img.crop);
const frameClass = (i: number) => `hero-frame kb-${beats[i].move}`;
const frameSizes = (img: SanityImageObject) =>
  heroSizes(photoAspect(img as Parameters<typeof photoAspect>[0])?.a ?? null, heightFraction);
const firstPosition = first ? position(first) : null;
---

{first && (
  <>
    {isSlideshow ? (
      <>
        {/* Frame 1 only, in the document, current and moving from the first
            paint. Frames 2..n wait in the <template> (the speed pass,
            2026-09-24: fetched at once, they competed with the first paint
            for a phone's connection) until the sequencer inserts them one
            ahead. */}
        <div class="hero-fade" data-hero-fade>
          <SanityImage
            source={first}
            width={2400}
            sizes={frameSizes(first)}
            loading="eager"
            fetchpriority="high"
            quality={70}
            class={`${frameClass(0)} is-current is-moving`}
            style={heroFrameStyle(beats[0], firstPosition)}
          />
        </div>
        {/* Outside .hero-fade, so the wrapper holds frames and nothing else. */}
        <template data-hero-later>
          {slides.slice(1).map((img, j) => (
            <SanityImage
              source={img}
              width={2400}
              sizes={frameSizes(img)}
              loading="lazy"
              fetchpriority="low"
              quality={70}
              alt=""
              class={frameClass(j + 1)}
              style={heroFrameStyle(beats[j + 1], position(img))}
            />
          ))}
        </template>
      </>
    ) : (
      <SanityImage
        source={first}
        width={2400}
        sizes={frameSizes(first)}
        loading="eager"
        fetchpriority="high"
        quality={70}
        class="hero-still absolute inset-0 w-full h-full object-cover"
        style={firstPosition ? `object-position:${firstPosition};--kb-origin:${firstPosition}` : undefined}
      />
    )}

    {/* ONE overlay, two gradients (plan 3 task 6, the prototype's hero). The
        gradients themselves moved into `.hero-overlay` in globals.css on
        2026-09-21 (task 12) so the motion pass could animate the bottom
        gradient's first stop: an inline style cannot be a keyframe target.
        Read that rule for what the stops do and why --hero-stop is registered.
        The flat 25% scrim that used to sit under this is gone: a uniform wash
        greys the whole photograph to buy contrast the gradient already buys
        only where it is needed. */}
    <div class="hero-overlay" aria-hidden="true"></div>

    {/* Deliberately OUTSIDE the .hero-entry-stagger content wrapper (it is not
        even in the same subtree), so it does not fade up with the words: a
        control that arrives half a second late is a control the visitor cannot
        reach yet. It is rendered after the overlay so it paints on top of it
        and receives the click. */}
    {isSlideshow && (
      <button
        type="button"
        data-hero-pause
        aria-pressed="false"
        class="hit-44 font-ui text-ui font-semibold text-bg/80 hover:text-bg border-b border-current pb-1 focus-visible:ring-2 focus-visible:ring-bg absolute right-gutter bottom-[clamp(20px,4vh,40px)] z-10 motion-reduce:hidden"
      >
        Pause
      </button>
    )}
  </>
)}

{isSlideshow && (
  <script is:inline>
    (function () {
      // The slideshow's sequencer (2026-09-27). One instance at a time lives
      // in window.__heroSeq; it is stopped on astro:before-swap and a new one
      // is bound on the next page, so View Transitions can neither double-bind
      // it nor leave its timers running against a detached hero.
      function stop() {
        var s = window.__heroSeq;
        window.__heroSeq = null;
        if (s) s.stop();
      }
      function init() {
        var box = document.querySelector('[data-hero-fade]');
        var tpl = document.querySelector('template[data-hero-later]');
        if (!box || !tpl || box.dataset.heroBound === '1') return;
        // Reduced motion: frame 1 alone, still; the template is never inflated.
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        stop();
        box.dataset.heroBound = '1';
        var button = document.querySelector('[data-hero-pause]');
        var later = tpl.content.querySelectorAll('.hero-frame');
        var frames = [box.querySelector('.hero-frame')];
        var total = later.length + 1;
        var cur = 0;
        var timer = 0;
        var cleanup = 0;
        var due = 0;
        var left = -1;
        var waiting = false;
        var loaded = document.readyState === 'complete';
        var userPaused = false;
        var hidden = document.hidden;
        var stopped = false;

        function holdMs(el) {
          return (parseFloat(el.style.getPropertyValue('--hold')) || 5) * 1000;
        }
        // Frame i, inserted from the template the first time it is asked for,
        // never before window load, so frame 2 cannot compete with frame 1.
        function frame(i) {
          if (!frames[i] && loaded) {
            var el = document.importNode(later[i - 1], true);
            var retry = function () {
              if (waiting) advance();
            };
            el.addEventListener('load', retry);
            el.addEventListener('error', retry);
            box.appendChild(el);
            frames[i] = el;
          }
          return frames[i];
        }
        function ready(el) {
          return !!el && el.complete && el.naturalWidth > 0;
        }
        // An image that failed (complete, with no pixels) is skipped, so one
        // missing photograph cannot stop the slideshow on the frame before it.
        function broken(el) {
          return !!el && el.complete && el.naturalWidth === 0;
        }
        function running() {
          return !userPaused && !hidden && !stopped;
        }
        function schedule(ms) {
          clearTimeout(timer);
          left = -1;
          due = Date.now() + ms;
          timer = setTimeout(holdEnded, ms);
        }
        // The hold is over. Advance if the next frame is ready; if it is not,
        // keep this one, slow its move so the picture is still moving, and
        // advance when the next image arrives.
        function holdEnded() {
          timer = 0;
          waiting = true;
          var el = frames[cur];
          if (el.getAnimations) {
            el.getAnimations().forEach(function (a) {
              if (a.updatePlaybackRate) a.updatePlaybackRate(0.25);
            });
          }
          advance();
        }
        function advance() {
          if (!waiting || !running()) return;
          var n = cur;
          var next = null;
          for (var step = 1; step < total; step++) {
            n = (cur + step) % total;
            next = frame(n);
            if (!broken(next)) break;
          }
          if (!ready(next)) return;
          waiting = false;
          var shown = function () {
            if (stopped) return;
            if (!running()) {
              waiting = true;
              return;
            }
            show(n);
          };
          if (next.decode) next.decode().then(shown, shown);
          else shown();
        }
        function show(n) {
          var prev = frames[cur];
          var el = frames[n];
          // Restart its move: off, a style read, on. It is at opacity 0 here.
          el.classList.remove('is-moving');
          void el.offsetWidth;
          el.classList.add('is-moving', 'is-current');
          prev.classList.remove('is-current');
          cur = n;
          // Once the previous frame has dissolved out, let its move go, so a
          // hidden frame holds no transform and no compositor layer.
          clearTimeout(cleanup);
          cleanup = setTimeout(function () {
            if (prev !== frames[cur]) prev.classList.remove('is-moving');
          }, 800);
          frame((n + 1) % total);
          schedule(holdMs(el));
        }
        function pause() {
          if (timer) {
            clearTimeout(timer);
            timer = 0;
            left = Math.max(0, due - Date.now());
          }
        }
        function resume() {
          if (!running()) return;
          if (waiting) advance();
          else if (!timer) schedule(left >= 0 ? left : holdMs(frames[cur]));
        }
        function onVisibility() {
          hidden = document.hidden;
          box.classList.toggle('is-idle', hidden);
          if (hidden) pause();
          else resume();
        }
        function onLoad() {
          loaded = true;
          frame(1);
        }
        function onPress() {
          userPaused = !userPaused;
          box.classList.toggle('is-paused', userPaused);
          button.setAttribute('aria-pressed', userPaused ? 'true' : 'false');
          button.textContent = userPaused ? 'Play' : 'Pause';
          if (userPaused) pause();
          else resume();
        }

        if (button) button.addEventListener('click', onPress);
        document.addEventListener('visibilitychange', onVisibility);
        if (loaded) frame(1);
        else window.addEventListener('load', onLoad, { once: true });
        if (hidden) {
          box.classList.add('is-idle');
          left = holdMs(frames[0]);
        } else schedule(holdMs(frames[0]));

        window.__heroSeq = {
          stop: function () {
            stopped = true;
            clearTimeout(timer);
            clearTimeout(cleanup);
            document.removeEventListener('visibilitychange', onVisibility);
            window.removeEventListener('load', onLoad);
            if (button) button.removeEventListener('click', onPress);
          },
        };
      }
      init();
      if (!window.__heroSeqBound) {
        window.__heroSeqBound = true;
        document.addEventListener('astro:page-load', init);
        document.addEventListener('astro:before-swap', stop);
      }
    })();
  </script>
)}
