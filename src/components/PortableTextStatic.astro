---
// Safe to edit by hand
// Server-side static Portable Text renderer. Converts simple Portable Text block
// arrays to HTML at build time with zero client-side JavaScript. Handles the
// node types used in privacy.astro and contact.astro:
//   - normal, h2, h3 block styles
//   - bullet and numbered lists
//   - strong, em, and link marks (external links get rel="noopener")
//
// Visual classes mirror PortableText.tsx so output is visually identical. Both
// were redrawn in the art-direction pass (PortableText.tsx in task 8, this one
// in task 11) and they have to be changed together: the headings are Castoro
// ROMAN, because the display face is capitals-only and was setting the privacy
// policy's sub-heads in full caps at h2.
// Does NOT handle inlineImage, pullQuote, or other journal-specific custom types.
// Use PortableText.tsx (React island) for content with those blocks.

interface Span {
  _type: 'span';
  _key: string;
  text?: string;
  marks?: string[];
}

interface MarkDef {
  _key: string;
  _type: string;
  href?: string;
  openInNewTab?: boolean;
}

interface Block {
  _type: 'block';
  _key: string;
  style?: string;
  listItem?: 'bullet' | 'number';
  level?: number;
  children?: Span[];
  markDefs?: MarkDef[];
}

interface Props {
  value?: Block[] | null;
  className?: string;
}

const { value, className } = Astro.props;

if (!value || value.length === 0) {
  return;
}

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

function escapeHtml(str: string): string {
  return str
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function renderSpans(spans: Span[] | undefined, markDefs: MarkDef[] | undefined): string {
  if (!spans) return '';
  const defsMap = new Map<string, MarkDef>((markDefs ?? []).map((d) => [d._key, d]));

  return spans
    .map((span) => {
      const text = escapeHtml(span.text ?? '');
      if (!span.marks || span.marks.length === 0) return text;

      // Apply marks innermost-first (last in array = innermost wrapper)
      let result = text;
      const reversed = [...span.marks].reverse();
      for (const mark of reversed) {
        if (mark === 'strong') {
          result = `<strong class="font-semibold">${result}</strong>`;
        } else if (mark === 'em') {
          result = `<em class="italic">${result}</em>`;
        } else {
          // Reference mark — look up in markDefs
          const def = defsMap.get(mark);
          // A link token with no address behind it (church-links.ts's
          // linkFallback()) fills to '', not a dead link: the words stay
          // plain text rather than linking nowhere.
          if (def?._type === 'link' && def.href) {
            const href = escapeHtml(def.href);
            const isExternal = /^https?:\/\//.test(def.href);
            const newTab = def.openInNewTab || isExternal;
            const extras = newTab ? ` target="_blank" rel="noopener noreferrer"` : '';
            result = `<a href="${href}" class="text-link underline underline-offset-2 hover:text-primary transition-colors"${extras}>${result}</a>`;
          }
        }
      }
      return result;
    })
    .join('');
}

// ---------------------------------------------------------------------------
// Block grouping (list items need to be wrapped in <ul>/<ol>)
// ---------------------------------------------------------------------------

type RenderedItem =
  | { kind: 'html'; html: string }
  | { kind: 'listItem'; listType: 'bullet' | 'number'; html: string };

const items: RenderedItem[] = value.map((block) => {
  if (block._type !== 'block') {
    // Non-block types (inlineImage, etc.) are silently skipped in the static renderer.
    return { kind: 'html', html: '' };
  }

  const inner = renderSpans(block.children, block.markDefs);

  if (block.listItem === 'bullet' || block.listItem === 'number') {
    return {
      kind: 'listItem',
      listType: block.listItem,
      html: `<li>${inner}</li>`,
    };
  }

  const style = block.style ?? 'normal';
  let html: string;
  if (style === 'h2') {
    html = `<h2 class="mt-14 mb-5 font-body text-h2 font-normal text-foreground scroll-mt-24">${inner}</h2>`;
  } else if (style === 'h3') {
    html = `<h3 class="mt-10 mb-3 font-body text-h3 font-normal text-foreground scroll-mt-24">${inner}</h3>`;
  } else if (style === 'h4') {
    html = `<h4 class="mt-8 mb-2 font-body text-h4 font-normal text-foreground scroll-mt-24">${inner}</h4>`;
  } else if (style === 'blockquote') {
    html = `<blockquote class="my-10 border-l border-gold pl-6 font-body text-h3 font-normal italic text-foreground">${inner}</blockquote>`;
  } else {
    // normal (and any unrecognised style)
    html = `<p class="my-5 font-body text-body leading-[1.72] text-foreground/90">${inner}</p>`;
  }
  return { kind: 'html', html };
});

// Merge consecutive list items of the same type into a single list element.
const segments: { html: string }[] = [];
let i = 0;
while (i < items.length) {
  const item = items[i];
  if (item.kind === 'listItem') {
    const listType = item.listType;
    const tag = listType === 'bullet' ? 'ul' : 'ol';
    const cls =
      listType === 'bullet'
        ? 'my-5 list-disc pl-6 space-y-2 font-body text-body leading-[1.72] text-foreground/90 marker:text-gold'
        : 'my-5 list-decimal pl-6 space-y-2 font-body text-body leading-[1.72] text-foreground/90 marker:text-gold';
    let inner = item.html;
    i += 1;
    while (i < items.length) {
      const next = items[i];
      if (next.kind === 'listItem' && next.listType === listType) {
        inner += next.html;
        i += 1;
      } else {
        break;
      }
    }
    segments.push({ html: `<${tag} class="${cls}">${inner}</${tag}>` });
  } else {
    segments.push({ html: item.html });
    i += 1;
  }
}

const rendered = segments.map((s) => s.html).join('');
---

{value && value.length > 0 && <div class={className} set:html={rendered} />}
