---
// Safe to edit by hand
// scaffold-file: church
// Page-builder block: questions and answers, drawn as THE FAQ BAND (2026-09-24,
// the Visit identity pass; the prototype's `.faq`,
// docs/superpowers/prototypes/2026-09-23-visit/visit.html).
//
// The deep indigo brand band (--color-band-deep, the same in both themes, so
// it is dark BY TYPE and carries no colour field, CLAUDE.md rule 9). The
// heading sits in the narrow left column under the rose glyph and holds its
// place while the questions scroll; the questions run down the right between
// gold hairlines. Native <details>, so the keyboard works, find-in-page finds
// a closed answer, and no JavaScript ships. The first question opens by
// default so the band never reads as a stack of closed doors.
//
// The one mark that says "this opens" is the small quatrefoil at the end of
// each question: an outline when closed, filled gold when open.
//
// The heading is in the one band grammar (H2_DISPLAY, rule 17) and is sized
// by its length: a long heading ("Frequently asked questions") steps down a
// size so no word has to break in the narrow column (rollout rule 9).
//
// THE ANSWER'S COLOUR IS AN OVERRIDE, and it has to be. PortableText.tsx
// hard-codes text-foreground on every paragraph, which is invisible on a
// fixed dark band in light mode. The arbitrary descendant variants below
// ([&_p]:...) generate `.wrapper p { ... }`, which outranks a single class.
import PortableText from '@/components/PortableText';
import BuildingGlyph from '@/components/church/BuildingGlyph.astro';
import { H2_DISPLAY } from '@/lib/heading-grammar';
import { splitStega } from '@/lib/preview-stega';

interface FaqItem {
  _key?: string;
  question?: string;
  answer?: any;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  items?: FaqItem[];
  headingId: string;
}

const { eyebrow, heading, items = [], headingId } = Astro.props as Props;
const validItems = items.filter((i) => i?.question);
const long = splitStega(heading ?? '').cleaned.trim().length > 18;
// The long step keeps the grammar's face and weight and changes only the size.
const headingClass = long
  ? H2_DISPLAY.replace('text-h2', 'text-[clamp(1.875rem,1.1rem+2vw,2.75rem)]').replace(
      'leading-[1.02]',
      'leading-[1.06]',
    )
  : H2_DISPLAY;
/** The quatrefoil, four circles about the origin (BuildingGlyph's QF, smaller). */
const QF = 'M-5-5A6.2 6.2 0 1 1 5-5A6.2 6.2 0 1 1 5 5A6.2 6.2 0 1 1-5 5A6.2 6.2 0 1 1-5-5Z';
---

<section class="bg-band-deep text-bg" aria-labelledby={heading ? headingId : undefined}>
  <div class="mx-auto max-w-content px-gutter py-section-lg">
    <div class="grid grid-cols-12 gap-x-[clamp(16px,2.5vw,40px)]">
      <div
        class="col-span-12 self-start lg:sticky lg:top-[calc(var(--header-offset)+1rem)] lg:col-span-4"
      >
        <BuildingGlyph name="rose" class="mb-[22px] w-14 text-gold" />
        {eyebrow && <p class="mb-4 font-ui text-ui font-semibold text-gold">{eyebrow}</p>}
        {
          heading && (
            <h2 id={headingId} class:list={[headingClass, 'text-gold']}>
              {heading}
            </h2>
          )
        }
      </div>

      {
        validItems.length > 0 && (
          <div class="col-span-12 mt-9 min-w-0 border-t border-gold/45 lg:col-span-8 lg:col-start-5 lg:mt-0">
            {validItems.map((item, i) => (
              <details class="faq-q group border-b border-gold/45" open={i === 0}>
                <summary class="grid cursor-pointer list-none grid-cols-[minmax(0,1fr)_28px] items-center gap-5 py-[clamp(20px,2.2vw,28px)] font-body text-[clamp(1.3rem,1.1rem+.6vw,1.5625rem)] leading-[1.3] text-bg [&::-webkit-details-marker]:hidden">
                  <span class="faq-q-text">{item.question}</span>
                  <svg
                    viewBox="-16 -16 32 32"
                    aria-hidden="true"
                    focusable="false"
                    class="building-glyph faq-mark w-6 text-gold"
                  >
                    <path d={QF} />
                  </svg>
                </summary>
                {item.answer && (
                  <PortableText
                    value={item.answer}
                    className="max-w-[40em] pb-[clamp(22px,2.4vw,32px)] font-body text-[1.1875rem] leading-[1.6] lg:pr-12 [&_a]:text-gold [&_li]:text-bg/85 [&_p]:my-0 [&_p]:text-bg/85 [&_strong]:text-bg [&_ul]:text-bg/85"
                  />
                )}
              </details>
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>
