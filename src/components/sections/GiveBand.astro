---
// Safe to edit by hand
// scaffold-file: church
// Page-builder block: the giving band, redrawn for the art-direction pass
// (2026-09-21, spec section 5, the prototype's `.give` block). Seven columns of
// heading on the left, the paragraph and one gold button on the right five.
//
// IT IS SOFT PAPER BY DEFAULT, AND INDIGO ONLY WHEN THE PAGE CAN AFFORD IT.
// The spec's rule is that two dark surfaces never touch. SectionRenderer works
// out both halves of that and passes them down: `lastBeforeFooter` (the footer
// is a fixed indigo-deep field, so an indigo band immediately above it would
// read as one tall dark block) and `prevIsDark` (the band above). The fill is
// indigo only when neither is true. Nothing here decides its own surface from
// its own content, which is the same reason blocks carry no colour field
// (CLAUDE.md rule 9).
//
// THE PAPER FILL IS `bg-surface-soft`, NOT `bg-bg-soft`. --color-bg-soft is a
// LIGHT-ONLY token: theme-tokens.test.ts forbids .dark from redeclaring it, so
// a band painted with it stays cream under .dark while --foreground flips to
// paper-white and the heading disappears. --surface-soft is the same value in
// light and a real dark counterpart (#262548), and it is what the cadence's
// own alternating band already uses (src/lib/surfaces.ts, the "muted" entry).
//
// The button goes to the block's own link when the editor typed one, and otherwise
// to the giving address in Site settings, so the church can move its giving page in
// one place. Church Center is somebody else's site, so the link opens in a new tab.
//
// SELF_CONTAINED: when it IS dark, the ink on it is text-bg (paper-white in both
// themes) rather than text-cream (which flips to ink under .dark).
import SectionHeading from '@/components/SectionHeading.astro';
import CtaLink from '@/components/CtaLink.astro';
import { getSiteSettings } from '@/lib/queries';
import type { SectionSiteSettings } from '@/lib/pageBuilder.types';

interface Props {
  heading?: string;
  body?: string;
  buttonLabel?: string;
  buttonUrl?: string;
  /**
   * The heading tag. 'h2' everywhere except when this band OPENS a page, in
   * which case it is the page's only h1 and SectionRenderer passes 'h1'. This
   * mirrors HeritageBand.astro's `level` prop: /give is the second page in
   * the site (after /history) to open on a band rather than a hero, and a
   * page with no h1 fails axe's page-has-heading-one.
   */
  level?: 'h1' | 'h2';
  headingId: string;
  /**
   * Site settings, handed down by SectionRenderer from the route that already
   * fetched them. In /preview/** that is the DRAFT client, so an editor moving
   * the giving link sees it; calling getSiteSettings() here would read the
   * published document and then serve a memoised copy of it for the isolate's
   * whole life. The fetch below is only the fallback for callers that pass
   * nothing (the styleguide, and the code-defined default sections).
   */
  settings?: SectionSiteSettings | null;
  /** True when this block is the last row of the page builder. See the note above. */
  lastBeforeFooter?: boolean;
  /** True when the row immediately above this one paints a dark surface. */
  prevIsDark?: boolean;
}

const {
  heading,
  body,
  buttonLabel,
  buttonUrl,
  level = 'h2',
  headingId,
  settings: settingsProp,
  lastBeforeFooter = false,
  prevIsDark = false,
} = Astro.props as Props;

// The one surface decision, stated once. See the note at the top of the file.
const dark = !lastBeforeFooter && !prevIsDark;

const settings: SectionSiteSettings | null =
  settingsProp !== undefined ? settingsProp : await getSiteSettings();
const href: string | undefined = buttonUrl || settings?.givingUrl || undefined;

const giveCta = href
  ? {
      label: buttonLabel || 'Give through Church Center',
      linkType: 'external' as const,
      externalUrl: href,
      openInNewTab: true,
    }
  : null;
---

<section
  class={dark ? 'bg-indigo-field text-bg' : 'bg-surface-soft'}
  aria-labelledby={heading ? headingId : undefined}
>
  <div
    class="mx-auto grid max-w-content grid-cols-12 gap-x-[clamp(16px,2.5vw,40px)] px-gutter py-section-lg"
  >
    <div class="col-span-12 lg:col-span-7">
      <SectionHeading
        headline={heading}
        headingId={headingId}
        level={level}
        align="left"
        tone={dark ? 'band' : 'default'}
      />
    </div>

    <div class="col-span-12 mt-6 self-center lg:col-span-5 lg:col-start-8 lg:mt-0">
      {
        body && (
          <p
            class:list={[
              'max-w-[38ch] font-body text-[1.125rem] leading-[1.72]',
              dark ? 'text-bg/80' : 'text-muted-foreground',
            ]}
          >
            {body}
          </p>
        )
      }

      {
        giveCta && (
          <div class="mt-6">
            <CtaLink cta={giveCta} variant="gold" onDark={dark} />
          </div>
        )
      }
    </div>
  </div>
</section>
