---
// Safe to edit by hand
// scaffold-file: church
// Page-builder block: documents to download. Newsletters, annual reports, the
// constitution. Since the art-direction pass (2026-09-21, task 10) the rows
// are the same editorial list the blog archive took in task 8: the year on the
// left in the UI face, the title as the link in Castoro roman, the note under
// it, and a hairline under each row. The 2px gold rule that used to sit over
// every row is gone; one hairline per row is the division, and the year group
// headings are what give the list its landmarks.
//
// Rows are sorted newest first by sortDocsByYearDesc() in church-derive.ts
// (undated rows last, ties by title), so the order is derived, never typed
// twice. A row pointing at an uploaded file gets the `download` attribute; a
// row pointing at somebody else's page must not, because you cannot download a
// website.
//
// When the sorted list spans two or more distinct years, groupDocsByYear()
// (same module) partitions it into year subheadings, descending, undated last.
// A single-year or undated-only list comes back as one ungrouped group
// (heading: null), so it renders as one straight run of rows. The year
// headings are set in old-style figures at h2, which is the one place a
// numeral is allowed to be the largest thing on a band.
//
// A CONTENT block: the alternating surface arrives as a prop from SectionRenderer.
import SectionHeading from '@/components/SectionHeading.astro';
import { surfaceClass } from '@/lib/surfaces';
import { sortDocsByYearDesc, groupDocsByYear } from '@/lib/church-derive';

interface ListedDocument {
  _key?: string;
  title?: string | null;
  year?: number | null;
  fileUrl?: string | null;
  url?: string | null;
  note?: string | null;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  docs?: ListedDocument[];
  surface?: 'background' | 'muted';
  headingId: string;
}

const { eyebrow, heading, docs = [], surface = 'background', headingId } = Astro.props as Props;
const bg = surfaceClass(surface);

// sortDocsByYearDesc needs a title on every row, so rows without one are
// dropped first: a document nobody can name is not a row a visitor can use.
const sorted = sortDocsByYearDesc(
  docs.filter((d): d is ListedDocument & { title: string } => !!d?.title),
);
const groups = groupDocsByYear(sorted);
---

<section class={bg} aria-labelledby={heading ? headingId : undefined}>
  <div class="mx-auto max-w-content px-gutter py-section-lg">
    <SectionHeading
      eyebrow={eyebrow}
      headline={heading}
      headingId={headingId}
      level="h2"
      align="left"
      tone="church"
    />

    {
      groups.map((group, i) => (
        <>
          {
            /* Only rendered when the list spans two or more distinct years
               (groupDocsByYear returns a single ungrouped entry otherwise).
               Castoro roman in old-style figures, on the same left edge as
               everything else on the page. */
            group.heading && (
              <h3
                class:list={[
                  'font-body text-h2 leading-none font-normal text-foreground oldstyle',
                  i === 0 ? 'mt-section-md' : 'mt-section-lg',
                ]}
              >
                {group.heading}
              </h3>
            )
          }
          <ul class:list={[group.heading ? 'mt-8' : 'mt-section-md']} role="list">
            {group.docs.map((doc) => {
              const href = doc.fileUrl || doc.url;
              const isFile = !!doc.fileUrl;
              return (
                <li class="grid grid-cols-12 items-baseline gap-x-[clamp(16px,2.5vw,40px)] border-b border-hair py-6">
                  <span class="col-span-12 font-ui text-[0.8125rem] tracking-[.06em] text-muted-foreground md:col-span-2">
                    {/* The year is the row's left-hand meta, exactly as the
                        date is on the blog list. Inside a YEAR GROUP it would
                        be the group's own heading repeated on every row, so it
                        is left blank there and the column keeps the indent. */}
                    {!group.heading && typeof doc.year === 'number' ? doc.year : ''}
                  </span>

                  <span class="col-span-12 md:col-span-9 md:col-start-3">
                    {href ? (
                      <a
                        href={href}
                        download={isFile ? true : undefined}
                        target={isFile ? undefined : '_blank'}
                        rel={isFile ? undefined : 'noopener noreferrer'}
                        class="block font-body text-h3 leading-snug font-normal text-foreground transition-colors hover:text-gold-ink"
                      >
                        {doc.title}
                      </a>
                    ) : (
                      <span class="block font-body text-h3 leading-snug font-normal text-foreground">
                        {doc.title}
                      </span>
                    )}

                    {doc.note && (
                      <span class="mt-2.5 block max-w-[56ch] font-body text-body text-muted-foreground">
                        {doc.note}
                      </span>
                    )}
                  </span>
                </li>
              );
            })}
          </ul>
        </>
      ))
    }
  </div>
</section>
