---
// Safe to edit by hand
// scaffold-file: church
// Page-builder block: a scripture band, redrawn in the Watchword band's verse
// treatment (2026-09-24, the Staff identity pass; the rollout's shared
// component table: "ScriptureBand: the watchword band's verse treatment").
//
// The ground is --color-band-deep (the brand's indigo-dark), the Watchword
// band's own, dark BY TYPE (SELF_CONTAINED in sectionCadence.ts; no colour
// field, CLAUDE.md rule 9). Every ink on it is measured in both themes in
// theme-tokens.test.ts: paper for reading, brand gold for everything picked
// out (the heading, the highlighted word, the reference).
//
// What it draws, top to bottom, each part only when it is filled in:
//   - `heading` (optional, 2026-09-24): the band h2 in H2_DISPLAY, the one
//     heading grammar every church band shares (rule 17).
//   - the verse in Castoro, at the Watchword's size (`.ww-verse` and
//     `.sb-verse` share one rule in globals.css). When the band carries a
//     reference the verse IS a quotation, so it is set in curly quotes with
//     the opening one hung in the margin; a band with no reference (Beliefs'
//     common statement) is set plain.
//   - `accentWord`, picked out in gold italic EVERYWHERE it appears as a whole
//     word, as the Watchword band picks out praise and proclaim. It goes
//     through highlightWords(), which matches on the stega-CLEANED text and
//     slices the RAW string, so in the preview the verse keeps its
//     click-to-edit payload; the accent word itself is cleaned before it is
//     used as a pattern (it is a stega-encoded string too).
//   - `reference`, in gold, beside the verse at desktop width and under it on
//     a phone, exactly as the Watchword's Isaiah 12:4.
//   - `intro` (optional, 2026-09-24): a paragraph under it all.
//
// The menu-window texture the art-direction pass set behind the right half
// is gone: the Watchword band carries none, and the rollout keeps one texture
// family (the building glyphs) for decoration.
//
// The region is named by the heading when there is one, else by the
// REFERENCE, never by the blockquote: pointing aria-labelledby at the verse
// made the landmark's accessible name the whole of scripture.
import { H2_DISPLAY } from '@/lib/heading-grammar';
import { highlightWords } from '@/lib/highlight-words';
import { splitStega } from '@/lib/preview-stega';

interface Props {
  heading?: string;
  verse?: string;
  reference?: string;
  accentWord?: string;
  intro?: string;
  headingId: string;
}

const { heading, verse, reference, accentWord, intro, headingId } = Astro.props as Props;
const accent = splitStega(accentWord ?? '').cleaned.trim();
const parts = verse ? highlightWords(verse, accent ? [accent] : []) : [];
const quoted = !!reference;
const labelled = heading || reference;
---

{
  verse && (
    <section class="sb bg-band-deep text-bg" aria-labelledby={labelled ? headingId : undefined}>
      <div class="sb-wrap mx-auto max-w-content px-gutter">
        {heading && (
          <h2 id={headingId} class:list={[H2_DISPLAY, 'text-gold']}>
            {heading}
          </h2>
        )}

        <blockquote class="sb-verse">
          <p class:list={['font-body', quoted && 'sb-q']}>
            {quoted && <>&ldquo;</>}
            {parts.map((part) =>
              part.hit ? (
                <mark class="bg-transparent text-gold italic">{part.text}</mark>
              ) : (
                part.text
              ),
            )}
            {quoted && <>&rdquo;</>}
          </p>
          {reference && (
            <cite
              id={heading ? undefined : headingId}
              class="font-ui font-bold text-gold not-italic"
            >
              {reference}
            </cite>
          )}
        </blockquote>

        {intro && <p class="sb-intro whitespace-pre-line">{intro}</p>}
      </div>
    </section>
  )
}
