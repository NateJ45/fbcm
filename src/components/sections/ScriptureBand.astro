---
// Safe to edit by hand
// scaffold-file: church
// Page-builder block: a scripture band on the indigo field, redrawn for the
// art-direction pass (2026-09-21, spec section 5).
//
// The verse is set at --text-h1 in Castoro ITALIC, not in the display face:
// Castoro Titling is capitals-only and has no italic, and a verse set in
// capitals reads as a slogan. One word may be picked out in gold, and the
// reference sits under it as a font-ui label.
//
// Behind the right half of the band, at 18% under mix-blend-mode: luminosity,
// is the alpha-and-omega window from src/assets/menu-window.jpg, masked so it
// fades out before it reaches the words. It is the same photograph the mobile
// menu and the footer carry, which is the point: one texture, three places.
// Decorative, so it is aria-hidden with an empty alt and loads lazily.
//
// The gold accent goes through splitHeadingAccent(), the same splitter the
// heading accents use, so it is case-insensitive, first-occurrence-only and
// stega-safe. `accentWord` is deliberately NOT in the in-canvas accent registry
// (see the note at the top of churchSections.ts), so it is split here directly.
//
// SELF_CONTAINED: the band is dark by type, so the ink on it is text-bg
// (paper-white in both themes) rather than text-cream (which flips to ink
// under .dark).
import { getImage } from 'astro:assets';
import { splitHeadingAccent } from '@/lib/heading-accent';
import menuWindowAsset from '@/assets/menu-window.jpg';

interface Props {
  verse?: string;
  reference?: string;
  accentWord?: string;
  headingId: string;
}

const { verse, reference, accentWord, headingId } = Astro.props as Props;
const { found, before, word, after } = splitHeadingAccent(verse, accentWord);

// The texture. 1200w at quality 60 is generous for something that renders at
// 18% opacity under a luminosity blend and a left-fading mask. Real dimensions
// go on the tag even though CSS sizes it absolutely: the numbers cost nothing
// and the file keeps the habit.
const texture = await getImage({
  src: menuWindowAsset,
  width: 1200,
  quality: 60,
  format: 'jpg',
});
const textureWidth = texture.options.width ?? 1200;
const textureHeight = Math.round(textureWidth * (menuWindowAsset.height / menuWindowAsset.width));
---

{
  /* The region is named by the REFERENCE, not the blockquote: pointing
    aria-labelledby at the verse made the landmark's accessible name the whole
    of scripture. With no reference typed the region stays unnamed, which is
    quieter and just as findable. */
}
{
  verse && (
    <section
      class="relative isolate overflow-hidden bg-indigo-field text-bg"
      aria-labelledby={reference ? headingId : undefined}
    >
      <img
        src={texture.src}
        alt=""
        aria-hidden="true"
        width={textureWidth}
        height={textureHeight}
        loading="lazy"
        decoding="async"
        class="pointer-events-none absolute inset-y-0 right-0 -z-10 w-1/2 object-cover opacity-[.18] mix-blend-luminosity"
        style="mask-image: linear-gradient(to left, #000, transparent); -webkit-mask-image: linear-gradient(to left, #000, transparent);"
      />

      <div class="mx-auto max-w-content px-gutter py-section-lg">
        <blockquote class="max-w-[20ch] font-body text-h1 leading-[1.08] font-normal text-bg italic">
          {found ? (
            <>
              {before}
              <span class="text-gold">{word}</span>
              {after}
            </>
          ) : (
            verse
          )}
        </blockquote>

        {reference && (
          <p id={headingId} class="mt-6 font-ui text-ui text-gold">
            {reference}
          </p>
        )}
      </div>
    </section>
  )
}
