---
// Safe to edit by hand
// scaffold-file: church
// Page-builder block: a scripture band. One verse, centred, on the indigo field,
// with a single word picked out in gold italic and the reference beneath it in
// small caps. This is the one place the spec allows a centred heading, and the only
// block with no heading field at all: the words are the heading.
//
// The gold accent goes through splitHeadingAccent(), the same splitter the heading
// accents use, so it is case-insensitive, first-occurrence-only and stega-safe.
// `accentWord` is deliberately NOT in the in-canvas accent registry (see the note
// at the top of churchSections.ts), so it is split here directly.
//
// SELF_CONTAINED: the band is dark by type.
import { splitHeadingAccent } from '@/lib/heading-accent';

interface Props {
  verse?: string;
  reference?: string;
  accentWord?: string;
  headingId: string;
}

const { verse, reference, accentWord, headingId } = Astro.props as Props;
const { found, before, word, after } = splitHeadingAccent(verse, accentWord);
---

{
  verse && (
    <section class="bg-indigo-field" aria-labelledby={headingId}>
      <div class="mx-auto max-w-content px-m py-section-lg text-center" data-reveal>
        {/* text-bg, never text-cream: --color-cream flips to ink under .dark
            while --color-bg stays paper-white, and this band is dark in both
            themes (see the .dark block in globals.css). */}
        <blockquote
          id={headingId}
          class="mx-auto max-w-3xl font-display text-[1.875rem] leading-snug text-bg"
        >
          {found ? (
            <>
              {before}
              <em class="text-gold italic">{word}</em>
              {after}
            </>
          ) : (
            verse
          )}
        </blockquote>

        {reference && (
          <p class="mt-m text-xs font-semibold tracking-eyebrow text-gold uppercase">{reference}</p>
        )}
      </div>
    </section>
  )
}
