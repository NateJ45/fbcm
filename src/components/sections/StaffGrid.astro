---
// Safe to edit by hand
// scaffold-file: church
// Page-builder block: the staff, as an editorial list rather than a grid of
// cards. The art-direction pass (2026-09-21, task 10) took the plate off: the
// gold top rule over every portrait and the bordered box around it are gone,
// and what is left is the photograph, a hairline over each person, the name in
// Castoro roman, the role as a gold-ink label and the email as a real mailto
// link, because the commonest reason anyone opens a staff page is to write to
// one person.
//
// THE PAGE GRAMMAR (the same one the prose bands took in task 8): the heading
// sits in the narrow left column and STICKS while the portraits scroll past it
// on the right. A staff page is one long run of faces, and a heading that
// scrolls away leaves a tall empty column that reads as a mistake.
//
// THE BIO STAYS BEHIND A DISCLOSURE (fix round 1, 2026-09-21). Set inline it
// made /staff 13,101px of unbroken text, which is a wall rather than a list of
// people. It is a native <details> again, closed by default, opened by a
// "Read more" in the site's own link style. No JavaScript, and the keyboard
// works for free.
//
// Every person carries their slug as an id, so /staff#pastor-name lands on
// them, and an anchored person's bio opens with the jump (the script at the
// foot of this file). When the block is set to "Everyone" the three groups are drawn in
// STAFF_GROUPS order with a subhead each, and an empty group is skipped rather
// than left as a heading over nothing.
//
// A CONTENT block: the alternating surface arrives as a prop from SectionRenderer.
import SectionHeading from '@/components/SectionHeading.astro';
import SanityImage from '@/components/SanityImage.astro';
import PortableText from '@/components/PortableText';
import { surfaceClass } from '@/lib/surfaces';
import { groupStaff, STAFF_GROUPS, type StaffGroup } from '@/lib/church-derive';

interface StaffMember {
  _id?: string;
  name: string;
  slug?: string;
  role?: string;
  email?: string;
  phone?: string;
  group?: string | null;
  order?: number | null;
  bio?: any;
  photo?: any;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  group?: string;
  showBios?: boolean;
  members?: StaffMember[];
  surface?: 'background' | 'muted';
  headingId: string;
}

const {
  eyebrow,
  heading,
  group = 'all',
  showBios,
  members = [],
  surface = 'background',
  headingId,
} = Astro.props as Props;

const bg = surfaceClass(surface);

// The Studio's own words for each group, so the page and the editor agree.
const GROUP_LABELS: Record<StaffGroup, string> = {
  pastors: 'Pastors',
  coordination: 'Church Coordination Team',
  support: 'Support and volunteer roles',
};

const named = members.filter((m) => m?.name);
const grouped = groupStaff(named);

// "Everyone" draws all three groups with a subhead each; any other choice draws
// one unlabelled run of people, because the heading has already said who they
// are. A block that picked ONE group and typed no heading of its own borrows
// that group's name for the narrow column, which is the only thing that would
// have gone there anyway.
const showGroups = group === 'all';
const groupHeading = !showGroups ? GROUP_LABELS[group as StaffGroup] : undefined;
const bandHeading = heading || groupHeading;

const shown: { key: StaffGroup; label: string; people: StaffMember[] }[] = showGroups
  ? STAFF_GROUPS.map((g) => ({ key: g, label: GROUP_LABELS[g], people: grouped[g] })).filter(
      (g) => g.people.length > 0,
    )
  : [{ key: 'support' as StaffGroup, label: '', people: named }];

// Group subheads are h3, so a person's name under one is h4; with no subheads
// the name is the h3 directly beneath the section's h2. Heading order is never
// skipped.
const NameTag = showGroups ? 'h4' : 'h3';

// THE CROP. These portraits are shot against the glass and are portrait
// already, so the 4:5 frame is close to the picture's own shape and the only
// question left is where the head sits in it. An editor who MOVED the hotspot
// has answered that; everyone else gets `object-top`, which is right for a
// standing figure and wrong for nothing. The hotspot is not applied by the CDN
// here (SanityImage crops only when a caller passes an explicit height), so it
// is translated into an object-position instead.
function cropFor(photo: any): { style?: string; className: string } {
  const x = photo?.hotspot?.x;
  const y = photo?.hotspot?.y;
  if (typeof x === 'number' && typeof y === 'number') {
    return {
      style: `object-position: ${(x * 100).toFixed(2)}% ${(y * 100).toFixed(2)}%;`,
      className: 'h-full w-full object-cover',
    };
  }
  return { className: 'h-full w-full object-cover object-top' };
}
---

<section class={bg} aria-labelledby={bandHeading ? headingId : undefined}>
  <div class="mx-auto max-w-content px-gutter py-section-lg" data-reveal>
    <div class="grid grid-cols-12 gap-x-[clamp(16px,2.5vw,40px)]">
      <div
        class="col-span-12 self-start lg:sticky lg:top-[calc(var(--header-offset)+1rem)] lg:col-span-4"
      >
        <SectionHeading
          eyebrow={eyebrow}
          headline={bandHeading}
          headingId={headingId}
          level="h2"
          align="left"
          tone="church"
        />
      </div>

      <div class="col-span-12 mt-9 lg:col-span-8 lg:col-start-5 lg:mt-0">
        {
          shown.map((section, sectionIndex) => (
            <div class={sectionIndex === 0 ? '' : 'mt-section-md'}>
              {section.label && (
                <h3 class="mb-8 font-body text-h3 font-normal text-foreground">{section.label}</h3>
              )}

              <div class="grid grid-cols-2 gap-x-6 gap-y-12 md:grid-cols-3" data-stagger-grid>
                {section.people.map((person) => {
                  const crop = cropFor(person.photo);
                  return (
                    <article
                      id={person.slug || undefined}
                      class="scroll-mt-[var(--header-offset)] border-t border-hair pt-6"
                    >
                      {person.photo?.asset ? (
                        <div class="aspect-[4/5] w-full overflow-hidden">
                          <SanityImage
                            source={person.photo}
                            width={480}
                            sizes="(min-width: 1024px) 18vw, (min-width: 768px) 22vw, 45vw"
                            quality={78}
                            class={crop.className}
                            style={crop.style}
                          />
                        </div>
                      ) : (
                        <div class="aspect-[4/5] w-full bg-surface-soft" aria-hidden="true" />
                      )}

                      <NameTag class="mt-4 font-body text-2xl leading-snug font-normal text-foreground">
                        {person.name}
                      </NameTag>

                      {person.role && (
                        <p class="mt-1 font-ui text-ui text-gold-ink">{person.role}</p>
                      )}

                      {person.email && (
                        <a
                          href={`mailto:${person.email}`}
                          class="mt-2 inline-block font-body text-sm break-words text-foreground underline decoration-gold underline-offset-4"
                        >
                          {person.email}
                        </a>
                      )}

                      {person.phone && (
                        <p class="mt-2 font-body text-sm text-muted-foreground">{person.phone}</p>
                      )}

                      {showBios !== false && person.bio && (
                        <details class="group mt-3">
                          <summary class="inline-flex cursor-pointer list-none gap-2 border-b border-current pb-1 font-ui text-ui font-semibold text-link focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background focus-visible:outline-none [&::-webkit-details-marker]:hidden">
                            Read more
                            <span
                              aria-hidden="true"
                              class="transition-transform group-open:rotate-90"
                            >
                              →
                            </span>
                          </summary>
                          <PortableText
                            value={person.bio}
                            className="mt-3 font-body text-base break-words [&>p+p]:mt-4 [&>p]:my-0 [&_p]:text-muted-foreground"
                          />
                        </details>
                      )}
                    </article>
                  );
                })}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

{
  /* A link like /staff#kendall-ellis names one person, so that person's bio
    opens with the jump. Without this the anchor lands on a name and a closed
    "Read more", which is the one case where the disclosure hides exactly what
    the visitor asked for. Everything else stays closed. The script runs on
    load and again on hashchange, and it is inert on a page with no hash. */
}
<script>
  function openAnchoredBio() {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id) return;
    const article = document.getElementById(id);
    const details = article?.querySelector('details');
    if (details) details.open = true;
  }
  openAnchoredBio();
  window.addEventListener('hashchange', openAnchoredBio);
  // View Transitions swap the document, so the handler re-runs per page.
  document.addEventListener('astro:page-load', openAnchoredBio);
</script>
