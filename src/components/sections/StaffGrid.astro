---
// Safe to edit by hand
// scaffold-file: church
// Page-builder block: the staff, as a band of lancet portraits (2026-09-24,
// the Staff identity pass; rollout rule 3, "arches for people").
//
// THE GROUND IS DERIVED, NOT STORED (CLAUDE.md rule 9). src/lib/staff-band.ts
// reads it off the group the band shows: the pastors on the gold band, the
// Church Coordination Team on the brown, the support and volunteer roles on
// the taupe, and "Everyone" on the page's own paper. That is the Who We Are
// goals sequence (indigo, gold, brown, taupe), so /staff, which opens on the
// indigo window, reads the same way down the page. Every ink on each ground
// is a pair measured in both themes in theme-tokens.test.ts. The band is
// SELF_CONTAINED in sectionCadence.ts: it no longer takes the alternating
// surface, except that the paper variant is the page's own background.
//
// THE PEOPLE. Each person is a lancet (ArchFrame, the 2:3 arch the portraits
// were shot for), their name in Castoro, the role under it, and the email as
// a real mailto link, because the commonest reason anyone opens a staff page
// is to write to one person. Three people or fewer are drawn large in one row
// ("feature"); more are a list of smaller lancets, four to a row at desktop
// width. On a phone the feature row becomes a list: the lancet on the left,
// the words beside it.
//
// THE HEADING GRAMMAR (rule 17): the band h2 is H2_DISPLAY, the one grammar
// every church band uses, full width at the top of the band with the
// optional introduction beside it (the church's own paragraphs about the
// people below, a staffGridSection `intro` since 2026-09-24). A heading with
// an eleven-capital word ("COORDINATION") steps down a size so no word breaks
// at 320px (staff-band.ts headingIsLong). The eyebrow, when an editor types
// one, is a plain small line in sentence case, never tracked capitals.
//
// THE BIO STAYS BEHIND A DISCLOSURE, a native <details> closed by default
// with "Read more" / "Read less" as on the Watchword band. No JavaScript, and
// the keyboard works for free. Every person carries their slug as an id, so
// /staff#kendall-ellis lands on them, and an anchored person's bio opens with
// the jump (the script at the foot of this file). Five retired Wix URLs
// redirect to those ids (src/lib/fbcm-redirects.ts).
//
// When the block is set to "Everyone" the three groups are drawn in
// STAFF_GROUPS order with a subhead each, and an empty group is skipped.
import ArchFrame from '@/components/church/ArchFrame.astro';
import PortableText from '@/components/PortableText';
import { H2_DISPLAY } from '@/lib/heading-grammar';
import { surfaceClass } from '@/lib/surfaces';
import { groupStaff, STAFF_GROUPS, type StaffGroup } from '@/lib/church-derive';
import { headingIsLong, staffBandLook, staffSize } from '@/lib/staff-band';
import type { PortableTextBlock } from '@portabletext/types';

interface StaffMember {
  _id?: string;
  name: string;
  slug?: string;
  role?: string;
  email?: string;
  phone?: string;
  group?: string | null;
  order?: number | null;
  bio?: any;
  photo?: any;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  intro?: unknown;
  group?: string;
  showBios?: boolean;
  members?: StaffMember[];
  surface?: 'background' | 'muted';
  headingId: string;
}

const {
  eyebrow,
  heading,
  intro,
  group = 'all',
  showBios,
  members = [],
  surface = 'background',
  headingId,
} = Astro.props as Props;

// The Studio's own words for each group, so the page and the editor agree.
const GROUP_LABELS: Record<StaffGroup, string> = {
  pastors: 'Pastors',
  coordination: 'Church Coordination Team',
  support: 'Support and volunteer roles',
};

const named = members.filter((m) => m?.name);
const grouped = groupStaff(named);

// "Everyone" draws all three groups with a subhead each; any other choice draws
// one unlabelled run of people, because the heading has already said who they
// are. A block that picked ONE group and typed no heading of its own borrows
// that group's name, which is the only thing that would have gone there anyway.
const showGroups = group === 'all';
const groupHeading = !showGroups ? GROUP_LABELS[group as StaffGroup] : undefined;
const bandHeading = heading || groupHeading;

const shown: { key: StaffGroup; label: string; people: StaffMember[] }[] = showGroups
  ? STAFF_GROUPS.map((g) => ({ key: g, label: GROUP_LABELS[g], people: grouped[g] })).filter(
      (g) => g.people.length > 0,
    )
  : [{ key: 'support' as StaffGroup, label: '', people: named }];

// Group subheads are h3, so a person's name under one is h4; with no subheads
// the name is the h3 directly beneath the section's h2. Heading order is never
// skipped.
const NameTag = showGroups ? 'h4' : 'h3';

const look = staffBandLook(group);
const introBlocks = (Array.isArray(intro) ? intro : []) as PortableTextBlock[];

// The inks for each ground. Every pair is in theme-tokens.test.ts.
const INK = {
  gold: {
    band: 'bg-band-gold text-band-ink',
    heading: 'text-band-ink',
    role: 'text-band-ink',
    link: 'decoration-band-ink',
    more: 'text-band-ink',
  },
  brown: {
    band: 'bg-band-brown text-bg',
    heading: 'text-white-pure',
    role: 'text-gold',
    link: 'decoration-gold',
    more: 'text-gold',
  },
  taupe: {
    band: 'bg-band-taupe text-band-ink',
    heading: 'text-band-indigo',
    role: 'text-band-brown',
    link: 'decoration-band-brown',
    more: 'text-band-ink',
  },
  paper: {
    band: `${surfaceClass(surface)} text-foreground`,
    heading: 'text-indigo',
    role: 'text-gold-ink',
    link: 'decoration-gold',
    more: 'text-link',
  },
}[look.ground];
---

<section
  class:list={['sg', `sg-${look.ground}`, INK.band]}
  aria-labelledby={bandHeading ? headingId : undefined}
>
  <div class="sg-wrap mx-auto max-w-content px-gutter">
    {
      (bandHeading || introBlocks.length > 0) && (
        <div class="sg-top">
          <div>
            {eyebrow && <p class={`mb-3 font-ui text-base font-semibold ${INK.role}`}>{eyebrow}</p>}
            {bandHeading && (
              <h2
                id={headingId}
                class:list={[H2_DISPLAY, INK.heading, headingIsLong(bandHeading) && 'sg-long']}
              >
                {bandHeading}
              </h2>
            )}
          </div>
          {introBlocks.length > 0 && (
            <div class="sg-intro space-y-4">
              <PortableText value={introBlocks} variant="bare" />
            </div>
          )}
        </div>
      )
    }

    {
      shown.map((section) => {
        const size = staffSize(section.people.length);
        return (
          <div class="sg-group">
            {section.label && (
              <h3 class={`mb-8 font-body text-h3 font-normal ${INK.heading}`}>{section.label}</h3>
            )}
            <ul class:list={['sg-people', `sg-${size}`]} role="list">
              {section.people.map((person) => (
                <li>
                  <article id={person.slug || undefined} class="sg-person">
                    <ArchFrame
                      image={person.photo}
                      shape="lancet"
                      width={size === 'feature' ? 720 : 560}
                      sizes={
                        size === 'feature'
                          ? '(min-width: 1024px) 320px, (min-width: 640px) 30vw, 38vw'
                          : '(min-width: 1024px) 22vw, (min-width: 768px) 30vw, 45vw'
                      }
                      alt={person.photo?.alt ?? person.name}
                      grade="warm"
                      glyph="window"
                      class="sg-arch"
                    />
                    <div class="sg-words min-w-0">
                      <NameTag class="sg-name font-body font-normal">{person.name}</NameTag>

                      {person.role && (
                        <p class={`mt-1 font-ui text-base font-semibold ${INK.role}`}>
                          {person.role}
                        </p>
                      )}

                      {person.email && (
                        <a
                          href={`mailto:${person.email}`}
                          class={`sg-mail mt-2 inline-block max-w-full font-body text-base break-words underline underline-offset-4 ${INK.link}`}
                        >
                          {/* A break is offered after the @ only, so a narrow
                              column wraps "name@" / "fbcmuncie.org" rather
                              than mid-word (the mailto keeps the whole address). */}
                          {person.email.includes('@') ? (
                            <>
                              {person.email.slice(0, person.email.indexOf('@') + 1)}
                              <wbr />
                              {person.email.slice(person.email.indexOf('@') + 1)}
                            </>
                          ) : (
                            person.email
                          )}
                        </a>
                      )}

                      {person.phone && <p class="mt-2 font-body text-base">{person.phone}</p>}

                      {showBios !== false && person.bio && (
                        <details class="sg-more">
                          <summary class={`font-ui font-bold ${INK.more}`}>
                            <span class="sg-rm">Read more</span>
                            <span class="sg-rl">Read less</span>
                          </summary>
                          <div class="mt-3 space-y-4 font-body text-base break-words">
                            <PortableText value={person.bio} variant="bare" />
                          </div>
                        </details>
                      )}
                    </div>
                  </article>
                </li>
              ))}
            </ul>
          </div>
        );
      })
    }
  </div>
</section>

{
  /* A link like /staff#kendall-ellis names one person, so that person's bio
    opens with the jump. Without this the anchor lands on a name and a closed
    "Read more", which is the one case where the disclosure hides exactly what
    the visitor asked for. Everything else stays closed. The script runs on
    load and again on hashchange, and it is inert on a page with no hash. */
}
<script>
  function openAnchoredBio() {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id) return;
    const article = document.getElementById(id);
    const details = article?.querySelector('details');
    if (details) details.open = true;
  }
  openAnchoredBio();
  // THE LISTENERS BIND ONCE PER DOCUMENT, not once per navigation. `window`
  // and `document` both survive a View Transitions swap, so without this flag
  // every visit to a page carrying this band added another pair of listeners
  // and the handler ran N times on the Nth hashchange. The flag is the same
  // idempotence guard the hero pause control and the other inline scripts use.
  // Cast rather than a `declare global`: this is a bundled module script, so
  // an ambient Window augmentation here would widen the type for the whole
  // project just to hold one boolean flag.
  const w = window as unknown as { __staffBioBound?: boolean };
  if (!w.__staffBioBound) {
    w.__staffBioBound = true;
    window.addEventListener('hashchange', openAnchoredBio);
    // View Transitions swap the document, so the handler re-runs per page.
    document.addEventListener('astro:page-load', openAnchoredBio);
  }
</script>
