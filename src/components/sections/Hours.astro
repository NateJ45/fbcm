---
// Safe to edit by hand
// scaffold-file: church
// Page-builder block: the hours band, drawn as THE OFFICE DOOR (2026-09-24,
// the utility identity pass; rollout plan "Give, Contact: short utility pages;
// CtaBand, Hours").
//
// THE BLOCK STORES NO HOURS, AND THAT IS THE POINT (CLAUDE.md rule 15). The
// office hours and the pastors' hours are each typed once, on siteSettings,
// where the footer already reads them. A field on this block would be a second
// copy, and the second copy is the one that goes stale the week the office
// changes its Friday closing time. The editor gets the eyebrow and the heading,
// which are about THIS page; the hours stay where every surface reads them.
//
// THE LOOK. A full-width brand TAUPE band (the church's "Work" ground), fixed
// in both themes like the gold give band and the brown hymn board, so it takes
// no cadence surface and carries no colour field (rule 9). The Tudor door
// glyph stands at the left above the heading, the one building glyph on the
// band: this is the notice on the office door. The heading is the one church
// band h2 (H2_DISPLAY, rule 17) in brand indigo, fitted so no word breaks
// mid-word (headingFit). On the right, each group of
// hours is a short ruled list: the days in indigo Castoro, the times beside
// them larger and in old-style figures, because the time is what a visitor
// came for. The day/time split is DERIVED from the line the office typed
// (src/lib/office-hours.ts, unit-tested, stega-safe); a line with no
// "days: times" shape ("Hours may change on holidays.") prints whole, in
// italic, under its group.
//
// THE ADDRESS IS NO LONGER A ROW HERE. It used to be the third row, which put
// the street on the Contact page three times over (the hero's facts, this
// band and the Sunday band) and a fourth in the footer. This band is hours.
//
// Every ink on the band is a pair gated in theme-tokens.test.ts: band-indigo
// and band-ink on band-taupe (the Church Blog pairs). Hairlines are band-ink
// at 30%. The CSS lives in this file's <style> block, not globals.css, so it
// ships only on the pages that draw the band (CLAUDE.md rule 20).
import PortableTextStatic from '@/components/PortableTextStatic.astro';
import BuildingGlyph from '@/components/church/BuildingGlyph.astro';
import { H2_DISPLAY, headingFit } from '@/lib/heading-grammar';
import { getSiteSettings } from '@/lib/queries';
import { hoursLines, type HoursBlock } from '@/lib/office-hours';
import type { SectionSiteSettings } from '@/lib/pageBuilder.types';

interface Props {
  eyebrow?: string;
  heading?: string;
  /** Accepted and ignored: the band is taupe on every page. */
  surface?: 'background' | 'muted';
  headingId: string;
  /**
   * Handed down by SectionRenderer from the route that already fetched them.
   * In /preview/** that is the DRAFT client, so an editor changing the Friday
   * hours sees it immediately. The fetch below is only the fallback for callers
   * that pass nothing (the styleguide, the code-defined default sections).
   */
  settings?: SectionSiteSettings | null;
}

const { eyebrow, heading, headingId, settings: settingsProp } = Astro.props;

const settings: SectionSiteSettings | null =
  settingsProp !== undefined ? settingsProp : await getSiteSettings();

// PortableTextStatic's own block shape, which the notes are handed back to.
interface PtBlock extends HoursBlock {
  _type: 'block';
  _key: string;
  listItem?: 'bullet' | 'number';
  children?: { _type: 'span'; _key: string; text?: string; marks?: string[] }[];
  markDefs?: { _key: string; _type: string; href?: string; openInNewTab?: boolean }[];
}

// SectionSiteSettings types both hours fields as `unknown` on purpose: the
// block shape belongs to PortableTextStatic. This is where it narrows.
const groups = [
  {
    label: 'Church office',
    lines: hoursLines((settings?.officeHours ?? null) as PtBlock[] | null),
  },
  {
    label: 'Pastors, by appointment',
    lines: hoursLines((settings?.pastoralHours ?? null) as PtBlock[] | null),
  },
].filter((g) => g.lines.length > 0);
---

<section class="hours-door" aria-labelledby={heading ? headingId : undefined}>
  <div class="hd-grid mx-auto max-w-content px-gutter">
    <div class="hd-head">
      <BuildingGlyph name="door" class="hd-glyph" />
      {eyebrow && <p class="hd-eyebrow font-ui text-ui">{eyebrow}</p>}
      {
        heading && (
          <h2 id={headingId} class:list={[H2_DISPLAY, 'hd-h2 h-fit']} style={headingFit(heading)}>
            <span class="h-fit-in">{heading}</span>
          </h2>
        )
      }
    </div>

    {
      groups.length > 0 && (
        <div class="hd-board">
          {groups.map((group) => (
            <div class="hd-group">
              <h3 class="hd-label font-ui">{group.label}</h3>
              {group.lines.some((l) => l.kind === 'row') && (
                <dl class="hd-rows">
                  {group.lines.map((l) =>
                    l.kind === 'row' ? (
                      <div class="hd-row">
                        <dt class="hd-days font-body">{l.days}</dt>
                        <dd class="hd-times font-body oldstyle">{l.times}</dd>
                      </div>
                    ) : null,
                  )}
                </dl>
              )}
              {group.lines.map((l) =>
                l.kind === 'note' ? (
                  <PortableTextStatic value={[l.block as PtBlock]} className="hd-note" />
                ) : null,
              )}
            </div>
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  .hours-door {
    background: var(--color-band-taupe);
    color: var(--color-band-ink);
    padding-block: clamp(64px, 7vw, 110px);
  }
  .hd-grid {
    display: grid;
    gap: clamp(32px, 4vw, 56px) clamp(24px, 4vw, 64px);
  }
  @media (min-width: 1024px) {
    .hd-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
    }
  }
  .hd-head :global(.hd-glyph) {
    display: block;
    width: clamp(56px, 6vw, 88px);
    color: var(--color-band-indigo);
    margin-bottom: clamp(18px, 2.4vw, 32px);
  }
  .hd-eyebrow {
    margin: 0 0 12px;
    font-weight: 600;
    color: var(--color-band-ink);
  }
  .hd-h2 {
    color: var(--color-band-indigo);
    margin: 0;
  }
  .hd-board {
    display: grid;
    gap: clamp(28px, 3.5vw, 44px);
  }
  .hd-label {
    margin: 0 0 10px;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-band-ink);
  }
  .hd-rows {
    margin: 0;
    border-top: 1px solid color-mix(in srgb, var(--color-band-ink) 30%, transparent);
  }
  .hd-row {
    display: grid;
    gap: 4px 24px;
    padding-block: clamp(12px, 1.4vw, 16px);
    border-bottom: 1px solid color-mix(in srgb, var(--color-band-ink) 30%, transparent);
  }
  @media (min-width: 640px) {
    .hd-row {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      align-items: baseline;
    }
  }
  .hd-days {
    font-size: clamp(1.125rem, 1.05rem + 0.3vw, 1.3rem);
    line-height: 1.25;
    color: var(--color-band-indigo);
  }
  .hd-times {
    margin: 0;
    font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem);
    line-height: 1.3;
    color: var(--color-band-ink);
  }
  .hours-door :global(.hd-note) {
    margin-top: 12px;
    font-family: var(--font-body);
    font-style: italic;
    font-size: 1.0625rem;
    color: var(--color-band-ink);
  }
  .hours-door :global(.hd-note p) {
    margin: 0;
    color: inherit;
  }
</style>
