---
// Safe to edit by hand
// scaffold-file: church
// Page-builder block: a timeline. One marker column (a time like "9:30" or a year
// like "1859") beside a bordered body column, which is the same shape whether the
// page is running a Sunday morning or a hundred and sixty years of history.
//
// Each row carries the id its `anchor` slug generated, so a link like
// /visit#accessibility lands on the row rather than the top of the band. `scroll-mt`
// keeps the sticky header from covering the row it just jumped to.
//
// A CONTENT block: the alternating surface arrives as a prop from SectionRenderer.
import SectionHeading from '@/components/SectionHeading.astro';
import PortableText from '@/components/PortableText';
import { surfaceClass } from '@/lib/surfaces';

interface TimelineRow {
  _key?: string;
  marker?: string;
  title?: string;
  body?: any;
  note?: string;
  anchor?: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  rows?: TimelineRow[];
  surface?: 'background' | 'muted';
  headingId: string;
}

const { eyebrow, heading, rows = [], surface = 'background', headingId } = Astro.props as Props;
const bg = surfaceClass(surface);
const validRows = rows.filter((r) => r?.marker || r?.title);
---

<section class={bg} aria-labelledby={heading ? headingId : undefined}>
  <div class="mx-auto max-w-content px-m py-section-lg" data-reveal>
    <SectionHeading
      eyebrow={eyebrow}
      headline={heading}
      headingId={headingId}
      level="h2"
      align="left"
      tone="church"
      rule
    />

    {
      validRows.length > 0 && (
        <div class="mt-section-md">
          {validRows.map((row) => (
            <div
              id={row.anchor || undefined}
              class="grid scroll-mt-28 grid-cols-[96px_1fr] md:grid-cols-[120px_1fr]"
            >
              <p class="font-display text-[1.625rem] leading-tight text-foreground">{row.marker}</p>

              <div class="border-l-2 border-gold pb-l pl-m">
                {row.title && (
                  <h3 class="font-display text-[1.125rem] leading-snug text-foreground">
                    {row.title}
                  </h3>
                )}
                {row.body && (
                  <PortableText
                    value={row.body}
                    className="mt-s text-base leading-relaxed text-foreground/85"
                  />
                )}
                {row.note && (
                  <p class="mt-s text-xs font-semibold tracking-eyebrow text-brown-mid uppercase dark:text-gold">
                    {row.note}
                  </p>
                )}
              </div>
            </div>
          ))}
        </div>
      )
    }
  </div>
</section>
