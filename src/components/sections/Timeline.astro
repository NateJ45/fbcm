---
// Safe to edit by hand
// scaffold-file: church
// Page-builder block: a timeline, drawn as THE DOOR-STEP PATH (2026-09-24,
// the Visit identity pass; the prototype's `.morning`,
// docs/superpowers/prototypes/2026-09-23-visit/visit.html, after The Way on
// Who We Are).
//
// Each row is a numbered step: a doorway (the row's own photo in a door arch,
// or a rectangle when the photo is of the building, photo-subject.ts), the
// number on the doorstep, and beside it the marker, the title, the note and
// the text. A dotted trail runs from under each door to the next. A short
// path with pictures climbs as a staircase; a long one (History's seven
// eras) or one without pictures (Ministries) walks straight down, with the
// numbers as its doors, so it never runs off the page.
//
// Everything that changes the drawing is DERIVED (src/lib/morning-path.ts,
// unit-tested; CLAUDE.md rule 15):
//   - a marker that is a clock time is a titling numeral with its am/pm small
//     and lower case; the step at Site settings' service time is the main
//     step, drawn largest; a marker in words (a year) is set smaller; an
//     empty marker (a welcome) draws no numeral;
//   - on a timeline that tells the time, a row after the last time whose
//     marker is words ("First Sundays") is a change to the morning rather
//     than a step in it, so it lands after the path as a closing note, with
//     the basin glyph (the prototype's Communion);
//   - a note "Place (Room)" is split into the place and a gold-ruled room
//     tag; a run of bullet lines "Class (Room): description" becomes a ruled
//     class list with room tags.
// Numbering stays because it is a real sequence (rule 11).
//
// The rows' anchors still land on the row (scroll-mt clears the header). When
// the window hero above drops its lancets into this band (SectionRenderer's
// dropInto), --after-window pads the top to clear them.
//
// A CONTENT block: the surface arrives as a prop from SectionRenderer.
import SectionHeading from '@/components/SectionHeading.astro';
import PortableText from '@/components/PortableText';
import SanityImage from '@/components/SanityImage.astro';
import ArchFrame from '@/components/church/ArchFrame.astro';
import BuildingGlyph from '@/components/church/BuildingGlyph.astro';
import { surfaceClass } from '@/lib/surfaces';
import { splitStega } from '@/lib/preview-stega';
import { photoSubject } from '@/lib/photo-subject';
import { bodySegments, noteParts, pathPlan, pathStairs } from '@/lib/morning-path';
import { textParagraphs } from '@/lib/hymn-board';
import type { SanityImageObject } from '@/lib/pageBuilder.types';

interface TimelineRow {
  _key?: string;
  marker?: string | null;
  title?: string | null;
  body?: any;
  note?: string | null;
  anchor?: string;
  image?: SanityImageObject | null;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  rows?: TimelineRow[];
  surface?: 'background' | 'muted';
  /** Site settings' service time: the main step is the one at this time. */
  serviceTime?: string | null;
  headingId: string;
}

const {
  eyebrow,
  heading,
  rows = [],
  surface = 'background',
  serviceTime,
  headingId,
} = Astro.props as Props;
const bg = surfaceClass(surface);
const plan = pathPlan(rows, serviceTime);
const withPictures = plan.steps.some((s) => !!s.row.image?.asset);
const stairs = pathStairs(plan.steps.length, withPictures);
const altOf = (img: SanityImageObject | null | undefined) =>
  splitStega(((img as { alt?: string } | null)?.alt ?? '') as string).cleaned;
const blocksOf = (body: unknown) => (Array.isArray(body) ? body : []);
---

<section
  class:list={[bg, 'tp-band']}
  style={`--tp-ground: var(--color-${surface === 'muted' ? 'muted' : 'background'});`}
  aria-labelledby={heading ? headingId : undefined}
>
  <div class="tp-wrap mx-auto max-w-content px-gutter">
    <SectionHeading
      eyebrow={eyebrow}
      headline={heading}
      headingId={headingId}
      level="h2"
      align="left"
      tone="church"
      face="display"
    />

    {
      plan.steps.length > 0 && (
        <ol
          class="tp-path"
          data-stairs={stairs ? '' : undefined}
          data-pictures={withPictures ? '' : undefined}
        >
          {plan.steps.map((step, i) => {
            const row = step.row;
            const img = row.image?.asset ? row.image : null;
            const note = noteParts(row.note);
            return (
              <li
                id={row.anchor || undefined}
                class:list={['tp-step scroll-mt-[var(--header-offset)]', step.main && 'is-main']}
                style={stairs ? `--n:${i}` : undefined}
              >
                <div class="tp-door">
                  {withPictures &&
                    (img && photoSubject(altOf(img)) === 'place' ? (
                      <figure class="tp-rect m-0" data-reveal>
                        <SanityImage
                          source={img}
                          width={440}
                          sizes="(min-width: 721px) 220px, 96px"
                          alt={altOf(img)}
                          class="graded h-full w-full object-cover"
                        />
                      </figure>
                    ) : img ? (
                      <ArchFrame
                        image={img}
                        shape="door"
                        width={440}
                        sizes="(min-width: 721px) 220px, 96px"
                        alt={altOf(img)}
                        grade="warm"
                        style="--arch-ratio: 100 / 124; --arch-mould: var(--color-brown-ink);"
                      />
                    ) : (
                      <ArchFrame
                        image={null}
                        glyph="door"
                        shape="door"
                        width={440}
                        sizes="220px"
                        alt=""
                        style="--arch-ratio: 100 / 124; --arch-mould: var(--color-brown-ink);"
                      />
                    ))}
                  <span class="tp-no" aria-hidden="true">
                    {step.n}
                  </span>
                </div>
                <div class="tp-text" data-reveal>
                  {step.kind === 'time' ? (
                    <p class="tp-when">
                      <span>{step.big}</span>
                      {step.meridiem && <small>{step.meridiem}</small>}
                    </p>
                  ) : step.kind === 'word' ? (
                    <p class="tp-when is-word">{step.big}</p>
                  ) : null}
                  {row.title && <h3 class="tp-title">{row.title}</h3>}
                  {(note.place || note.room) && (
                    <p class="tp-place">
                      {note.place && <span>{note.place}</span>}
                      {note.room && <span class="tp-room">{note.room}</span>}
                    </p>
                  )}
                  {bodySegments(blocksOf(row.body)).map((seg) =>
                    seg.kind === 'classes' ? (
                      <ul class="tp-classes">
                        {seg.items.map((c) => (
                          <li>
                            <b>{c.name}</b>
                            <span class="tp-room">{c.room}</span>
                            <p>{c.desc}</p>
                            {c.extra.map((x) => (
                              <p>{x}</p>
                            ))}
                          </li>
                        ))}
                      </ul>
                    ) : (
                      <PortableText
                        value={seg.blocks}
                        className="tp-body font-body text-body [&>p+p]:mt-4 [&>p]:my-0 [&_a]:decoration-gold [&_p]:text-foreground"
                      />
                    ),
                  )}
                </div>
              </li>
            );
          })}
        </ol>
      )
    }

    {
      plan.landings.map((row) => {
        const paras = blocksOf(row.body);
        const [first, ...rest] = paras;
        return (
          <div
            id={row.anchor || undefined}
            class="tp-landing scroll-mt-[var(--header-offset)]"
            data-reveal
          >
            <div class="tp-lh">
              <BuildingGlyph name="basin" class="w-12 shrink-0 text-indigo" />
              <div>
                {row.marker && <p class="tp-kick">{row.marker}</p>}
                {row.title && <h3 class="tp-land-title">{row.title}</h3>}
              </div>
            </div>
            <div>
              {first && (
                <PortableText
                  value={[first]}
                  className="tp-say font-body [&>p]:my-0 [&_p]:text-indigo"
                />
              )}
              {rest.length > 0 && (
                <PortableText
                  value={rest}
                  className="tp-body mt-4 font-body text-body [&>p+p]:mt-4 [&>p]:my-0 [&_p]:text-foreground"
                />
              )}
              {row.note && textParagraphs(row.note).map((n) => <p class="tp-place mt-4">{n}</p>)}
            </div>
          </div>
        );
      })
    }
  </div>
</section>
