---
// Page-builder block: a pull quote. Surface comes from SectionRenderer.
// Safe to edit by hand.
//
// NO QUOTATION MARKS AND NO RULE (art-direction pass, 2026-09-21, task 10).
// The block used to open with a decorative asterism and close with a centred,
// tracked, uppercase attribution, which is three devices telling a reader the
// same thing the italic already tells them. What is left is the sentence, set
// large in Castoro italic on a short measure, and the name under it as a
// gold-ink label. A quote that needs a glyph to read as a quote is not set
// large enough.
import { surfaceClass } from '@/lib/surfaces';
import { splitStega } from '@/lib/preview-stega';

interface Props {
  quote?: string;
  attribution?: string;
  detail?: string;
  surface?: 'background' | 'muted';
}

const { quote, attribution, detail, surface = 'background' } = Astro.props as Props;
const bg = surfaceClass(surface);

// LONG QUOTES STEP DOWN ONE SIZE.
//
// The block was drawn for a pull quote of a dozen words. The wedding page's
// testimonial is 90, and at the display size that is thirteen lines of italic
// type, which stops reading as an emphasis and starts reading as a page of
// body copy that has lost its measure. Over roughly forty words the type drops
// one step and the line height opens up, which is enough to bring that quote
// back to eight lines without touching the short ones. The measure opens with
// it: 24ch is right for a sentence and far too narrow for a paragraph.
//
// MEASURE THE CLEANED STRING, NEVER THE STEGA-ENCODED ONE (CLAUDE.md, the
// preview section). Stega writes its payload in U+200B/C/D and U+FEFF, and
// U+FEFF matches \s in a JavaScript regex, so splitting an encoded headline on
// whitespace shatters it into dozens of fake words. splitStega() returns the
// text with the payload removed, which is the only thing safe to count. The
// visible string is untouched: only the CLASS depends on this.
const LONG_QUOTE_WORDS = 40;
const quoteWordCount = splitStega(quote ?? '')
  .cleaned.trim()
  .split(/\s+/)
  .filter(Boolean).length;
const isLongQuote = quoteWordCount > LONG_QUOTE_WORDS;
const quoteTypeClass = isLongQuote
  ? 'text-h3 leading-relaxed max-w-[44ch]'
  : 'text-h2 leading-[1.15] max-w-[24ch]';
---

{
  quote && (
    <section class={bg}>
      <div class="mx-auto max-w-content px-gutter py-section-lg">
        <blockquote class:list={['font-body font-normal text-foreground italic', quoteTypeClass]}>
          {quote}
        </blockquote>
        {(attribution || detail) && (
          <p class="mt-6 font-ui text-ui text-gold-ink">
            {attribution}
            {attribution && detail ? ' · ' : ''}
            {detail}
          </p>
        )}
      </div>
    </section>
  )
}
