---
// Page-builder block: a pull quote. Safe to edit by hand.
//
// ON THE GOLD BAND (2026-09-24, the Wedding identity pass). The quote is a
// full-width brand band (rule 2), the church's gold, with the words in
// Castoro italic and the name under them in the UI face, both in band-ink
// (band-ink on band-gold is gated in theme-tokens.test.ts, and the band keeps
// its gold in dark mode, like The Way and Give). It paints its own ground, so
// the cadence surface SectionRenderer hands it is accepted and not used. A
// light band, so it sits well between two dark ones (on the wedding page,
// after the rooms' indigo-dark band).
//
// NO QUOTATION MARKS AND NO RULE (art-direction pass, 2026-09-21, task 10).
// What is left is the sentence, set large, and the name under it. A quote
// that needs a glyph to read as a quote is not set large enough. The words and
// the name are a <figure> and its <figcaption>, which is what ties the name to
// the words for a screen reader.
import { LONG_QUOTE_WORDS, parseQuote } from '@/lib/quote-text';

interface Props {
  quote?: string;
  attribution?: string;
  detail?: string;
  surface?: 'background' | 'muted';
}

const { quote, attribution, detail } = Astro.props as Props;

// LONG QUOTES STEP DOWN ONE SIZE.
//
// The block was drawn for a pull quote of a dozen words. The wedding page's
// testimonial is 90, and at the display size that is thirteen lines of italic
// type, which stops reading as an emphasis and starts reading as a page of
// body copy that has lost its measure. Over roughly forty words the type drops
// one step and the line height opens up. The measure opens with it: 24ch is
// right for a sentence and far too narrow for a paragraph.
//
// A STATEMENT STEPS DOWN TWICE (2026-10-05, fix/long-quote-section). The
// Beliefs page holds the 2005 ABCUSA identity statement in one quote: several
// paragraphs and a bulleted list in a single plain string. src/lib/quote-text.ts
// splits it on blank lines and bullet glyphs, and a quote that comes out as
// more than one block (or as a list) is set at READING size: Castoro italic at
// the Ledger's item size, a 1.6 line height and a 62ch measure, paragraphs and
// a real <ul> with a band-ink dot, instead of a wall of display type. A quote
// that parses to ONE paragraph, short or long, renders byte-for-byte as before.
//
// MEASURE THE CLEANED STRING, NEVER THE STEGA-ENCODED ONE (CLAUDE.md, the
// preview section). parseQuote() splits and counts the cleaned text and puts
// the stega run back on the last text, so the visible string is untouched.
const { blocks, structured, wordCount } = parseQuote(quote);
const isLongQuote = wordCount > LONG_QUOTE_WORDS;
const quoteTypeClass = structured
  ? 'text-item leading-[1.6] max-w-[62ch]'
  : isLongQuote
    ? 'text-h3 leading-[1.5] max-w-[46ch]'
    : 'text-h2 leading-[1.15] max-w-[24ch]';
---

{
  quote && (
    <section class="bg-band-gold text-band-ink">
      <figure class="mx-auto my-0 max-w-content px-gutter py-[clamp(72px,8vw,128px)]">
        <blockquote class:list={['font-body font-normal italic', quoteTypeClass]}>
          {structured
            ? blocks.map((b, i) =>
                b.kind === 'paragraph' ? (
                  <p class={i > 0 ? 'mt-[0.9em]' : undefined}>{b.text}</p>
                ) : (
                  <ul class:list={['space-y-[0.5em]', i > 0 && 'mt-[0.9em]']}>
                    {b.items.map((item) => (
                      <li class="relative pl-[1.4em] before:absolute before:top-[0.62em] before:left-[0.3em] before:size-[0.38em] before:rounded-full before:bg-band-ink before:content-['']">
                        {item}
                      </li>
                    ))}
                  </ul>
                ),
              )
            : quote}
        </blockquote>
        {(attribution || detail) && (
          <figcaption class="mt-8 font-ui text-ui font-semibold">
            {attribution}
            {attribution && detail ? ' · ' : ''}
            {detail}
          </figcaption>
        )}
      </figure>
    </section>
  )
}
