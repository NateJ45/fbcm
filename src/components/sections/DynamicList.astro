---
// Safe to edit by hand
// Dynamic list section: auto-pulls the latest items from a core collection and
// renders them as a card grid. No manual curation required -- the editor picks
// the source and a limit. Each source belongs to a scaffold capability; this
// fork keeps only journal (see the "source" prop doc below).
//
// Sources and their shape:
//   journal      - an editorial LIST (art-direction pass, 2026-09-20): a ruled
//                  row per post, the date in the first column, the title and
//                  excerpt in the middle, the category on the right. It was a
//                  grid of cover-image cards; three photographs stacked beside
//                  each other said less about the posts than their titles do,
//                  and the band now reads as a contents page. Links to the
//                  journal entry at /post/<slug>.
//   anything else - the generic card grid at the foot of this file.
//
// SELF_CONTAINED: manages its own surface. Never receives a surface prop.
// Empty state: renders nothing when items is empty or absent (graceful absence).
import SectionHeading from '@/components/SectionHeading.astro';
import CtaLink from '@/components/CtaLink.astro';
import type { ProjectedDynamicListSection } from '@/lib/pageBuilder.types';
import { columnsClass } from '@/lib/layout-variants';
import { splitDurable, entryIsSermonPreview, weekOfEyebrow } from '@/lib/blog-derive'; // scaffold: journal

type Props = {
  eyebrow?: string;
  headline?: string;
  subhead?: string;
  /** Optional rich twin of `subhead` (bold / italic). See src/lib/inline-rich.ts. */
  subheadRich?: unknown;
  /**
   * Which collection to pull from. Every value this can take belongs to a
   * scaffold capability, so this is a plain string rather than a union: a fork
   * that removes the last one would otherwise be left with an empty union,
   * which does not parse. The dropdown in `richSections.ts` (dynamicListSection)
   * is what actually limits an editor's choice, and each of its options
   * carries its own scaffold marker.
   */
  source?: string;
  items?: ProjectedDynamicListSection['items'];
  /**
   * The editor's actual "how many to show" value (3-12, richSections.ts). The
   * GROQ query always fetches a fixed batch of DYNAMIC_LIST_MAX candidates
   * (see dynamicListLimits.ts and queries.ts -- a slice bound can't be a field
   * reference), so this component is what honours the editor's smaller number
   * by trimming the batch down before rendering.
   */
  limit?: number;
  cta?: ProjectedDynamicListSection['cta'];
  /** How many cards across on a desktop. Three is what this grid always was. */
  columns?: number;
  headingId?: string;
};

const {
  eyebrow,
  headline = 'Latest updates',
  subhead,
  subheadRich,
  source = 'journal',
  items = [],
  limit,
  cta,
  columns,
  headingId = 'dynamic-list-heading',
} = Astro.props as Props;

// scaffold: journal
// DURABLE FIRST. The journal source hands back the newest DYNAMIC_LIST_MAX
// posts, and on this site 106 of the 142 are weekly sermon previews, so the
// newest three are almost always three previews that went stale on Monday.
// Home's "From the blog" wants the posts worth arriving at. The split is
// DERIVED from each post's category and the two piles are concatenated, so the
// previews are still there, just behind the durable ones, and nothing about
// this reads journalEntry.featured (CLAUDE.md rule 15).
const durableFirst = (() => {
  if (source !== 'journal') return items;
  const { durable, previews } = splitDurable(items as any[]);
  return [...durable, ...previews] as typeof items;
})();
// scaffold:end

// The query fetches up to DYNAMIC_LIST_MAX items regardless of what the editor
// asked for (GROQ can't slice by a field reference), so this is the one place
// that trims the batch down to the editor's real `limit`. Without this, every
// dynamicListSection would show up to DYNAMIC_LIST_MAX items no matter what an
// editor typed into "How many to show".
const visibleItems =
  typeof limit === 'number' && Number.isFinite(limit) ? durableFirst.slice(0, limit) : durableFirst;

const hasItems = Array.isArray(visibleItems) && visibleItems.length > 0;

// Unset, this emits `sm:grid-cols-2 lg:grid-cols-3`, which is the string that
// was inline on all three card grids below before src/lib/layout-variants.ts
// existed (2026-08-28). One value drives all three, because they are three
// renderings of one grid, not three grids.
const colClass = columnsClass('dynamicListSection', columns);

// The sources that have a card layout of their own below. Anything else falls
// through to the generic grid at the end, which is also what happens once a
// fork has scaffold-removed the capabilities these belong to. Each entry is
// marked, so this list shrinks with them.
const KNOWN_SOURCES: string[] = [
  'journal', // scaffold: journal
];

// Format a datetime string to a short readable date.
function formatDate(d?: string | null): string {
  if (!d) return '';
  const date = new Date(d);
  if (Number.isNaN(date.getTime())) return '';
  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

// Source-specific fallback CTA link if no cta prop provided.
const fallbackHref: Record<string, string> = {
  journal: '/blog', // scaffold: journal
};
const fallbackLabel: Record<string, string> = {
  journal: 'Read all posts', // scaffold: journal
};
---

{
  hasItems && (
    <section class="bg-background" aria-labelledby={headingId}>
      <div class="mx-auto max-w-content px-gutter py-section-lg">
        {/* scaffold: journal */}
        {/* ── The journal, as an editorial list ─────────────────────────── */}
        {source === 'journal' && (
          <Fragment>
            {/* The band's name and its way out, on one ruled line. The <h2> is
                set in the UI face at label size on purpose: it is a rubric over
                a list, not a headline, and the posts' own titles are the type
                on this band. It stays a real heading so the section's
                aria-labelledby points at something. */}
            <div class="flex items-baseline justify-between gap-6 border-b border-hair-strong pb-4">
              <h2 id={headingId} class="font-ui text-ui text-gold-ink">
                {eyebrow || headline}
              </h2>
              <CtaLink
                cta={cta}
                variant="link"
                fallbackHref={fallbackHref[source]}
                fallbackLabel={fallbackLabel[source]}
              />
            </div>

            {subhead && (
              <p class="mt-6 max-w-[46ch] text-lede font-normal text-muted-foreground">{subhead}</p>
            )}

            {visibleItems.map((item) => (
              <a
                href={item.href ?? '/blog'}
                class="group grid grid-cols-12 items-baseline gap-x-[clamp(16px,2.5vw,40px)] border-b border-hair py-8"
              >
                {/* A sermon preview says which week it is for; everything else
                    says its date. Same line, same size, one of two sentences,
                    derived from the category (CLAUDE.md rule 15). */}
                <span class="col-span-12 font-ui text-[0.8125rem] tracking-[.06em] text-muted-foreground md:col-span-2">
                  {item.meta
                    ? entryIsSermonPreview(item as any)
                      ? weekOfEyebrow(item.meta)
                      : formatDate(item.meta)
                    : ''}
                </span>

                <span class="col-span-12 md:col-span-6 md:col-start-3">
                  <span class="block font-body text-[clamp(1.5rem,1.1rem+1.4vw,2.25rem)] leading-[1.15] font-normal text-foreground transition-colors group-hover:text-gold-ink">
                    {item.title}
                  </span>
                  {item.summary && (
                    <span class="mt-2.5 block max-w-[56ch] text-muted-foreground">
                      {item.summary}
                    </span>
                  )}
                </span>

                {/* The category travelled with the item for the ordering and
                    the eyebrow above; on this list it also EARNS its place as
                    the right-hand rubric, which is what the prototype's `.tag`
                    column is. */}
                <span class="col-span-12 mt-2.5 font-ui text-ui text-muted-foreground md:col-span-3 md:col-start-10 md:mt-0 md:justify-self-end">
                  {item.categories?.[0]?.title}
                </span>
              </a>
            ))}
          </Fragment>
        )}
        {/* scaffold:end */}

        {/* ── Any other source ────────────────────────────────────────────
              Every branch above belongs to a scaffold capability and can be
              removed; this one belongs to none and is what is left when they
              have been. It renders the flat shape the GROQ projection
              normalises every source into (title, meta, summary, optional
              href), so a new source works the day it is added and before
              anyone writes cards for it, and the block keeps a real grid to
              lay out however many of its sources a fork has kept.

              It is also what keeps `colClass` interpolated somewhere in this
              file, which layout-variants.test.ts reads off disk to confirm the
              registry's `baseColumns` has not gone stale. */}
        {!KNOWN_SOURCES.includes(source) && (
          <Fragment>
            <SectionHeading
              eyebrow={eyebrow}
              headline={headline}
              subhead={subhead}
              subheadRich={subheadRich}
              headingId={headingId}
            />

            <ul class={`mt-section-lg grid grid-cols-1 ${colClass} list-none gap-m p-0`}>
              {visibleItems.map((item) => (
                <li>
                  <div class="h-full rounded-md border border-border-soft bg-card p-m">
                    <h3 class="font-display text-h4 text-foreground">{item.title}</h3>
                    {item.meta && (
                      <p class="mt-xs text-xs font-semibold tracking-eyebrow text-link uppercase">
                        {item.meta}
                      </p>
                    )}
                    {item.summary && (
                      <p class="mt-s line-clamp-3 text-sm leading-relaxed text-foreground/80">
                        {item.summary}
                      </p>
                    )}
                  </div>
                </li>
              ))}
            </ul>

            <div class="mt-section-lg flex justify-center">
              <CtaLink
                cta={cta}
                variant="secondary"
                fallbackHref={fallbackHref[source]}
                fallbackLabel={fallbackLabel[source]}
              />
            </div>
          </Fragment>
        )}
      </div>
    </section>
  )
}
