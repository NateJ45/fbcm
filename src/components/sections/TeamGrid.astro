---
// Safe to edit by hand
// Page-builder block: an inline team member grid.
// Members are stored as inline objects -- no external collection dependency.
// A future modules/team module will own a teamMember collection with richer
// fields (full bio, portfolio links, order rank). When that ships, pages can
// migrate from this inline approach to the reference-based approach.
//
// REDRAWN IN THE CHURCH IDENTITY (2026-09-24, the Staff identity pass), so a
// team block an editor adds reads as the staff bands do rather than as the
// starter's circles: each person in a lancet (ArchFrame), the name in
// Castoro, the role in sentence case (no tracked capitals), and the band
// heading in H2_DISPLAY, the one heading grammar every church band shares
// (CLAUDE.md rule 17). The people are laid out by the staff bands' own list
// rule (`.sg-people.sg-list` in globals.css), so the two cannot drift apart.
// No page on the site uses this block today; the staff live on staffGrid
// bands, which read the staffMember documents.
//
// SELF_CONTAINED -- manages its own bg-background surface (no surface prop).
import ArchFrame from '@/components/church/ArchFrame.astro';
import InlineRich from '@/components/InlineRich.astro';
import { H2_DISPLAY } from '@/lib/heading-grammar';
import { hasInlineRich } from '@/lib/inline-rich';

interface SocialLink {
  _key?: string;
  label?: string;
  url?: string;
}

interface TeamMember {
  _key?: string;
  name?: string;
  role?: string;
  photo?: any;
  bio?: string;
  socialLinks?: SocialLink[];
}

interface Props {
  eyebrow?: string;
  headline?: string;
  subhead?: string;
  /** Optional rich twin of `subhead`: bold and italic only. */
  subheadRich?: unknown;
  members?: TeamMember[];
  headingId?: string;
}

const {
  eyebrow,
  headline = 'Meet the Team.',
  subhead,
  subheadRich,
  members = [],
  headingId = 'team-section-heading',
} = Astro.props as Props;

const validMembers = members.filter((m) => m?.name);
const richSubhead = hasInlineRich(subheadRich);
---

{
  validMembers.length > 0 && (
    <section class="sg bg-background text-foreground" aria-labelledby={headingId}>
      <div class="sg-wrap mx-auto max-w-content px-gutter">
        <div class="sg-top">
          <div>
            {eyebrow && <p class="mb-3 font-ui text-base font-semibold text-gold-ink">{eyebrow}</p>}
            <h2 id={headingId} class:list={[H2_DISPLAY, 'text-indigo']}>
              {headline}
            </h2>
          </div>
          {(richSubhead || subhead) && (
            <p class="sg-intro text-muted-foreground">
              {richSubhead ? <InlineRich value={subheadRich} /> : subhead}
            </p>
          )}
        </div>

        <ul class="sg-people sg-list" role="list">
          {validMembers.map((member) => (
            <li>
              <article>
                <ArchFrame
                  image={member.photo}
                  shape="lancet"
                  width={560}
                  sizes="(min-width: 1024px) 22vw, (min-width: 768px) 30vw, 45vw"
                  alt={member.photo?.alt ?? member.name ?? ''}
                  grade="warm"
                  glyph="window"
                  class="sg-arch"
                />
                <div class="sg-words min-w-0">
                  <h3 class="sg-name font-body font-normal">{member.name}</h3>
                  {member.role && (
                    <p class="mt-1 font-ui text-base font-semibold text-gold-ink">{member.role}</p>
                  )}
                  {member.bio && (
                    <p class="mt-3 font-body text-base text-muted-foreground">{member.bio}</p>
                  )}
                  {member.socialLinks && member.socialLinks.length > 0 && (
                    <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-2" role="list">
                      {member.socialLinks.map((link) =>
                        link?.url && link?.label ? (
                          <li>
                            <a
                              href={link.url}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="font-ui text-base font-semibold text-link underline decoration-gold underline-offset-4"
                            >
                              {link.label}
                            </a>
                          </li>
                        ) : null,
                      )}
                    </ul>
                  )}
                </div>
              </article>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
