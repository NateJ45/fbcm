---
// Page-builder block: a text section (optional heading + rich body).
// Surface (background / muted) is assigned by SectionRenderer so the page
// cadence stays correct no matter the order. Safe to edit by hand.
import SectionHeading from '@/components/SectionHeading.astro';
import PortableText from '@/components/PortableText';
import { surfaceClass } from '@/lib/surfaces';
import { PROSE_MEASURE } from '@/lib/prose';

interface Props {
  eyebrow?: string;
  heading?: string;
  scriptAccent?: string;
  /** One word of the heading in the brand accent colour. See SectionHeading. */
  headingAccent?: string;
  body?: any;
  /**
   * Kept for compatibility with documents that already carry it, and with the
   * schema field editors still see. It has NO visual effect: see the ruling
   * P19 note below. 'narrow' is an alias of 'normal'.
   */
  width?: 'normal' | 'narrow';
  align?: 'left' | 'center';
  surface?: 'background' | 'muted';
  headingId: string;
}

const {
  eyebrow,
  heading,
  scriptAccent,
  headingAccent,
  body,
  align = 'left',
  surface = 'background',
  headingId,
} = Astro.props as Props;

// Surface classes come from src/lib/surfaces.ts, where the contrast gate
// measures this pair. Same strings as the ternary that was here (2026-08-28).
const bg = surfaceClass(surface);

// MEASURE IS THE BODY'S RULE, NOT THE BAND'S (plan 2b ruling P19, 2026-09-19).
//
// This band used to swap the whole CONTAINER to `max-w-prose` when `width` was
// 'narrow', which pulled the eyebrow, the heading and the text inward to a
// second left edge while every other band on the page started at the gutter.
// One page, two left edges: exactly what CLAUDE.md rule 17 is about. The other
// setting, 'normal', had the opposite fault: the body ran the full content
// width, about 108 characters a line, which is past the point where a reader
// loses the start of the next line.
//
// So the container is ALWAYS the page's `max-w-content px-m`, and the body
// carries its own measure.
//
// The NUMBER is measured, not assumed. CSS `ch` is the advance width of the
// digit zero, and this body face sets a zero far wider than its average
// letter: at 1280 a `max-w-[68ch]` body came out 772px and fitted 88 to 93
// real characters a line, which is barely narrower than the full content
// width it was meant to fix. 52ch is 590px here and measures 65 to 69
// characters on the Beliefs bands, which is the target. Re-measure in the
// browser if the body font ever changes; do not convert this by arithmetic.
//
// The `width` field stays in the schema and on existing documents; 'narrow' is
// now an alias with no visual difference.
//
// The measure itself moved to src/lib/prose.ts on 2026-09-20 so /privacy, which
// is a bespoke route rather than a builder page, can read the same one string
// instead of carrying a second copy of it.
const alignClass = align === 'center' ? 'text-center' : '';
const proseClass = [
  PROSE_MEASURE,
  heading ? 'mt-l' : '',
  alignClass,
  // Centred prose has to be centred as a BOX as well as as text, or the 68ch
  // measure would sit against the left edge with its lines centred inside it.
  align === 'center' ? 'mx-auto' : '',
]
  .filter(Boolean)
  .join(' ');
---

<section class={bg} aria-labelledby={heading ? headingId : undefined}>
  <div class="mx-auto max-w-content px-m py-section-lg" data-reveal>
    {
      heading && (
        <SectionHeading
          eyebrow={eyebrow}
          headline={heading}
          headingId={headingId}
          align={align}
          scriptAccent={scriptAccent}
          headingAccent={headingAccent}
          class={align === 'center' ? 'mx-auto' : ''}
        />
      )
    }
    {body && <PortableText value={body} className={proseClass} />}
  </div>
</section>
