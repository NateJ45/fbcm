---
// Safe to edit by hand
// scaffold-file: church
// Page-builder block: Sunday times, drawn as THE HYMN BOARD (2026-09-23, the
// Home identity pass; the prototype's `section.expect`,
// docs/superpowers/prototypes/2026-09-23-home/home.html).
//
// The whole band is brand brown (--color-band-brown), dark BY TYPE, so it is on
// no cadence and carries no colour field (CLAUDE.md rule 9). The owner's
// override #5 (plan 2026-09-23-fbcm-home-identity.md): no boxed card floating
// on the cream page. The prototype's framed brown board on cream became the
// band itself, and the times are set STRAIGHT ONTO IT, the way the board by
// the pulpit carries its numbers: gold numerals, the title beside each, a
// small line under it, and a gold hairline between the rows.
//
// The rows come from boardRows() (src/lib/hymn-board.ts, unit-tested): every
// item, then every door. A clock time is a gold numeral with its am/pm set
// small and lower case; any other big line ("309 East Adams", "Online") is set
// in the same gold, smaller, and wraps inside its cell; a door has the door
// glyph where the time would be. The row whose time is the service time in
// Site settings is drawn largest, derived rather than chosen (rule 15). The
// first column is a subgrid track sized to its widest cell (capped at 40% of
// the board), so the titles share one left edge down the whole board.
//
// THE PICTURES. The band's own `photos` come first: the first in a wide door
// arch, the second in a small lancet overlapping its lower right corner, cut
// out of the photo behind it by a brown halo. With no photos of its own the
// band takes a spare photograph from the page's pool (src/lib/spare-images.ts,
// which skips a band that has its own), drawn in the same door arch. With no
// picture at all, the map from Site settings stands in the picture's place
// when `showMap` is on and a map has been uploaded; with none of those the
// board sits alone, centred.
//
// The `notes` go under the pictures (under the board when there are none),
// each with the same small gold quatrefoil. Not a building glyph: the four
// glyphs stand for the four goals (Worship, The Way, Witness, Work) and the
// goals band follows this one on the home page (controller ruling, fix 1).
//
// On a long board (Visit's three doors) the picture holds its place at the
// top of the viewport while the board scrolls past it, so the left half is
// not a picture and then a long empty field. Only when there are no notes:
// the notes sit under the picture, and a sticky column taller than a short
// laptop screen would hold them out of sight until the band ended.
//
// The address and the directions link come from Site settings, so the church
// types them once. The address is printed under the board. The band's `rule`
// button is its own `cta` when an editor set one, with the directions as a
// text link beside it; with no `cta` the directions link is the rule button.
// The directions link shows whenever Site settings has one. The address is
// the one thing this band must never fail to show when it has no picture:
// `showMap` off only hides the address when there is a picture beside the
// board.
import SanityImage from '@/components/SanityImage.astro';
import CtaLink from '@/components/CtaLink.astro';
import ArchFrame from '@/components/church/ArchFrame.astro';
import BuildingGlyph from '@/components/church/BuildingGlyph.astro';
import { getSiteSettings } from '@/lib/queries';
import type {
  ProjectedCtaBlock,
  ProjectedImage,
  SectionSiteSettings,
  SanityImageObject,
} from '@/lib/pageBuilder.types';
import { splitStega, reattachStega } from '@/lib/preview-stega';
import { boardRows, type BoardItem, type BoardDoor } from '@/lib/hymn-board';

/** The notes' neutral mark: a quatrefoil, four circles of radius 9 (BuildingGlyph's QF). */
const QUATREFOIL =
  'M-8.94-8.94A9 9 0 1 1 8.94-8.94A9 9 0 1 1 8.94 8.94A9 9 0 1 1-8.94 8.94A9 9 0 1 1-8.94-8.94Z';

interface Props {
  eyebrow?: string | null;
  heading?: string | null;
  intro?: string | null;
  items?: BoardItem[] | null;
  notes?: (string | null)[] | null;
  photos?: (ProjectedImage | SanityImageObject | null)[] | null;
  cta?: ProjectedCtaBlock | null;
  doors?: BoardDoor[] | null;
  showMap?: boolean | null;
  headingId: string;
  /**
   * A photograph borrowed from elsewhere on the page, used only when the band
   * has no photos of its own. Null (the default) means none. SectionRenderer
   * computes it once per page with assignSpareImages(), so two bands on the
   * same page can never be handed the same picture.
   */
  frame?: SanityImageObject | null;
  /**
   * Site settings, handed down by SectionRenderer from the route that already
   * fetched them. In /preview/** that is the DRAFT client, so an editor
   * changing the map, the address, the directions link or the service time
   * sees it; calling getSiteSettings() here would read the published document
   * and then serve a memoised copy of it for the isolate's whole life. The
   * fetch below is only the fallback for callers that pass nothing (the
   * styleguide, and the code-defined default sections).
   */
  settings?: SectionSiteSettings | null;
}

const {
  eyebrow,
  heading,
  intro,
  items,
  notes,
  photos,
  cta,
  doors,
  showMap,
  headingId,
  frame = null,
  settings: settingsProp,
} = Astro.props as Props;

const settings: SectionSiteSettings | null =
  settingsProp !== undefined ? settingsProp : await getSiteSettings();
const mapImage = settings?.mapImage;
const directionsUrl: string | undefined = settings?.directionsUrl ?? undefined;

// ── The pictures ───────────────────────────────────────────────────────────
const ownPhotos = (photos ?? []).filter((p): p is SanityImageObject => !!p?.asset).slice(0, 2);
const mainPhoto: SanityImageObject | null = ownPhotos[0] ?? (frame?.asset ? frame : null);
const smallPhoto: SanityImageObject | null = ownPhotos[1] ?? null;
const showTheMap = !mainPhoto && showMap !== false && !!mapImage?.asset;
const hasPicture = !!mainPhoto || showTheMap;
const altOf = (image: SanityImageObject | null): string => {
  const alt = (image as { alt?: unknown } | null)?.alt;
  return typeof alt === 'string' ? alt : '';
};

// ── The board ──────────────────────────────────────────────────────────────
const rows = boardRows(items ?? [], doors ?? [], settings?.serviceTime);
const validNotes = (notes ?? []).filter(
  (n): n is string => typeof n === 'string' && splitStega(n).cleaned.trim() !== '',
);

// The address lines. `address` is a plain string in Site settings and may hold
// more than one line; the city/state pair comes from Business info through the
// same flattened settings object. splitStega first: the payload is written in
// U+200B/C/D and U+FEFF, and trim() eats U+FEFF, so splitting the raw string
// shatters it and click-to-edit stops resolving on the address. The payload
// is put back on the first line.
const addressSplit = splitStega(typeof settings?.address === 'string' ? settings.address : '');
const addressLines: string[] = [
  ...addressSplit.cleaned.split('\n'),
  [settings?.city, settings?.state].filter(Boolean).join(', '),
]
  .map((line) => line.trim())
  .filter(Boolean)
  .map((line, i) => (i === 0 ? reattachStega(line, addressSplit.encoded) : line));
const showAddress = addressLines.length > 0 && (showMap !== false || !hasPicture);

// The directions link shows whenever Site settings has one, even on a band
// whose address is hidden (a picture beside the board and `showMap` off):
// that was the old band's behaviour, and a visitor can still use the link.
const directionsCta = directionsUrl
  ? {
      label: 'Open in Google Maps',
      linkType: 'external' as const,
      externalUrl: directionsUrl,
      openInNewTab: true,
    }
  : null;
const hasCta = !!cta?.label;
const stickyPicture = hasPicture && validNotes.length === 0;
---

<section class="bg-band-brown text-bg" aria-labelledby={heading ? headingId : undefined}>
  <div
    class:list={[
      'mx-auto max-w-content px-gutter py-section-lg',
      hasPicture &&
        'grid grid-cols-1 gap-y-[clamp(40px,5vw,64px)] lg:grid-cols-12 lg:grid-rows-[auto_1fr] lg:gap-x-[clamp(32px,4vw,64px)]',
    ]}
  >
    {
      /* ── The pictures (or the map) ─────────────────────────────────────── */
      hasPicture && (
        <div
          class:list={[
            'relative w-full max-w-[40rem] lg:col-span-6 lg:max-w-none',
            stickyPicture &&
              'lg:sticky lg:top-[clamp(104px,12vh,136px)] lg:row-span-2 lg:self-start',
          ]}
        >
          {mainPhoto ? (
            <div class:list={['relative', smallPhoto && 'pb-[clamp(40px,5vw,80px)]']}>
              <ArchFrame
                image={mainPhoto}
                shape="door"
                width={1400}
                sizes="(min-width:1024px) 45vw, 100vw"
                alt={altOf(mainPhoto)}
                grade="warm"
                style="--arch-ratio: 160 / 112;"
              />
              {smallPhoto && (
                <div class="absolute right-[-2%] bottom-0 w-[36%]">
                  <span class="hb-halo arch-lancet" aria-hidden="true" />
                  <ArchFrame
                    image={smallPhoto}
                    shape="lancet"
                    width={600}
                    sizes="(min-width:1024px) 16vw, 36vw"
                    alt={altOf(smallPhoto)}
                    grade="warm"
                    class="relative"
                  />
                </div>
              )}
            </div>
          ) : (
            <figure class="m-0 border border-gold/40" data-reveal>
              <SanityImage
                source={mapImage}
                width={1400}
                sizes="(min-width:1024px) 45vw, 100vw"
                quality={75}
                alt="Map of the streets around the church"
                class="block w-full"
              />
            </figure>
          )}
        </div>
      )
    }

    {/* ── The words and the board ─────────────────────────────────────── */}
    <div
      class:list={[
        hasPicture
          ? 'lg:col-span-6 lg:col-start-7 lg:row-span-2 lg:row-start-1 xl:col-span-5 xl:col-start-8'
          : 'mx-auto max-w-[40rem]',
      ]}
    >
      {eyebrow && <p class="mb-4 font-ui text-ui font-semibold text-gold">{eyebrow}</p>}
      {
        heading && (
          <h2 id={headingId} class="font-display text-h2 leading-[1.02] font-normal text-gold">
            {heading}
          </h2>
        )
      }
      {
        intro && (
          <p class="mt-[clamp(18px,2vw,28px)] max-w-[30em] font-body text-lede leading-normal whitespace-pre-line">
            {intro}
          </p>
        )
      }

      {
        rows.length > 0 && (
          <ol
            class="mt-[clamp(28px,3.5vw,48px)] grid grid-cols-[fit-content(40%)_minmax(0,1fr)] gap-x-[clamp(14px,2vw,24px)] border-t border-gold/35"
            data-reveal
          >
            {rows.map((row) => (
              <li
                class:list={[
                  'col-span-full grid items-baseline border-b border-gold/35 py-[clamp(12px,1.4vw,16px)]',
                  // A door row on a phone keeps its glyph in a narrow track of
                  // its own, so the door's long directions get the width the
                  // time column would otherwise hold empty beside them.
                  row.kind === 'door'
                    ? 'grid-cols-[28px_minmax(0,1fr)] gap-x-3.5 sm:grid-cols-subgrid sm:gap-x-[clamp(14px,2vw,24px)]'
                    : 'grid-cols-subgrid',
                ]}
              >
                {row.kind === 'time' ? (
                  <span
                    class:list={[
                      'min-w-[3.2ch] font-display leading-none whitespace-nowrap text-gold lining-nums',
                      row.main ? 'text-[clamp(36px,3.8vw,54px)]' : 'text-[clamp(28px,2.8vw,40px)]',
                    ]}
                  >
                    {row.big}
                    {row.meridiem && (
                      <span class="ml-[.14em] font-body text-[.42em] italic">{row.meridiem}</span>
                    )}
                  </span>
                ) : row.kind === 'word' ? (
                  <span class="max-w-full min-w-0 font-display text-[clamp(19px,1.7vw,24px)] leading-[1.1] break-words text-gold">
                    {row.big}
                  </span>
                ) : row.kind === 'door' ? (
                  <span class="self-start pt-1 text-gold">
                    <BuildingGlyph name="door" class="w-6" />
                  </span>
                ) : (
                  <span />
                )}
                <span class="min-w-0">
                  {row.label && (
                    <span
                      class:list={[
                        'block font-body leading-tight',
                        row.main
                          ? 'text-[clamp(1.375rem,1.1rem+.8vw,1.75rem)] text-white-pure italic'
                          : 'text-[clamp(1.2rem,1.05rem+.4vw,1.375rem)]',
                      ]}
                    >
                      {row.label}
                    </span>
                  )}
                  {row.body && (
                    <span class="mt-1 block font-ui text-[1rem] leading-snug text-band-taupe">
                      {row.body}
                    </span>
                  )}
                </span>
              </li>
            ))}
          </ol>
        )
      }

      {
        showAddress && (
          <div class="mt-7">
            <address class="font-body text-body leading-snug not-italic oldstyle">
              {addressLines.map((line) => (
                <span class="block">{line}</span>
              ))}
            </address>
          </div>
        )
      }
      {
        (hasCta || directionsCta) && (
          <div
            class:list={[
              showAddress ? 'mt-7' : 'mt-9',
              'flex flex-wrap items-center gap-x-[34px] gap-y-[22px] pb-1.5',
            ]}
          >
            <CtaLink cta={hasCta ? cta : directionsCta} variant="rule" onDark />
            {hasCta && directionsCta && <CtaLink cta={directionsCta} variant="link" onDark />}
          </div>
        )
      }

      {
        !hasPicture && validNotes.length > 0 && (
          <ul class="mt-10 grid max-w-[32em] gap-3.5">
            {validNotes.map((note) => (
              <li class="grid grid-cols-[18px_minmax(0,1fr)] items-start gap-3.5 font-body text-[1.125rem] leading-normal">
                <svg
                  viewBox="-19 -19 38 38"
                  aria-hidden="true"
                  focusable="false"
                  class="building-glyph mt-[.3em] w-[18px] text-gold"
                >
                  <path d={QUATREFOIL} />
                </svg>
                <span>{note}</span>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    {
      /* ── The notes, under the pictures ─────────────────────────────────── */
      hasPicture && validNotes.length > 0 && (
        <ul class="grid max-w-[32em] content-start gap-3.5 self-start lg:col-span-6 lg:row-start-2">
          {validNotes.map((note) => (
            <li class="grid grid-cols-[18px_minmax(0,1fr)] items-start gap-3.5 font-body text-[1.125rem] leading-normal">
              <svg
                viewBox="-19 -19 38 38"
                aria-hidden="true"
                focusable="false"
                class="building-glyph mt-[.3em] w-[18px] text-gold"
              >
                <path d={QUATREFOIL} />
              </svg>
              <span>{note}</span>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>
