---
// Safe to edit by hand
// Draws the Ledger's pieces (src/lib/rich-shape.ts) as children of an .rt-g
// grid. Every block goes through PortableText variant="bare" so marks, links
// and the preview's click-to-edit survive; the only plain strings are the
// split-off heads (a said prefix, a table name, a run-in label), which are
// cleaned text by construction (src/lib/span-split.ts).
//
// The Beliefs identity pass (2026-09-24): prose is always one measure (the
// newspaper columns are gone, rollout rule 11), a run-in label is an italic
// head in the accent ink rather than tracked capitals, body heads are in the
// brand indigo, and the Ledger's CSS (src/styles/ledger.css) carries the three
// brand grounds a text band can be drawn on
// (src/lib/rich-ground.ts).
import '@/styles/ledger.css';
import PortableText from '@/components/PortableText';
import type { RichPiece } from '@/lib/rich-shape';
import { toPt, blockText } from '@/lib/span-split';
import type { PtBlock } from '@/lib/span-split';
import BeliefGlyph from '@/components/church/BeliefGlyph.astro';
import { beliefGlyphFor } from '@/lib/belief-glyphs';

interface Props {
  pieces: RichPiece[];
  /** True only inside /beliefs' "Our Basic Beliefs" band (RichTextSection
   *  decides, from the band heading): an h3 whose text is one of the six
   *  known subheadings then gets its small line glyph (src/lib/belief-glyphs.ts).
   *  False everywhere else, so every other band renders exactly as before. */
  glyphs?: boolean;
}
const { pieces, glyphs = false } = Astro.props as Props;
/** The glyph for a subheading block, or null (always null outside the band). */
const glyphOf = (head: PtBlock) => (glyphs ? beliefGlyphFor(blockText(head)) : null);
---

{
  pieces.map((x) =>
    x.kind === 'lede' ? (
      <div class="rt-lede rt-v">
        <PortableText value={toPt(x.block)} variant="bare" />
      </div>
    ) : x.kind === 'standfirst' ? (
      <div class="rt-standfirst">
        <PortableText value={toPt(x.block)} variant="bare" />
      </div>
    ) : x.kind === 'leadin' ? (
      <div class="rt-leadin">
        <PortableText value={toPt(x.block)} variant="bare" />
      </div>
    ) : x.kind === 'quote' ? (
      <blockquote class="rt-sub rt-quote rt-v">
        {/* the element is here, so the block renders as its paragraph */}
        <PortableText value={toPt({ ...x.block, style: 'normal' })} variant="bare" />
      </blockquote>
    ) : x.kind === 'measure' ? (
      <div class="rt-measure rt-v">
        {x.paras.map((q) =>
          q.label ? (
            <div class="rt-runin">
              <span class="rt-rl">{q.label}</span>
              <PortableText value={toPt(q.block)} variant="bare" />
            </div>
          ) : (
            <PortableText value={toPt(q.block)} variant="bare" />
          ),
        )}
      </div>
    ) : x.kind === 'table' ? (
      <div class="rt-sub rt-ledger rt-v">
        {x.rows.map((r) => (
          <div class="rt-row">
            {r.name ? <p class="rt-nm">{r.name}</p> : null}
            <div class="rt-ds" style={r.name ? undefined : 'grid-column:1/12'}>
              <PortableText value={toPt(r.tail)} variant="bare" />
            </div>
          </div>
        ))}
      </div>
    ) : x.kind === 'labelled' ? (
      <div class="rt-sub rt-ledger rt-labelled rt-v">
        {x.rows.map((r) => (
          <div class="rt-row">
            <div class="rt-nm">
              <PortableText value={toPt(r.label)} variant="bare" />
            </div>
            <div class="rt-ds">
              {r.body.map((b) => (
                <PortableText value={toPt(b)} variant="bare" />
              ))}
            </div>
          </div>
        ))}
      </div>
    ) : x.kind === 'said' ? (
      <ul class:list={['rt-said rt-v', x.hang && 'is-hang']}>
        {x.items.map((it) => (
          <li>
            <span class="rt-pre">
              <span>{x.prefix}</span>
            </span>
            <span class="rt-tx">
              <PortableText value={toPt(it)} variant="bare" />
            </span>
          </li>
        ))}
      </ul>
    ) : x.kind === 'triad' ? (
      <div class="rt-triad rt-v">
        {x.items.map((it) => (
          <span>
            {x.prefix && <span class="rt-pre">{x.prefix} </span>}
            <PortableText value={toPt(it)} variant="bare" />
          </span>
        ))}
      </div>
    ) : x.kind === 'index' ? (
      <ul class="rt-index rt-v">
        {x.items.map((it) => (
          <li>
            <PortableText value={toPt(it)} variant="bare" />
          </li>
        ))}
      </ul>
    ) : x.kind === 'plain' && x.ordered ? (
      <ol class="rt-sub rt-ledger rt-v is-ol">
        {x.items.map((it) => (
          <li class="rt-row">
            <span class="rt-it">
              <PortableText value={toPt(it)} variant="bare" />
            </span>
          </li>
        ))}
      </ol>
    ) : x.kind === 'plain' ? (
      <ul class="rt-sub rt-ledger rt-v">
        {x.items.map((it) => (
          <li class="rt-row">
            <span class="rt-it">
              <PortableText value={toPt(it)} variant="bare" />
            </span>
          </li>
        ))}
      </ul>
    ) : x.kind === 'section' && x.beside ? (
      <div class="rt-sub rt-section rt-v">
        <h3 class:list={['rt-h3 rt-sh', glyphOf(x.head) && 'rt-hg']}>
          {glyphOf(x.head) ? (
            <>
              <BeliefGlyph name={glyphOf(x.head)!} class="rt-hg-i" />

              <span class="rt-hg-t">
                <PortableText value={toPt(x.head)} variant="bare" />
              </span>
            </>
          ) : (
            <PortableText value={toPt(x.head)} variant="bare" />
          )}
        </h3>
        <div class="rt-sb">
          <Astro.self pieces={x.pieces} glyphs={glyphs} />
        </div>
      </div>
    ) : x.kind === 'section' ? (
      <>
        <div class="rt-sect">
          <h3 class:list={['rt-h3', glyphOf(x.head) && 'rt-hg']}>
            {glyphOf(x.head) ? (
              <>
                <BeliefGlyph name={glyphOf(x.head)!} class="rt-hg-i" />

                <span class="rt-hg-t">
                  <PortableText value={toPt(x.head)} variant="bare" />
                </span>
              </>
            ) : (
              <PortableText value={toPt(x.head)} variant="bare" />
            )}
          </h3>
        </div>
        <Astro.self pieces={x.pieces} glyphs={glyphs} />
      </>
    ) : x.kind === 'columns' ? (
      <div class:list={['rt-sub rt-cols rt-v', `n${x.across}`, x.flush && 'is-flush']}>
        {x.groups.map((g) => (
          <div class:list={['rt-col', g.big && 'is-big']}>
            {x.level === 'h3' ? (
              <h3 class:list={['rt-h3', glyphOf(g.head) && 'rt-hg']}>
                {glyphOf(g.head) ? (
                  <>
                    <BeliefGlyph name={glyphOf(g.head)!} class="rt-hg-i" />

                    <span class="rt-hg-t">
                      <PortableText value={toPt(g.head)} variant="bare" />
                    </span>
                  </>
                ) : (
                  <PortableText value={toPt(g.head)} variant="bare" />
                )}
              </h3>
            ) : (
              <h4 class="rt-h4">
                <PortableText value={toPt(g.head)} variant="bare" />
              </h4>
            )}
            <Astro.self pieces={g.pieces} glyphs={glyphs} />
          </div>
        ))}
      </div>
    ) : x.kind === 'register' ? (
      <div class="rt-sub rt-register">
        {x.left.map((cell, k) => (
          <div class:list={['rt-cell is-l', k === 0 && 'is-first']} style={`grid-row:${k + 1}`}>
            <Astro.self pieces={cell} glyphs={glyphs} />
          </div>
        ))}
        {x.right.map((cell, k) => (
          <div class:list={['rt-cell is-r', k === 0 && 'is-first']} style={`grid-row:${k + 1}`}>
            <Astro.self pieces={cell} glyphs={glyphs} />
          </div>
        ))}
      </div>
    ) : x.kind === 'foot' ? (
      <div class="rt-foot">
        <PortableText value={toPt(x.block)} variant="bare" />
      </div>
    ) : null,
  )
}
