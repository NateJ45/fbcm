---
// Safe to edit by hand
// Page-builder block: one picture and a piece of text, drawn ASYMMETRICALLY
// (art-direction pass, 2026-09-20, spec section 5; the prototype's `.first`
// band). It was a 50/50 split with the image vertically centred beside the
// words, which is the layout every template ships and the reason the band read
// as a brochure.
//
// The shape now is the prototype's: a short heading block in the first four of
// twelve columns, the body starting at column six so the two have a real gap
// rather than a gutter, and the photograph BELOW both, wider than either, bled
// off the edge of the page. `imageSide` still decides which edge it runs off.
//
// Four things are worth knowing before editing it.
//
// 1. THE LEDE IS BORROWED FROM THE BODY, and only when there is enough body to
//    spare. The prototype's heading block carries a short line under the h2,
//    and this block has no field for one: the pass changed no schema. So the
//    FIRST paragraph of the body is promoted into that slot, and it is then
//    removed from the body render so the page never says it twice. A body of
//    one or two paragraphs is left alone: taking half of a two-paragraph band
//    into the heading column empties the column that is supposed to hold the
//    reading.
//
// 2. THE CAPTION IS THE ALT TEXT. A figure with no caption under a bled
//    photograph looks unfinished, and the alt is the one description the
//    editor has already written. It is not a second field to keep in step.
//
// 3. THE CROP IS THE SITE'S HEAD-ROOM RULE, `object-[50%_40%]`, the same one
//    the hero and the Sunday band's frame use: a 16:9 window on a photograph
//    of people cuts foreheads off when it is centred. It is NOT read from the
//    image's stored hotspot, because a hotspot an editor never moved still
//    stores dead centre and would quietly undo the rule on every picture.
//
// 4. THE PICTURE IS ALSO THE PAGE'S SPARE. src/lib/spare-images.ts reads
//    `imageTextSection.image` into the pool the statement band and the Sunday
//    band borrow from. It stays here as well: the building shows at two
//    distances on purpose.
import { surfaceClass } from '@/lib/surfaces';
import SanityImage from '@/components/SanityImage.astro';
import PortableText from '@/components/PortableText';
import CtaLink from '@/components/CtaLink.astro';

interface Props {
  image?: any;
  imageSide?: 'left' | 'right';
  eyebrow?: string;
  heading?: string;
  body?: any;
  cta?: any;
  surface?: 'background' | 'muted';
  headingId: string;
}

const {
  image,
  imageSide = 'left',
  eyebrow,
  heading,
  body,
  cta,
  surface = 'background',
  headingId,
} = Astro.props as Props;

const bg = surfaceClass(surface);

// See note 1. Portable Text arrives as an array of blocks; only a plain
// paragraph (`style: 'normal'`) is promotable, because a heading or a list item
// read as a lede is a different kind of sentence. Three paragraphs is the
// floor: below it the body would lose too much of itself.
const blocks: any[] = Array.isArray(body) ? body : [];
const paragraphs = blocks.filter((b) => b?._type === 'block' && (b.style ?? 'normal') === 'normal');
const promoteLede = paragraphs.length >= 3 && (blocks[0]?.style ?? 'normal') === 'normal';
const ledeBlock = promoteLede ? blocks[0] : null;
const bodyBlocks = promoteLede ? blocks.slice(1) : blocks;

// The lede is rendered as plain text rather than through PortableText, because
// it is one paragraph in a display slot, not a piece of prose. `.children` is
// the span array every normal block carries.
const ledeText: string = ledeBlock
  ? (ledeBlock.children ?? []).map((c: any) => c?.text ?? '').join('')
  : '';

// The photograph runs off the edge the editor chose. `bleed-right` and
// `bleed-left` are the shared utilities from globals.css; both collapse to a
// plain gutter pull on a phone, where the grid is one column anyway.
const figureClass =
  imageSide === 'left'
    ? 'col-span-12 lg:col-span-8 bleed-left'
    : 'col-span-12 lg:col-start-5 lg:col-span-8 bleed-right';
---

<section class={bg} aria-labelledby={heading ? headingId : undefined}>
  <div
    class="mx-auto grid max-w-content grid-cols-12 gap-x-[clamp(16px,2.5vw,40px)] px-gutter py-section-lg"
    data-reveal
  >
    <div class="col-span-12 lg:col-span-4">
      {eyebrow && <p class="mb-5 font-ui text-ui text-gold-ink">{eyebrow}</p>}
      {
        heading && (
          <h2 id={headingId} class="max-w-[11ch] font-body text-h2 font-normal text-foreground">
            {heading}
          </h2>
        )
      }
      {
        ledeText && (
          <p class="mt-5 max-w-[22ch] text-lede font-normal text-muted-foreground">{ledeText}</p>
        )
      }
    </div>

    <div class="col-span-12 mt-9 lg:col-span-6 lg:col-start-6 lg:mt-0">
      {
        bodyBlocks.length > 0 && (
          <PortableText
            value={bodyBlocks}
            className="font-body text-[1.125rem] leading-[1.72] text-foreground/90"
          />
        )
      }
      {
        cta?.label && (
          <div class="mt-8">
            <CtaLink cta={cta} variant="link" />
          </div>
        )
      }
    </div>

    {
      image?.asset && (
        <figure class:list={[figureClass, 'mt-[clamp(56px,7vw,96px)]']}>
          <SanityImage
            source={image}
            width={1800}
            sizes="(min-width: 1024px) 70vw, 100vw"
            quality={75}
            class="aspect-video w-full object-cover object-[50%_40%]"
          />
          {image?.alt && (
            <figcaption class="mt-3 font-ui text-[0.75rem] tracking-[.06em] text-muted-foreground">
              {image.alt}
            </figcaption>
          )}
        </figure>
      )
    }
  </div>
</section>
