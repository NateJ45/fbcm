---
// Safe to edit by hand
// Page-builder block: one picture and its text. The PICTURE decides the band
// (2026-09-22; src/lib/photo-shape.ts, prototype in
// docs/superpowers/prototypes/2026-09-22-richtext-and-photos/photos/):
//   ground  a wide sharp view of the place; the band's ground, heading set in
//   window  the page's first portrait, through the tower's lancet (Lancet.astro)
//   frame   any later portrait, native shape, hung on a gold line
//   plate   an archival scan, matted on the other surface, never cropped
//   legend  a wide group photo whose body names the people left to right
//   row     everything else, beside its text at its native shape
// No picture ever sits in a column below its words, and no picture is forced
// into a landscape crop (that is how portraits lost their heads).
//
// Three things are worth knowing before editing it.
//
// 1. THE LEDE IS BORROWED FROM THE BODY by the one rule the whole site uses,
//    isLedeParagraph in src/lib/rich-shape.ts. It is then removed from the
//    body render so the page never says it twice. The Ledger classifier is
//    called with hasHead: false so it never takes a second one.
//
// 2. NO VISIBLE CAPTIONS (2026-09-23, the owner: "the pictures speak for
//    themselves"). This block used to print the image's alt text under every
//    photograph as a figcaption. The alt text still lives on the <img>, for
//    screen readers, but nothing prints it as reading copy any more.
//
// 4. PEOPLE IN ARCHES, BUILDINGS IN RECTANGLES (2026-09-24, the Visit
//    identity pass; rollout rule 3). The shape pass above is unchanged; what
//    changes is the frame a ROW, FRAME or WINDOW picture is drawn in. A photo of
//    people (photo-subject.ts, read from its alt text) is drawn in a door arch
//    (a wide door for a landscape photo) or, as a portrait, a lancet (the
//    tower-lancet Lancet.astro stays for a portrait of a place);
//    a photo of the building keeps its rectangle. The window, the ground, the
//    plate and the legend are untouched. A people photo may carry a small
//    second photo (`detail`), drawn in a lancet over its lower corner, cut
//    out of it by a halo of the band's own ground (the prototype's
//    "Where the children go"). The heading is in the one band grammar
//    (H2_DISPLAY, CLAUDE.md rule 17) and the button is the gold plate.
//
// 5. A BODY WRITTEN AS ROOMS IS A ROOM BOARD. When every small heading in the
//    body names its room in brackets ("Nursery Care (104)"), the body is drawn
//    as the prototype's board: the room number large in the gold-ruled
//    titling figures, the name beside it, the text under the name, and a
//    bullet list as quatrefoil lines (roomBoard() in morning-path.ts).
//
// 3. THE PICTURE IS ALSO THE PAGE'S SPARE, AND MAY NOT BE THIS ONE.
//    src/lib/spare-images.ts reads `imageTextSection.image` into the pool the
//    statement band and the Sunday band borrow from, and a band whose picture
//    was borrowed is handed a different one by SectionRenderer so the page
//    never shows one photograph twice. `image` can therefore be null even
//    though the block carries one, and the band then renders as text alone
//    (`data-photo-shape="none"`): the heading, then the body across the full
//    grid, and no figure. That is a real layout, not a broken one, which is
//    why there is no placeholder box.
import { surfaceClass } from '@/lib/surfaces';
import SanityImage from '@/components/SanityImage.astro';
import PortableText from '@/components/PortableText';
import CtaLink from '@/components/CtaLink.astro';
import RichBody from '@/components/sections/RichBody.astro';
import Lancet from '@/components/sections/Lancet.astro';
import { classifyRichText, isLedeParagraph } from '@/lib/rich-shape';
import { photoAspect, resolveLegend, type PhotoShape } from '@/lib/photo-shape';
import { toPt, type PtBlock } from '@/lib/span-split';
import { splitStega } from '@/lib/preview-stega';
import ArchFrame from '@/components/church/ArchFrame.astro';
import { photoSubject } from '@/lib/photo-subject';
import { roomBoard } from '@/lib/morning-path';
import { H2_DISPLAY } from '@/lib/heading-grammar';

interface Props {
  image?: any;
  /** A small second photo, drawn over a people photo's corner (note 4). */
  detail?: any;
  imageSide?: 'left' | 'right';
  eyebrow?: string;
  heading?: string;
  body?: any;
  cta?: any;
  shape?: PhotoShape;
  surface?: 'background' | 'muted';
  headingId: string;
}

const {
  image,
  detail,
  imageSide = 'left',
  eyebrow,
  heading,
  body,
  cta,
  shape: shapeProp = 'row',
  surface = 'background',
  headingId,
} = Astro.props as Props;

const bg = surfaceClass(surface);
const band = surface === 'muted' ? 'var(--color-muted)' : 'var(--color-background)';
const mat = surface === 'muted' ? 'var(--color-background)' : 'var(--color-muted)';
const blocks: PtBlock[] = Array.isArray(body) ? body : [];
const hasPicture = !!image?.asset;
const assigned: PhotoShape = hasPicture ? shapeProp : 'row';
// The alt ATTRIBUTE and every test run on this cleaned string, stega stripped
// so the alt read by screen readers and the alt test comparisons never carry
// the preview's invisible markers.
const alt = splitStega(image?.alt ?? '').cleaned;
const dims = photoAspect(image);

// The lede: one rule for the whole site (src/lib/rich-shape.ts isLedeParagraph).
const firstRun = blocks.findIndex((b) => b?.listItem || (b?.style ?? 'normal') !== 'normal');
const runLength = firstRun === -1 ? blocks.length : firstRun;
const ledeBlock = isLedeParagraph(blocks[0], runLength, blocks.length - 1) ? blocks[0] : null;
let rest = ledeBlock ? blocks.slice(1) : blocks;

// The legend lifts its label, names and footnote out of the body. The shape is
// settled here, after the lede, so the whole template sees a legend that has
// nothing left to lift as the row it falls back to (resolveLegend).
const { shape, legend } = resolveLegend(assigned, rest);
const legendLabel = legend ? rest[legend.labelIndex] : null;
const legendNames = legend ? rest.slice(legend.listStart, legend.listEnd) : [];
const legendFoot = legend && legend.footIndex !== null ? rest[legend.footIndex] : null;
if (legend) {
  const end = legend.footIndex !== null ? legend.footIndex + 1 : legend.listEnd;
  rest = rest.filter((_, i) => i < legend.labelIndex || i >= end);
}

const beside = shape === 'row' || shape === 'window' || shape === 'frame' || shape === 'plate';
// A ground's body sits at full width under the photo: the prototype's wide flow
// (labelled rows, a two-column set up to 180 words). Opt-in, ground only.
const layout = classifyRichText(rest, { hasHead: false, narrow: beside, wide: shape === 'ground' });
const side = imageSide; // the schema default is 'left', which is where the window wants to be
// ROW width follows the picture (P1's mapping): portrait 4, square 5, landscape 6, wide 7.
const rowWidth = !dims ? 6 : dims.a < 0.9 ? 4 : dims.a <= 1.15 ? 5 : dims.a < 1.6 ? 6 : 7;
// Note 4: people in arches. Only a row or a frame changes frame.
const people = hasPicture && photoSubject(alt) === 'people';
const arched = people && (shape === 'row' || shape === 'frame' || shape === 'window');
// A portrait is a lancet, unless it carries the small lancet over its corner:
// then the main photo takes the door, so the two arches are not the same shape.
const lancet = (shape === 'frame' || shape === 'window') && !detail?.asset;
const archRatio = lancet ? '100 / 150' : dims && dims.a >= 1.25 ? '160 / 124' : '100 / 130';
const detailAlt = splitStega(detail?.alt ?? '').cleaned;
const hasDetail = arched && !!detail?.asset;
const rowBleed = shape === 'row' && !arched && !!dims && dims.a >= 1.15;
// Note 5: a body written as rooms.
const board = roomBoard(rest);
const QF =
  'M-8.94-8.94A9 9 0 1 1 8.94-8.94A9 9 0 1 1 8.94 8.94A9 9 0 1 1-8.94 8.94A9 9 0 1 1-8.94-8.94Z';
---

<section
  class={bg}
  style={`--band:${band};--mat:${mat}`}
  aria-labelledby={heading ? headingId : undefined}
  data-photo-shape={hasPicture ? shape : 'none'}
>
  {
    shape === 'ground' ? (
      <>
        <div class="ph-ground-fig">
          <SanityImage source={image} width={2400} sizes="100vw" quality={75} alt={alt} />
          <div class="hero-overlay" aria-hidden="true" />
          <div class="ph-ground-text">
            <div class="ph-in">
              {eyebrow && (
                <>
                  <span class="ph-tick" />
                  <p class="mb-5 font-ui text-ui text-bg">{eyebrow}</p>
                </>
              )}
              {heading && (
                <h2 id={headingId} class={H2_DISPLAY}>
                  {heading}
                </h2>
              )}
              {ledeBlock && (
                <div class="ph-lede">
                  <PortableText value={toPt(ledeBlock)} variant="bare" />
                </div>
              )}
            </div>
          </div>
        </div>
        <div class="mx-auto max-w-content px-gutter pt-[clamp(40px,5vw,64px)] pb-section-lg">
          <div class="rt-g">
            <div class="ph-gbody rt-g">
              <RichBody pieces={layout.pieces} />
            </div>
            {cta?.label && (
              <div class="col-span-12 mt-8">
                <CtaLink cta={cta} variant="gold" />
              </div>
            )}
          </div>
        </div>
      </>
    ) : (
      <div class="mx-auto max-w-content px-gutter py-section-lg">
        <div
          class:list={[
            'rt-g',
            beside && hasPicture && 'ph-beside',
            hasPicture && `is-${shape}`,
            hasPicture && side === 'left' && 'is-left',
            hasPicture && shape === 'row' && `w${rowWidth}`,
          ]}
        >
          <header class="rt-head">
            {eyebrow && <p class="mb-5 font-ui text-ui text-gold-ink">{eyebrow}</p>}
            {heading && (
              <h2 id={headingId} class:list={[H2_DISPLAY, 'max-w-[22ch] text-foreground']}>
                {heading}
              </h2>
            )}
          </header>

          {shape === 'legend' && hasPicture ? (
            <>
              <figure class="ph-legend">
                <SanityImage
                  source={image}
                  width={2000}
                  sizes="(min-width: 1400px) 1400px, 100vw"
                  quality={78}
                  alt={alt}
                  class="ph-img"
                />
                {legendLabel && (
                  <div class="ph-label font-ui text-ui">
                    <PortableText value={toPt(legendLabel)} variant="bare" />
                  </div>
                )}
                <ol class="ph-names" style={`--n:${legendNames.length}`}>
                  {legendNames.map((nm, k) => (
                    <li>
                      <span class="ph-pos">{k + 1}</span>
                      <PortableText value={toPt(nm)} variant="bare" />
                    </li>
                  ))}
                </ol>
                {legendFoot && (
                  <div class="ph-foot">
                    <PortableText value={toPt(legendFoot)} variant="bare" />
                  </div>
                )}
              </figure>
              <div class="ph-legend-rest rt-g">
                {ledeBlock && (
                  <div class="rt-lede rt-v">
                    <PortableText value={toPt(ledeBlock)} variant="bare" />
                  </div>
                )}
                <RichBody pieces={layout.pieces} />
                {cta?.label && (
                  <div class="col-span-12 mt-8">
                    <CtaLink cta={cta} variant="gold" />
                  </div>
                )}
              </div>
            </>
          ) : (
            <>
              {hasPicture && (
                <div class="ph-fig" data-reveal>
                  {shape === 'window' && !arched ? (
                    <figure class="ph-window-wrap">
                      <Lancet image={image} alt={alt} uid={headingId} />
                    </figure>
                  ) : shape === 'plate' ? (
                    <figure class="ph-plate">
                      <div class="ph-print">
                        <SanityImage
                          source={image}
                          width={1000}
                          sizes="500px"
                          quality={80}
                          alt={alt}
                          class="ph-img"
                        />
                      </div>
                    </figure>
                  ) : arched ? (
                    <div class:list={['it-arches relative', hasDetail && 'has-detail']}>
                      <ArchFrame
                        image={image}
                        shape={lancet ? 'lancet' : 'door'}
                        width={1400}
                        sizes="(min-width: 1024px) 45vw, 100vw"
                        alt={alt}
                        grade="warm"
                        style={`--arch-ratio: ${archRatio}; --arch-mould: var(--color-brown-ink);`}
                      />
                      {hasDetail && (
                        <div class="it-detail">
                          <span class="it-halo arch-lancet" aria-hidden="true" />
                          <ArchFrame
                            image={detail}
                            shape="lancet"
                            width={600}
                            sizes="(min-width: 1024px) 17vw, 38vw"
                            alt={detailAlt}
                            grade="warm"
                            class="relative"
                          />
                        </div>
                      )}
                    </div>
                  ) : shape === 'frame' ? (
                    <figure class="ph-frame">
                      <div class="ph-hung">
                        <SanityImage
                          source={image}
                          width={900}
                          sizes="(min-width: 1024px) 420px, 100vw"
                          quality={78}
                          alt={alt}
                          class="ph-img"
                        />
                      </div>
                    </figure>
                  ) : (
                    <figure
                      class:list={[rowBleed && (side === 'left' ? 'bleed-left' : 'bleed-right')]}
                    >
                      <SanityImage
                        source={image}
                        width={1600}
                        sizes="(min-width: 1024px) 60vw, 100vw"
                        quality={75}
                        alt={alt}
                        class="ph-img"
                      />
                    </figure>
                  )}
                </div>
              )}
              {hasPicture ? (
                <div class="ph-text">
                  {ledeBlock && (
                    <div class="rt-lede rt-v">
                      <PortableText value={toPt(ledeBlock)} variant="bare" />
                    </div>
                  )}
                  {board ? (
                    <>
                      {board.intro.length > 0 && (
                        <PortableText
                          value={board.intro.flatMap((b) => toPt(b))}
                          className="font-body text-body"
                        />
                      )}
                      <ol class="it-rooms">
                        {board.rooms.map((r) => (
                          <li data-reveal>
                            <p class="it-room-no font-display lining-nums">
                              {r.room.split(/\s*&\s*/).map((part, k) => (
                                <>
                                  {k > 0 && <i>&amp;</i>}
                                  {part}
                                </>
                              ))}
                            </p>
                            <div class="min-w-0">
                              <h3 class="it-room-title font-body">{r.title}</h3>
                              {r.blocks.filter((b) => !b.listItem).length > 0 && (
                                <PortableText
                                  value={r.blocks
                                    .filter((b) => !b.listItem)
                                    .flatMap((b) => toPt(b))}
                                  className="it-room-body font-body [&>p+p]:mt-2 [&>p]:my-0"
                                />
                              )}
                              {r.blocks.some((b) => b.listItem) && (
                                <ul class="it-room-list">
                                  {r.blocks
                                    .filter((b) => b.listItem)
                                    .map((b) => (
                                      <li>
                                        <svg
                                          viewBox="-19 -19 38 38"
                                          aria-hidden="true"
                                          focusable="false"
                                          class="building-glyph mt-[.35em] w-3.5 text-gold"
                                        >
                                          <path d={QF} />
                                        </svg>
                                        <span>
                                          {(b.children ?? []).map((c) => c.text).join('')}
                                        </span>
                                      </li>
                                    ))}
                                </ul>
                              )}
                            </div>
                          </li>
                        ))}
                      </ol>
                    </>
                  ) : (
                    <RichBody pieces={layout.pieces} />
                  )}
                  {cta?.label && (
                    <div class="mt-8">
                      <CtaLink cta={cta} variant="gold" />
                    </div>
                  )}
                </div>
              ) : (
                <div class="rt-sub">
                  {ledeBlock && (
                    <div class="rt-lede rt-v">
                      <PortableText value={toPt(ledeBlock)} variant="bare" />
                    </div>
                  )}
                  <RichBody pieces={layout.pieces} />
                  {cta?.label && (
                    <div class="col-span-12 mt-8">
                      <CtaLink cta={cta} variant="gold" />
                    </div>
                  )}
                </div>
              )}
            </>
          )}
        </div>
      </div>
    )
  }
</section>
