---
// Foundation, edit with care
// Renders a page-builder section array. Maps each block _type to its component
// and OWNS the alternating background cadence for content blocks, so reordering
// can never break the page rhythm (that is why blocks have no color field).
// Self-contained blocks (hero, CTA band, stats, spacer) manage their own surface.
//
// Cadence logic lives in src/lib/sectionCadence.ts and is unit-tested separately.
// This file is thin template glue: it imports classified rows and delegates.
//
// The GROQ query that loads `sections` must project images with imageProjection
// and ctaBlocks with ctaProjection (see sectionsProjection() in queries.ts).
import Hero from '@/components/Hero.astro';
import FinalCta from '@/components/FinalCta.astro';
import StatsRow from '@/components/StatsRow.astro';
import SectionDivider from '@/components/SectionDivider.astro';
import RichTextSection from '@/components/sections/RichTextSection.astro';
import ImageText from '@/components/sections/ImageText.astro';
import GalleryGrid from '@/components/sections/GalleryGrid.astro';
import QuoteBlock from '@/components/sections/QuoteBlock.astro';
import VideoEmbed from '@/components/sections/VideoEmbed.astro';
import LogoStrip from '@/components/sections/LogoStrip.astro';
import TeamGrid from '@/components/sections/TeamGrid.astro';
import EmbedSection from '@/components/sections/EmbedSection.astro';
import DynamicList from '@/components/sections/DynamicList.astro';
// scaffold: church
import SundayTimes from '@/components/sections/SundayTimes.astro';
import Timeline from '@/components/sections/Timeline.astro';
import StaffGrid from '@/components/sections/StaffGrid.astro';
import FaqBand from '@/components/sections/FaqBand.astro';
import ScriptureBand from '@/components/sections/ScriptureBand.astro';
import HeritageBand from '@/components/sections/HeritageBand.astro';
import GiveBand from '@/components/sections/GiveBand.astro';
import Hours from '@/components/sections/Hours.astro';
import DocumentList from '@/components/sections/DocumentList.astro';
import LinkCards from '@/components/sections/LinkCards.astro';
import WatchwordBand from '@/components/sections/WatchwordBand.astro';
import PledgeReading from '@/components/sections/PledgeReading.astro';
import PastorsLetter from '@/components/sections/PastorsLetter.astro';
import GoalsBand from '@/components/sections/GoalsBand.astro';
import MinistryGoals from '@/components/sections/MinistryGoals.astro';
import { resolveMinistryBands } from '@/lib/ministry-band';
// scaffold:end
import { classifySections } from '@/lib/sectionCadence';
import { splitStega } from '@/lib/preview-stega';
import { assignSpareImages } from '@/lib/spare-images';
import { assignPhotoShapes, type PhotoRow } from '@/lib/photo-shape';
import type { PageBuilderBlock, RenderedBlock, SectionSiteSettings } from '@/lib/pageBuilder.types';
import { sectionEditAttr, type EditDoc } from '@/lib/preview-edit-attr';
import { sectionAnchor } from '@/lib/anchor';

interface Props {
  sections?: unknown[];
  /** Prefix for generated heading ids, so two renderers on a page do not collide. */
  idPrefix?: string;
  /**
   * PREVIEW ONLY. When the Studio preview route passes the document each
   * section belongs to, every section is wrapped in a real block box carrying a
   * `data-sanity` attribute, which is what gives the Presentation overlay its
   * in-canvas insert / duplicate / remove / drag-to-reorder controls
   * (PORTS.md card 17).
   *
   * The live pages never pass it, and with it absent the wrapper is the same
   * <div> carrying the same anchor id and NOTHING else, so the live markup and
   * the preview markup differ by exactly this one attribute.
   *
   * (Until 2026-09-19 the wrapper was a `<Fragment>` on live renders, which
   * rendered nothing at all. Plan 2b task 1 gave every band a stable anchor id,
   * and an id needs an element to sit on, so the wrapper is now unconditional
   * and `scripts/.parity` baselines captured before that date no longer match.)
   */
  editDoc?: EditDoc;
  /**
   * The siteSettings document the route already fetched for the header and
   * footer. A couple of blocks (the Sunday-times band and the give band) show
   * fields that live in Site settings rather than in the block, and they read
   * this rather than fetching for themselves.
   *
   * That is what keeps the preview honest: `/preview/**` fetches settings with
   * the DRAFT client, so an editor's unpublished change to the giving link or
   * the map shows up in the same render as their change to the block. A block
   * calling the build-time `getSiteSettings()` would read the PUBLISHED
   * document instead, and then hold a memoised copy of it for the Worker
   * isolate's whole life.
   *
   * Absent (the styleguide, a bare render) the blocks fall back to their own
   * `getSiteSettings()` call, so nothing breaks by leaving it off.
   */
  settings?: SectionSiteSettings | null;
}

const { sections = [], idPrefix = 'section', editDoc, settings } = Astro.props as Props;
// A MINISTRY BAND IS RESOLVED FIRST (2026-09-22). A ministrySection only points
// at a ministry document; src/lib/ministry-band.ts swaps it for the exact
// imageTextSection (the ministry has a photo) or richTextSection (it has none)
// it draws as, with the contact lines generated from the people the document
// names. Doing it HERE, before the cadence and the spare-image pool below,
// means both treat it as the band it renders as, so a page that trades a typed
// band for a Ministry band changes nothing else about itself.
let blocks = sections as RenderedBlock[];
// scaffold: church
blocks = resolveMinistryBands(sections as PageBuilderBlock[]);
// scaffold:end
const rows = classifySections<RenderedBlock>(blocks, idPrefix);

// THE SPARE-IMAGE POOL, computed ONCE for the whole page.
//
// Three bands in the art-direction pass show a photograph they do not own (the
// Sunday band's right door is the first of them), and none of them has an image
// field: adding one was ruled out. So the pictures are borrowed from the blocks
// that do carry them, and the sharing has to be decided in one place. Three
// components each scanning for "the first image after me" would hand the SAME
// photograph to two bands on a page that only has one, and no build would say
// so. assignSpareImages() builds the pool in array order and hands each
// consumer the next unused entry; the indexes it returns are ROW indexes, so
// the loop below can ask "is this the block that gets it" rather than
// re-deriving "the first one". Pure and unit-tested in spare-images.test.ts.
//
// A borrowed picture no longer stays in its own block (fix round 1,
// 2026-09-21): home showed the nave full-bleed behind the statement and again
// at nearly the same crop in the image-and-text band two screens earlier. So
// assignSpareImages also returns `replacements`, a row index -> the picture
// that row should draw INSTEAD of its own (or null for no figure at all), and
// the ImageText call below asks it before reading the block's own image.
const spares = assignSpareImages(rows.map(({ block }) => block as unknown as { _type: string }));

// PHOTO SHAPES (2026-09-22). The picture decides the band: see
// src/lib/photo-shape.ts. The pass runs on the picture each ImageText row will
// ACTUALLY render (after the spare-image swap above), because a borrowed
// picture changes the shape. It is page-level so there is at most one lancet
// window and at most two grounds per page.
const heroHasPhoto = rows.some(({ block }) => {
  const b = block as { _type?: string; frames?: unknown[]; backgroundImage?: unknown };
  return (
    b._type === 'heroSection' &&
    ((Array.isArray(b.frames) && b.frames.length > 0) || !!b.backgroundImage)
  );
});
const renderedImage = (block: unknown, index: number) =>
  spares.replacements.has(index)
    ? spares.replacements.get(index)
    : (block as { image?: unknown }).image;
const photoShapes = assignPhotoShapes(
  rows.map(
    ({ block }, i) => ({ ...(block as object), image: renderedImage(block, i) }) as PhotoRow,
  ),
  { heroHasPhoto },
);

// The section wrapper. It is a real block-level element on EVERY render now,
// live and preview alike, because it carries the anchor id (2026-09-19, plan 2b
// task 1). It must NOT be `display: contents`: the overlay outlines the
// element's rect, and a contents element has none. A plain block-level div
// around a full-width <section> changes no layout.
//
// The only preview-only thing left on it is `data-sanity`, which is what gives
// the Presentation overlay its in-canvas insert / duplicate / remove /
// drag-to-reorder controls (PORTS.md card 17). Nothing else goes on this
// element: the live markup should differ from the preview markup by that one
// attribute and no more.
const Wrap = 'div';

// ANCHOR IDS. Every band gets one so a link can reach it:
//   - the editor's `anchor` slug when they set one (that is the stable name a
//     redirect or a printed bulletin points at: /beliefs#baptists),
//   - otherwise `<headingId>-band`, which is positional and good enough for a
//     link written the same day.
//
// The fallback is deliberately NOT `headingId` itself. `headingId` is already
// on the <h2> inside the section, and the section's own landmark points at it
// with aria-labelledby, so reusing it here would put two elements with the same
// id in the document and break that reference (axe's duplicate-id-aria).
//
// Collisions are resolved rather than allowed: two bands whose editors typed
// the same anchor would otherwise both answer to it and the browser would pick
// the first, silently. The second one gets `-2`, the third `-3`, and so on.
const usedAnchors = new Set<string>();
const uniqueAnchor = (block: unknown, headingId: string): string => {
  const base = sectionAnchor(
    block as { anchor?: { current?: string | null } | null },
    `${headingId}-band`,
  );
  let id = base;
  let n = 1;
  while (usedAnchors.has(id)) {
    n += 1;
    id = `${base}-${n}`;
  }
  usedAnchors.add(id);
  return id;
};

// A page that OPENS on a band rather than a hero has no other h1, so that
// band carries the page's h1; everywhere else it is an h2, like every other
// band. /history opens on the brown heritageBandSection and /give opens on
// the indigo giveBandSection; both read this the same way. Without it the
// page has no h1 at all: axe reports page-has-heading-one and a screen reader
// is handed a page with no title.
//
// THE PROMOTION IS CONDITIONAL ON THERE BEING NO HERO (2026-09-20). Block
// index 0 used to be promoted unconditionally, so a page whose first block was
// a band AND which also carried a heroSection further down would emit two h1s,
// which is the opposite failure and the one axe does not always name clearly.
// None of the eleven pages is built that way today, which is exactly why the
// guard belongs here rather than in a reviewer's memory: the arrangement is
// one drag in the Studio away.
const hasHero = rows.some(({ block }) => (block as { _type?: string })._type === 'heroSection');
const openingLevel = (index: number): 'h1' | 'h2' => (index === 0 && !hasHero ? 'h1' : 'h2');

// NO HAIRLINE UNDER A FULL-BLEED PHOTOGRAPH (art-direction pass, task 8).
//
// A divider is drawn between two content blocks whose surfaces differ, which is
// the right rule for two bands of paper. The statement band is neither: when it
// has a borrowed photograph it is a dark picture running edge to edge, and the
// cadence still counts it as a content block, so the block after it would open
// with a stray rule floating on the paper an inch below the photograph. The
// divider is suppressed for exactly that one position. Without a frame the
// statement is an ordinary light band and nothing changes.
const afterFullBleed = (index: number): boolean =>
  (spares.statementIndex !== null && index === spares.statementIndex + 1) ||
  // The goal index is a deep indigo band edge to edge, so the same stray rule
  // would sit an inch under it (2026-09-24, the Ministries identity pass).
  (rows[index - 1]?.block as { _type?: string } | undefined)?._type === 'ministryGoalsIndex';

// THE HERO'S FIRST FRAME, by asset ref, or null when the page has no hero.
//
// HeritageBand's detail strip drops the band's own photograph when it is this
// one: the first frame is the LCP image, the one picture a visitor has
// certainly seen, and showing it again two screens down at a different crop
// reads as a mistake. The comparison is done in the band (it also has to know
// whether dropping would empty the strip); this is only the lookup, and it is
// null-safe on both sides because a projection that carries no ref must never
// compare equal to one that does.
const heroBlock = rows.find(({ block }) => (block as { _type?: string })._type === 'heroSection')
  ?.block as { frames?: unknown[]; backgroundImage?: unknown } | undefined;
const heroFirstFrame = (() => {
  const frames = Array.isArray(heroBlock?.frames) ? heroBlock.frames : [];
  return frames.length > 0 ? frames[0] : heroBlock?.backgroundImage;
})();
const heroFirstRef: string | null =
  ((heroFirstFrame as { asset?: { _ref?: string; _id?: string } } | undefined)?.asset?._ref ??
    (heroFirstFrame as { asset?: { _ref?: string; _id?: string } } | undefined)?.asset?._id) ||
  null;

// THE HERITAGE BAND'S NUMERALS, DERIVED (CLAUDE.md rule 15).
//
// The brown band shows up to three dated numerals, and nothing stores them:
// they are the FIRST timeline block's first row, its middle row and its last,
// so the numerals and the timeline on the same page cannot drift apart. The
// strings are cleaned through splitStega BEFORE they are trimmed or compared,
// because the stega payload is written in characters that a regex counts as
// whitespace (CLAUDE.md, the preview rules).
const timelineRows = (() => {
  const block = rows.find(({ block: b }) => (b as { _type?: string })._type === 'timelineSection')
    ?.block as { rows?: unknown[] } | undefined;
  return Array.isArray(block?.rows) ? block.rows : [];
})();
const heritageYears = (() => {
  if (timelineRows.length === 0) return [];
  // First, middle, last. Deduped by index, so a timeline of one or two rows
  // yields one or two numerals rather than the same row twice.
  const picks = [0, Math.floor((timelineRows.length - 1) / 2), timelineRows.length - 1];
  const seen = new Set<number>();
  const out: { year: string; label: string }[] = [];
  for (const i of picks) {
    if (seen.has(i)) continue;
    seen.add(i);
    const row = timelineRows[i] as { marker?: unknown; title?: unknown };
    const year = typeof row?.marker === 'string' ? splitStega(row.marker).cleaned.trim() : '';
    const label = typeof row?.title === 'string' ? splitStega(row.title).cleaned.trim() : '';
    if (year) out.push({ year, label });
  }
  return out;
})();

// THE GIVE BAND IS GOLD ON EVERY PAGE (2026-09-23, the Home identity pass).
// It used to ask whether the row above it was dark (an `isDarkBand` walk over
// the rows) and paint indigo or soft paper to suit. Gold is a light, fixed
// ground that sits beside every band on the site, so nothing asks any more.

const wrapAttrs = (key: string | undefined) =>
  editDoc && key ? { 'data-sanity': sectionEditAttr(editDoc, key) } : {};
---

{
  rows.map(({ block: s, surface, insertDividerBefore, headingId }, blockIndex) => (
    <>
      {insertDividerBefore && !afterFullBleed(blockIndex) && <SectionDivider />}

      <Wrap
        id={uniqueAnchor(s, headingId)}
        class="scroll-mt-[var(--header-offset)]"
        {...wrapAttrs((s as { _key?: string })._key)}
      >
        {s._type === 'heroSection' ? (
          <Hero
            eyebrow={s.eyebrow}
            headline={s.headline ?? ''}
            subhead={s.subhead}
            backgroundImage={s.backgroundImage}
            backgroundImages={s.frames}
            layout={s.layout}
            facts={s.facts}
            primaryCta={s.primaryCta}
            secondaryCta={s.secondaryCta}
            size={s.size ?? 'short'}
            serviceTime={settings?.serviceTime}
            dropInto={['watchwordSection', 'timelineSection'].includes(
              (rows[blockIndex + 1]?.block as { _type?: string } | undefined)?._type ?? '',
            )}
            headingAccent={s.headingAccent ?? undefined}
            headingId={headingId}
          />
        ) : s._type === 'ctaBandSection' ? (
          <FinalCta
            eyebrow={s.eyebrow}
            headline={s.headline}
            subhead={s.subhead}
            subheadRich={s.subheadRich}
            cta={s.cta}
            secondaryCta={s.secondaryCta}
            scriptAccent={s.scriptAccent}
            headingAccent={s.headingAccent}
            backgroundImage={s.backgroundImage}
            headingId={headingId}
          />
        ) : s._type === 'statSection' ? (
          <StatsRow
            stats={
              (s.stats ?? []).filter((x) => typeof x?.number === 'number') as {
                number: number;
                suffix?: string;
                label: string;
              }[]
            }
          />
        ) : s._type === 'spacerSection' ? (
          s.variant === 'space' ? (
            <div class="py-section-md" aria-hidden="true" />
          ) : (
            <SectionDivider variant={s.variant === 'line' ? 'line' : 'ornament'} />
          )
        ) : s._type === 'richTextSection' ? (
          <RichTextSection
            eyebrow={s.eyebrow}
            heading={s.heading}
            scriptAccent={s.scriptAccent}
            headingAccent={s.headingAccent}
            body={s.body}
            width={s.width}
            align={s.align}
            surface={surface ?? 'background'}
            headingId={headingId}
          />
        ) : s._type === 'imageTextSection' ? (
          <ImageText
            image={renderedImage(s, blockIndex)}
            detail={s.detail}
            imageSide={s.imageSide}
            eyebrow={s.eyebrow}
            heading={s.heading}
            body={s.body}
            cta={s.cta}
            shape={photoShapes.get(blockIndex) ?? 'row'}
            surface={surface ?? 'background'}
            headingId={headingId}
          />
        ) : s._type === 'gallerySection' ? (
          <GalleryGrid
            heading={s.heading}
            images={s.images}
            columns={s.columns}
            surface={surface ?? 'background'}
            headingId={headingId}
          />
        ) : s._type === 'quoteSection' ? (
          <QuoteBlock
            quote={s.quote}
            attribution={s.attribution}
            detail={s.detail}
            surface={surface ?? 'background'}
          />
        ) : s._type === 'videoSection' ? (
          <VideoEmbed
            url={s.url}
            heading={s.heading}
            caption={s.caption}
            surface={surface ?? 'background'}
            headingId={headingId}
          />
        ) : s._type === 'logoStripSection' ? (
          <LogoStrip
            eyebrow={s.eyebrow}
            headline={s.headline}
            logos={s.logos ?? []}
            layout={s.layout ?? 'row'}
            headingId={headingId}
          />
        ) : s._type === 'teamSection' ? (
          <TeamGrid
            eyebrow={s.eyebrow}
            headline={s.headline}
            subhead={s.subhead}
            subheadRich={s.subheadRich}
            members={s.members ?? []}
            headingId={headingId}
          />
        ) : s._type === 'embedSection' ? (
          <EmbedSection
            eyebrow={s.eyebrow}
            headline={s.headline}
            subhead={s.subhead}
            embedUrl={s.embedUrl}
            embedCode={s.embedCode}
            heightHint={s.heightHint ?? 'medium'}
            headingId={headingId}
          />
        ) : /* scaffold-branch: church */ s._type === 'sundayTimesSection' ? (
          <SundayTimes
            eyebrow={s.eyebrow}
            heading={s.heading}
            intro={s.intro}
            items={s.items ?? []}
            notes={s.notes ?? []}
            photos={s.photos ?? []}
            cta={s.cta}
            doors={s.doors ?? []}
            showMap={s.showMap}
            frame={blockIndex === spares.doorIndex ? spares.door : null}
            headingId={headingId}
            settings={settings}
          />
        ) : /* scaffold-branch: church */ s._type === 'timelineSection' ? (
          <Timeline
            eyebrow={s.eyebrow}
            heading={s.heading}
            rows={s.rows ?? []}
            surface={surface ?? 'background'}
            serviceTime={settings?.serviceTime}
            headingId={headingId}
          />
        ) : /* scaffold-branch: church */ s._type === 'staffGridSection' ? (
          <StaffGrid
            eyebrow={s.eyebrow}
            heading={s.heading}
            intro={s.intro}
            group={s.group}
            showBios={s.showBios}
            members={s.members ?? []}
            surface={surface ?? 'background'}
            headingId={headingId}
          />
        ) : /* scaffold-branch: church */ s._type === 'faqSection' ? (
          <FaqBand
            eyebrow={s.eyebrow}
            heading={s.heading}
            items={s.items ?? []}
            headingId={headingId}
          />
        ) : /* scaffold-branch: church */ s._type === 'scriptureBandSection' ? (
          <ScriptureBand
            heading={s.heading}
            verse={s.verse}
            reference={s.reference}
            accentWord={s.accentWord}
            intro={s.intro}
            headingId={headingId}
          />
        ) : /* scaffold-branch: church */ s._type === 'heritageBandSection' ? (
          <HeritageBand
            eyebrow={s.eyebrow}
            heading={s.heading}
            body={s.body}
            image={s.image}
            archive={s.archive}
            dates={s.dates}
            cta={s.cta}
            extraImages={spares.strip.slice(0, 2)}
            heroFirstRef={heroFirstRef}
            years={heritageYears}
            level={openingLevel(blockIndex)}
            headingId={headingId}
          />
        ) : /* scaffold-branch: church */ s._type === 'giveBandSection' ? (
          <GiveBand
            heading={s.heading}
            body={s.body}
            buttonLabel={s.buttonLabel}
            buttonUrl={s.buttonUrl}
            level={openingLevel(blockIndex)}
            headingId={headingId}
            settings={settings}
          />
        ) : /* scaffold-branch: church */ s._type === 'hoursSection' ? (
          <Hours
            eyebrow={s.eyebrow}
            heading={s.heading}
            surface={surface ?? 'background'}
            headingId={headingId}
            settings={settings}
          />
        ) : /* scaffold-branch: church */ s._type === 'documentListSection' ? (
          <DocumentList
            eyebrow={s.eyebrow}
            heading={s.heading}
            docs={s.docs ?? []}
            surface={surface ?? 'background'}
            headingId={headingId}
          />
        ) : /* scaffold-branch: church */ s._type === 'linkCardsSection' ? (
          <LinkCards
            eyebrow={s.eyebrow}
            heading={s.heading}
            intro={s.intro}
            cards={s.cards ?? []}
            surface={surface ?? 'background'}
            frame={blockIndex === spares.statementIndex ? spares.statement : null}
            headingId={headingId}
          />
        ) : /* scaffold-branch: church */ s._type === 'watchwordSection' ? (
          <WatchwordBand block={s} headingId={headingId} />
        ) : /* scaffold-branch: church */ s._type === 'ministryGoalsIndex' ? (
          <MinistryGoals goals={s.goals} headingId={headingId} />
        ) : /* scaffold-branch: church */ s._type === 'pledgeSection' ? (
          <PledgeReading block={s} headingId={headingId} />
        ) : /* scaffold-branch: church */ s._type === 'letterSection' ? (
          <PastorsLetter block={s} headingId={headingId} settings={settings} />
        ) : /* scaffold-branch: church */ s._type === 'goalsSection' ? (
          <GoalsBand block={s} headingId={headingId} />
        ) : s._type === 'dynamicListSection' ? (
          <DynamicList
            eyebrow={s.eyebrow}
            headline={s.headline}
            subhead={s.subhead}
            subheadRich={s.subheadRich}
            source={s.source}
            items={s.items ?? []}
            limit={s.limit}
            cta={s.cta}
            columns={s.columns}
            headingId={headingId}
          />
        ) : (
          // Unknown block type: render nothing, log in dev.
          import.meta.env.DEV &&
          console.warn(
            // `s` is `never` here: every member of PageBuilderBlock is handled
            // above, which is exactly what this branch exists to prove. The cast
            // is only so the runtime warning can name the type Sanity actually
            // sent when a NEW block ships without a mapping. Written as a
            // Record rather than an inline object type on purpose: a brace
            // inside an .astro template expression ends that expression, even
            // inside a comment, so an inline object type breaks the parse.
            `[SectionRenderer] Unknown block type: "${(s as Record<string, unknown>)._type}". Add a mapping in SectionRenderer.astro.`,
          )
        )}
      </Wrap>
    </>
  ))
}
