---
// Safe to edit by hand
// A hairline between two sections that share a background colour and need a
// visual break. Most transitions do not need it: the alternating paper /
// bg-soft cadence is usually enough on its own.
//
// 2026-09-20 (plan 3, task 2): the sun glyph, the accent dot and the three
// dots are gone. The art-direction pass draws every division on this site with
// the same hairline, so a divider is a RULE, not an ornament, and it sits
// inside the page container on the shared left edge rather than floating in
// the middle of the band (CLAUDE.md rule 17, one grammar per page).
//
// `variant` is still accepted and ignored so the existing callers compile.

interface Props {
  /** Accepted and ignored since 2026-09-20. Every divider is the hairline. */
  variant?: 'ornament' | 'line' | 'dots';
  /** Override the default fluid vertical padding. */
  class?: string;
}

const { class: extraClass = '' } = Astro.props as Props;
---

<div class:list={['mx-auto max-w-content px-gutter', extraClass]} aria-hidden="true">
  <hr class="border-0 border-t border-hair" />
</div>
