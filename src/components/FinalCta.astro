---
// Safe to edit by hand
// The full-bleed call-to-action section that closes every interior page (and the home page).
// Redrawn for the art-direction pass (2026-09-21, spec section 5): the indigo
// field, the headline in the titling capitals at --text-h1 held to 16ch so it
// breaks as a poster line, the subhead as a lede, and the gold button.
// It punctuates the read and points at the next step, which for this church is
// planning a first visit.
//
// THREE ORNAMENTS CAME OFF IT. The 2px bronze stripe across the top, the cream
// hairline under the eyebrow, and the centred axis. The first two were the
// starter's brand signature drawn on every band (the same rule SectionHeading
// retired on 2026-09-20), and the stripe was navy-on-indigo here, which is an
// ornament nobody can see. The third is CLAUDE.md rule 17: one left edge per
// page, and this band was the only thing on an interior page running down the
// middle.
//
// THE GOLD CLOSING BAND (2026-09-24, the Visit identity pass; the prototype's
// `.cta`, docs/superpowers/prototypes/2026-09-23-visit/visit.html; rollout
// plan "CtaBand: brand band, rule buttons, one glyph"). The band is the brand
// gold in both themes (like the Give band), so it carries no colour field and
// its ink is --color-band-ink, which never flips. One building glyph, the
// door, stands at its left: an open door for the page's last invitation. The
// headline is in the one band grammar (H2_DISPLAY, CLAUDE.md rule 17), and
// the buttons are the one family's outline plate and a text link, both drawn
// in band ink because a gold button on the gold band would vanish. A band
// with a background photo keeps the old indigo panel with its scrim: the gold
// cannot sit under a photograph.
//
// scriptAccent: optional single word/phrase from the headline to render in handwritten
// the script accent font via the `.font-script` utility. Inherits the heading color (text-bg) so
// it reads correctly on the Charcoal Dark surface in both light and dark theme.
// Falls back silently when undefined, blank, or not found. No existing CTA is affected.

import CtaLink from '@/components/CtaLink.astro';
import SanityImage from '@/components/SanityImage.astro';
import { splitHeadingAccent } from '@/lib/heading-accent';
import { hasInlineRich } from '@/lib/inline-rich';
import InlineRich from '@/components/InlineRich.astro';
import type { SanityImageObject } from '@/lib/pageBuilder.types';
import BuildingGlyph from '@/components/church/BuildingGlyph.astro';
import { H2_DISPLAY } from '@/lib/heading-grammar';

interface CtaBlock {
  label?: string;
  linkType?: 'internal' | 'external' | 'email' | 'phone';
  internalLink?: { _type?: string; slug?: string } | null;
  externalUrl?: string;
  emailAddress?: string;
  phoneNumber?: string;
  openInNewTab?: boolean;
}

interface Props {
  /** Optional eyebrow label above the headline (e.g., "Ready to Begin?"). */
  eyebrow?: string;
  headline?: string;
  subhead?: string;
  cta?: CtaBlock | null;
  /** Optional secondary CTA rendered as an outlined inverse button next to the primary. */
  secondaryCta?: CtaBlock | null;
  /** Override the default heading id (defaults to "final-cta"). */
  headingId?: string;
  /**
   * Fallback CTA label and href when the block resolves no CTA of its own.
   *
   * These defaults SHIP: the band renders whenever a ctaBandSection has no cta
   * set, which is every page singleton in an unseeded dataset. The starter's
   * "Book a Consultation" -> /contact sat here until 2026-09-19 (CLAUDE.md rule
   * 11: correct code carrying the wrong noun). A Sanity cta still overrides
   * both.
   */
  fallbackCtaLabel?: string;
  fallbackCtaHref?: string;
  /**
   * Optional single word/phrase from the headline to render in handwritten
   * the script accent font. Matched case-insensitively against the headline,
   * first occurrence only. Leave
   * blank to skip. Use sparingly, one accent per heading. The script word
   * inherits the heading color (text-bg / cream) so contrast is correct on
   * the Charcoal Dark surface in both themes.
   */
  scriptAccent?: string;
  /**
   * The COLOUR sibling of the script accent (PORTS.md card 26). One word from
   * the headline, set in the section accent. Skipped when a script accent is
   * already in play: one accent per heading. On this panel the accent is pinned
   * by `.bg-indigo-field` in globals.css, because the band is the same indigo
   * whatever theme the reader is in.
   */
  headingAccent?: string;
  /** Optional rich twin of `subhead`: bold and italic only. */
  subheadRich?: unknown;
  /**
   * Optional decorative background photo. When set, it fills the panel behind a
   * fixed charcoal scrim that keeps the cream headline and bronze button
   * readable. When absent, the panel renders as the solid Charcoal Dark surface,
   * exactly as before. The shape matches what SanityImage accepts.
   */
  backgroundImage?: SanityImageObject | null;
}

const {
  eyebrow,
  headline = 'Come and see',
  // NO DEFAULT SUBHEAD (plan 2b ruling P14, 2026-09-19). The band used to
  // invent "Plan a visit, or send us a note and we will answer." whenever a
  // page left the field blank, which put a sentence nobody wrote onto the
  // bottom of the page. A band with no subhead now renders without one.
  subhead,
  cta,
  secondaryCta,
  headingId = 'final-cta',
  fallbackCtaLabel = 'Plan your visit',
  fallbackCtaHref = '/visit',
  scriptAccent,
  headingAccent,
  subheadRich,
  backgroundImage,
} = Astro.props as Props;

// Only treat the background as present when a real asset is attached, so an
// empty image object never flips on the overlay path.
const hasBackground = !!backgroundImage?.asset;

// Split the headline around the script-accent word when provided. Both accent
// devices go through splitHeadingAccent: same matching, same stega handling,
// only the class on the wrapping span differs.
const {
  found: scriptFound,
  before: scriptBefore,
  word: scriptWord,
  after: scriptAfter,
} = splitHeadingAccent(headline, scriptAccent);

// The colour accent, only considered when the script accent did not fire.
const colour = scriptFound
  ? { found: false, before: '', word: '', after: '', heading: headline }
  : splitHeadingAccent(headline, headingAccent);

const richSubhead = hasInlineRich(subheadRich);
---

{
  hasBackground ? (
    <section class="relative overflow-hidden bg-indigo-field text-bg" aria-labelledby={headingId}>
      <div class="absolute inset-0 z-0" aria-hidden="true">
        <SanityImage
          source={backgroundImage}
          width={1920}
          sizes="100vw"
          loading="lazy"
          alt=""
          class="h-full w-full object-cover"
        />
        <div class="absolute inset-0 bg-indigo-field/70" />
      </div>
      <div class="relative z-10 mx-auto max-w-content px-gutter py-section-lg">
        {eyebrow && <p class="mb-5 font-ui text-ui text-gold">{eyebrow}</p>}
        <h2 id={headingId} class:list={[H2_DISPLAY, 'max-w-[18ch] text-bg']}>
          {scriptFound ? (
            <>
              {scriptBefore}
              <span class="font-script">{scriptWord}</span>
              {scriptAfter}
            </>
          ) : colour.found ? (
            <>
              {colour.before}
              <span class="heading-accent">{colour.word}</span>
              {colour.after}
            </>
          ) : (
            headline
          )}
        </h2>
        {(subhead || richSubhead) && (
          <p class="mt-6 max-w-[46ch] font-body text-lede font-normal text-bg/85">
            {richSubhead ? <InlineRich value={subheadRich} /> : subhead}
          </p>
        )}
        <div class="mt-10 flex flex-wrap items-center gap-x-9 gap-y-5">
          <CtaLink
            cta={cta}
            variant="gold"
            onDark
            fallbackHref={fallbackCtaHref}
            fallbackLabel={fallbackCtaLabel}
          />
          {secondaryCta && <CtaLink cta={secondaryCta} variant="link" onDark />}
        </div>
      </div>
    </section>
  ) : (
    <section class="bg-band-gold text-band-ink" aria-labelledby={headingId}>
      <div class="cta-grid mx-auto grid max-w-content items-center px-gutter py-[clamp(64px,7vw,110px)]">
        <BuildingGlyph name="door" class="cta-glyph text-band-ink" />
        <div class="min-w-0">
          {eyebrow && <p class="mb-3 font-ui text-ui font-semibold text-band-ink">{eyebrow}</p>}
          <h2 id={headingId} class:list={[H2_DISPLAY, 'text-band-ink']}>
            {scriptFound ? (
              <>
                {scriptBefore}
                <span class="font-script">{scriptWord}</span>
                {scriptAfter}
              </>
            ) : colour.found ? (
              <>
                {colour.before}
                <span class="underline decoration-2 underline-offset-[0.12em]">{colour.word}</span>
                {colour.after}
              </>
            ) : (
              headline
            )}
          </h2>
          {(subhead || richSubhead) && (
            <p class="mt-2.5 max-w-[46ch] font-body text-[clamp(1.25rem,1.1rem+.5vw,1.5rem)] leading-[1.45] text-band-ink">
              {richSubhead ? <InlineRich value={subheadRich} /> : subhead}
            </p>
          )}
        </div>
        <div class="cta-act flex flex-wrap items-center gap-x-7 gap-y-3.5">
          <CtaLink
            cta={cta}
            variant="outline"
            onGold
            fallbackHref={fallbackCtaHref}
            fallbackLabel={fallbackCtaLabel}
          />
          {secondaryCta && <CtaLink cta={secondaryCta} variant="link" onGold />}
        </div>
      </div>
    </section>
  )
}
