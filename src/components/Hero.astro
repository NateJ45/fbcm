---
// Safe to edit by hand
// Page hero. Three shapes:
//   1) "image, full" hero (home, optionally Process/Services if a hero photo is added)
//      — full-bleed Sanity background image with a dark scrim, h1 + subhead + CTAs overlay.
//   2) "image, split" hero (layout="split", Task 7) — cream two-column band:
//      words on the left (eyebrow, headline, subhead, facts, buttons), the
//      first photo on the right with a gold left rule. 7:5 columns at lg,
//      stacked with the photo first on mobile.
//   3) "text" hero (About, Contact, FAQ, Process by default)
//      — clean editorial heading on Soft Linen with eyebrow + headline + subhead.
//
// The image hero is the LCP element on the homepage. SanityImage is set to loading="eager"
// in that case and the headline uses font-display (Cormorant Garamond), which BaseLayout
// preloads inline. Don't add layout-shift animations to this section.

import HeroBackground from '@/components/HeroBackground.astro';
import SanityImage from '@/components/SanityImage.astro';
import CtaLink from '@/components/CtaLink.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { splitHeadingAccent } from '@/lib/heading-accent';
import { ChevronDown } from 'lucide-react';

interface CtaBlock {
  label?: string;
  linkType?: 'internal' | 'external' | 'email' | 'phone';
  internalLink?: { _type?: string; slug?: string } | null;
  externalUrl?: string;
  emailAddress?: string;
  phoneNumber?: string;
  openInNewTab?: boolean;
}

import type { SanityImageObject } from '@/lib/pageBuilder.types';

/** One fact under the hero words (Task 7): a short label/value pair like
    "Sundays" / "10:45 am". Up to three, schema-capped. */
interface HeroFact {
  _key?: string;
  label?: string;
  value?: string;
}

interface Props {
  eyebrow?: string;
  headline: string;
  subhead?: string;
  backgroundImage?: SanityImageObject | null;
  /** Optional list of hero images. 2+ render a cross-fading slideshow; 1 (or
      falling back to backgroundImage) renders a single static image. */
  backgroundImages?: SanityImageObject[] | null;
  /**
   * "full" (default when unset) = photo behind the words, full-bleed, as the
   * hero always rendered. "split" = cream two-column band, words left, first
   * photo right. Only meaningful when an image is present.
   */
  layout?: 'full' | 'split';
  /** Up to three short facts (when, where, online) shown under the subhead. */
  facts?: HeroFact[] | null;
  primaryCta?: CtaBlock | null;
  secondaryCta?: CtaBlock | null;
  headingId: string;
  /** "tall" = fills the viewport below the header on first load (homepage), "short" = generous but not full screen (interior pages). */
  size?: 'tall' | 'short';
  /**
   * Optional list of words to cycle through in place of the FIRST word of the
   * headline. Animates once on first visit per session, then locks back to
   * the original. Honors prefers-reduced-motion. Pass undefined to skip.
   */
  rotatingWords?: string[];
  /**
   * Optional single word/phrase in the headline to render in script
   * (the script accent font). One per hero — the editorial-signature flourish.
   * The first occurrence in the headline string is wrapped. If the word
   * isn't found, the headline renders unchanged.
   *
   * Don't combine with `rotatingWords` — they may target the same first
   * word; pick one effect per hero. If both are passed, rotatingWords wins.
   *
   * heroSection (the page-builder block) no longer offers this field (Task 7
   * dropped it from that schema); it is kept here because the singleton hero
   * fields on other pages (blog index, contact, the preview route) still pass
   * their own scriptAccent value through to this component.
   */
  scriptAccent?: string;
}

const {
  eyebrow,
  headline,
  subhead,
  backgroundImage,
  backgroundImages,
  layout = 'full',
  facts,
  primaryCta,
  secondaryCta,
  headingId,
  size = 'short',
  rotatingWords,
  scriptAccent,
} = Astro.props as Props;

const heroFacts = (facts ?? []).filter((f) => f?.label || f?.value).slice(0, 3);

// Split the headline into a first word + the rest, so the rotator can swap
// the first word in place without touching the rest of the line. Matches
// alphanumerics + apostrophes; falls back to the whole headline if the regex
// doesn't catch (e.g., headline starts with punctuation).
const rotateEnabled = Array.isArray(rotatingWords) && rotatingWords.length > 1;
const firstWordMatch = rotateEnabled ? headline.match(/^([\w'’]+)(.*)$/s) : null;
const headlineFirst = firstWordMatch ? firstWordMatch[1] : headline;
const headlineRest = firstWordMatch ? firstWordMatch[2] : '';
const rotatingPayload = rotateEnabled ? JSON.stringify([headlineFirst, ...rotatingWords!]) : '';

// Script accent: split the headline around the accent word so it can be
// rendered in three pieces (before / accent-span / after). Only fires when
// rotatingWords isn't active — the two flourishes shouldn't compete.
// Delegates to the shared splitHeadingAccent helper so Hero, SectionHeading and
// FinalCta use identical logic.
//
// The headline argument used to read `rotateEnabled ? headline : headline`,
// which is the same value on both branches and so did nothing. Only the ACCENT
// is conditional, and always was: when the rotator owns the first word there is
// no accent to apply, so the accent argument goes undefined and the helper
// returns found:false. Simplified to say exactly that.
const {
  found: scriptFound,
  before: scriptBefore,
  word: scriptWord,
  after: scriptAfter,
} = splitHeadingAccent(headline, rotateEnabled ? undefined : scriptAccent);

// Subhead emphasis: parse markdown-style _word_ markers into <em> spans so
// editors can italicize a key word in the Sanity subhead without HTML.
// Example: "Pick the tier that fits _where you are_." → italic on "where you are".
// Falls back to plain text when no markers are present.
function parseSubhead(s?: string): Array<{ type: 'text' | 'em'; value: string }> {
  if (!s) return [];
  const parts = s.split(/(_[^_]+_)/g);
  return parts.map((part) =>
    part.startsWith('_') && part.endsWith('_') && part.length > 2
      ? { type: 'em' as const, value: part.slice(1, -1) }
      : { type: 'text' as const, value: part },
  );
}
const subheadParts = parseSubhead(subhead);

// Prefer the slideshow array; fall back to the single backgroundImage so every
// other page (which only passes backgroundImage) is unaffected.
const heroImageList = (Array.isArray(backgroundImages) ? backgroundImages : []).filter(
  (img) => !!img?.asset,
);
const effectiveImages = heroImageList.length > 0
  ? heroImageList
  : (backgroundImage?.asset ? [backgroundImage] : []);
const hasImage = effectiveImages.length > 0;

// SPLIT-LAYOUT FRAME CROP (2026-09-20, final review of plan 2b).
//
// The split hero's frame is `object-cover` inside a tall column, so the browser
// crops the photograph. Its default is object-position: 50% 50%, dead centre,
// which on a group photograph taken from adult eye height takes the crop
// through everyone's faces: on /visit the children in the arch frame lost the
// tops of their heads.
//
// Two rules, in order.
//   1. An editor's HOTSPOT wins. Sanity stores it as fractions of the image's
//      width and height, which is exactly what object-position takes as
//      percentages, so the point the editor picked in the Studio is the point
//      that stays in frame at every viewport.
//   2. With no hotspot, the default is the TOP of the image rather than its
//      middle. Faces sit above centre in almost every photograph a church
//      takes, and a top crop keeps them whole. It is a better default, not a
//      substitute for the hotspot.
//
// Only the split layout does this. The full-bleed hero is a background behind
// text and is handled by HeroBackground.astro.
const splitFrame = effectiveImages[0];
const splitHotspot = splitFrame?.hotspot;
const splitObjectPosition =
  typeof splitHotspot?.x === 'number' && typeof splitHotspot?.y === 'number'
    ? `${(splitHotspot.x * 100).toFixed(2)}% ${(splitHotspot.y * 100).toFixed(2)}%`
    : '50% 0%';

// "tall" (homepage) fills the screen below the sticky header on first load.
// The exact fill height comes from the .hero-fill class plus the measured
// --header-h variable (see the inline script and scoped <style> below).
// "short" stays a generous editorial band for interior pages.
const wrapperHeight =
  size === 'tall'
    ? 'hero-fill'
    : 'min-h-[42svh] md:min-h-[52svh]';
---

{/* Home hero scroll cue (size="tall" only): glide past the hero to the band
    below it. --header-h, which this reads to know where the hero ends, is
    measured and published by the inline script in BaseLayout, right after the
    header, so it is set on every page rather than only on this one. */}
{size === 'tall' && (
  <script is:inline>
    (function () {
      function wireCue() {
        var cue = document.querySelector('[data-scroll-cue]');
        if (!cue || cue.dataset.wired === '1') return;
        cue.dataset.wired = '1';
        cue.addEventListener('click', function () {
          var hero = cue.closest('section');
          if (!hero) return;
          var hh = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-h')) || 0;
          var top = hero.offsetTop + hero.offsetHeight - hh;
          if (window.lenis && typeof window.lenis.scrollTo === 'function') {
            window.lenis.scrollTo(top);
          } else {
            window.scrollTo({ top: top, behavior: 'smooth' });
          }
        });
      }
      wireCue();
      if (!window.__heroLayoutBound) {
        window.__heroLayoutBound = true;
        document.addEventListener('astro:page-load', wireCue);
      }
    })();
  </script>
)}

{/* Rotating-word animator. Runs once per session: cycles the wrapped word
    through alternates every 850ms for ~5 seconds, then locks back to the
    original. Skipped under prefers-reduced-motion or when sessionStorage
    already holds the seen flag. Inline + idempotent so View Transitions
    don't re-trigger on every navigation. */}
{rotateEnabled && (
  <script is:inline>
    (function () {
      try {
        if (sessionStorage.getItem('hero-word-rotated') === '1') return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      } catch (_) { /* ignore */ }

      function init() {
        const el = document.querySelector('[data-rotating-word]');
        if (!el || el.dataset.rotated === '1') return;
        el.dataset.rotated = '1';
        let words;
        try { words = JSON.parse(el.dataset.rotatingWords || '[]'); } catch (_) { return; }
        if (!Array.isArray(words) || words.length < 2) return;

        const original = words[0];
        const intervalMs = 850;
        // words.length ticks lands us on the original at the final cycle
        // because words[length % length] === words[0] === original. The
        // earlier `length + 1` produced one redundant tick that flashed the
        // original word twice in a row at the end of the sequence.
        const totalCycles = words.length;
        let count = 0;

        const id = setInterval(() => {
          count += 1;
          const target = count >= totalCycles ? original : words[count % words.length];
          el.style.transition = 'opacity 200ms ease-out';
          el.style.opacity = '0';
          setTimeout(() => {
            el.textContent = target;
            el.style.opacity = '1';
          }, 200);

          if (count >= totalCycles) {
            clearInterval(id);
            try { sessionStorage.setItem('hero-word-rotated', '1'); } catch (_) {}
          }
        }, intervalMs);
      }
      init();
      document.addEventListener('astro:page-load', init);
    })();
  </script>
)}

{hasImage && layout === 'split' ? (
  <section class="bg-background text-foreground" aria-labelledby={headingId}>
    {/* Split hero (Task 7): words left, photo right, 7:5 at lg. Stacked with
        the photo first on mobile so the page doesn't open on a wall of text.
        Shares the site's left edge and container (max-w-content px-m) with
        every other band on the page (CLAUDE.md rule 17: one grammar per page). */}
    <div class="mx-auto grid max-w-content grid-cols-1 items-stretch gap-0 px-m lg:grid-cols-12">
      <div class="order-2 flex flex-col justify-center py-section-md lg:order-1 lg:col-span-7 lg:pr-l">
        <div class="hero-entry-stagger max-w-2xl">
          {/* One grammar per page (CLAUDE.md rule 17). The eyebrow is the shared
              mono style every church band draws, and the headline carries the
              same 56x2 gold rule SectionHeading gives every other heading.
              On this cream ground the eyebrow is text-foreground/80, which is
              SectionHeading's own default tone. */}
          {eyebrow && (
            <p class="font-mono text-[0.75rem] uppercase tracking-eyebrow text-foreground/80">{eyebrow}</p>
          )}
          <h1
            id={headingId}
            class="mt-xs font-display text-h1 leading-headline-tight tracking-[-0.02em] text-foreground"
          >
            {scriptFound ? (
              <>
                {scriptBefore}<span class="font-script">{scriptWord}</span>{scriptAfter}
              </>
            ) : (
              headline
            )}
          </h1>
          <div class="mt-m h-0.5 w-14 bg-gold" aria-hidden="true"></div>
          {subhead && (
            <p class="mt-m max-w-2xl text-lg text-muted-foreground">
              {subheadParts.map((part) =>
                part.type === 'em'
                  ? <em class="italic font-display text-foreground">{part.value}</em>
                  : part.value
              )}
            </p>
          )}
          {heroFacts.length > 0 && (
            <dl class="mt-l flex flex-wrap gap-l">
              {heroFacts.map((fact) => (
                <div>
                  {fact.label && (
                    <dt class="font-mono text-[0.75rem] tracking-eyebrow uppercase text-muted-foreground">
                      {fact.label}
                    </dt>
                  )}
                  {fact.value && (
                    <dd class="mt-1 font-display text-h4 text-foreground">{fact.value}</dd>
                  )}
                </div>
              ))}
            </dl>
          )}
          {(primaryCta || secondaryCta) && (
            <div class="mt-l flex flex-wrap gap-s">
              {/* The church pair, the same one the header's Give button and every
                  band below use: gold fill with an indigo-field label (4.90:1,
                  gated in theme-tokens.test.ts), outlined indigo beside it. */}
              {primaryCta && <CtaLink cta={primaryCta} variant="gold" />}
              {secondaryCta && <CtaLink cta={secondaryCta} variant="outline" />}
            </div>
          )}
        </div>
      </div>
      <div class="order-1 border-l-4 border-gold lg:order-2 lg:col-span-5">
        <SanityImage
          source={effectiveImages[0]}
          width={1200}
          height={900}
          sizes="(min-width: 1024px) 40vw, 100vw"
          loading="eager"
          fetchpriority="high"
          quality={75}
          class="h-full min-h-[16rem] w-full object-cover"
          style={`object-position: ${splitObjectPosition};`}
        />
      </div>
    </div>
  </section>
) : hasImage ? (
  <section
    class:list={[
      'relative overflow-hidden bg-accent-dark text-bg flex flex-col justify-end',
      wrapperHeight,
    ]}
    aria-labelledby={headingId}
  >
    {/* Background: single static image or a cross-fading slideshow (2+ images),
        plus the readability overlays. See HeroBackground.astro. */}
    <HeroBackground images={effectiveImages} />

    {/* Content sits at the bottom of the section thanks to justify-end on the
        section itself. Avoids the h-full-on-flex-item brittleness that left
        content floating mid-hero on min-height containers. */}
    <div class="relative mx-auto w-full max-w-content px-m pb-section-lg pt-section-md">
      {/*
        hero-entry-stagger triggers the global page-load fade-up animation
        defined in globals.css. Each direct child of this wrapper fades up
        with a small per-child delay (eyebrow → hairline → h1 → subhead →
        CTAs). Reduced-motion users get the final composition instantly.

        Cream hairline beneath the eyebrow mirrors the SectionHeading
        inverse-tone treatment so heroes carry the same editorial signature
        as every interior section heading.
      */}
      <div class="hero-entry-stagger max-w-3xl">
        {/* Same grammar as the split layout above and as every band below: mono
            eyebrow, then the gold rule under the headline rather than a cream
            hairline over it.

            The eyebrow is CREAM here, not gold, and that is a departure from
            the dark bands on purpose. Gold clears AA against the flat
            --color-accent-dark band those use, but this hero's ground is a
            PHOTOGRAPH under an overlay, and on the bright-sky frames the gold
            line was the weakest text on the page. text-bg/90 is the same paper
            white as the headline at 90%, so the eyebrow reads on every one of
            the five frames. The gold rule below the headline keeps the brand
            colour in the band. */}
        {eyebrow && (
          <p class="font-mono text-[0.75rem] uppercase tracking-eyebrow text-bg/90">{eyebrow}</p>
        )}
        <h1 id={headingId} class="mt-xs font-display text-h1 leading-headline-tight tracking-[-0.02em] text-bg">
          {rotateEnabled ? (
            <>
              <span data-rotating-word data-rotating-words={rotatingPayload}>
                {headlineFirst}
              </span>{headlineRest}
            </>
          ) : scriptFound ? (
            <>
              {scriptBefore}<span class="font-script">{scriptWord}</span>{scriptAfter}
            </>
          ) : (
            headline
          )}
        </h1>
        <div class="mt-m h-0.5 w-14 bg-gold" aria-hidden="true"></div>
        {subhead && (
          <p class="mt-m max-w-2xl text-lg text-bg/90">
            {subheadParts.map((part) =>
              part.type === 'em'
                ? <em class="italic font-display text-bg/95">{part.value}</em>
                : part.value
            )}
          </p>
        )}
        {heroFacts.length > 0 && (
          <dl class="mt-l flex flex-wrap gap-l">
            {heroFacts.map((fact) => (
              <div>
                {fact.label && (
                  <dt class="font-mono text-[0.75rem] tracking-eyebrow uppercase text-bg/80">
                    {fact.label}
                  </dt>
                )}
                {fact.value && (
                  <dd class="mt-1 font-display text-h4 text-bg">{fact.value}</dd>
                )}
              </div>
            ))}
          </dl>
        )}
        {(primaryCta || secondaryCta) && (
          <div class="mt-l flex flex-wrap gap-s">
            {/* Gold primary, white-outlined secondary: CtaLink's onDark outline.
                The starter's bronze primary/secondary pair sat here, directly
                under a gold Give button in the header. */}
            {primaryCta && <CtaLink cta={primaryCta} variant="gold" onDark />}
            {secondaryCta && <CtaLink cta={secondaryCta} variant="outline" onDark />}
          </div>
        )}
      </div>
    </div>

    {/* Soft pulsing scroll cue at the bottom-center of the hero. Tells
        visitors there is more below; clicking it glides past the hero.
        Static under prefers-reduced-motion (see the scoped <style>). */}
    {size === 'tall' && (
      <button
        type="button"
        data-scroll-cue
        aria-label="Scroll down to see more"
        class="scroll-cue absolute bottom-4 left-1/2 z-10 inline-flex h-11 w-11 items-center justify-center rounded-full text-bg/85 hover:text-bg hover:bg-bg/10 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-bg/70"
      >
        <ChevronDown size={28} strokeWidth={1.5} aria-hidden="true" />
      </button>
    )}
  </section>
) : (
  <section class="bg-background" aria-labelledby={headingId}>
    <div class:list={['mx-auto max-w-content px-m py-section-lg flex items-end', wrapperHeight]}>
      {/* The text-only hero speaks the same grammar as the two above: the
          church eyebrow tone (brown-mid on paper, gold in dark mode) and the
          gold rule under the headline. */}
      <SectionHeading
        eyebrow={eyebrow}
        headline={headline}
        subhead={subhead}
        headingId={headingId}
        level="h1"
        tone="church"
        rule
      />
    </div>
  </section>
)}

<style>
  /* Full-viewport home hero. Fill the screen below the sticky header on first
     load. --header-h is measured by the inline script above; the per-breakpoint
     fallback covers the brief pre-measure window and the no-JS case (mobile
     header ~7rem, desktop with the eyebrow strip ~9.5rem). svh keeps the hero
     within the initially-visible viewport on mobile (address bar shown) so it
     never forces an immediate scroll; the vh line is the pre-svh fallback. */
  .hero-fill {
    min-height: calc(100vh - var(--header-h, 7rem));
    min-height: calc(100svh - var(--header-h, 7rem));
  }
  @media (min-width: 1024px) {
    .hero-fill {
      min-height: calc(100vh - var(--header-h, 9.5rem));
      min-height: calc(100svh - var(--header-h, 9.5rem));
    }
  }

  /* Scroll cue: a soft down-bob plus opacity pulse so it reads as "there is
     more below" without shouting. Centered with translateX(-50%) (the keyframe
     re-applies it each step). Reduced-motion users get a static, clearly
     visible chevron instead. */
  .scroll-cue {
    transform: translateX(-50%);
    animation: scroll-cue-bob 2.4s ease-in-out infinite;
  }
  @keyframes scroll-cue-bob {
    0%, 100% { transform: translate(-50%, 0); opacity: 0.55; }
    50%      { transform: translate(-50%, 0.4rem); opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-cue {
      animation: none;
      opacity: 0.85;
      transform: translateX(-50%);
    }
  }
</style>
