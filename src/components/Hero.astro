---
// Safe to edit by hand
// Page hero. Three shapes:
//   1) "image, full" hero (home and any interior page with a hero photo) —
//      the photograph fills the viewport (100svh on the home hero, 72svh on an
//      interior one) under the two gradients in HeroBackground, with the words
//      sitting bottom-left over it.
//   2) "image, split" hero (layout="split") — cream two-column band: words on
//      the left (eyebrow, headline, lede, facts, buttons), the photo on the
//      right bleeding to the viewport edge. 7:5 columns at lg, stacked with
//      the photo first on mobile.
//   3) "text" hero (interior pages with no photograph) — clean editorial
//      heading on paper with eyebrow + headline + subhead.
//
// THE HEADER OVERLAYS THIS SECTION (plan 3 task 3). On a page that opens with
// an image hero the bar is transparent and is pulled down onto the picture by
// a negative margin-bottom (globals.css, .site-header[data-overlay]), so the
// hero IS the viewport and subtracts nothing for the header. That is why the
// tall hero is a plain `min-h-[100svh]` and why the old `.hero-fill` class,
// its --header-h arithmetic and the scroll cue that measured the same variable
// are all gone: there is no longer a header-shaped strip above the picture for
// any of them to reason about.
//
// The image hero is the LCP element on the homepage. SanityImage is set to
// loading="eager" in that case and the headline uses font-display (Castoro
// Titling), which BaseLayout preloads inline. Don't add layout-shift
// animations to this section.

import HeroBackground from '@/components/HeroBackground.astro';
import SanityImage from '@/components/SanityImage.astro';
import CtaLink from '@/components/CtaLink.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { splitHeadingAccent } from '@/lib/heading-accent';
import { splitStega } from '@/lib/preview-stega';
import { staticSunday, timeOnly } from '@/lib/live-sunday';

interface CtaBlock {
  label?: string;
  linkType?: 'internal' | 'external' | 'email' | 'phone';
  internalLink?: { _type?: string; slug?: string } | null;
  externalUrl?: string;
  emailAddress?: string;
  phoneNumber?: string;
  openInNewTab?: boolean;
}

import type { SanityImageObject } from '@/lib/pageBuilder.types';

/** One fact under the hero words: a short label/value pair like
    "Sundays" / "10:45 am". Up to three, schema-capped. */
interface HeroFact {
  _key?: string;
  label?: string;
  value?: string;
}

interface Props {
  eyebrow?: string;
  headline: string;
  subhead?: string;
  backgroundImage?: SanityImageObject | null;
  /** Optional list of hero images. 2+ render a cross-fading slideshow; 1 (or
      falling back to backgroundImage) renders a single static image. */
  backgroundImages?: SanityImageObject[] | null;
  /**
   * "full" (default when unset) = photo behind the words, full-bleed, as the
   * hero always rendered. "split" = cream two-column band, words left, first
   * photo right. Only meaningful when an image is present.
   */
  layout?: 'full' | 'split';
  /** Up to three short facts (when, where, online) shown under the subhead. */
  facts?: HeroFact[] | null;
  primaryCta?: CtaBlock | null;
  secondaryCta?: CtaBlock | null;
  headingId: string;
  /** "tall" = fills the viewport (homepage), "short" = generous but not full
      screen (interior pages). */
  size?: 'tall' | 'short';
  /**
   * siteSettings.serviceTime, passed down by SectionRenderer. When it is
   * present on a TALL hero it replaces the eyebrow with the live dated line
   * ("This Sunday, September 27 · Worship at 10:45 am"), whose date the
   * BaseLayout upgrade script computes from the visitor's own clock. Interior
   * heroes keep their eyebrow.
   */
  serviceTime?: string;
  /**
   * Optional single word/phrase in the headline to render in script
   * (the script accent font). One per hero — the editorial-signature flourish.
   * The first occurrence in the headline string is wrapped. If the word
   * isn't found, the headline renders unchanged.
   *
   * heroSection (the page-builder block) no longer offers this field (plan 2
   * task 7 dropped it from that schema); it is kept here because the singleton
   * hero fields on other pages (blog index, the preview route) still pass
   * their own scriptAccent value through to this component.
   */
  scriptAccent?: string;
}

const {
  eyebrow,
  headline,
  subhead,
  backgroundImage,
  backgroundImages,
  layout = 'full',
  facts,
  primaryCta,
  secondaryCta,
  headingId,
  size = 'short',
  serviceTime,
  scriptAccent,
} = Astro.props as Props;

const heroFacts = (facts ?? []).filter((f) => f?.label || f?.value).slice(0, 3);

// Script accent: split the headline around the accent word so it can be
// rendered in three pieces (before / accent-span / after). Delegates to the
// shared splitHeadingAccent helper so Hero, SectionHeading and FinalCta use
// identical logic.
const {
  found: scriptFound,
  before: scriptBefore,
  word: scriptWord,
  after: scriptAfter,
} = splitHeadingAccent(headline, scriptAccent);

// THE LIVE DATED LINE. Two strings come out of one setting:
//   - `sundayStatic` is what the SERVER renders. It carries no date, so it is
//     true whenever the page is served and true with JavaScript off.
//   - `sundayTime` rides along in data-live-sunday for the upgrade script,
//     which rewrites the text with the visitor's clock on load.
// serviceTime is CLEANED of its stega payload first. Both functions measure
// and rewrite the string, and the payload's U+FEFF matches `\s` in a regex,
// so an encoded value would smuggle invisible characters into an attribute
// and into the rewritten line (CLAUDE.md, the preview rules).
const serviceTimeClean = serviceTime ? splitStega(serviceTime).cleaned.trim() : '';
const showLiveSunday = size === 'tall' && serviceTimeClean.length > 0;
const sundayStatic = showLiveSunday ? staticSunday(serviceTimeClean) : '';
const sundayTime = showLiveSunday ? timeOnly(serviceTimeClean) : '';

// Subhead emphasis: parse markdown-style _word_ markers into <em> spans so
// editors can italicize a key word in the Sanity subhead without HTML.
// Example: "Pick the tier that fits _where you are_." → emphasis on "where you
// are". The lede is set in italic throughout now, so an emphasised run flips
// back to roman, which is how type has always marked emphasis inside italics.
function parseSubhead(s?: string): Array<{ type: 'text' | 'em'; value: string }> {
  if (!s) return [];
  const parts = s.split(/(_[^_]+_)/g);
  return parts.map((part) =>
    part.startsWith('_') && part.endsWith('_') && part.length > 2
      ? { type: 'em' as const, value: part.slice(1, -1) }
      : { type: 'text' as const, value: part },
  );
}
const subheadParts = parseSubhead(subhead);

// Prefer the slideshow array; fall back to the single backgroundImage so every
// other page (which only passes backgroundImage) is unaffected.
const heroImageList = (Array.isArray(backgroundImages) ? backgroundImages : []).filter(
  (img) => !!img?.asset,
);
const effectiveImages =
  heroImageList.length > 0 ? heroImageList : backgroundImage?.asset ? [backgroundImage] : [];
const hasImage = effectiveImages.length > 0;

// SPLIT-LAYOUT FRAME CROP (2026-09-20, final review of plan 2b).
//
// The split hero's frame is `object-cover` inside a tall column, so the browser
// crops the photograph. Its default is object-position: 50% 50%, dead centre,
// which on a group photograph taken from adult eye height takes the crop
// through everyone's faces: on /visit the children in the arch frame lost the
// tops of their heads.
//
// Two rules, in order.
//   1. An editor's HOTSPOT wins. Sanity stores it as fractions of the image's
//      width and height, which is exactly what object-position takes as
//      percentages, so the point the editor picked in the Studio is the point
//      that stays in frame at every viewport.
//   2. With no hotspot, the default is the TOP of the image rather than its
//      middle. Faces sit above centre in almost every photograph a church
//      takes, and a top crop keeps them whole. It is a better default, not a
//      substitute for the hotspot.
//
// Only the split layout does this. The full-bleed hero is a background behind
// text and is handled by HeroBackground.astro.
const splitFrame = effectiveImages[0];
const splitHotspot = splitFrame?.hotspot;
const splitObjectPosition =
  typeof splitHotspot?.x === 'number' && typeof splitHotspot?.y === 'number'
    ? `${(splitHotspot.x * 100).toFixed(2)}% ${(splitHotspot.y * 100).toFixed(2)}%`
    : '50% 0%';

// The image hero's height. The header overlays it, so these are the whole
// viewport (home) and a deep interior band, with nothing subtracted.
const imageHeroHeight = size === 'tall' ? 'min-h-[100svh]' : 'min-h-[72svh]';

// The headline's one scale decision: poster scale on the home hero, h1
// everywhere else. Both are the titling face, capitals only.
const displayHeadlineClass =
  size === 'tall'
    ? 'font-display uppercase tracking-[0.01em] font-normal text-display max-w-[12ch]'
    : 'font-display uppercase tracking-[0.01em] font-normal text-h1 leading-none max-w-[12ch]';
---

{hasImage && layout === 'split' ? (
  <section class="bg-background text-foreground" aria-labelledby={headingId}>
    {/* Split hero: words left, photo right, 7:5 at lg. Stacked with the photo
        first on mobile so the page doesn't open on a wall of text. The words
        share the site's left edge and container with every other band on the
        page (CLAUDE.md rule 17: one grammar per page); the picture breaks that
        container and bleeds to the viewport edge, which is the art-direction
        pass's rule for any photograph beside words. */}
    <div class="mx-auto grid max-w-content grid-cols-1 items-stretch gap-0 px-gutter lg:grid-cols-12">
      <div class="order-2 flex flex-col justify-center py-section-md lg:order-1 lg:col-span-7 lg:pr-l">
        <div class="hero-entry-stagger max-w-2xl">
          {eyebrow && (
            <p class="font-ui text-ui font-medium mb-[clamp(18px,3vh,32px)] text-foreground/80">
              {eyebrow}
            </p>
          )}
          <h1 id={headingId} class:list={[displayHeadlineClass, 'text-foreground']}>
            {scriptFound ? (
              <>
                {scriptBefore}<span class="font-script">{scriptWord}</span>{scriptAfter}
              </>
            ) : (
              headline
            )}
          </h1>
          {subhead && (
            <p class="lede mt-[clamp(18px,3vh,30px)] max-w-[34ch] font-body italic font-normal text-lede text-foreground/80">
              {subheadParts.map((part) =>
                part.type === 'em' ? <em class="not-italic">{part.value}</em> : part.value,
              )}
            </p>
          )}
          {heroFacts.length > 0 && (
            <dl class="mt-[clamp(28px,5vh,48px)] flex max-w-[960px] flex-wrap gap-[clamp(24px,4vw,64px)] border-t border-hair pt-[clamp(20px,3vh,28px)]">
              {heroFacts.map((fact) => (
                <div>
                  {fact.label && (
                    <dt class="font-ui text-ui mb-1.5 text-foreground/70">{fact.label}</dt>
                  )}
                  {fact.value && (
                    <dd class="font-body text-[clamp(1.25rem,1rem+.9vw,1.625rem)] leading-tight">
                      {fact.value}
                    </dd>
                  )}
                </div>
              ))}
            </dl>
          )}
          {(primaryCta || secondaryCta) && (
            <div class="mt-[clamp(26px,4vh,40px)] flex flex-wrap items-center gap-x-[34px] gap-y-[22px]">
              {primaryCta && <CtaLink cta={primaryCta} variant="gold" />}
              {secondaryCta && <CtaLink cta={secondaryCta} variant="link" />}
            </div>
          )}
        </div>
      </div>
      <div class="bleed-right order-1 lg:order-2 lg:col-span-5">
        <SanityImage
          source={effectiveImages[0]}
          width={1200}
          height={900}
          sizes="(min-width: 1024px) 45vw, 100vw"
          loading="eager"
          fetchpriority="high"
          quality={75}
          class="h-full min-h-[16rem] w-full object-cover"
          style={`object-position: ${splitObjectPosition};`}
        />
      </div>
    </div>
  </section>
) : hasImage ? (
  <section
    class:list={[
      'relative isolate flex flex-col justify-end overflow-hidden bg-accent-dark text-bg',
      imageHeroHeight,
    ]}
    aria-labelledby={headingId}
  >
    {/* Background: single static image or a cross-fading slideshow (2+ images),
        plus the one readability gradient. See HeroBackground.astro. */}
    <HeroBackground images={effectiveImages} />

    {/* Content sits at the bottom of the section thanks to justify-end on the
        section itself. hero-entry-stagger rides on this wrapper, so its direct
        children (the line, the headline, the lede, the facts, the buttons)
        rise in sequence at 0/150/300/450/600ms. Reduced-motion users get the
        final composition instantly. */}
    <div class="hero-entry-stagger relative mx-auto w-full max-w-content px-gutter pt-[clamp(72px,12vh,128px)] pb-[clamp(40px,7vh,72px)]">
      {showLiveSunday ? (
        // The dated line, with the gold dash that marks it as the live one.
        // The server text carries no date; the upgrade script in BaseLayout
        // rewrites the inner span from data-live-sunday and the visitor's clock.
        <p class="font-ui text-ui font-medium inline-flex items-center gap-3.5 mb-[clamp(18px,3vh,32px)]">
          <span class="h-px w-11 bg-gold" aria-hidden="true"></span>
          <span data-live-sunday={sundayTime}>{sundayStatic}</span>
        </p>
      ) : (
        eyebrow && (
          <p class="font-ui text-ui font-medium inline-flex items-center gap-3.5 mb-[clamp(18px,3vh,32px)]">
            <span>{eyebrow}</span>
          </p>
        )
      )}
      <h1 id={headingId} class:list={[displayHeadlineClass, 'text-bg']}>
        {scriptFound ? (
          <>
            {scriptBefore}<span class="font-script">{scriptWord}</span>{scriptAfter}
          </>
        ) : (
          headline
        )}
      </h1>
      {subhead && (
        <p class="lede mt-[clamp(18px,3vh,30px)] max-w-[34ch] font-body italic font-normal text-lede text-bg">
          {subheadParts.map((part) =>
            part.type === 'em' ? <em class="not-italic">{part.value}</em> : part.value,
          )}
        </p>
      )}
      {heroFacts.length > 0 && (
        <dl class="mt-[clamp(28px,5vh,48px)] flex max-w-[960px] flex-wrap gap-[clamp(24px,4vw,64px)] border-t border-bg/18 pt-[clamp(20px,3vh,28px)]">
          {heroFacts.map((fact) => (
            <div>
              {fact.label && <dt class="font-ui text-ui mb-1.5 text-bg/70">{fact.label}</dt>}
              {fact.value && (
                <dd class="font-body text-[clamp(1.25rem,1rem+.9vw,1.625rem)] leading-tight">
                  {fact.value}
                </dd>
              )}
            </div>
          ))}
        </dl>
      )}
      {(primaryCta || secondaryCta) && (
        <div class="mt-[clamp(26px,4vh,40px)] flex flex-wrap items-center gap-x-[34px] gap-y-[22px]">
          {/* One gold button and one text link with an arrow, not two buttons:
              the second action is quieter than the first and should look it. */}
          {primaryCta && <CtaLink cta={primaryCta} variant="gold" onDark />}
          {secondaryCta && <CtaLink cta={secondaryCta} variant="link" onDark />}
        </div>
      )}
    </div>
  </section>
) : (
  <section class="bg-background" aria-labelledby={headingId}>
    <div
      class:list={[
        'mx-auto flex max-w-content items-end px-gutter py-section-lg',
        size === 'tall' ? 'min-h-[100svh]' : 'min-h-[42svh] md:min-h-[52svh]',
      ]}
    >
      {/* The text-only hero speaks the same grammar as the two above; the type
          itself lives in SectionHeading, which the primitives pass redrew. */}
      <SectionHeading
        eyebrow={eyebrow}
        headline={headline}
        subhead={subhead}
        headingId={headingId}
        level="h1"
        tone="church"
      />
    </div>
  </section>
)}
