---
// Safe to edit by hand
// The eyebrow + headline pairing used at the top of nearly every section.
// Pass `headingId` so the parent <section> can use aria-labelledby={headingId}
// for an accessible name (per CLAUDE.md a11y guidance).
//
// Variants:
//   - level: which heading tag (h1 for hero, h2 for sections, h3 for sub-sections). Default h2.
//   - align: "left" (default) or "center" for centered section heads.
//     2026-09-19: eight starter components used to pass align="center" plus
//     class="mx-auto" on every call, so a page mixing church blocks (left) with
//     starter blocks (centred) had two left edges and broke CLAUDE.md rule 17.
//     They now pass nothing and take the left default. Centring is a PAGE
//     decision made per call, not a component default, and on this site the
//     only centred headings are the ones drawn inside a fixed dark band
//     (FinalCta, spec section 2.3). A component's own GRID may still centre
//     itself (a logo strip's marks, a team card's portrait); the heading may
//     not.
//   - tone: "default" (foreground on light surfaces), "inverse" (bg/light on
//     dark CTA banners), "church" (the church's LIGHT surfaces: a brown-mid
//     eyebrow that becomes gold in dark mode, because --color-brown-mid does
//     not move between themes and would sit dark-on-dark if it did nothing),
//     or "band" (the church's dark bands: gold eyebrow,
//     paper-white headline, taupe subhead). "band" exists because the church
//     identity gives the eyebrow on a dark band the brand gold, which neither
//     of the other two tones can express, and putting it here keeps the five
//     dark-band components from each inventing their own eyebrow.
//     "paper" (2026-09-23, the Home pass) is the FIXED cream band: the
//     heritage band with dates, which stays cream in both themes so the
//     drawing on it can blend into the paper. Indigo headline, brown-mid
//     eyebrow, brown subhead, none of which flips, because the ground does
//     not either ("default" and "church" flip with the page and would set
//     paper-coloured ink on cream in dark mode).
//
// Script accent:
//   - scriptAccent?: optional single word/phrase from the headline to render
//     in the script accent font via the `.font-script` utility. The first occurrence is
//     wrapped. Falls back to plain rendering when undefined, empty, or not
//     found — so no existing heading is affected unless the prop is explicitly
//     passed with a matching string.
//   - Logic is shared with Hero.astro and FinalCta.astro via splitHeadingAccent()
//     in src/lib/heading-accent.ts, which is the one splitter both accent
//     devices use.
//   - At most one script accent per heading (editorial discipline, per CLAUDE.md).
//
// Heading accent (PORTS.md card 26, 2026-08-28):
//   - headingAccent?: the COLOUR sibling of the script accent. Same idea, same
//     one-per-heading rule: an editor types a word that already appears in the
//     headline and the first match is wrapped in `.heading-accent`, which reads
//     the brand accent colour (globals.css; measured on every surface in both
//     themes by src/lib/surfaces.test.ts). Matching is case-insensitive and
//     stega-safe - see src/lib/heading-accent.ts.
//   - PRECEDENCE, and it is deliberate: if a script accent is set AND found,
//     the colour accent is skipped. Two accents on one heading is decoration,
//     not emphasis, and the script accent is the older, louder device.
//   - Unset or not found, `headline` renders exactly the string it always did.
//
// Gold rule (RETIRED 2026-09-20, plan 3 task 2):
//   - `rule?` is still ACCEPTED and now IGNORED. The 56x2px gold bar beneath a
//     heading, and the bronze hairline beneath the eyebrow it used to replace,
//     are both gone: the art-direction pass gives a heading its authority from
//     the face, the size and the space around it, not from an ornament under
//     every one of them. Two rules inside one block was already decoration
//     rather than structure; one rule under every heading on the site was the
//     same argument at page scale.
//   - The prop survives so the ~dozen existing callers that pass `rule` keep
//     compiling. Do not pass it in new code; Task 13 removes the callers.
//
// Rich subhead (same card):
//   - subheadRich?: the optional portable-text twin of `subhead`, allowing bold
//     and italic and nothing else (src/lib/inline-rich.ts). When it holds text
//     it is rendered INSIDE the same <p> with the same classes, so the only
//     difference in the markup is the <strong> / <em> the editor asked for.
//     Empty or absent, the plain `subhead` renders untouched.

import { splitHeadingAccent } from '@/lib/heading-accent';
import { hasInlineRich } from '@/lib/inline-rich';
import InlineRich from '@/components/InlineRich.astro';
import { headlineClass, type HeadlineScale } from '@/lib/headline-scale';

interface Props {
  eyebrow?: string;
  headline?: string;
  subhead?: string;
  /** Optional rich twin of `subhead`: bold and italic only. */
  subheadRich?: unknown;
  headingId: string;
  level?: 'h1' | 'h2' | 'h3';
  align?: 'left' | 'center';
  tone?: 'default' | 'inverse' | 'band' | 'church' | 'paper';
  /**
   * Optional single word/phrase from the headline to render in handwritten
   * the script accent font. Matched case-insensitively against the headline,
   * first occurrence only.
   * Leave undefined or blank to skip. Use sparingly — one accent per heading.
   */
  scriptAccent?: string;
  /**
   * Optional single word/phrase from the headline to set in the brand accent
   * colour. Case-insensitive, first match only. Ignored when a script accent is
   * already in play: one accent per heading.
   */
  headingAccent?: string;
  /**
   * h1 only: the hero headline scale from src/lib/headline-scale.ts. Hero's
   * text-only branch and the band-opening GiveBand / HeritageBand pass it.
   * Unset or 'poster', the h1 keeps the classes it always had (and the 404
   * and privacy pages never pass it).
   */
  scale?: HeadlineScale;
  /** Accepted and ignored since 2026-09-20. See the note in the header. */
  rule?: boolean;
  class?: string;
}

const {
  eyebrow,
  headline,
  subhead,
  subheadRich,
  headingId,
  level = 'h2',
  align = 'left',
  tone = 'default',
  scriptAccent,
  headingAccent,
  rule = false,
  scale,
  class: extraClass = '',
} = Astro.props as Props;

// `rule` is destructured only so a caller passing it does not land in the
// rest object; nothing reads it any more. See the header note.
void rule;

// Split the headline around the script-accent word when provided.
// When not found or not set, `found` is false and we render `headline` plain.
const {
  found: scriptFound,
  before: scriptBefore,
  word: scriptWord,
  after: scriptAfter,
} = splitHeadingAccent(headline, scriptAccent);

// The colour accent, only considered when the script accent did not fire.
const colour = scriptFound
  ? { found: false, before: '', word: '', after: '', heading: headline ?? '' }
  : splitHeadingAccent(headline, headingAccent);

const richSubhead = hasInlineRich(subheadRich);

// The art-direction heading system (2026-09-20, plan 3 task 2).
// h1 is the TITLING face: Castoro Titling is capitals-only at one weight, so
// the utility sets the casing rather than trusting the copy. h2 and h3 are
// Castoro roman at the same single weight, which is why every level is
// font-normal: there is no weight axis to reach for, and `font-light` would
// silently fall back to the 400 face while telling a maintainer otherwise.
// A `scale` (hero headlines, src/lib/headline-scale.ts) only changes the h1
// when it steps DOWN from poster: a poster keeps this component's own h1
// classes, so a short band-opening headline ("Since 1859.") renders exactly
// as it did before the scale existed.
const headingClass =
  level === 'h1' && scale && scale !== 'poster'
    ? headlineClass(scale, { tall: false })
    : level === 'h1'
      ? 'font-display uppercase text-h1 leading-none tracking-[0.01em] font-normal'
      : level === 'h2'
        ? 'font-body text-h2 leading-[1.05] font-normal max-w-[22ch]'
        : 'font-body text-h3 leading-[1.15] font-normal';

const wrapperAlign = align === 'center' ? 'text-center mx-auto' : 'text-left';
// text-bg, never text-cream, on anything that sits on a FIXED dark band:
// --color-cream flips to ink under .dark (globals.css) while --color-bg stays
// paper-white in both themes.
const toneHeadline =
  tone === 'paper'
    ? 'text-band-indigo'
    : tone === 'default' || tone === 'church'
      ? 'text-foreground'
      : 'text-bg';
// Default tone swapped from text-secondary (Warm Taupe, fails AA at 12px) to
// text-foreground/80 (4.77:1 on Cream). Inverse tone (used on FinalCta's
// dark Charcoal panel) keeps cream-on-dark.
// Eyebrow colour. On paper (default / church) the eyebrow is the darkened
// gold that carries a label at AA; on a dark band or an inverse panel it is
// the brand gold itself, which is a fill and an on-dark ink.
const toneEyebrow =
  tone === 'paper'
    ? 'text-brown-mid'
    : tone === 'band' || tone === 'inverse'
      ? 'text-gold'
      : 'text-gold-ink';
// Subhead colour: full-strength foreground on paper, lifted paper on dark.
const toneSub =
  tone === 'paper'
    ? 'text-band-brown'
    : tone === 'band' || tone === 'inverse'
      ? 'text-bg/85'
      : 'text-foreground';
---

<div class:list={[wrapperAlign, 'max-w-3xl', extraClass]}>
  {eyebrow && <p class:list={['mb-5 font-ui text-ui font-medium', toneEyebrow]}>{eyebrow}</p>}
  {
    headline &&
      (level === 'h1' ? (
        <h1 id={headingId} class:list={[headingClass, toneHeadline]}>
          {scriptFound ? (
            <>
              {scriptBefore}
              <span class="font-script">{scriptWord}</span>
              {scriptAfter}
            </>
          ) : colour.found ? (
            <>
              {colour.before}
              <span class="heading-accent">{colour.word}</span>
              {colour.after}
            </>
          ) : (
            headline
          )}
        </h1>
      ) : level === 'h2' ? (
        <h2 id={headingId} class:list={[headingClass, toneHeadline]}>
          {scriptFound ? (
            <>
              {scriptBefore}
              <span class="font-script">{scriptWord}</span>
              {scriptAfter}
            </>
          ) : colour.found ? (
            <>
              {colour.before}
              <span class="heading-accent">{colour.word}</span>
              {colour.after}
            </>
          ) : (
            headline
          )}
        </h2>
      ) : (
        <h3 id={headingId} class:list={[headingClass, toneHeadline]}>
          {scriptFound ? (
            <>
              {scriptBefore}
              <span class="font-script">{scriptWord}</span>
              {scriptAfter}
            </>
          ) : colour.found ? (
            <>
              {colour.before}
              <span class="heading-accent">{colour.word}</span>
              {colour.after}
            </>
          ) : (
            headline
          )}
        </h3>
      ))
  }
  {
    (subhead || richSubhead) && (
      <p class:list={['lede mt-5 font-body text-lede font-normal italic', toneSub]}>
        {richSubhead ? <InlineRich value={subheadRich} /> : subhead}
      </p>
    )
  }
</div>
