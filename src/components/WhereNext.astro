---
// Safe to edit by hand
// "Where next" (starter card 191, from FBC Auburn 2026-10-24): full-width rows at the top of the
// footer, each a big link with a long hairline arrow, so no page ends at a dead end. The rows come
// from Site settings > Where next rows, else the church defaults (src/data/wayfinding-defaults.ts),
// resolved by whereNextRows() in src/lib/wayfinding.ts: the first three that are not the page you
// are on, and a row that points at a Studio page only while that page is published.
//
// THIS SITE (2026-10-27): drawn in the phone menu's grammar on the footer's indigo. The labels
// are the menu rows' Castoro Titling capitals, the notes the gold eyebrow, the rows parted by the
// footer's own paper hairlines. Rows have no hover background (art-direction spec, the menu): the
// hover is the gold hairline drawing under the label and the gold arrow drawing out.
//
// One closing device per page: a page that ends on its own closing band (FinalCta.astro, marked
// data-final-cta) does not also get these rows; the CSS below hides them there.
import type { WhereNextRow } from '@/lib/wayfinding';

interface Props {
  rows: WhereNextRow[];
}

const { rows } = Astro.props;
---

{rows.length > 0 && (
  <nav class="where-next relative border-b border-bg/15" aria-label="Where next">
    <ul role="list" class="where-next__list mx-auto max-w-content px-gutter">
      {rows.map((r) => (
        <li>
          <a href={r.href} class="where-next__row">
            <span class="where-next__label">{r.label}</span>
            {r.note && <span class="where-next__note">{r.note}</span>}
            <svg
              class="where-next__arrow"
              viewBox="0 0 120 16"
              width="120"
              height="16"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="M0 8 H118 M110 1 L118 8 L110 15"
                fill="none"
                stroke="currentColor"
                stroke-width="1.25"
              />
            </svg>
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  /* The page's own closing band already ends it: one closing device per page. */
  :global(body:has(main [data-final-cta])) .where-next {
    display: none;
  }
  .where-next {
    padding-block: clamp(1rem, 2.5vw, 2rem);
  }
  .where-next__list {
    list-style: none;
    margin-block: 0;
  }
  .where-next__list > li + li .where-next__row {
    border-top: 1px solid rgb(244 239 230 / 0.15);
  }
  .where-next__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: 'label arrow' 'note arrow';
    align-items: center;
    column-gap: 1.5rem;
    min-height: 44px;
    padding-block: clamp(0.85rem, 1.6vw, 1.2rem);
    color: var(--color-bg);
    text-decoration: none;
  }
  .where-next__label {
    grid-area: label;
    justify-self: start;
    position: relative;
    min-width: 0;
    overflow-wrap: anywhere;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.5rem);
    line-height: 1.05;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  /* The gold hairline, drawn left to right on hover and focus (the menu's .nav-underline). */
  .where-next__label::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: -0.3rem;
    height: 1px;
    background: var(--color-gold);
    transition: right 300ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .where-next__row:hover .where-next__label::after,
  .where-next__row:focus-visible .where-next__label::after {
    right: 0;
  }
  .where-next__note {
    grid-area: note;
    margin-top: 0.55rem;
    font-family: var(--font-ui);
    font-size: var(--text-ui);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-gold);
  }
  .where-next__arrow {
    grid-area: arrow;
    width: clamp(40px, 9vw, 120px);
    height: auto;
    color: var(--color-gold);
    transform: translateX(-10px);
    transition: transform 450ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .where-next__row:hover .where-next__arrow,
  .where-next__row:focus-visible .where-next__arrow {
    transform: none;
  }
  .where-next__row:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 4px;
  }
  @media (prefers-reduced-motion: reduce) {
    .where-next__label::after,
    .where-next__arrow {
      transition: none;
    }
  }
  @media (max-width: 767px) {
    .where-next__row {
      padding-block: 0.75rem;
      column-gap: 1rem;
    }
    .where-next__note {
      margin-top: 0.4rem;
    }
  }
</style>
