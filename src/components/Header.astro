---
// Foundation, edit with care
// Site header, in the church's own grammar (Plan 2a, Task 9).
//
//   ┌─────────────────────────────────────── 4px indigo accent stripe
//   │ ─────────────────────────────────────── utility row (md and up)
//   │   (765) 284-7749                     Contact  ·  theme
//   ├─────────────────────────────────────── main row
//   │   [wordmark]        Visit Who We Are ... Blog   [ GIVE ]
//   └───────────────────────────────────────
//
// Three things about the layout are deliberate.
//
//   1. ONE LEFT EDGE. Both rows use the same `max-w-content px-m` container the
//      church blocks and the footer use (CLAUDE.md rule 17), so the phone, the
//      wordmark and every heading down the page share a left edge.
//   2. The utility row appears at md, and the main row switches from the
//      centred-logo phone layout to logo-left at md too, so the phone number
//      sits directly above the wordmark rather than above nothing. The NAV
//      still waits for lg: seven links plus the Give button need the room.
//   3. ONE BUTTON FAMILY. Give is the only button in the header, and it is the
//      exact pair CtaLink's `gold` variant draws: a gold fill with an
//      indigo-FIELD label. Not text-indigo: --color-indigo flips to paper white
//      under .dark (globals.css), which puts 2.37:1 white-on-gold on the button
//      in dark mode only. --color-indigo-field stays dark in both themes.
//      There is no second button style up here.
//
// The seven links and the Give button both come from Sanity (Site Settings ->
// Navigation). Desktop nav is SERVER-RENDERED (CLAUDE.md rule 4): real <a>
// tags, crawlable, present before any JS runs.
//
// siteSettings is optional. Defaults render cleanly so the header works
// even before Sanity content is wired up.

import { getImage } from 'astro:assets';
import { site } from '@/data/site';
import { Phone } from 'lucide-react';
import ThemeToggle from './ThemeToggle';
import MobileNav from './MobileNav';
import { ChevronDown } from 'lucide-react';
import logoLightAsset from '@/assets/logo-light.svg';
import logoDarkAsset from '@/assets/logo-dark.svg';
import { resolveSiteSettings, type RawChromeSettings } from '@/lib/siteSettings';
import { telHref } from '@/lib/phone';
import { urlFor } from '@/lib/sanity';

// SVG logos are passed through Astro's image pipeline for cache-busted URLs.
// SVGs are resolution-independent so no 1x/2x variants are needed — one URL
// serves all pixel densities. The same URL is used for both desktop and mobile.
const logoLightImg = await getImage({ src: logoLightAsset });
const logoDarkImg = await getImage({ src: logoDarkAsset });
const logoLightSrcset = logoLightImg.src;
const logoDarkSrcset = logoDarkImg.src;

// Mobile drawer logos — same SVG URLs, passed as plain strings into MobileNav.
const logoLightWebpMobile = logoLightImg;
const logoDarkWebpMobile = logoDarkImg;

interface Props {
  siteSettings?:
    | (RawChromeSettings & {
        siteName?: string;
        title?: string;
        tagline?: string;
        email?: string;
        phone?: string;
      })
    | null;
}

const { siteSettings } = Astro.props as Props;

const brandName = siteSettings?.siteName ?? siteSettings?.title ?? site.name;

// The chrome (menu, header button, logo, the show/hide switches) resolves
// through one shared helper (see src/lib/siteSettings.ts) so the header, the
// drawer, and the footer can never disagree about what the menu is.
const chrome = resolveSiteSettings(siteSettings);
const headerCta = chrome.headerCta;
const logo = chrome.logo;
// The logo box is 48px tall (h-12), so 280w covers a wide wordmark at 1x and
// 560w covers it at 2x. Built with urlFor() rather than <SanityImage> because
// the header renders on EVERY page: importing that component would pull its
// module into the always-loaded chunk and rename the site-wide CSS bundle.
const logoSrc = logo ? urlFor(logo).width(280).quality(80).auto('format').url() : undefined;
const logoSrcset = logo
  ? [280, 560]
      .map((w) => `${urlFor(logo).width(w).quality(80).auto('format').url()} ${w}w`)
      .join(', ')
  : undefined;

// The church's Give button points at Church Center, which is somebody else's
// site, so it opens in a new tab. An internal destination (the built-in
// fallback, or an editor who repoints it at a page here) stays in this tab.
const ctaIsExternal = /^https?:\/\//i.test(headerCta.href);

// The phone number in the utility row. Blank in Sanity means the row carries
// the Contact link alone, which is why the markup guards on it.
const phone = siteSettings?.phone ?? '';

// Subset of siteSettings the mobile menu needs. Pass as a plain object so the
// React island doesn't try to serialize the whole Sanity document graph.
const mobileNavSettings = siteSettings
  ? {
      tagline: siteSettings.tagline,
      email: chrome.showEmail ? siteSettings.email : undefined,
      phone: siteSettings.phone,
    }
  : null;

// The drawer's CTA prop is only passed when it DIFFERS from the drawer's own
// built-in button. An island's props are serialized into the page, so passing
// the default every time would rewrite the markup of every page for no change.
const mobileCtaProps =
  headerCta.show && headerCta.label === 'Contact us' && headerCta.href === '/contact'
    ? {}
    : { cta: headerCta };

// The menu comes from Sanity (Site Settings -> Navigation). Both the mapping
// and the built-in safety-net menu live in src/lib/siteSettings.ts, so the
// header, the drawer, and the footer read one source. Empty in Sanity = the
// built-in menu.
//
// Flat items render as plain anchor links; dropdown items render as native
// <details>/<summary> disclosure groups. Why <details> and not a React island:
// the desktop nav must exist in the server-rendered HTML so crawlers see every
// internal link and there is no flash-of-missing-nav before hydration. The
// progressive-enhancement script at the bottom of this file adds open-on-hover,
// close-on-outside-click, close-on-Escape and close-on-navigation; the links
// work without it. The church's own menu is seven flat links with no group, but
// the machinery stays so an editor can add one without a code change.
const NAV_ITEMS = chrome.headerNav;

// Flatten NAV_ITEMS into the shape MobileNav expects (a list of NavLink[]
// with optional sub-items for the groups). MobileNav already handles both
// shapes via its updated interface.
const NAV_LINKS = NAV_ITEMS;

const pathname = Astro.url.pathname;
function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
// A dropdown group is "active" (its trigger underline locks wide + aria-current
// is set) when the current route matches any of its child links.
function isGroupActive(items: { href: string }[]) {
  return items.some((item) => isActive(item.href));
}
---

<header class="site-header bg-background">
  {
    /* Brand accent stripe — same visual signature used at the top of the
      mobile menu drawer. Visible on every viewport. */
  }
  <div class="h-1 bg-primary" aria-hidden="true"></div>

  {
    /* Utility row (md and up). Phone on the left, on the wordmark's own left
      edge; Contact and the theme toggle on the right. Phones get the same two
      links at the foot of the drawer instead. */
  }
  <div class="hidden border-b border-border-soft bg-surface-soft md:block">
    <div class="mx-auto flex max-w-content items-center justify-between px-m py-2">
      {
        phone ? (
          <a
            href={telHref(phone)}
            class="inline-flex items-center gap-xs font-mono text-[0.75rem] tracking-eyebrow text-muted-foreground uppercase transition-colors hover:text-link"
          >
            <Phone size={12} aria-hidden="true" />
            {phone}
          </a>
        ) : (
          <span />
        )
      }
      <div class="flex items-center gap-m">
        <a
          href="/contact"
          class="font-mono text-[0.75rem] tracking-eyebrow text-muted-foreground uppercase transition-colors hover:text-link"
        >
          Contact
        </a>
        {
          /* Hydrate when idle, not on load — the anti-FOUC inline script in
            BaseLayout already applies the correct theme class before first
            paint, so this React island only needs to be live by the time the
            visitor moves to click it. Demoting from client:load shaves real
            TBT off mobile Lighthouse runs. */
        }
        <ThemeToggle client:idle />
      </div>
    </div>
  </div>

  {
    /* Main nav row. Phones centre the logo with the hamburger pinned right;
      from md the logo goes left so it lines up with the utility row above it;
      from lg the seven links and the Give button join it on the right. */
  }
  <div
    class="relative mx-auto flex max-w-content items-center justify-center border-b border-border px-m py-m md:justify-between"
  >
    <a
      href="/"
      class="inline-flex items-center transition-opacity hover:opacity-80"
      aria-label={`${brandName} home`}
    >
      {
        /*
        Single theme-aware logo. The img ships with NO src/srcset so the
        browser doesn't start fetching anything; the inline script below
        sets the right variant synchronously before paint based on the
        current html.dark state, then re-applies on theme-toggle and
        astro:after-swap (handled in the anti-FOUC script in BaseLayout).
        Net result: only one logo file is ever fetched per page load, and
        Lighthouse no longer sees a dark-variant in light-mode DOM (or
        vice-versa).

        Dimensions and aspect ratio match the wordmark's own 249.45:97.06,
        so the browser reserves the right layout box before the file lands —
        no CLS. This is NOT the old 280:60 lockup: the church's mark is a
        tower beside two words and is nearly three times as tall for its
        width, so the numbers here move with the file.
      */
      }
      {
        logo ? (
          /* An uploaded Site Settings logo replaces the pair above. It carries no
           data-theme-logo attribute, so the inline swap script below skips it
           and the one image serves both themes. */
          <img
            src={logoSrc}
            srcset={logoSrcset}
            sizes="280px"
            alt={logo.alt || brandName}
            class="h-12 w-auto"
            loading="eager"
            decoding="async"
          />
        ) : (
          <img
            alt={brandName}
            width={257}
            height={100}
            class="h-14 w-auto lg:h-20"
            loading="eager"
            decoding="async"
            data-theme-logo
            data-logo-light-src={logoLightImg.src}
            data-logo-light-srcset={logoLightSrcset}
            data-logo-dark-src={logoDarkImg.src}
            data-logo-dark-srcset={logoDarkSrcset}
          />
        )
      }
    </a>
    {
      /* Synchronous inline setup — runs immediately after the img element
        is parsed, so the src is set before the browser begins any image
        fetch. Re-applied across View Transitions navs by the anti-FOUC
        listener in BaseLayout. */
    }
    <script is:inline>
      (function () {
        const img = document.querySelector('header img[data-theme-logo]');
        if (!img) return;
        const dark = document.documentElement.classList.contains('dark');
        img.src = dark ? img.dataset.logoDarkSrc : img.dataset.logoLightSrc;
        img.srcset = dark ? img.dataset.logoDarkSrcset : img.dataset.logoLightSrcset;
      })();
    </script>

    {
      /* Nav + Give grouped on the right (lg+ only).

        The gaps tighten at lg and open back up at xl. Measured: seven links
        plus the button need about 585px of the 983px a 1024-wide viewport
        leaves inside the container, so the row fits on one line with room to
        spare and the utility row keeps its full phone number. */
    }
    <div class="hidden items-center gap-m lg:flex xl:gap-l">
      <nav class="site-nav flex items-center gap-5 xl:gap-l" aria-label="Primary">
        {
          NAV_ITEMS.map((item) =>
            item.kind === 'flat' ? (
              <a
                href={item.href}
                class:list={[
                  'nav-underline text-sm tracking-wide transition-colors',
                  isActive(item.href)
                    ? 'font-semibold text-link'
                    : 'text-foreground hover:text-link',
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ) : (
              <details class="site-nav__group relative">
                {/* <summary> is the disclosure toggle. It carries .nav-underline
                  so it gets the same underline as flat links, and
                  aria-current="page" (which locks the underline wide) when one
                  of its children is the active route. role/aria-expanded are
                  managed natively by <details>. */}
                <summary
                  class:list={[
                    'nav-underline text-sm tracking-wide transition-colors',
                    'inline-flex cursor-pointer list-none items-center gap-0.5 select-none',
                    'rounded-sm outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2',
                    isGroupActive(item.items)
                      ? 'font-semibold text-link'
                      : 'text-foreground hover:text-link',
                  ]}
                  aria-current={isGroupActive(item.items) ? 'page' : undefined}
                >
                  {item.label}
                  <ChevronDown
                    size={14}
                    className="site-nav__chevron mt-px transition-transform duration-150"
                    aria-hidden="true"
                  />
                </summary>

                {/* Menu panel. Absolutely positioned under the summary so it
                  doesn't shift layout. */}
                <div class="site-nav__menu absolute top-full left-0 z-50 mt-2 min-w-[200px] rounded-lg bg-popover p-1 text-popover-foreground shadow-md ring-1 ring-foreground/10">
                  {item.items.map((sub) => (
                    <a
                      href={sub.href}
                      class:list={[
                        'block rounded-md px-2.5 py-1.5 text-sm transition-colors',
                        'outline-none hover:bg-accent hover:text-accent-foreground focus-visible:bg-accent focus-visible:text-accent-foreground',
                        isActive(sub.href) ? 'font-semibold text-link' : 'text-foreground',
                      ]}
                      aria-current={isActive(sub.href) ? 'page' : undefined}
                    >
                      {sub.label}
                    </a>
                  ))}
                </div>
              </details>
            ),
          )
        }
      </nav>
      {
        headerCta.show && (
          <a
            href={headerCta.href}
            target={ctaIsExternal ? '_blank' : undefined}
            rel={ctaIsExternal ? 'noopener noreferrer' : undefined}
            class="press-tactile inline-flex min-h-[44px] items-center rounded-sm bg-gold px-m py-2 text-xs font-semibold tracking-eyebrow text-indigo-field uppercase transition-colors hover:bg-gold/90 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background focus-visible:outline-none"
          >
            {headerCta.label}
          </a>
        )
      }
    </div>

    {
      /* The drawer hydrates on idle, not client:only. The shadcn Sheet (Radix
        Dialog) server-renders its trigger button fine, and the portal mounts
        nothing until the drawer opens, so the hamburger is in the server HTML
        and React arrives behind requestIdleCallback rather than on the
        critical path. An Astro comment, not an HTML one, so it does not ship
        on every page. See docs/agent/components.md. */
    }
    <MobileNav
      client:idle
      links={NAV_LINKS}
      siteSettings={mobileNavSettings}
      logoLightUrl={logoLightWebpMobile.src}
      logoDarkUrl={logoDarkWebpMobile.src}
      {...mobileCtaProps}
    />
  </div>
</header>

<style>
  /* Desktop dropdown groups (native <details>). The links are server-rendered
     and fully usable with no JS; these styles + the script below add the
     dropdown affordances. */

  /* Hide the default disclosure triangle in every engine. */
  .site-nav__group > summary {
    list-style: none;
  }
  .site-nav__group > summary::-webkit-details-marker,
  .site-nav__group > summary::marker {
    display: none;
    content: '';
  }

  /* Rotate the chevron when the group is open. */
  .site-nav__group[open] > summary .site-nav__chevron {
    transform: rotate(180deg);
  }

  /* The menu panel starts hidden until the <details> is open. <details>
     natively hides non-summary children when closed, but we keep an explicit
     rule so the absolutely-positioned panel never flashes during hydration. */
  .site-nav__menu {
    display: none;
  }
  .site-nav__group[open] > .site-nav__menu {
    display: block;
  }
</style>

{
  /* Progressive enhancement for the desktop dropdown nav. Everything still
  works without this (native <details> toggles on click/Enter/Space, links
  are real <a> tags). This adds: open-on-hover with a small close delay,
  close-on-outside-click, close-on-Escape, and close-when-a-link-is-followed.
  Re-binds on astro:page-load so it survives View Transitions navigations. */
}
<script>
  // Query groups fresh each call — the nav DOM is replaced on every View
  // Transitions navigation, so a captured list would go stale.
  function currentGroups() {
    return Array.from(document.querySelectorAll<HTMLDetailsElement>('.site-nav__group'));
  }

  function closeAllGroups(except?: HTMLDetailsElement) {
    for (const g of currentGroups()) {
      if (g !== except) g.open = false;
    }
  }

  function initHeaderNav() {
    const groups = currentGroups();
    if (groups.length === 0) return;

    const closeAll = closeAllGroups;

    for (const group of groups) {
      const summary = group.querySelector('summary');
      let closeTimer: number | undefined;

      const cancelClose = () => {
        if (closeTimer) {
          window.clearTimeout(closeTimer);
          closeTimer = undefined;
        }
      };

      // Hover intent: open immediately on enter, close after a short delay on
      // leave so a diagonal mouse path to the menu doesn't snap it shut. Only
      // engages on pointers that can actually hover (skips touch).
      group.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'touch') return;
        cancelClose();
        closeAll(group);
        group.open = true;
      });
      group.addEventListener('pointerleave', (e) => {
        if (e.pointerType === 'touch') return;
        cancelClose();
        closeTimer = window.setTimeout(() => {
          group.open = false;
        }, 140);
      });

      // When opened via keyboard/click, make sure the others close.
      summary?.addEventListener('click', () => {
        // <details> toggles AFTER this handler, so the post-toggle state is the
        // inverse of the current one. If it's about to open, close the rest.
        if (!group.open) closeAll(group);
      });

      // Following a link inside the menu should close the group (so it isn't
      // left open behind the next page during a View Transitions swap).
      group.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          group.open = false;
        });
      });
    }
  }

  // Document-level listeners bind ONCE (guarded by a window flag), so they
  // don't stack up across View Transitions navigations. They query the nav
  // groups fresh each time they fire, so the swapped-in DOM is always covered.
  const w = window as typeof window & { __headerNavBound?: boolean };
  if (!w.__headerNavBound) {
    w.__headerNavBound = true;

    // Close any open group when clicking outside the nav.
    document.addEventListener('pointerdown', (e) => {
      const target = e.target as Node;
      if (!currentGroups().some((g) => g.contains(target))) closeAllGroups();
    });

    // Escape closes the open group and returns focus to its summary.
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const openGroup = currentGroups().find((g) => g.open);
      if (openGroup) {
        openGroup.open = false;
        openGroup.querySelector('summary')?.focus();
      }
    });
  }

  initHeaderNav();
  document.addEventListener('astro:page-load', initHeaderNav);
</script>
