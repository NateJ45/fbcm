---
// Foundation, edit with care
// Site header, in the church's own grammar.
//
// Redrawn 2026-09-20 (art-direction pass, task 3) from three stacked rows to
// ONE. What came off: the 4px indigo accent stripe and the whole utility row
// (phone, Contact, theme toggle). The phone and the Contact link now live in
// the mobile menu and the footer, which is where a visitor looks for them;
// repeating them across the top of every page bought nothing but 57px of
// chrome above the wordmark.
//
//   +-----------------------------------------------+  74px, 88px from lg
//   | [wordmark]   Visit  Our Church ... Blog  Watch live  [ GIVE ]
//   +-----------------------------------------------+
//
// Four things about the layout are deliberate.
//
//   1. ONE LEFT EDGE. The row uses the same `max-w-content px-gutter`
//      container the page bands and the footer use (CLAUDE.md rule 17), so the
//      wordmark and every heading down the page share a left edge.
//   2. ONE BUTTON FAMILY. Give is the only button in the header, and it draws
//      exactly what CtaLink's `gold` variant draws: a gold fill with an
//      indigo-FIELD label and the gold/indigo inset keyline. Not text-indigo:
//      --color-indigo flips to paper white under .dark (globals.css), which
//      would put 2.37:1 white-on-gold on the button in dark mode only.
//      --color-indigo-field stays dark in both themes.
//   3. OVERLAY MODE. When the page opens with an image hero the layout passes
//      `overlay`, which puts `data-overlay` on this element; the rules in
//      globals.css then strip the background and the rule, turn the lettering
//      paper, and pull the hero up underneath with a negative margin. The
//      polish script in BaseLayout adds `data-scrolled` when it pins the bar
//      (a scroll up past 150px slides it in over the page) and the bar becomes
//      ordinary paper. The logo swap below follows the same state.
//   4. WATCH LIVE (2026-09-24) sits beside Give in the nav's own quiet link
//      style, not as a second gold plate. It goes to Site settings' live
//      stream address (the channel when that is empty; nothing when both
//      are). It is built saying "Watch live", which is true at any moment,
//      and BaseLayout's inline script upgrades it to "Live now" with a
//      pulsing gold dot only during the Sunday service window, on the
//      church's clock (src/lib/live-service.ts).
//   5. No theme toggle. The site is light-only since 2026-09-24 (CLAUDE.md
//      rule 3); ThemeToggle.tsx is kept dormant and rendered nowhere.
//
// The seven links and the Give button both come from Sanity (Site Settings ->
// Navigation). Desktop nav is SERVER-RENDERED (CLAUDE.md rule 4): real <a>
// tags, crawlable, present before any JS runs.
//
// siteSettings is optional. Defaults render cleanly so the header works
// even before Sanity content is wired up.

import { getImage } from 'astro:assets';
import { site } from '@/data/site';
import MobileNav from './MobileNav';
import GoalsRow from '@/components/church/GoalsRow.astro';
import { ChevronDown } from 'lucide-react';
import logoLightAsset from '@/assets/logo-light.svg';
import logoDarkAsset from '@/assets/logo-dark.svg';
import menuWindowAsset from '@/assets/menu-window.jpg';
import menuRenderingAsset from '@/assets/menu-rendering-gold.webp';
import { splitStega } from '@/lib/preview-stega';
import { resolveSiteSettings, type RawChromeSettings } from '@/lib/siteSettings';
import { watchLiveHref } from '@/lib/live-service';
import { socialLinksOf, socialLinkLabel } from '@/lib/social-links';
import { urlFor } from '@/lib/sanity';

// SVG logos are passed through Astro's image pipeline for cache-busted URLs.
// SVGs are resolution-independent so no 1x/2x variants are needed — one URL
// serves all pixel densities. The same URL is used for both desktop and mobile.
const logoLightImg = await getImage({ src: logoLightAsset });
const logoDarkImg = await getImage({ src: logoDarkAsset });
const logoLightSrcset = logoLightImg.src;
const logoDarkSrcset = logoDarkImg.src;

// Mobile drawer logos — same SVG URLs, passed as plain strings into MobileNav.
const logoLightWebpMobile = logoLightImg;
const logoDarkWebpMobile = logoDarkImg;

// The stained-glass window behind the top of the mobile menu. 1200w covers a
// 430px-wide phone at 2x with room to spare, and quality 70 is plenty for a
// picture that renders at 22% opacity under a mask. Built here rather than in
// the island because a React component cannot call Astro's image pipeline.
const menuWindowImg = await getImage({
  src: menuWindowAsset,
  width: 1200,
  quality: 70,
  format: 'jpg',
});

interface Props {
  /** True when this page opens with an image hero, so the bar sits ON the
   *  picture until the visitor scrolls. Set by BaseLayout's `overlayHeader`. */
  overlay?: boolean;
  siteSettings?:
    | (RawChromeSettings & {
        siteName?: string;
        title?: string;
        tagline?: string;
        email?: string;
        phone?: string;
        serviceTime?: string;
        address?: string;
        youtubeUrl?: string;
        livestreamUrl?: string;
        socialLinks?: { platform?: string; url?: string; label?: string }[] | null;
        socialFacebook?: string;
        socialInstagram?: string;
      })
    | null;
}

const { siteSettings, overlay = false } = Astro.props as Props;

const brandName = siteSettings?.siteName ?? siteSettings?.title ?? site.name;

// The chrome (menu, header button, logo, the show/hide switches) resolves
// through one shared helper (see src/lib/siteSettings.ts) so the header, the
// drawer, and the footer can never disagree about what the menu is.
const chrome = resolveSiteSettings(siteSettings);
const headerCta = chrome.headerCta;
const logo = chrome.logo;
// The logo box is 48px tall (h-12), so 280w covers a wide wordmark at 1x and
// 560w covers it at 2x. Built with urlFor() rather than <SanityImage> because
// the header renders on EVERY page: importing that component would pull its
// module into the always-loaded chunk and rename the site-wide CSS bundle.
const logoSrc = logo ? urlFor(logo).width(280).quality(80).auto('format').url() : undefined;
const logoSrcset = logo
  ? [280, 560]
      .map((w) => `${urlFor(logo).width(w).quality(80).auto('format').url()} ${w}w`)
      .join(', ')
  : undefined;

// The church's Give button points wherever Site settings' Online giving box
// says (an outside address, so it opens in a new tab) or, until that box is
// filled again, at this site's own /give page (an internal destination, so it
// stays in this tab, the same as the built-in fallback or an editor who
// repoints it at a page here).
const ctaIsExternal = /^https?:\/\//i.test(headerCta.href);

// The two facts the mobile menu's foot states: when the church meets, and the
// street it meets on. Both are cleaned of their stega payload before they are
// handed to the island. The service time is only DISPLAYED, but the address is
// SPLIT on newlines, and the payload is written in zero-width characters of
// which U+FEFF matches \s in a JavaScript regex, so splitting an encoded
// string shatters the payload into fake lines (CLAUDE.md, the preview rules).
// Footer.astro does the same split the same way.
const serviceTime = splitStega(
  typeof siteSettings?.serviceTime === 'string' ? siteSettings.serviceTime : '',
).cleaned;
const street =
  splitStega(typeof siteSettings?.address === 'string' ? siteSettings.address : '')
    .cleaned.split(/\r?\n/)
    .map((line) => line.trim())
    .filter(Boolean)[0] ?? undefined;

// Where "Watch live" goes: the live stream, else the channel, else nowhere.
// Cleaned of stega because it becomes an href, and a URL with zero-width
// characters in it is a different URL.
const cleanUrl = (u: unknown) => (typeof u === 'string' ? splitStega(u).cleaned : undefined);
const watchHref = watchLiveHref(
  cleanUrl(siteSettings?.livestreamUrl),
  cleanUrl(siteSettings?.youtubeUrl),
);

// The church's accounts elsewhere, for the row at the foot of the mobile
// menu: the same derived list the footer and the Contact page draw
// (src/lib/social-links.ts), cut down to the three strings the island needs,
// with each link's accessible name ("First Baptist Church Muncie on
// Facebook") worked out here so the island imports nothing to build it.
// Absent when there are none, so the island's props do not grow for nothing.
const menuSocial = socialLinksOf(siteSettings).map((link) => ({
  platform: link.platform,
  url: link.url,
  label: socialLinkLabel(link, brandName),
}));
const menuSocialProps = menuSocial.length > 0 ? { social: menuSocial } : {};

// Subset of siteSettings the mobile menu needs. Pass as a plain object so the
// React island doesn't try to serialize the whole Sanity document graph.
const mobileNavSettings = siteSettings
  ? {
      tagline: siteSettings.tagline,
      email: chrome.showEmail ? siteSettings.email : undefined,
      phone: siteSettings.phone,
    }
  : null;

// The drawer's CTA prop is only passed when it DIFFERS from the drawer's own
// built-in button. An island's props are serialized into the page, so passing
// the default every time would rewrite the markup of every page for no change.
const mobileCtaProps =
  headerCta.show && headerCta.label === 'Contact us' && headerCta.href === '/contact'
    ? {}
    : { cta: headerCta };

// The menu comes from Sanity (Site Settings -> Navigation). Both the mapping
// and the built-in safety-net menu live in src/lib/siteSettings.ts, so the
// header, the drawer, and the footer read one source. Empty in Sanity = the
// built-in menu.
//
// Flat items render as plain anchor links; dropdown items render as native
// <details>/<summary> disclosure groups. Why <details> and not a React island:
// the desktop nav must exist in the server-rendered HTML so crawlers see every
// internal link and there is no flash-of-missing-nav before hydration. The
// progressive-enhancement script at the bottom of this file adds open-on-hover,
// close-on-outside-click, close-on-Escape and close-on-navigation; the links
// work without it. The church's own menu is seven flat links with no group, but
// the machinery stays so an editor can add one without a code change.
const NAV_ITEMS = chrome.headerNav;

// Flatten NAV_ITEMS into the shape MobileNav expects (a list of NavLink[]
// with optional sub-items for the groups). MobileNav already handles both
// shapes via its updated interface.
const NAV_LINKS = NAV_ITEMS;

const pathname = Astro.url.pathname;
function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
// A dropdown group is "active" (its trigger underline locks wide + aria-current
// is set) when the current route matches any of its child links.
function isGroupActive(items: { href: string }[]) {
  return items.some((item) => isActive(item.href));
}
---

<header class="site-header" data-overlay={overlay ? '' : undefined}>
  {
    /* ONE row. `relative` is load-bearing: MobileNav's trigger positions
      itself absolutely against this box. The fixed height (rather than
      vertical padding) is what lets --header-offset and the overlay mode's
      negative margin both be a single known number. */
  }
  <div
    class="relative mx-auto flex h-[74px] max-w-content items-center justify-between px-gutter lg:h-[88px]"
  >
    <a
      href="/"
      class="inline-flex items-center transition-opacity hover:opacity-80"
      aria-label={`${brandName} home`}
    >
      {
        /*
        Single theme-aware logo. The img ships with NO src/srcset so the
        browser doesn't start fetching anything; the inline script below sets
        the right variant synchronously before paint from the current
        html.dark state AND the header's overlay state, then re-applies on
        theme-toggle, on the header:scrolled event, and on astro:after-swap
        (handled in the anti-FOUC script in BaseLayout). Net result: only one
        logo file is ever fetched per page load.

        Dimensions and aspect ratio match the wordmark's own 249.45:97.06, so
        the browser reserves the right layout box before the file lands. No CLS.
      */
      }
      {
        logo ? (
          /* An uploaded Site Settings logo replaces the pair above. It carries no
           data-theme-logo attribute, so the inline swap script below skips it
           and the one image serves both themes. */
          <img
            src={logoSrc}
            srcset={logoSrcset}
            sizes="280px"
            alt={logo.alt || brandName}
            class="h-12 w-auto lg:h-14"
            loading="eager"
            decoding="async"
          />
        ) : (
          <img
            alt={brandName}
            width={257}
            height={100}
            class="h-12 w-auto lg:h-14"
            loading="eager"
            decoding="async"
            data-theme-logo
            data-logo-light-src={logoLightImg.src}
            data-logo-light-srcset={logoLightSrcset}
            data-logo-dark-src={logoDarkImg.src}
            data-logo-dark-srcset={logoDarkSrcset}
          />
        )
      }
    </a>
    {
      /* Synchronous inline setup, right after the img element is parsed, so the
        src is set before the browser begins any image fetch.

        Overlay mode reads the DARK file (paper lettering) whatever the theme
        is, because the bar is sitting on a dark photograph. Once the polish
        script adds data-scrolled the bar is ordinary paper again and the logo
        goes back to following the theme, which is what the `header:scrolled`
        listener is for. Re-applied across View Transitions navs by the
        anti-FOUC listener in BaseLayout, which makes the same overlay check. */
    }
    <script is:inline>
      (function () {
        const header = document.querySelector('header.site-header');
        const img = header && header.querySelector('img[data-theme-logo]');
        if (!img) return;
        function applyLogo() {
          const onPicture =
            header.hasAttribute('data-overlay') && !header.hasAttribute('data-scrolled');
          const dark = onPicture || document.documentElement.classList.contains('dark');
          img.src = dark ? img.dataset.logoDarkSrc : img.dataset.logoLightSrc;
          img.srcset = dark ? img.dataset.logoDarkSrcset : img.dataset.logoLightSrcset;
        }
        applyLogo();
        window.addEventListener('header:scrolled', applyLogo);
      })();
    </script>

    {/* Nav, Watch live and Give grouped on the right (lg+ only). */}
    <div class="hidden items-center gap-m lg:flex xl:gap-l">
      <nav class="site-nav flex items-center gap-5 xl:gap-l" aria-label="Primary">
        {
          NAV_ITEMS.map((item) =>
            item.kind === 'flat' ? (
              <a
                href={item.href}
                class:list={[
                  'nav-underline py-1 font-ui text-[0.9375rem] font-medium tracking-[0.01em] transition-colors',
                  isActive(item.href) ? 'text-link' : 'text-foreground hover:text-link',
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ) : (
              <details class="site-nav__group relative">
                {/* <summary> is the disclosure toggle. It carries .nav-underline
                  so it gets the same gold rule as flat links, and
                  aria-current="page" (which locks the rule wide) when one of
                  its children is the active route. role/aria-expanded are
                  managed natively by <details>. */}
                <summary
                  class:list={[
                    'nav-underline py-1 font-ui text-[0.9375rem] font-medium tracking-[0.01em] transition-colors',
                    'inline-flex cursor-pointer list-none items-center gap-0.5 select-none',
                    'rounded-sm outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2',
                    isGroupActive(item.items) ? 'text-link' : 'text-foreground hover:text-link',
                  ]}
                  aria-current={isGroupActive(item.items) ? 'page' : undefined}
                >
                  {item.label}
                  <ChevronDown
                    size={14}
                    className="site-nav__chevron mt-px transition-transform duration-150"
                    aria-hidden="true"
                  />
                </summary>

                {/* Menu panel. Absolutely positioned under the summary so it
                  doesn't shift layout. A hairline and a flat surface, no
                  shadow: this pass draws depth with rules, not drop shadows. */}
                <div class="site-nav__menu absolute top-full left-0 z-50 mt-2 min-w-[200px] rounded-sm border border-hair bg-background p-1 text-popover-foreground">
                  {item.items.map((sub) => (
                    <a
                      href={sub.href}
                      class:list={[
                        'block rounded-sm px-2.5 py-1.5 font-ui text-[0.9375rem] transition-colors',
                        'outline-none hover:bg-accent hover:text-accent-foreground focus-visible:bg-accent focus-visible:text-accent-foreground',
                        isActive(sub.href) ? 'font-semibold text-link' : 'text-foreground',
                      ]}
                      aria-current={isActive(sub.href) ? 'page' : undefined}
                    >
                      {sub.label}
                    </a>
                  ))}
                </div>
              </details>
            ),
          )
        }
      </nav>
      {/* scaffold: journal */}
      {
        /* Search (2026-09-24): the nav's own quiet style, a glass drawn in
          currentColor so it follows the bar (paper over an image hero, ink on
          paper). A button, not a link: it opens the search dialog, which
          search-dialog.ts loads on the first click and never before. */
      }
      <button
        type="button"
        data-search-open
        aria-haspopup="dialog"
        class="site-search-btn nav-underline inline-flex min-h-[44px] min-w-[44px] items-center justify-center py-1 text-foreground transition-colors hover:text-link"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="8.5" cy="8.5" r="6"></circle>
          <path d="M13 13l5 5"></path>
        </svg>
        <span class="sr-only">Search the site</span>
      </button>
      {/* scaffold:end */}
      {
        /* Watch live: the nav's own link style, so Give stays the one plate.
          data-live-service carries the cleaned service time for the upgrade
          script in BaseLayout, which sets data-live (the dot shows) and swaps
          the label to "Live now" during the service. The dot is decorative;
          the words carry the state, so the accessible name changes with them. */
        watchHref && (
          <a
            href={watchHref}
            target="_blank"
            rel="noopener noreferrer"
            data-live-service={serviceTime}
            class="watch-live nav-underline inline-flex items-center gap-2 py-1 font-ui text-[0.9375rem] font-medium tracking-[0.01em] whitespace-nowrap text-foreground transition-colors hover:text-link"
          >
            <span class="live-dot" aria-hidden="true" />
            <span data-live-label>Watch live</span>
          </a>
        )
      }
      {
        headerCta.show && (
          <a
            href={headerCta.href}
            target={ctaIsExternal ? '_blank' : undefined}
            rel={ctaIsExternal ? 'noopener noreferrer' : undefined}
            class="header-give press-tactile inline-flex min-h-[44px] items-center justify-center rounded-sm bg-gold px-[1.6em] py-[1.05em] font-ui text-ui font-semibold text-indigo-field shadow-[inset_0_0_0_3px_var(--color-gold),inset_0_0_0_4px_var(--color-indigo-field)] hover:-translate-y-px focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background focus-visible:outline-none"
          >
            {headerCta.label}
          </a>
        )
      }
    </div>

    {
      /* The drawer hydrates on idle, not client:only. The shadcn Sheet (Radix
        Dialog) server-renders its trigger button fine, and the portal mounts
        nothing until the drawer opens, so the hamburger is in the server HTML
        and React arrives behind requestIdleCallback rather than on the
        critical path. Its trigger inherits `color`, so it reads as paper over
        an image hero and as ink on the ordinary bar. An Astro comment, not an
        HTML one, so it does not ship on every page. */
    }
    <MobileNav
      client:idle
      links={NAV_LINKS}
      siteSettings={mobileNavSettings}
      logoLightUrl={logoLightWebpMobile.src}
      logoDarkUrl={logoDarkWebpMobile.src}
      serviceTime={serviceTime || undefined}
      street={street}
      watchUrl={watchHref}
      windowUrl={menuWindowImg.src}
      renderingUrl={menuRenderingAsset.src}
      {...mobileCtaProps}
      {...menuSocialProps}
    >
      <GoalsRow size="menu" />
    </MobileNav>
  </div>
</header>

<style>
  /* Desktop dropdown groups (native <details>). The links are server-rendered
     and fully usable with no JS; these styles + the script below add the
     dropdown affordances. */

  /* Hide the default disclosure triangle in every engine. */
  .site-nav__group > summary {
    list-style: none;
  }
  .site-nav__group > summary::-webkit-details-marker,
  .site-nav__group > summary::marker {
    display: none;
    content: '';
  }

  /* Rotate the chevron when the group is open. */
  .site-nav__group[open] > summary .site-nav__chevron {
    transform: rotate(180deg);
  }

  /* The menu panel starts hidden until the <details> is open. <details>
     natively hides non-summary children when closed, but we keep an explicit
     rule so the absolutely-positioned panel never flashes during hydration. */
  .site-nav__menu {
    display: none;
  }
  .site-nav__group[open] > .site-nav__menu {
    display: block;
  }
</style>

{
  /* Progressive enhancement for the desktop dropdown nav. Everything still
  works without this (native <details> toggles on click/Enter/Space, links
  are real <a> tags). This adds: open-on-hover with a small close delay,
  close-on-outside-click, close-on-Escape, and close-when-a-link-is-followed.
  Re-binds on astro:page-load so it survives View Transitions navigations. */
}
<script>
  // Query groups fresh each call — the nav DOM is replaced on every View
  // Transitions navigation, so a captured list would go stale.
  function currentGroups() {
    return Array.from(document.querySelectorAll<HTMLDetailsElement>('.site-nav__group'));
  }

  function closeAllGroups(except?: HTMLDetailsElement) {
    for (const g of currentGroups()) {
      if (g !== except) g.open = false;
    }
  }

  function initHeaderNav() {
    const groups = currentGroups();
    if (groups.length === 0) return;

    const closeAll = closeAllGroups;

    for (const group of groups) {
      const summary = group.querySelector('summary');
      let closeTimer: number | undefined;

      const cancelClose = () => {
        if (closeTimer) {
          window.clearTimeout(closeTimer);
          closeTimer = undefined;
        }
      };

      // Hover intent: open immediately on enter, close after a short delay on
      // leave so a diagonal mouse path to the menu doesn't snap it shut. Only
      // engages on pointers that can actually hover (skips touch).
      group.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'touch') return;
        cancelClose();
        closeAll(group);
        group.open = true;
      });
      group.addEventListener('pointerleave', (e) => {
        if (e.pointerType === 'touch') return;
        cancelClose();
        closeTimer = window.setTimeout(() => {
          group.open = false;
        }, 140);
      });

      // When opened via keyboard/click, make sure the others close.
      summary?.addEventListener('click', () => {
        // <details> toggles AFTER this handler, so the post-toggle state is the
        // inverse of the current one. If it's about to open, close the rest.
        if (!group.open) closeAll(group);
      });

      // Following a link inside the menu should close the group (so it isn't
      // left open behind the next page during a View Transitions swap).
      group.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          group.open = false;
        });
      });
    }
  }

  // Document-level listeners bind ONCE (guarded by a window flag), so they
  // don't stack up across View Transitions navigations. They query the nav
  // groups fresh each time they fire, so the swapped-in DOM is always covered.
  const w = window as typeof window & { __headerNavBound?: boolean };
  if (!w.__headerNavBound) {
    w.__headerNavBound = true;

    // Close any open group when clicking outside the nav.
    document.addEventListener('pointerdown', (e) => {
      const target = e.target as Node;
      if (!currentGroups().some((g) => g.contains(target))) closeAllGroups();
    });

    // Escape closes the open group and returns focus to its summary.
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const openGroup = currentGroups().find((g) => g.open);
      if (openGroup) {
        openGroup.open = false;
        openGroup.querySelector('summary')?.focus();
      }
    });
  }

  initHeaderNav();
  document.addEventListener('astro:page-load', initHeaderNav);
</script>
