---
// Safe to edit by hand
// Picks the component for one builder-kit block (builderSections.ts, starter
// PORTS.md card 173). SectionRenderer hands every builder block here in one
// branch, so the kit grows without touching the shared renderer again. Every
// component is empty-safe: a block with nothing to show (a notice outside its
// dates, an event whose dates have all passed, a schedule with nothing in it)
// renders nothing.
import '@/styles/builder-blocks.css';
import type { BuilderPageBlock } from '@/lib/builderBlocks.types';
import type { SectionSiteSettings } from '@/lib/pageBuilder.types';
import ColumnsBlock from './ColumnsBlock.astro';
import ButtonRowBlock from './ButtonRowBlock.astro';
import PhotoBlock from './PhotoBlock.astro';
import TabsBlock from './TabsBlock.astro';
import CountdownBlock from './CountdownBlock.astro';
import NoticeBlock from './NoticeBlock.astro';
import EventDetailsBlock from './EventDetailsBlock.astro';
import ScheduleBlock from './ScheduleBlock.astro';

interface Props {
  block: BuilderPageBlock;
  /** The cadence's paper for this row (rule 9). */
  surface?: 'background' | 'muted';
  headingId: string;
  /** Site settings, for the event's default place (the church's address). */
  settings?: SectionSiteSettings | null;
  /** True for the first section on the page: its photo loads first. */
  isFirst?: boolean;
}

const { block: b, surface = 'background', headingId, settings, isFirst = false } = Astro.props;
const common = { surface, headingId };
---

{b._type === 'columnsSection' ? (
  <ColumnsBlock block={b} {...common} />
) : b._type === 'buttonRowSection' ? (
  <ButtonRowBlock block={b} {...common} />
) : b._type === 'photoSection' ? (
  <PhotoBlock block={b} {...common} isFirst={isFirst} />
) : b._type === 'tabsSection' ? (
  <TabsBlock block={b} {...common} />
) : b._type === 'countdownSection' ? (
  <CountdownBlock block={b} {...common} />
) : b._type === 'noticeSection' ? (
  <NoticeBlock block={b} />
) : b._type === 'eventDetailsSection' ? (
  <EventDetailsBlock block={b} {...common} settings={settings} isFirst={isFirst} />
) : b._type === 'scheduleSection' ? (
  <ScheduleBlock block={b} {...common} />
) : null}
