---
// Safe to edit by hand
// The frame most builder-kit blocks share (builderSections.ts, starter PORTS.md
// card 173): the paper the cadence gave the row (rule 9), the content column on
// the page's one left edge (the gutter, rule 17), and the optional heading and
// intro in the church's band grammar: the h2 in Castoro Titling at text-h2
// (H2_DISPLAY, fitted so no word breaks), indigo on paper, the intro in the
// reading face under it. A block with no heading is named by `label`, so its
// region still has a name for screen readers.
import { H2_DISPLAY, headingFit } from '@/lib/heading-grammar';
import { surfaceClass } from '@/lib/surfaces';

interface Props {
  heading?: string | null;
  intro?: string | null;
  headingId: string;
  surface?: 'background' | 'muted';
  /** The region's name when there is no heading. */
  label?: string;
  /** The block's _type, for tests and the thumbnail script. */
  type: string;
}

const { heading, intro, headingId, surface = 'background', label, type } = Astro.props;
---

<section
  class:list={[surfaceClass(surface), 'bb']}
  data-builder-block={type}
  aria-labelledby={heading ? headingId : undefined}
  aria-label={!heading ? label : undefined}
>
  <div class="mx-auto max-w-content px-gutter py-section-lg">
    {(heading || intro) && (
      <div class="bb-head">
        {heading && (
          <h2
            id={headingId}
            class:list={[H2_DISPLAY, 'h-fit text-indigo']}
            style={headingFit(heading)}
          >
            <span class="h-fit-in">{heading}</span>
          </h2>
        )}
        {intro && <p class="bb-intro">{intro}</p>}
      </div>
    )}
    <slot />
  </div>
</section>
