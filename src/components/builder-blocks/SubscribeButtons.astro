---
// Safe to edit by hand
// "Add to your calendar" buttons for one calendar feed (starter PORTS.md card 193, from FBC
// Auburn): Google, Apple (and desktop Outlook, which opens webcal links) and Outlook on the web,
// derived from the one feed address by subscribeLinks() (rule 15). A subscription keeps itself up
// to date on the phone, which a downloaded .ics does not. The feed can be an https:// or webcal://
// address (the church's Church Trac feed by default) or a path on this site ("/visit/sunday.ics").
// Draws nothing without a usable feed. The buttons are CtaLink's outline, this site's one button
// family (the starter draws its own class string here).
import CtaLink from '@/components/CtaLink.astro';
import { subscribeLinks } from '@/lib/builder-blocks';
import { site } from '@/data/site';

interface Props {
  feed?: string | null;
  /** The calendar's name, shown in Outlook's subscribe dialog. */
  name?: string;
}
const { feed, name = site.name } = Astro.props;
const links = subscribeLinks(feed, name, site.url);
const ext = (label: string, href: string, openInNewTab = true) => ({
  label,
  linkType: 'external' as const,
  externalUrl: href,
  openInNewTab,
});
---

{links && (
  <div class="bb-actions" data-bb-subscribe>
    <CtaLink cta={ext('Google Calendar', links.google)} variant="outline" />
    <CtaLink cta={ext('Apple Calendar', links.apple, false)} variant="outline" />
    <CtaLink cta={ext('Outlook', links.outlook)} variant="outline" />
  </div>
)}
