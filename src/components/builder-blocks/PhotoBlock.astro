---
// Safe to edit by hand
// One wide photo across the content column, square-cornered and without a
// visible caption (DESIGN.md: photographs carry no radius, shadow or caption).
// It fades in as it reaches the screen ([data-reveal] is allowed on figures).
// Two or more photos side by side is the gallery block; a photo beside words is
// image and text.
import BuilderBand from './BuilderBand.astro';
import SanityImage from '@/components/SanityImage.astro';
import type { ProjectedPhotoSection } from '@/lib/builderBlocks.types';
import type { SanityImageObject } from '@/lib/pageBuilder.types';

interface Props {
  block: ProjectedPhotoSection;
  surface?: 'background' | 'muted';
  headingId: string;
  isFirst?: boolean;
}
const { block, surface, headingId, isFirst = false } = Astro.props;
const image = block.image?.asset ? (block.image as SanityImageObject) : null;
---

{image && (
  <BuilderBand
    type={block._type}
    headingId={headingId}
    surface={surface}
    label={image.alt || 'Photo'}
  >
    <figure class="bb-photo" data-reveal>
      <SanityImage
        source={image}
        width={1600}
        sizes="(min-width: 82.5rem) 80rem, 95vw"
        quality={72}
        loading={isFirst ? 'eager' : 'lazy'}
        fetchpriority={isFirst ? 'high' : undefined}
      />
    </figure>
  </BuilderBand>
)}
