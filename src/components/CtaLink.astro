---
// Safe to edit by hand
// Resolves a Sanity ctaBlock to the right <a href>:
//   - internal: maps the referenced page _type to its route (homePage → /, etc.)
//   - external: passes through the URL, opens in new tab by default
//   - email: builds a mailto: link
//   - phone: builds a tel: link
//
// ONE BUTTON FAMILY (2026-09-19, plan 2b task 1). There are exactly two looks
// on this site now, plus a tone modifier:
//   - "gold" — indigo-field label on a gold fill (4.90:1, gated in
//     theme-tokens.test.ts). NOT --color-indigo, which measures 5.60:1 but
//     flips to paper-white under .dark; indigo-field holds its value in both
//     themes, which is why the header and the mobile drawer use it too. Gold
//     never changes on a dark band: it is a fill in both themes and the indigo
//     label on it clears AA either way.
//   - "outline" — indigo outline on light; under onDark, a white outline,
//     which is what the indigo and brown bands ask for.
//   - "link" — NOT a button. A plain text link in --link with the shared
//     nav-underline hover, for a place where a row of buttons would be four
//     buttons shouting at once (the link-cards band). Added 2026-09-19 so that
//     ctaBlock href resolution stays in ONE file: a component drawing its own
//     <a> would have had to re-implement resolveHref() below, and the second
//     copy is the one that forgets /post/<slug>.
//   - `onDark` toggle — for CTAs sitting over a dark surface (hero image
//     overlay, a fixed indigo or brown band). Passing a `class` override to
//     recolor does not work: Tailwind v4 generates utilities alphabetically, so
//     `text-link` beats `text-bg` in the cascade. Use onDark={true}.
//
// THE RETIRED BRONZE PAIR. "primary" and "secondary" were the starter's bronze
// CTA pill and its bronze-outlined twin. Plan 2a added gold/outline ALONGSIDE
// them so the starter's own pages kept rendering unchanged; plan 2b retires the
// bronze pair, because CLAUDE.md rule 17 says buttons come from one family and
// a page drawing from two reads as unfinished for a reason no single band is
// responsible for. They survive as ALIASES so every existing caller keeps
// compiling and every existing page picks up the church look for free:
//   primary   -> gold
//   secondary -> outline
// Write gold/outline in new code. The aliases are for callers that have not
// been visited yet, not a second family wearing the first one's clothes.
//
// All variants share generous padding, uppercase tracking, and a 44×44 minimum tap target.

interface CtaBlock {
  label?: string;
  linkType?: 'internal' | 'external' | 'email' | 'phone';
  internalLink?: { _type?: string; slug?: string } | null;
  externalUrl?: string;
  emailAddress?: string;
  phoneNumber?: string;
  openInNewTab?: boolean;
}

interface Props {
  cta?: CtaBlock | null;
  /**
   * `gold` and `outline` are the names to use. `primary` and `secondary` are
   * deprecated aliases for them (see the header): kept so old callers compile,
   * not a separate look.
   */
  variant?: 'primary' | 'secondary' | 'gold' | 'outline' | 'link';
  /** When true, swap variant colors for legibility on a dark surface. */
  onDark?: boolean;
  /** Fallback href if the CTA can't be resolved (e.g., siteSettings hasn't been populated). */
  fallbackHref?: string;
  /** Fallback label if cta.label is missing. */
  fallbackLabel?: string;
  class?: string;
}

const {
  cta,
  variant = 'gold',
  onDark = false,
  fallbackHref = '/contact',
  fallbackLabel = 'Get in touch',
  class: extraClass = '',
} = Astro.props as Props;

// Map Sanity document _type to its route. Mirrors the routes in src/pages/.
// Singletons go to a fixed path; journalEntry uses {slug} for the dynamic
// /post/[slug] route.
const TYPE_TO_PATH: Record<string, string> = {
  homePage: '/',
  contactPage: '/contact',
  journalPage: '/blog', // scaffold: journal
};

function resolveHref(c?: CtaBlock | null): string {
  if (!c?.linkType) return fallbackHref;
  switch (c.linkType) {
    case 'internal': {
      const t = c.internalLink?._type;
      if (!t) return fallbackHref;
      // Slug-based types need the slug appended. Singletons use a fixed path.
      // scaffold: journal
      if (t === 'journalEntry' && c.internalLink?.slug) {
        return `/post/${c.internalLink.slug}`;
      }
      // scaffold:end
      // Custom pages (type 'page') route via /[slug].astro.
      if (t === 'page' && c.internalLink?.slug) {
        return `/${c.internalLink.slug}`;
      }
      return TYPE_TO_PATH[t] ?? fallbackHref;
    }
    case 'external':
      return c.externalUrl ?? fallbackHref;
    case 'email':
      return c.emailAddress ? `mailto:${c.emailAddress}` : fallbackHref;
    case 'phone':
      return c.phoneNumber ? `tel:${c.phoneNumber.replace(/[^\d+]/g, '')}` : fallbackHref;
    default:
      return fallbackHref;
  }
}

const href = resolveHref(cta);
const label = cta?.label ?? fallbackLabel;
const isExternal = cta?.linkType === 'external';
// An explicit `openInNewTab: false` is now honoured, even on an external link.
// It has to be: since plan 2b task 4, a same-site path that a reference cannot
// express ("/history#building", "/blog") rides in on `externalUrl`, and sending
// the visitor to a second tab for a link inside the same site is wrong. Only an
// UNSET value falls back to the old default of opening an off-site URL in a new
// tab, so nothing an editor wrote before this change moves.
const newTab = cta?.openInNewTab ?? isExternal;

// Focus ring offset uses --background by default, but under onDark we offset
// against transparent so the ring still reads on the photographic surface.
// The text-link look shares nothing with the button base: no pill padding, no
// uppercase tracking, no 44px floor (WCAG 2.5.8 exempts a link in a block of
// text, and this one sits at the foot of a card's prose).
const linkClasses = onDark
  ? 'nav-underline inline-block text-sm font-semibold text-bg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-transparent'
  : 'nav-underline inline-block text-sm font-semibold text-link focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background';

const baseClasses = onDark
  ? 'press-tactile inline-flex items-center justify-center min-h-[44px] px-l py-s text-xs font-semibold uppercase tracking-[0.18em] rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-transparent'
  : 'press-tactile inline-flex items-center justify-center min-h-[44px] px-l py-s text-xs font-semibold uppercase tracking-[0.18em] rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background';

// The two looks, and the two aliases that resolve into them. The aliases are
// resolved HERE, in one expression, rather than at each call site: that is the
// whole point of keeping them, and it is why `onDark` keeps working through an
// alias. A `secondary` caller on a dark band now gets outline's OWN onDark
// classes, not a bronze button sitting on indigo.
const resolved = variant === 'primary' ? 'gold' : variant === 'secondary' ? 'outline' : variant;

const variantClasses = (() => {
  if (resolved === 'gold') {
    return 'bg-gold text-indigo-field hover:bg-gold/90';
  }
  // outline. text-bg, not text-cream: --color-cream FLIPS to ink in dark mode
  // (see globals.css .dark), while --color-bg stays paper-white in both, which
  // is what a fixed dark band needs.
  return onDark
    ? 'border border-bg/70 text-bg hover:bg-bg/10 hover:border-bg'
    : 'border border-indigo text-indigo hover:bg-indigo/5';
})();
---

<a
  href={href}
  class:list={resolved === 'link'
    ? [linkClasses, extraClass]
    : [baseClasses, variantClasses, extraClass]}
  target={newTab ? '_blank' : undefined}
  rel={newTab ? 'noopener noreferrer' : undefined}
>
  {label}
</a>
