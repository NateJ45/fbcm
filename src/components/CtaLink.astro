---
// Safe to edit by hand
// Resolves a Sanity ctaBlock to the right <a href>:
//   - internal: maps the referenced page _type to its route (homePage → /, etc.)
//   - external: passes through the URL, opens in new tab by default
//   - email: builds a mailto: link
//   - phone: builds a tel: link
//
// ONE BUTTON FAMILY (2026-09-19, plan 2b task 1). There are exactly two looks
// on this site now, plus a tone modifier:
//   - "gold" — indigo-field label on a gold fill (4.90:1, gated in
//     theme-tokens.test.ts). NOT --color-indigo, which measures 5.60:1 but
//     flips to paper-white under .dark; indigo-field holds its value in both
//     themes, which is why the header and the mobile drawer use it too. Gold
//     never changes on a dark band: it is a fill in both themes and the indigo
//     label on it clears AA either way.
//   - "outline" — indigo outline on light; under onDark, a white outline,
//     which is what the indigo and brown bands ask for.
//   - "link" — NOT a button. A plain text link in --link, underlined on the
//     baseline, with a trailing arrow that nudges 4px on hover. For a place
//     where a row of buttons would be four
//     buttons shouting at once (the link-cards band). Added 2026-09-19 so that
//     ctaBlock href resolution stays in ONE place: a component drawing its own
//     <a> would have had to re-implement the mapping, and the second copy is
//     the one that forgets /post/<slug>. That mapping now lives in
//     src/lib/cta-href.ts, which this file and the statement band both import.
//   - `onDark` toggle — for CTAs sitting over a dark surface (hero image
//     overlay, a fixed indigo or brown band). Passing a `class` override to
//     recolor does not work: Tailwind v4 generates utilities alphabetically, so
//     `text-link` beats `text-bg` in the cascade. Use onDark={true}.
//
// THE RETIRED BRONZE PAIR. "primary" and "secondary" were the starter's bronze
// CTA pill and its bronze-outlined twin. Plan 2a added gold/outline ALONGSIDE
// them so the starter's own pages kept rendering unchanged; plan 2b retires the
// bronze pair, because CLAUDE.md rule 17 says buttons come from one family and
// a page drawing from two reads as unfinished for a reason no single band is
// responsible for. They survive as ALIASES so every existing caller keeps
// compiling and every existing page picks up the church look for free:
//   primary   -> gold
//   secondary -> outline
// Write gold/outline in new code. The aliases are for callers that have not
// been visited yet, not a second family wearing the first one's clothes.
//
//   rule      -> gold
//     "rule" was the square church-identity button with a bar beneath and
//     rays (2026-09-23, Who We Are). Nathan preferred the header's GIVE plate,
//     so the same day it became an alias for gold: one button family.
//
//   `onGold` toggle (2026-09-23, the Home give band) — for an outline button
//     on the FIXED gold band. The ordinary outline inks in --foreground, which
//     flips to paper-white under .dark, and its inset rule is drawn in
//     --color-bg, a cream ring on gold. onGold draws the same plate in
//     --color-band-ink (never flips; 6.75:1 on gold, gated in
//     theme-tokens.test.ts) with the pseudo-element rule onDark uses.
//
// All variants are set in the UI face at the shared label size, and the two
// button variants share the inset double rule, em-based padding and a 44x44
// minimum tap target.

import { resolveCtaHref, type CtaBlock } from '@/lib/cta-href';

interface Props {
  cta?: CtaBlock | null;
  /**
   * `gold` and `outline` are the names to use. `primary` and `secondary` are
   * deprecated aliases for them (see the header): kept so old callers compile,
   * not a separate look.
   */
  variant?: 'primary' | 'secondary' | 'gold' | 'outline' | 'link' | 'rule';
  /** When true, swap variant colors for legibility on a dark surface. */
  onDark?: boolean;
  /** Outline and link: dark ink on the fixed gold band, in both themes. */
  onGold?: boolean;
  /** Fallback href if the CTA can't be resolved (e.g., siteSettings hasn't been populated). */
  fallbackHref?: string;
  /** Fallback label if cta.label is missing. */
  fallbackLabel?: string;
  class?: string;
}

const {
  cta,
  variant = 'gold',
  onDark = false,
  onGold = false,
  fallbackHref = '/contact',
  fallbackLabel = 'Get in touch',
  class: extraClass = '',
} = Astro.props as Props;

// The ctaBlock -> href mapping lives in src/lib/cta-href.ts, so the statement
// band's ruled row (whose whole card is the <a>) can resolve the same hrefs
// without a second copy of it. See the note at the top of that file.
const href = resolveCtaHref(cta, fallbackHref);
const label = cta?.label ?? fallbackLabel;
const isExternal = cta?.linkType === 'external';
// An explicit `openInNewTab: false` is now honoured, even on an external link.
// It has to be: since plan 2b task 4, a same-site path that a reference cannot
// express ("/history#building", "/blog") rides in on `externalUrl`, and sending
// the visitor to a second tab for a link inside the same site is wrong. Only an
// UNSET value falls back to the old default of opening an off-site URL in a new
// tab, so nothing an editor wrote before this change moves.
const newTab = cta?.openInNewTab ?? isExternal;

// Focus ring offset uses --background by default, but under onDark we offset
// against transparent so the ring still reads on the photographic surface.
// The text-link look shares nothing with the button base: no plate, no
// em padding, no 44px floor (WCAG 2.5.8 exempts a link in a block of text, and
// this one sits at the foot of a card's prose).
// The text link is the UI face, underlined on the baseline, with a trailing
// arrow that nudges on hover. `group` is on the <a> so the arrow can react to
// the link's hover without a second hover target.
// onGold (2026-09-24, the gold closing band): the link in band ink, which
// never flips, so it reads on the fixed gold ground in both themes.
const linkClasses = onGold
  ? 'group font-ui text-ui font-semibold border-b border-current pb-1 inline-flex gap-2 items-center text-band-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-band-ink focus-visible:ring-offset-2 focus-visible:ring-offset-transparent'
  : onDark
    ? 'group font-ui text-ui font-semibold border-b border-current pb-1 inline-flex gap-2 items-center text-bg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-transparent'
    : 'group font-ui text-ui font-semibold border-b border-current pb-1 inline-flex gap-2 items-center text-link focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background';

// The button plate. Padding is in em so it tracks the label's own size, and
// the 44px floor stays for the tap target.
const baseClasses = onGold
  ? 'press-tactile inline-flex items-center justify-center min-h-[44px] font-ui text-ui font-semibold px-[1.6em] py-[1.05em] rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-band-ink focus-visible:ring-offset-2 focus-visible:ring-offset-transparent'
  : onDark
    ? 'press-tactile inline-flex items-center justify-center min-h-[44px] font-ui text-ui font-semibold px-[1.6em] py-[1.05em] rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-transparent'
    : 'press-tactile inline-flex items-center justify-center min-h-[44px] font-ui text-ui font-semibold px-[1.6em] py-[1.05em] rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background';

// The two looks, and the two aliases that resolve into them. The aliases are
// resolved HERE, in one expression, rather than at each call site: that is the
// whole point of keeping them, and it is why `onDark` keeps working through an
// alias. A `secondary` caller on a dark band now gets outline's OWN onDark
// classes, not a bronze button sitting on indigo.
// `rule` is an alias for `gold` since 2026-09-23: Nathan preferred the header's
// GIVE plate (the inset double rule) over the square button with a bar and rays,
// so the site has one button family again (CLAUDE.md rule 17).
const resolved =
  variant === 'primary' || variant === 'rule'
    ? 'gold'
    : variant === 'secondary'
      ? 'outline'
      : variant;

// THE PLATE SIGNATURE (2026-09-20, plan 3 task 2). Every button carries an
// inset double rule: a 3px band of its own fill, then a 1px line of its label
// colour drawn just inside the edge. It is two inset box-shadows rather than a
// border plus a pseudo-element, so the rule costs no extra box and cannot fall
// out of sync with a rounded corner.
const variantClasses = (() => {
  if (resolved === 'gold') {
    return 'bg-gold text-indigo-field shadow-[inset_0_0_0_3px_var(--color-gold),inset_0_0_0_4px_var(--color-indigo-field)] hover:-translate-y-px';
  }
  // outline. text-bg, not text-cream: --color-cream FLIPS to ink in dark mode
  // (see globals.css .dark), while --color-bg stays paper-white in both, which
  // is what a fixed dark band needs.
  // onDark draws the same double rule with a pseudo-element instead of the
  // two inset shadows. The shadow trick needs the BUTTON'S OWN background as
  // the covering layer, and an onDark outline button has none: it sits on a
  // fixed indigo or brown band whose colour this component cannot know, and
  // --color-foreground flips between themes while the band does not. The
  // pseudo-element draws the 1px line 3px inside the edge over whatever is
  // behind it, in both themes, on every band.
  if (onGold) {
    return 'relative border border-band-ink text-band-ink before:pointer-events-none before:absolute before:inset-[3px] before:rounded-[1px] before:border before:border-current hover:bg-band-ink/10';
  }
  return onDark
    ? 'relative border border-bg text-bg before:pointer-events-none before:absolute before:inset-[3px] before:rounded-[1px] before:border before:border-current hover:bg-bg/10'
    : 'border border-foreground text-foreground shadow-[inset_0_0_0_3px_var(--color-bg),inset_0_0_0_4px_var(--color-foreground)]';
})();
---

<a
  href={href}
  class:list={resolved === 'link'
    ? [linkClasses, extraClass]
    : [baseClasses, variantClasses, extraClass]}
  target={newTab ? '_blank' : undefined}
  rel={newTab ? 'noopener noreferrer' : undefined}
>
  {label}
  {
    resolved === 'link' && (
      <span
        aria-hidden="true"
        class="transition-transform duration-300 group-hover:translate-x-1 group-focus-visible:translate-x-1"
      >
        &#8594;
      </span>
    )
  }
</a>
