---
// Safe to edit by hand
// The hero's three facts on a brand band (2026-09-24, the Visit identity
// pass; the prototype's `.facts`): a small taupe label over each value, a gold
// hairline between them. A value that is a clock time ("10:45 am") is set as
// the gold titling numeral with its am/pm small, italic and lower case, read
// by readBig (clock-read.ts) on the stega-cleaned text, exactly as the hymn board
// sets its times; any other value is set in the UI face. Used by the window
// and split branches of Hero.astro, both of which sit on a fixed dark band.
import { readBig } from '@/lib/clock-read';

interface Fact {
  _key?: string;
  label?: string | null;
  value?: string | null;
  /**
   * An in-page link (2026-09-25, the Ministries hero), derived by Hero.astro
   * from the label (src/lib/hero-fact-links.ts). With one, the value is the
   * link, with a small gold down arrow: the fact jumps to its band.
   */
  href?: string | null;
}

interface Props {
  facts: Fact[];
  /**
   * Visit's "Add Sundays to your calendar" (2026-09-24, `feat/last-sunday`):
   * the weekly service as a calendar file (/visit/sunday.ics), linked on the
   * line under the facts, beside the service time. Absent everywhere else.
   */
  calendarHref?: string;
}

const { facts, calendarHref } = Astro.props as Props;
const rows = facts.map((f) => ({ ...f, read: readBig(f.value) }));
// Facts that jump to their bands are an index of the page (the Ministries
// hero: Children, Youth, Adults), so they are set as ruled rows, label beside
// value, rather than the when/where row, whose short values sit side by side.
const index = rows.some((f) => !!f.href);
---

<dl class:list={['hero-facts', index && 'hf-index', calendarHref && 'hf-with-cal']}>
  {
    rows.map((f) => (
      <div>
        {f.label && <dt class="font-ui text-band-taupe">{f.label}</dt>}
        {f.value &&
          (f.read.kind === 'time' ? (
            <dd class="hf-time font-display text-gold lining-nums">
              {f.read.big}
              {f.read.meridiem && (
                <span class="ml-[.2em] font-body text-[.62em] text-band-taupe italic">
                  {f.read.meridiem}
                </span>
              )}
            </dd>
          ) : f.href ? (
            <dd class="font-ui">
              <a href={f.href} class="hf-jump">
                {f.value}
                <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
                  <path d="M6 1.5v8.5M2.5 6.5 6 10l3.5-3.5" />
                </svg>
              </a>
            </dd>
          ) : (
            <dd class="font-ui">{f.value}</dd>
          ))}
      </div>
    ))
  }
</dl>
{
  calendarHref && (
    <p class="hf-cal font-ui">
      <a href={calendarHref} type="text/calendar" data-add-sundays>
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
          <rect x="2.5" y="4" width="15" height="13.5" rx="1.5" />
          <path d="M2.5 8.5h15M6.5 2.5v3M13.5 2.5v3" />
        </svg>
        Add Sundays to your calendar
      </a>
    </p>
  )
}

<style is:global>
  /* Moved out of globals.css (2026-09-24, rule 20): Astro bundles a
     component's styles only into the pages that render it. is:global because
     the rules reach into ArchFrame, PortableText and SanityImage children. */
  /* The hero facts on a brand band (HeroFacts.astro, 2026-09-24, the Visit
   identity pass): label over value, a gold hairline between them. */
  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    row-gap: 14px;
    margin: 0 0 clamp(28px, 3.4vw, 44px);
  }
  .hero-facts > div {
    padding-right: clamp(16px, 1.8vw, 26px);
    margin-right: clamp(16px, 1.8vw, 26px);
    border-right: 1px solid color-mix(in srgb, var(--color-gold) 50%, transparent);
  }
  .hero-facts > div:last-child {
    border: 0;
    margin: 0;
    padding: 0;
  }
  .hero-facts dt {
    margin-bottom: 4px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.06em;
  }
  .hero-facts dd {
    margin: 0;
    font-size: clamp(18px, 1.4vw, 21px);
    font-weight: 600;
    line-height: 1.25;
  }
  .hero-facts .hf-time {
    font-size: clamp(24px, 2vw, 30px);
    font-weight: 400;
    line-height: 1;
    white-space: nowrap;
  }
  /* A fact that jumps to its band on the page (the Ministries hero): the
     value in paper with the gold hairline under it, and a small gold down
     arrow for "further down this page". */
  .hero-facts .hf-jump {
    display: inline;
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--color-gold);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }
  .hero-facts .hf-jump:hover {
    text-decoration-thickness: 2px;
  }
  .hero-facts .hf-jump:focus-visible {
    outline: 2px solid var(--color-bg);
    outline-offset: 3px;
  }
  .hero-facts .hf-jump svg {
    display: inline-block;
    margin-left: 0.4em;
    vertical-align: -0.05em;
    fill: none;
    stroke: var(--color-gold);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* The index form: one ruled row per fact, the label in a fixed column
     beside its value, gold hairlines above, between and below. */
  .hero-facts.hf-index {
    display: grid;
    row-gap: 0;
    max-width: 30rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-gold) 50%, transparent);
  }
  .hero-facts.hf-index > div,
  .hero-facts.hf-index > div:last-child {
    display: grid;
    grid-template-columns: 5.5em minmax(0, 1fr);
    align-items: baseline;
    column-gap: 16px;
    margin: 0;
    padding: 11px 0;
    border: 0;
    border-top: 1px solid color-mix(in srgb, var(--color-gold) 50%, transparent);
  }
  .hero-facts.hf-index dt {
    margin: 0;
  }
  .hero-facts.hf-with-cal {
    margin-bottom: 16px;
  }
  .hf-cal {
    margin: 0 0 clamp(28px, 3.4vw, 44px);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .hf-cal a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 24px;
    color: var(--color-bg);
    text-decoration: underline;
    text-decoration-color: var(--color-gold);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }
  .hf-cal a:hover {
    text-decoration-thickness: 2px;
  }
  .hf-cal a:focus-visible {
    outline: 2px solid var(--color-bg);
    outline-offset: 3px;
  }
  .hf-cal svg {
    flex: none;
    fill: none;
    stroke: var(--color-gold);
    stroke-width: 1.5;
  }
  @media (max-width: 380px) {
    .hero-facts {
      display: grid;
    }
    .hero-facts > div {
      border: 0;
      margin: 0;
      padding: 0;
    }
  }
</style>
