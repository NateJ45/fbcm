---
// Safe to edit by hand
// The phone action bar (PORTS.md card 191, from FBC Auburn's Sunday bar, 2026-10-17 to 10-26): a
// slim bar docked to the bottom of a phone screen with one short line of information and one
// button. Which bar a page gets is chosen in Site settings > Phone action bar (a bar per page, or
// one for every page) and picked by pickActionBar() in src/lib/wayfinding.ts. A page with no bar
// renders nothing at all, so a site that never fills the box is unchanged.
//
// Behaviour:
//   - Phones only (below 768px). It appears once the page's anchor has scrolled up out of view: an
//     element marked [data-action-bar-anchor] inside <main>, else the page's h1. It hides again
//     while the footer is on screen, so it never covers the footer (which carries the same links).
//   - It respects the safe-area inset (the iPhone home bar) and, while it shows, html gets
//     data-action-bar-on and --action-bar-h: scroll-padding-bottom keeps a focused field or link from
//     sliding under it, and the back-to-top button and the journal's CTA chip move up above it.
//   - Rendered inside <footer>, so its content sits in the contentinfo landmark. The button is a
//     plain link, 44px tall.
// THIS SITE (2026-10-27): drawn like the phone menu's foot, the indigo field with a gold keyline
// on top, the line in the menu's furniture face and the one gold button exactly as the menu's Give
// button draws it. While Site settings > Phone action bar is empty the church default is the
// Sunday bar on Home and Visit (src/data/wayfinding-defaults.ts): the service time from Site
// settings, and a button to Visit (on Home) or to the directions (on Visit).

import type { ActionBar } from '@/lib/wayfinding';

interface Props {
  bar: ActionBar | null;
}
const { bar } = Astro.props;
---

{bar && (
  <div class="action-bar" data-action-bar hidden>
    {bar.text && <p class="action-bar__text">{bar.text}</p>}
    <a class="action-bar__button" href={bar.href}>
      {bar.label}
    </a>
  </div>
)}

<script>
  // Shown once the anchor has scrolled up out of view, hidden while the footer is on screen. Two
  // IntersectionObservers, no scroll listener. Re-run after every View Transitions navigation; the
  // old observers go with the old page.
  let observers: IntersectionObserver[] = [];
  let resize: ResizeObserver | null = null;
  function initActionBar() {
    observers.forEach((o) => o.disconnect());
    observers = [];
    resize?.disconnect();
    const root = document.documentElement;
    root.removeAttribute('data-action-bar-on');
    const bar = document.querySelector<HTMLElement>('[data-action-bar]');
    const anchor =
      document.querySelector<HTMLElement>('main [data-action-bar-anchor]') ??
      document.querySelector<HTMLElement>('main h1');
    const footer = document.querySelector<HTMLElement>('#site-footer');
    if (!bar || !anchor || !('IntersectionObserver' in window)) return;
    let pastAnchor = false;
    let footerIn = false;
    const sync = () => {
      const show = pastAnchor && !footerIn;
      bar.hidden = !show;
      root.toggleAttribute('data-action-bar-on', show);
      if (show) root.style.setProperty('--action-bar-h', `${bar.offsetHeight}px`);
    };
    // The root runs on far below the screen, so the only change it reports is the anchor crossing
    // the top edge. With a plain root, a jump from below the screen to above it (a long swipe, an
    // in-page link) crossed nothing and the bar never showed.
    const a = new IntersectionObserver(
      ([e]) => {
        pastAnchor = !e.isIntersecting && e.boundingClientRect.top < 0;
        sync();
      },
      { rootMargin: '0px 0px 100000px 0px' },
    );
    a.observe(anchor);
    observers.push(a);
    if (footer) {
      const f = new IntersectionObserver(([e]) => {
        footerIn = e.isIntersecting;
        sync();
      });
      f.observe(footer);
      observers.push(f);
    }
    if ('ResizeObserver' in window) {
      resize = new ResizeObserver(() => {
        if (!bar.hidden) root.style.setProperty('--action-bar-h', `${bar.offsetHeight}px`);
      });
      resize.observe(bar);
    }
  }
  initActionBar();
  document.addEventListener('astro:page-load', initActionBar);
</script>

<style>
  .action-bar {
    display: none;
  }
  @media (max-width: 767px) {
    .action-bar:not([hidden]) {
      position: fixed;
      inset: auto 0 0;
      z-index: 45;
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px max(16px, env(safe-area-inset-right)) calc(10px + env(safe-area-inset-bottom))
        max(16px, env(safe-area-inset-left));
      /* The gold keyline the menu's rules use, over the indigo field. */
      border-top: 2px solid var(--color-gold);
      background: var(--color-indigo-deep);
      color: var(--color-bg);
      box-shadow: 0 -12px 30px -24px rgb(0 0 0 / 0.55);
    }
    .action-bar__text {
      flex: 1;
      min-width: 0;
      margin: 0;
      font-family: var(--font-ui);
      font-size: var(--fs-small, 0.875rem);
      font-weight: 600;
      letter-spacing: 0.02em;
      line-height: 1.25;
      overflow-wrap: anywhere;
    }
    /* The menu's Give button: gold fill, indigo-field label, the gold and indigo inset keyline. */
    .action-bar__button {
      display: inline-flex;
      flex: none;
      align-items: center;
      justify-content: center;
      min-height: var(--btn-height, 44px);
      max-width: 100%;
      margin-left: auto;
      padding: 8px 18px;
      border-radius: var(--radius-control);
      background: var(--color-gold);
      color: var(--color-indigo-field);
      box-shadow:
        inset 0 0 0 3px var(--color-gold),
        inset 0 0 0 4px var(--color-indigo-field);
      font-family: var(--font-ui);
      font-size: var(--text-ui);
      font-weight: 600;
      letter-spacing: 0.02em;
      text-align: center;
      text-decoration: none;
      transition: background-color 160ms ease;
    }
    .action-bar__button:hover {
      background: var(--color-gold-hover);
      box-shadow:
        inset 0 0 0 3px var(--color-gold-hover),
        inset 0 0 0 4px var(--color-indigo-field);
    }
    .action-bar__button:focus-visible {
      outline: 2px solid var(--color-gold);
      outline-offset: 3px;
    }
    /* While the bar shows: a focused element is never hidden under it, and the floating buttons
       (BackToTop.tsx, StickyCTAChip.tsx) ride above it. */
    :global(html[data-action-bar-on]) {
      scroll-padding-bottom: calc(var(--action-bar-h, 4.5rem) + 12px);
    }
    :global(html[data-action-bar-on] .fixed.bottom-6),
    :global(html[data-action-bar-on] .fixed.bottom-\[5\.5rem\]) {
      translate: 0 calc(-1 * var(--action-bar-h, 4.5rem));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .action-bar__button {
      transition: none;
    }
  }
  /* The narrowest phones: the line gives way to the button rather than wrapping to four lines. */
  @media (max-width: 359px) {
    .action-bar__text {
      font-size: 0.75rem;
    }
    .action-bar__button {
      padding-inline: 12px;
    }
  }
</style>
