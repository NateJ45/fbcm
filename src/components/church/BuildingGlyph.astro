---
// Safe to edit by hand
// The four goal glyphs, one per goal of the church, each a line drawing in a
// 48x64 box:
//
//   window  Worship. The two-light lancet WINDOW with its quatrefoil, drawn
//           from the building (ported from the prototype's `#i-window`; the
//           shared `#qf` quatrefoil is inlined with the transform the symbol
//           gave its `<use>`, so no page needs a global <defs> sprite).
//   door    The Way. The Tudor DOOR, and since 2026-09-24 a paved PATH that
//           narrows in perspective to its threshold, so "the way" reads
//           literally: "I am the way" (John 14:6). The door's handles came off
//           in the redraw; at 32px they merged with the centre line into a
//           cross, and the arch and the split leaves already say door.
//   rose    Witness. Despite the name, since 2026-09-24 a LAMP ON A STAND: a
//           clay oil lamp of the biblical kind (a low body with a pointed
//           nozzle, the flame rising from the nozzle tip, a loop handle at the
//           back and the filling hole on top) resting on a slim lampstand, a
//           small tray on one upright with a small foot. "Neither do men light
//           a candle, and put it under a bushel, but on a candlestick"
//           (Matthew 5:15); "ye are the light of the world" (5:14). It replaced
//           the rose window, which read as a sun, a gear or a virus at 32px. A
//           first redraw set a genie-like lamp on a squat pedestal; Nathan
//           found it did not read as an oil lamp, and picked this one from
//           three (the lamp alone sat too low in the row; the lamp on a hill,
//           Matthew 5:14, read as legs at 32px). The name `rose` stays because
//           it is a stored value (the goals' `glyph` field in Sanity,
//           church-goals.ts), so renaming it would be a data migration; the
//           Studio's option title reads "Lamp on a stand".
//   basin   Work. The BASIN AND TOWEL of John 13, the foot-washing, since the
//           church's Work is "following Jesus' example of serving others".
//           Since 2026-09-24 one large basin seen a little from above, its
//           towel draped over the front rim; the jug that used to pour into it
//           came off, because three objects were too small to read at 32px.
//
// The redraw of 2026-09-24 (feat/goal-glyphs) chose each drawing from two or
// three candidates by the at-a-glance test: at 32px, without the label, could a
// visitor name it? Line art in currentColor at a constant 2px stroke whatever
// the size, and always decorative: the goal's name beside it is the label.
// Each glyph is 3 to 6 strokes so the staggered draw below still reads.
//
// THE DRAW (2026-09-24, feat/print-motion). Every stroke carries
// pathLength="1", and the svg is on the site's [data-reveal] observer with the
// `draw` variant: the first time a glyph scrolls into view its lines draw
// themselves, one after another, the way the building's own line art would be
// drawn, and they stay drawn (the observer lets go of it). A dotted stroke
// would not be a line to trace, so the draw CSS fades a `.glyph-dots` child in
// after the rest instead; no glyph carries one since the basin lost its pour
// (2026-09-24), but the rule stays for the next dotted line. Every drawable
// child must be a DIRECT child of the svg: the draw CSS staggers them by
// `nth-child`.
// Under prefers-reduced-motion, and on paper, the glyph is simply there
// (globals.css, "Reveal variants").

interface Props {
  name: 'window' | 'door' | 'rose' | 'basin';
  class?: string;
}

const { name, class: extraClass = 'w-12' } = Astro.props;

/** The quatrefoil: four circles of radius 9 around the origin. */
const QF =
  'M-8.94-8.94A9 9 0 1 1 8.94-8.94A9 9 0 1 1 8.94 8.94A9 9 0 1 1-8.94 8.94A9 9 0 1 1-8.94-8.94Z';
---

<svg
  viewBox="0 0 48 64"
  aria-hidden="true"
  focusable="false"
  class:list={['building-glyph h-auto', extraClass]}
  data-glyph={name}
  data-reveal="draw"
>
  {
    name === 'window' && (
      <>
        <path pathLength="1" d="M5 62V30C5 16 14 7 24 3C34 7 43 16 43 30V62" />
        <path pathLength="1" d="M10 62V36A12 12 0 0 1 16 25A12 12 0 0 1 22 36V62" />
        <path pathLength="1" d="M26 62V36A12 12 0 0 1 32 25A12 12 0 0 1 38 36V62" />
        <path pathLength="1" d={QF} transform="translate(24 16) scale(.36)" />
        <path pathLength="1" d="M2 62H46" />
      </>
    )
  }
  {
    name === 'door' && (
      <>
        <path pathLength="1" d="M9 46V22C9 14 17 9 24 5C31 9 39 14 39 22V46" />
        <path pathLength="1" d="M14 46V24C14 19 19 15 24 12C29 15 34 19 34 24V46" />
        <path pathLength="1" d="M24 12V46" />
        <path pathLength="1" d="M9 46H39" />
        <path pathLength="1" d="M14 46L4 62M34 46L44 62" />
        <path pathLength="1" d="M17 51H31M12 57H36" />
      </>
    )
  }
  {
    name === 'rose' && (
      <>
        <path
          pathLength="1"
          d="M9.6 31.6C9.6 27.4 14.7 25.2 20.6 25.2C25.7 25.2 29.1 26.5 32.5 27.4L39.3 27.8C41.4 28 41.4 30.6 39.3 30.8L32.5 31.6C29.1 35 25.7 38 20.6 38C14.7 38 9.6 35.9 9.6 31.6Z"
        />
        <path
          pathLength="1"
          d="M17.6 28.6a3 1.1 0 1 0 6 0a3 1.1 0 1 0-6 0M10.4 29C5.3 27.4 4.5 34.2 10 34.6"
        />
        <path
          pathLength="1"
          d="M40.2 7.8C42.7 13.8 43.6 18 43.6 21.4A3.4 3.4 0 0 1 36.8 21.4C36.8 18 37.6 13.8 40.2 7.8Z"
        />
        <path pathLength="1" d="M11 38H31" />
        <path pathLength="1" d="M21 38V58" />
        <path pathLength="1" d="M15 62C16 59.5 18.5 58 21 58C23.5 58 26 59.5 27 62M10 62H32" />
      </>
    )
  }
  {
    name === 'basin' && (
      <>
        <path
          pathLength="1"
          d="M3 30A21 5 0 0 1 45 30A21 5 0 0 1 38 33.7M28 34.9A21 5 0 0 1 3 30"
        />
        <path
          pathLength="1"
          d="M3 30C4 41.5 13 48 24 48C25.4 48 26.7 47.9 28 47.7M38 43.5C41.9 40.5 44.5 35.9 45 30"
        />
        <path pathLength="1" d="M28 34.9V55L33 53L38 55V33.7" />
        <path pathLength="1" d="M28 34.9C28 29 31 26 33 26C35 26 38 28 38 33.7" />
        <path pathLength="1" d="M17 48L15 56H28" />
        <path pathLength="1" d="M2 62H46" />
      </>
    )
  }
</svg>
