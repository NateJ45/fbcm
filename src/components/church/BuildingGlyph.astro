---
// Safe to edit by hand
// The four goal glyphs: the two-light WINDOW (Worship), the Tudor DOOR (The
// Way) and the ROSE window (Witness), drawn from the building, and the BASIN
// (Work): a jug pouring into a basin with a towel over its rim, the
// foot-washing of John 13, since the church's Work is "following Jesus'
// example of serving others". The basin was first drawn as a piscina niche,
// which read as a face or a sink; it was redrawn 2026-09-24 at Nathan's
// request. The other three are ported from the prototype's `#i-window`,
// `#i-door` and `#i-rose` symbols; the shared `#qf` quatrefoil is inlined
// with the transform each symbol gave its `<use>`, so no page needs a global
// <defs> sprite. Line art in currentColor at a constant 2px stroke whatever
// the size, and always decorative: the goal's name beside it is the label.
//
// THE DRAW (2026-09-24, feat/print-motion). Every stroke carries
// pathLength="1", and the svg is on the site's [data-reveal] observer with the
// `draw` variant: the first time a glyph scrolls into view its lines draw
// themselves, one after another, the way the building's own line art would be
// drawn, and they stay drawn (the observer lets go of it). The basin's dotted
// pour is not a line to trace, so it fades in after the rest (`glyph-dots`).
// Under prefers-reduced-motion, and on paper, the glyph is simply there
// (globals.css, "Reveal variants").

interface Props {
  name: 'window' | 'door' | 'rose' | 'basin';
  class?: string;
}

const { name, class: extraClass = 'w-12' } = Astro.props;

/** The quatrefoil: four circles of radius 9 around the origin. */
const QF =
  'M-8.94-8.94A9 9 0 1 1 8.94-8.94A9 9 0 1 1 8.94 8.94A9 9 0 1 1-8.94 8.94A9 9 0 1 1-8.94-8.94Z';
---

<svg
  viewBox="0 0 48 64"
  aria-hidden="true"
  focusable="false"
  class:list={['building-glyph h-auto', extraClass]}
  data-glyph={name}
  data-reveal="draw"
>
  {
    name === 'window' && (
      <>
        <path pathLength="1" d="M5 62V30C5 16 14 7 24 3C34 7 43 16 43 30V62" />
        <path pathLength="1" d="M10 62V36A12 12 0 0 1 16 25A12 12 0 0 1 22 36V62" />
        <path pathLength="1" d="M26 62V36A12 12 0 0 1 32 25A12 12 0 0 1 38 36V62" />
        <path pathLength="1" d={QF} transform="translate(24 16) scale(.36)" />
        <path pathLength="1" d="M2 62H46" />
      </>
    )
  }
  {
    name === 'door' && (
      <>
        <path pathLength="1" d="M7 58V28C7 18 16 13 24 9C32 13 41 18 41 28V58" />
        <path pathLength="1" d="M12 58V30C12 23 18 19 24 16C30 19 36 23 36 30V58" />
        <path pathLength="1" d="M24 16V58" />
        <circle pathLength="1" cx="20.5" cy="40" r="1" />
        <circle pathLength="1" cx="27.5" cy="40" r="1" />
        <path pathLength="1" d="M3 58H45M1 62H47" />
      </>
    )
  }
  {
    name === 'rose' && (
      <>
        <circle pathLength="1" cx="24" cy="34" r="15" />
        <path pathLength="1" d={QF} transform="translate(24 34) scale(.9)" />
        <path
          pathLength="1"
          d="M24 13V9M24 55V59M3 34H7M41 34H45M9.2 19.2L12 22M38.8 19.2L36 22M9.2 48.8L12 46M38.8 48.8L36 46"
        />
      </>
    )
  }
  {
    name === 'basin' && (
      <>
        <path
          pathLength="1"
          d="M19 6H29M20 6C17 10 16 16 17 21C18 25 21 27 24 27C27 27 30 25 31 21C32 16 31 10 28 6"
        />
        <path pathLength="1" d="M31 11C35 11 36 16 32 19" />
        <path pathLength="1" d="M17 12L12 15" />
        <path d="M12 17V34" stroke-dasharray="2 3" class="glyph-dots" />
        <path pathLength="1" d="M3 40H45" />
        <path pathLength="1" d="M5 40C7 51 13 55 24 55C35 55 41 51 43 40" />
        <path pathLength="1" d="M18 55L16 59H32L30 55" />
        <path pathLength="1" d="M36 40V52L40 50" />
        <path pathLength="1" d="M2 62H46" />
      </>
    )
  }
</svg>
