---
// Safe to edit by hand
// "Which door?": a line-art sketch of the church's street side, with each of
// the doors band's entrances pinned by its number (2026-09-24, the
// craft-details pass). Drawn by SundayTimes.astro's doors path (Visit's
// "Doors, parking and access") above the list of doors, which it mirrors.
//
// THE LIST IS THE INTERFACE; THE SKETCH MIRRORS IT. Each door's name in the
// list is a link to its pin here (`#<prefix>-pin-<n>`), so with no JavaScript
// the link still jumps to the sketch and `:target` lights the pin, and with no
// SVG at all the list is the whole of the content, unchanged. With JavaScript,
// choosing a door (click, or keyboard focus on its name) lights its pin and
// shows its name and the church's own words for it under the sketch; hovering
// a pin or a row previews it. The pins are not focusable and the figure is one
// image to assistive technology (role="img", with a <desc> that says where
// every door is), so a keyboard or screen-reader user meets each door once,
// in the list.
//
// THE GEOGRAPHY, AND HOW SURE IT IS. src/lib/door-plan.ts has the sources. In
// short: the corner of Adams (north) and Jefferson (west) is certain (the
// church's History, OpenStreetMap); the drive, the lot and the side doors'
// streets are the church's own words; their order along Adams is read from the
// photographs. So this is a sketch of the street side, labelled "not to
// scale", not a floor plan. North is up.
//
// Gold line art on the band's brown, the building glyphs' language: 2px-ish
// strokes, no fills beyond a faint wash, the Sofia Sans labels in caps.
// Motion (the pin's halo) only under prefers-reduced-motion: no-preference.
import type { DoorPlan, DoorPlace } from '@/lib/door-plan';
import { doorPinId } from '@/lib/door-plan';

interface Props {
  plan: DoorPlan;
  /** Prefix for the pin ids, shared with the list rows (doorRowId / doorPinId). */
  idPrefix: string;
  /** The doors' names by list number, for the figure's description. */
  names: Record<number, string>;
}

const { plan, idPrefix, names } = Astro.props;

/** Where each place's door is drawn, and the words that say so (the <desc>). */
const PLACES: Record<DoorPlace, { x: number; y: number; where: string }> = {
  drive: { x: 206, y: 150, where: 'on the Adams Street side, at the circular drive' },
  front: { x: 259, y: 96, where: 'on the Adams Street side, at the foot of the tower' },
  jefferson: { x: 96, y: 262, where: 'on the Jefferson Street side' },
};

const titleId = `${idPrefix}-plan-title`;
const descId = `${idPrefix}-plan-desc`;
const desc = [
  'The church stands on the corner of Adams Street and Jefferson Street.',
  ...plan.pins.map((p) => `Door ${p.n}, ${names[p.n] ?? ''}, is ${PLACES[p.place].where}.`),
  plan.parking ? 'The parking lot is on the Adams Street side.' : '',
]
  .filter(Boolean)
  .join(' ');
---

<figure class="dp" data-door-plan>
  <svg
    viewBox="0 0 560 400"
    role="img"
    aria-labelledby={titleId}
    aria-describedby={descId}
    class="dp-svg"
    focusable="false"
  >
    <title id={titleId}>Sketch of the church's street side</title>
    <desc id={descId}>{desc}</desc>

    {/* The streets: a faint wash, the kerbs, the sidewalk line. */}
    <g class="dp-street">
      <rect x="0" y="20" width="20" height="44"></rect>
      <rect x="64" y="20" width="496" height="44"></rect>
      <rect x="20" y="0" width="44" height="400"></rect>
    </g>
    <g class="dp-kerb">
      <path d="M0 20H20V0M64 0V20H560M64 400V74Q64 64 74 64H560M0 64H20V400"></path>
    </g>
    <path class="dp-walk" d="M74 400V84Q74 74 84 74H560"></path>
    <text class="dp-street-name" x="330" y="46.5" text-anchor="middle">Adams Street</text>
    <text
      class="dp-street-name"
      x="0"
      y="0"
      text-anchor="middle"
      transform="translate(46.5 250) rotate(-90)">Jefferson Street</text
    >

    {/* The circular drive, in front of the office wing. */}
    <path class="dp-drive" d="M112 64V100Q112 128 140 128H194Q222 128 222 100V64"></path>

    {/* The building: the office wing, set back; the sanctuary; the tower. */}
    <g class="dp-building">
      <path d="M96 150H236V370H96Z"></path>
      <path d="M236 118H384V370H236Z"></path>
      <path d="M236 96H282V142H236Z"></path>
    </g>
    <path class="dp-roof" d="M236 96L282 142M282 96L236 142"></path>
    <text class="dp-room" x="166" y="266" text-anchor="middle">Offices</text>
    <text class="dp-room" x="316" y="266" text-anchor="middle">Sanctuary</text>

    {
      plan.parking && (
        <g class="dp-lot">
          <path class="dp-lot-edge" d="M440 64V96H404V370H548V96H484V64" />
          <path
            class="dp-stall"
            d="M404 124H436M404 152H436M404 180H436M404 208H436M404 236H436M404 264H436M404 292H436M404 320H436M404 348H436M516 124H548M516 152H548M516 180H548M516 208H548M516 236H548M516 264H548M516 292H548M516 320H548M516 348H548"
          />
          <text class="dp-room" x="476" y="238" text-anchor="middle">
            Parking
          </text>
        </g>
      )
    }

    {/* North arrow. */}
    <g class="dp-north" transform="translate(534 380)">
      <path d="M0 -4V-26M-5 -19L0 -26L5 -19"></path>
      <text x="0" y="10" text-anchor="middle">N</text>
    </g>

    {/* The doors, numbered as the list numbers them. */}
    {
      plan.pins.map((pin) => {
        const at = PLACES[pin.place];
        return (
          <g
            id={doorPinId(idPrefix, pin.n)}
            class="dp-pin"
            data-pin={String(pin.n)}
            transform={`translate(${at.x} ${at.y})`}
          >
            <circle class="dp-halo" r="24" />
            <circle class="dp-dot" r="15" />
            <text y="5.5" text-anchor="middle">
              {pin.n}
            </text>
          </g>
        );
      })
    }
  </svg>
  <figcaption class="dp-cap">
    <p class="dp-say" data-dp-say>Choose a door to see where it is.</p>
    <p class="dp-note">A sketch of the street side, not to scale. North is up.</p>
  </figcaption>
</figure>

<script>
  // Mirrors the doors list onto the sketch. Everything here is an enhancement:
  // without it the list is complete and each name still links to its pin.
  const reduceMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function initDoorPlans() {
    document.querySelectorAll<HTMLElement>('[data-door-plan]').forEach((fig) => {
      if (fig.dataset.ready) return;
      fig.dataset.ready = '1';
      const band = fig.closest('section') ?? document.body;
      const say = fig.querySelector<HTMLElement>('[data-dp-say]');
      if (!say) return;
      const idle = say.textContent ?? '';
      const pins = Array.from(fig.querySelectorAll<SVGGElement>('[data-pin]'));
      const rows = Array.from(band.querySelectorAll<HTMLElement>('[data-door-row]'));
      let chosen = '';

      const show = (n: string) => {
        for (const p of pins) p.classList.toggle('is-on', p.dataset.pin === n);
        for (const r of rows) {
          const on = r.dataset.doorRow === n;
          r.classList.toggle('is-on', on);
          const link = r.querySelector('[data-door-link]');
          if (on && n === chosen) link?.setAttribute('aria-current', 'true');
          else link?.removeAttribute('aria-current');
        }
        const row = rows.find((r) => r.dataset.doorRow === n);
        say.replaceChildren();
        if (!row) {
          say.textContent = idle;
          return;
        }
        const name = row.querySelector('[data-door-name]')?.textContent?.trim() ?? '';
        const words = row.querySelector('p')?.textContent?.trim() ?? '';
        const strong = document.createElement('strong');
        strong.textContent = `${n}. ${name}`;
        say.append(strong, words ? ` ${words}` : '');
      };
      const choose = (n: string) => {
        chosen = n;
        show(n);
      };

      for (const p of pins) {
        const n = p.dataset.pin ?? '';
        p.addEventListener('pointerenter', () => show(n));
        p.addEventListener('pointerleave', () => show(chosen));
        p.addEventListener('click', () => choose(n));
      }
      for (const r of rows) {
        const n = r.dataset.doorRow ?? '';
        const link = r.querySelector<HTMLAnchorElement>('[data-door-link]');
        r.addEventListener('pointerenter', () => show(n));
        r.addEventListener('pointerleave', () => show(chosen));
        link?.addEventListener('focus', () => choose(n));
        link?.addEventListener('click', (e) => {
          e.preventDefault();
          choose(n);
          const box = fig.getBoundingClientRect();
          if (box.top < 0 || box.bottom > window.innerHeight) {
            fig.scrollIntoView({ block: 'center', behavior: reduceMotion() ? 'auto' : 'smooth' });
          }
        });
      }
    });
  }

  initDoorPlans();
  document.addEventListener('astro:page-load', initDoorPlans);
</script>

<style is:inline>
  /* The door plan (DoorPlan.astro). Gold line art on the band's brown.
     is:inline ON PURPOSE (measured 2026-09-24): as a bundled style this
     landed in the chunk every SectionRenderer page inlines, +3,183 B of CSS
     on ~370 pages that never draw the sketch. Inline, it ships only with the
     sketch itself (/visit). */
  .dp {
    margin: clamp(26px, 3vw, 40px) 0 clamp(4px, 1vw, 10px);
  }
  .dp-svg {
    display: block;
    width: 100%;
    height: auto;
    max-width: 640px;
    overflow: visible;
  }
  .dp-street rect {
    fill: var(--color-gold);
    fill-opacity: 0.07;
  }
  .dp-kerb path,
  .dp-walk,
  .dp-drive,
  .dp-building path,
  .dp-roof,
  .dp-lot path,
  .dp-north path {
    fill: none;
    stroke: var(--color-gold);
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .dp-kerb path {
    stroke-width: 1.5;
    stroke-opacity: 0.7;
  }
  .dp-walk {
    stroke-width: 1;
    stroke-opacity: 0.3;
    stroke-dasharray: 2 5;
  }
  .dp-drive {
    stroke-width: 16;
    stroke-opacity: 0.16;
  }
  .dp-building path {
    stroke-width: 2;
    fill: var(--color-gold);
    fill-opacity: 0.06;
  }
  .dp-roof {
    stroke-width: 1;
    stroke-opacity: 0.55;
  }
  .dp-lot-edge {
    stroke-width: 1.5;
    stroke-opacity: 0.6;
    stroke-dasharray: 6 5;
  }
  .dp-stall {
    stroke-width: 1;
    stroke-opacity: 0.4;
  }
  .dp-north path {
    stroke-width: 1.5;
  }
  .dp-svg text {
    font-family: var(--font-ui);
    fill: var(--color-bg);
  }
  .dp-street-name {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    fill-opacity: 0.85;
  }
  .dp-room {
    font-size: 16px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    fill-opacity: 0.72;
  }
  .dp-north text {
    font-size: 13px;
    font-weight: 700;
    fill: var(--color-gold) !important;
  }
  .dp-pin {
    cursor: pointer;
  }
  .dp-dot {
    fill: var(--color-band-brown);
    stroke: var(--color-gold);
    stroke-width: 2;
  }
  .dp-pin text {
    font-family: var(--font-display) !important;
    font-size: 16px;
    fill: var(--color-gold) !important;
    pointer-events: none;
  }
  .dp-halo {
    transform-box: fill-box;
    transform-origin: center;
    fill: none;
    stroke: var(--color-gold);
    stroke-width: 1.5;
    opacity: 0;
  }
  .dp-pin.is-on .dp-dot,
  .dp-pin:target .dp-dot {
    fill: var(--color-gold);
  }
  .dp-pin.is-on text,
  .dp-pin:target text {
    fill: var(--color-band-ink) !important;
  }
  .dp-pin.is-on .dp-halo,
  .dp-pin:target .dp-halo {
    opacity: 0.7;
  }
  @media (prefers-reduced-motion: no-preference) {
    .dp-dot,
    .dp-halo {
      transition:
        fill 160ms ease,
        opacity 200ms ease;
    }
    .dp-pin.is-on .dp-halo {
      animation: dp-halo 1.6s ease-out 1;
    }
    @keyframes dp-halo {
      from {
        opacity: 0.9;
        transform: scale(0.7);
      }
      to {
        opacity: 0.7;
        transform: scale(1);
      }
    }
  }
  .dp-cap {
    margin-top: 14px;
    max-width: 36em;
  }
  .dp-say {
    margin: 0;
    min-height: 3.1em;
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.55;
    color: color-mix(in srgb, var(--color-bg) 88%, transparent);
  }
  .dp-say strong {
    font-weight: 400;
    color: var(--color-gold);
  }
  .dp-note {
    margin: 8px 0 0;
    font-family: var(--font-ui);
    font-size: 15px;
    letter-spacing: 0.02em;
    color: var(--color-band-taupe);
  }
  /* The list rows the sketch mirrors (SundayTimes.astro's doors path). */
  .sd-door-link {
    color: inherit;
    text-decoration: none;
    display: inline-flex;
    align-items: baseline;
    gap: 12px;
    max-width: 100%;
  }
  .sd-door-link:hover .sd-door-label,
  .sd-door-link:focus-visible .sd-door-label,
  .sd-doors > li.is-on .sd-door-label {
    text-decoration: underline;
    text-decoration-color: var(--color-gold);
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }
  .sd-door-link:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 4px;
  }
  .sd-door-num {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 1.35em;
    height: 1.35em;
    border: 1.5px solid var(--color-gold);
    border-radius: 50%;
    font-family: var(--font-display);
    font-size: 0.78em;
    line-height: 1;
    color: var(--color-gold);
    transform: translateY(-0.08em);
  }
  .sd-doors > li.is-on .sd-door-num,
  .sd-doors > li:target .sd-door-num {
    background: var(--color-gold);
    color: var(--color-band-ink);
  }
  .sd-door-label {
    min-width: 0;
    overflow-wrap: anywhere;
  }
</style>
