---
// Safe to edit by hand
// The season of the church year as a short ruled line: "Ordinary Time,
// the season after Pentecost". Derived from the date by churchSeason()
// (CLAUDE.md rule 15), so it turns over on its own with the daily scheduled
// deploy (.github/workflows/deploy.yml, 05:15 UTC).
// Ported from the prototype's `.season`.
//
// `data-season` carries the season name so a band can key its colour off it.
// The line's own ink follows the season's band (theme-tokens.test.ts
// IDENTITY_PAIRS measures each): mint on green, gold-light on violet, purple
// and red, and the dark ink on the two light grounds, gold and white.

import { churchSeason, type SeasonToken } from '@/lib/church-year';

interface Props {
  /** Defaults to now, i.e. the build date. Pass a fixed date for fixtures. */
  date?: Date;
  class?: string;
}

const { date, class: extraClass = '' } = Astro.props;
const { season, label, token } = churchSeason(date ?? new Date());

// Written out in full: Tailwind reads source text, so `text-${x}` would
// generate nothing.
const INK: Record<SeasonToken, string> = {
  green: 'text-mint',
  violet: 'text-gold-light',
  purple: 'text-gold-light',
  red: 'text-gold-light',
  gold: 'text-goal-ink-on-gold',
  white: 'text-goal-ink-on-gold',
};
---

<p
  class:list={[
    'season-line m-0 flex items-center gap-3 font-ui text-base font-semibold',
    INK[token],
    extraClass,
  ]}
  data-season={season}
>
  {label}
</p>
