---
// Safe to edit by hand
// A photograph framed by one of the two arches drawn from the building: the
// LANCET (the tall pointed window) or the DOOR (the low four-centred head of
// the Adams Street door). Ported from the Who We Are prototype's `.arch` /
// `.mould` (docs/superpowers/prototypes/2026-09-23-who-we-are/c-alive.html).
//
// - The arch is a CSS mask (`.arch-lancet` / `.arch-door` in the "Church
//   identity" block of globals.css), stretched to the frame, so any aspect
//   ratio keeps the same arch. The ratio defaults to the prototype's (2:3 for
//   the lancet, 10:13 for the door); a caller changes it with the
//   `--arch-ratio` custom property, set through the `style` prop.
// - The thin outline is an SVG drawn a few pixels outside the mask, in
//   `--arch-mould` (brand gold unless a band sets it).
// - `reveal` puts the figure on the site's [data-reveal] observer with the
//   `arch` variant: lancets rise from the bottom, doors open from the centre,
//   the photo settles from a slight zoom, and the outline fades in after. The
//   figure itself is never clipped, so the observer always has a box to see.
//   Under prefers-reduced-motion the frame is simply there.
// - `grade="warm"` applies the prototype's one shared photo grade.
// - The crop follows the editor's hotspot, exactly as Hero.astro's split frame
//   does; with no hotspot it keeps the top of the photograph, where faces are.
//   A close portrait of people in a LANCET whose hotspot puts the face above
//   the arch's springing is drawn lower, with headroom that fades into the
//   arch (2026-09-25, src/lib/hero-frames.ts archPlacement): a portrait fills
//   the arch's height, so no object-position can move its head clear of the
//   point.
// - `glyph` (2026-09-23, the Home blog rows): with no photograph the frame
//   normally draws nothing, but a caller whose rows must line up (a post with
//   no featured image) passes a building glyph, and the arch is drawn filled
//   with the indigo band and the glyph in gold instead. Never an empty frame.

import SanityImage from '@/components/SanityImage.astro';
import BuildingGlyph from '@/components/church/BuildingGlyph.astro';
import type { SanityImageObject } from '@/lib/pageBuilder.types';
import { archPlacement, archRatioFromStyle, type FrameCrop } from '@/lib/hero-frames';
import { photoAspect } from '@/lib/photo-shape';
import { photoSubject } from '@/lib/photo-subject';

interface Props {
  image: SanityImageObject | null | undefined;
  shape: 'lancet' | 'door';
  /** Largest width the frame renders at (the srcset ceiling). */
  width: number;
  sizes: string;
  alt: string;
  class?: string;
  reveal?: boolean;
  grade?: 'warm' | 'none';
  loading?: 'lazy' | 'eager';
  /** Inline style on the figure, e.g. `--arch-ratio: 100/190`. */
  style?: string;
  /** Drawn in the arch when there is no photograph (see the header note). */
  glyph?: 'window' | 'door' | 'rose' | 'basin';
  /** 'high' when this frame is the page's LCP image (a split hero's photo). */
  fetchpriority?: 'high' | 'auto';
  /**
   * The arch's height / width, for a caller whose --arch-ratio lives in its
   * own CSS rather than in `style` (the window hero's lights). Read from
   * `style` otherwise, else the shape's default. Only the headroom reads it.
   */
  frameRatio?: number;
  /**
   * Preview only: a `data-sanity` value (src/lib/preview-edit-attr.ts), so a
   * click on the picture in the Studio's Edit mode opens its field. Absent
   * everywhere else, and then no attribute is rendered at all.
   */
  editAttr?: string;
}

const {
  image,
  shape,
  width,
  sizes,
  alt,
  class: extraClass = '',
  reveal = true,
  grade = 'none',
  loading = 'lazy',
  style,
  glyph,
  fetchpriority,
  frameRatio,
  editAttr,
} = Astro.props;

const hasImage = !!image?.asset;
// No photograph and no glyph, no frame: an empty grey arch is not a designed state.
if (!hasImage && !glyph) return null;

// Where the photograph sits (src/lib/hero-frames.ts archPlacement): the
// hotspot, mapped through any crop, else the top; and, for a close portrait of
// people in a lancet whose face the hotspot puts above the arch's springing,
// headroom, so the pointed head never cuts off hair and forehead. The alt is
// read stega-cleaned (photoSubject cleans it itself).
const { objectPosition, headroom } = archPlacement({
  shape,
  people: hasImage && photoSubject(alt) === 'people',
  aspect: photoAspect(image as Parameters<typeof photoAspect>[0])?.a,
  frameRatio: frameRatio ?? archRatioFromStyle(style) ?? (shape === 'lancet' ? 1.5 : 1.3),
  hotspot: image?.hotspot,
  crop: (image as { crop?: FrameCrop | null } | null | undefined)?.crop,
});
const imgStyle =
  headroom > 0
    ? `object-position: ${objectPosition}; position: absolute; left: 0; bottom: 0; height: ${((1 - headroom) * 100).toFixed(2)}%; -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 6%); mask-image: linear-gradient(to bottom, transparent 0, #000 6%);`
    : `object-position: ${objectPosition};`;

// The outline path, in the same box as the mask, so the two always agree.
const mould =
  shape === 'lancet'
    ? { viewBox: '0 0 100 150', d: 'M0 150V67.1A70 70 0 0 1 50 0A70 70 0 0 1 100 67.1V150' }
    : { viewBox: '0 0 100 130', d: 'M0 130V30C0 17 28 8 50 0C72 8 100 17 100 30V130' };
---

<figure
  class:list={['relative m-0', extraClass]}
  data-reveal={reveal ? 'arch' : undefined}
  data-arch={shape}
  data-sanity={editAttr}
  style={style}
>
  {
    hasImage ? (
      <div class:list={['arch', shape === 'lancet' ? 'arch-lancet' : 'arch-door']}>
        <SanityImage
          source={image}
          width={width}
          sizes={sizes}
          alt={alt}
          loading={loading}
          fetchpriority={fetchpriority}
          class:list={['h-full w-full object-cover', grade === 'warm' && 'graded']}
          style={imgStyle}
        />
      </div>
    ) : (
      <div
        class:list={[
          'arch arch-glyph flex items-end justify-center',
          shape === 'lancet' ? 'arch-lancet' : 'arch-door',
        ]}
      >
        <BuildingGlyph name={glyph ?? 'window'} class="mb-[14%] w-[52%] text-gold" />
      </div>
    )
  }
  <svg class="arch-mould" viewBox={mould.viewBox} preserveAspectRatio="none" aria-hidden="true">
    <path d={mould.d}></path>
  </svg>
</figure>
