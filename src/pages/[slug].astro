---
// Custom pages built in the page builder. Generates one static page per
// published `page` document at /<slug>. Built-in routes (about.astro, etc.) are
// explicit files and take precedence. The schema blocks reserved slugs; the
// filter below is a second guard so a custom page can never shadow a real route.
//
// IMPORTANT: RESERVED must be defined INSIDE getStaticPaths. Astro's static
// build runs getStaticPaths in an isolated scope. A module-level import of
// the set from reservedSlugs.ts is NOT visible to the runtime at path-generation
// time due to Astro's static-build isolation. This is a known Astro gotcha
// documented in CLAUDE.md.
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import { getPage, getAllPageSlugs, getSiteSettings } from '@/lib/queries';
import { breadcrumbSchema, sundayWorshipSchema, SERVICE_PAGE_SLUG } from '@/lib/schemas';
import { sundayOnOrAfter } from '@/lib/church-schema';
import { sanityFetch } from '@/lib/sanity';
import { site } from '@/data/site';
import { shouldOverlayHeader } from '@/lib/heroOverlay';

export async function getStaticPaths() {
  // Defined inside getStaticPaths, and it has to be: CLAUDE.md rule 10. Astro
  // runs this function in an isolated scope, and a guard lifted out of it stops
  // working without saying so. So this is a hand-kept copy of RESERVED_SLUGS in
  // src/lib/reservedSlugs.ts, on purpose.
  //
  // What is NOT on purpose is the copy going stale, which it had: it still
  // reserved seven module routes the starter never built. reservedSlugs.test.ts
  // now reads this file off disk and fails when the two lists disagree, the
  // same way layout-variants.test.ts re-derives a grid's base columns from the
  // component. Every line carries its capability's scaffold marker so a removal
  // takes the slug out of both copies at once.
  const RESERVED = new Set([
    'blog', // scaffold: journal
    'post', // scaffold: journal
    'privacy',
    '404',
    'styleguide',
    'sitemap-index.xml',
    'og',
    '_astro',
  ]);
  const slugs = await getAllPageSlugs().catch(() => [] as string[]);
  return slugs.filter((slug) => !RESERVED.has(slug)).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const [pageDoc, siteSettings] = await Promise.all([
  getPage(slug as string).catch(() => null),
  getSiteSettings().catch(() => null),
]);

if (!pageDoc) return Astro.redirect('/404');

const title = (pageDoc as any).seoTitle ?? (pageDoc as any).title ?? site.name;
const description = (pageDoc as any).seoDescription ?? '';
const seoImage = (pageDoc as any).seoImage ?? undefined;
// "Keep this page out of Google" (page.hideFromSearch). The other half of that
// switch is the sitemap filter in astro.config.mjs, which drops the same page.
const noindex = (pageDoc as any).hideFromSearch === true;

// The header sits ON the picture when this page opens with an image hero.
// One predicate, shared with index.astro, so the two routes cannot disagree.
const overlayHeader = shouldOverlayHeader((pageDoc as any).pageBuilder);

// The page about the Sunday service also carries the service as an Event
// (src/lib/church-schema.ts sundayWorshipNode). Its dated occurrence is the
// Sunday of the newest post, so the same dataset always renders the same
// bytes; see the note at the top of church-schema.ts.
let worship: string | null = null;
if (slug === SERVICE_PAGE_SLUG) {
  const newest = await sanityFetch<string | null>(
    `*[_type == "journalEntry" && defined(publishedAt)] | order(publishedAt desc)[0].publishedAt`,
    {},
    null,
  ).catch(() => null);
  worship = sundayWorshipSchema(siteSettings, sundayOnOrAfter(newest));
}

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: (pageDoc as any).title ?? 'Page', url: `${site.url}/${slug}` },
  ]),
  ...(worship ? [worship] : []),
];
---

<BaseLayout
  {title}
  {description}
  {schemas}
  {siteSettings}
  {noindex}
  {overlayHeader}
  seoImage={seoImage}
>
  <SectionRenderer
    sections={(pageDoc as any).pageBuilder}
    idPrefix="page"
    settings={siteSettings}
  />
</BaseLayout>
