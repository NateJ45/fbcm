---
// scaffold-file: journal
// Safe to edit by hand
// Pages 2..N of one category. A second route rather than a rest parameter,
// because a `[...rest]` catch-all under /blog/category would also swallow the
// single-segment category pages and it would be the file order, not the URL,
// that decided which one answered.
//
// Page 1 of a category is /blog/category/<slug>/ and is never built here.
import BaseLayout from '@/layouts/BaseLayout.astro';
import Archive from '@/components/blog/Archive.astro';
import FinalCta from '@/components/FinalCta.astro';
import {
  getAllJournalEntries,
  getAllJournalCategories,
  getJournalPage,
  getSiteSettings,
} from '@/lib/queries';
import { getSectionVisibility } from '@/lib/sectionVisibility';
import { breadcrumbSchema } from '@/lib/schemas';
import { site } from '@/data/site';
import { paginate, PER_PAGE, clean } from '@/lib/blog-derive';

export async function getStaticPaths() {
  const [entries, categories, settings] = await Promise.all([
    getAllJournalEntries().catch(() => []),
    getAllJournalCategories().catch(() => []),
    getSiteSettings().catch(() => null),
  ]);
  if (!getSectionVisibility(settings?.sectionVisibility).journal) return [];

  const all = (entries ?? []) as any[];
  const paths: Array<{ params: { slug: string; page: string } }> = [];
  for (const c of (categories ?? []) as any[]) {
    const slug = c?.slug?.current;
    if (!slug) continue;
    const count = all.filter((e) =>
      (e.categories ?? []).some((cat: any) => clean(cat?.slug?.current) === slug),
    ).length;
    const { pages } = paginate(new Array(count), PER_PAGE, 1);
    for (let n = 2; n <= pages; n += 1) paths.push({ params: { slug, page: String(n) } });
  }
  return paths;
}

const { slug } = Astro.params;
const pageNumber = Number(Astro.params.page);
const [entries, categories, journalPage, siteSettings] = await Promise.all([
  getAllJournalEntries().catch(() => []),
  getAllJournalCategories().catch(() => []),
  getJournalPage().catch(() => null),
  getSiteSettings().catch(() => null),
]);

const category = ((categories ?? []) as any[]).find((c) => c?.slug?.current === slug);
if (!category) return Astro.redirect('/blog');

const inCategory = ((entries ?? []) as any[]).filter((e) =>
  (e.categories ?? []).some((c: any) => clean(c?.slug?.current) === slug),
);
const slice = paginate(inCategory, PER_PAGE, pageNumber);
const label = clean(category.title) || String(slug);

const title = `${label}, page ${slice.page} | Blog | ${site.name}`;
const description = `Page ${slice.page} of ${slice.pages} of ${label} from First Baptist Church Muncie.`;

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'Blog', url: `${site.url}/blog` },
    { name: label, url: `${site.url}/blog/category/${slug}/` },
    { name: `Page ${slice.page}`, url: `${site.url}/blog/category/${slug}/page/${slice.page}/` },
  ]),
];
---

<BaseLayout {title} {description} {schemas} {siteSettings}>
  <Archive
    eyebrow="Category"
    heading={label}
    intro={`Page ${slice.page} of ${slice.pages}.`}
    entries={slice.items}
    page={slice.page}
    pages={slice.pages}
    basePath={`/blog/category/${slug}`}
    categories={(categories ?? []) as any}
    activeSlug={String(slug)}
  />
  <FinalCta
    headline={journalPage?.finalCtaHeadline}
    subhead={journalPage?.finalCtaSubhead}
    cta={journalPage?.finalCta}
    backgroundImage={journalPage?.finalCtaBackgroundImage}
  />
</BaseLayout>
