---
// scaffold-file: journal
// Safe to edit by hand for copy + structure changes.
// The blog index. Spec 5.10: the archive foregrounds the 36 durable posts
// without hiding the 106 weekly sermon previews.
//
// Five bands, in this order:
//   1. Hero, from the journalPage singleton (seeded by scripts/pages/blog.mjs).
//   2. Featured: the newest six DURABLE posts. Which six is derived from the
//      category every build (splitDurable), never from journalEntry.featured,
//      which is a stored boolean nothing here reads (CLAUDE.md rule 15).
//   3. This week: the newest sermon preview, one wide card, under an eyebrow
//      that names the week it was written for.
//   4. All posts: page 1 of 12, with the category chips and the pager.
//   5. The singleton's additionalSections (this is where the #publications
//      document list lives), then the closing CTA.
//
// The whole archive is static. There is no SSR outside /preview, so the
// category filter is a ROUTE (/blog/category/<slug>/), not a querystring, and
// the inline script at the top of <main> is what carries plan 1's six
// /blog?category=... redirect targets onto it.
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  getJournalPage,
  getAllJournalEntries,
  getAllJournalCategories,
  getSiteSettings,
} from '@/lib/queries';
import { getSectionVisibility } from '@/lib/sectionVisibility';
import { breadcrumbSchema } from '@/lib/schemas';
import { site } from '@/data/site';
import {
  splitDurable,
  paginate,
  weekOfEyebrow,
  clean,
  tagIndex,
  PER_PAGE,
} from '@/lib/blog-derive';
import { slugify } from '@/lib/slugify';

import Hero from '@/components/Hero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import JournalCard from '@/components/JournalCard.astro';
import PostGrid from '@/components/blog/PostGrid.astro';
import Pager from '@/components/blog/Pager.astro';
import CategoryChips from '@/components/blog/CategoryChips.astro';
import FinalCta from '@/components/FinalCta.astro';

const [page, entries, categories, siteSettings] = await Promise.all([
  getJournalPage().catch(() => null),
  getAllJournalEntries().catch(() => []),
  getAllJournalCategories().catch(() => []),
  getSiteSettings().catch(() => null),
]);

// Section visibility guard.
const visible = getSectionVisibility(siteSettings?.sectionVisibility);
if (!visible.journal) return Astro.redirect('/');

const title = page?.seoTitle ?? `Blog | ${site.name}`;
const description =
  page?.seoDescription ??
  'Sermon previews, church news and writing from the pastors of First Baptist Church Muncie.';

const heroEyebrow = page?.heroEyebrow ?? 'Blog';
const heroHeadline = page?.heroHeadline ?? 'Writing from First Baptist.';
const heroSubhead = page?.heroSubhead ?? undefined;

const all = (entries ?? []) as any[];
const { durable, previews } = splitDurable(all);
const featured = durable.slice(0, 6);
const thisWeek = previews[0] ?? null;
const firstPage = paginate(all, PER_PAGE, 1);

// The routes the redirect script below is allowed to send a visitor to. Both
// lists are derived from the SAME data the two routes build from, so the script
// can never point at a page this build did not produce:
//   - category: the filter in src/pages/blog/category/[slug].astro's
//     getStaticPaths (a slug, and at least one post),
//   - tag: the grouping in src/pages/blog/tag/[tag].astro's getStaticPaths.
const builtCategorySlugs = ((categories ?? []) as any[])
  .filter((c) => c?.slug?.current && (c.postCount ?? 0) > 0)
  .map((c) => clean(c.slug.current));
const builtTagSlugs = tagIndex(all as any[], slugify).map((g) => g.slug);

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'Blog', url: `${site.url}/blog` },
  ]),
];
---

<BaseLayout {title} {description} {schemas} {siteSettings} seoImage={page?.seoImage}>
  {
    /* Plan 1 retired six Wix category listings to `/blog?category=<slug>` (see
     BLOG_CATEGORIES in src/lib/fbcm-redirects.ts). This site is static, so the
     index cannot read a querystring at build time; this hands the visitor on to
     the built category page instead. `pianist` was a TAG on the old site, not a
     category, so it goes to the tag route. `fbcm-events-1` is the legacy spelling
     of `fbcm-events`.

     ANYTHING ELSE FALLS THROUGH and /blog just renders, which is what the
     comment always claimed and what the script now actually does. It used to
     redirect on ANY non-empty value, so a mistyped or long-dead slug in
     somebody's bookmark was sent to a category route this build never made:
     a 404 in place of the archive index. The two allow-lists are built above
     from the same data the two routes' getStaticPaths use, so the script and
     the build cannot disagree about what exists. */
  }
  <script is:inline define:vars={{ categorySlugs: builtCategorySlugs, tagSlugs: builtTagSlugs }}>
    (function () {
      var slug = new URLSearchParams(location.search).get('category');
      if (!slug) return;
      var MOVED = { 'fbcm-events-1': 'fbcm-events' };
      var s = MOVED[slug] || slug;
      if (categorySlugs.indexOf(s) !== -1) {
        location.replace('/blog/category/' + encodeURIComponent(s) + '/');
      } else if (tagSlugs.indexOf(s) !== -1) {
        location.replace('/blog/tag/' + encodeURIComponent(s) + '/');
      }
      // Unknown slug: do nothing. The archive index is already rendering.
    })();
  </script>

  {/* ------- 1. Hero --------------------------------------------------------- */}
  <Hero
    eyebrow={heroEyebrow}
    headline={heroHeadline}
    subhead={heroSubhead}
    backgroundImage={page?.heroImage}
    headingId="blog-hero-heading"
    size="short"
    layout="split"
  />

  {/* ------- 2. Featured: the newest six durable posts ---------------------- */}
  {
    featured.length > 0 && (
      <section class="bg-background" aria-labelledby="blog-featured-heading">
        <div class="mx-auto max-w-content px-gutter py-section-lg">
          <SectionHeading
            eyebrow="Featured"
            headline="Worth coming back for"
            headingId="blog-featured-heading"
            level="h2"
            align="left"
            tone="church"
          />
          <div class="mt-section-md">
            <PostGrid entries={featured} />
          </div>
        </div>
      </section>
    )
  }

  {
    /* ------- 3. This week: the newest sermon preview, one wide card --------
     The eyebrow names the week from the post's own publish date. It is the
     band's eyebrow rather than the card's because there is exactly one card
     here and the date IS the heading of this band. */
  }
  {
    thisWeek && (
      <section class="bg-muted" aria-labelledby="blog-this-week-heading">
        <div class="mx-auto max-w-content px-gutter py-section-lg">
          <SectionHeading
            eyebrow={weekOfEyebrow(thisWeek.publishedAt)}
            headline="This week"
            headingId="blog-this-week-heading"
            level="h2"
            align="left"
            tone="church"
          />
          <div class="mt-section-md grid grid-cols-1 lg:grid-cols-2">
            <JournalCard entry={thisWeek} featured />
          </div>
        </div>
      </section>
    )
  }

  {/* ------- 4. All posts: page 1 of the archive ---------------------------- */}
  <section class="bg-background" aria-labelledby="blog-all-heading">
    <div class="mx-auto max-w-content px-gutter py-section-lg">
      <SectionHeading
        eyebrow="The archive"
        headline="All posts"
        headingId="blog-all-heading"
        level="h2"
        align="left"
        tone="church"
      />

      <div class="mt-l">
        <CategoryChips categories={(categories ?? []) as any} />
      </div>

      <div class="mt-section-md">
        <PostGrid entries={firstPage.items} emptyMessage="The first posts are on their way." />
      </div>

      <Pager page={firstPage.page} pages={firstPage.pages} basePath="/blog" />
    </div>
  </section>

  {
    /* ------- 5. Extra sections from the Studio ------------------------------
     The #publications document list (The Visitor, and the two books) is one of
     these, seeded by scripts/pages/blog.mjs. idPrefix keeps its generated
     heading ids from colliding with the bands drawn above. */
  }
  <SectionRenderer
    sections={(page as any)?.additionalSections}
    idPrefix="blog"
    settings={siteSettings}
  />

  {/* ------- 6. Final CTA ---------------------------------------------------- */}
  <FinalCta
    headline={page?.finalCtaHeadline}
    subhead={page?.finalCtaSubhead}
    cta={page?.finalCta}
    backgroundImage={page?.finalCtaBackgroundImage}
  />
</BaseLayout>
