---
// scaffold-file: journal
// Safe to edit by hand
// One page per tag. 217 of them, which is exactly why the tags are NOT a cloud
// on the index: a 217-chip band is not a filter, it is a wall. They are reached
// from the chips on a post, where a tag means "more like the thing you are
// already reading".
//
// No pagination here: the largest tag is far short of a page break's worth, and
// a pager on a six-post list is furniture.
import BaseLayout from '@/layouts/BaseLayout.astro';
import Archive from '@/components/blog/Archive.astro';
import { getAllJournalEntries, getSiteSettings } from '@/lib/queries';
import { getSectionVisibility } from '@/lib/sectionVisibility';
import { breadcrumbSchema } from '@/lib/schemas';
import { site } from '@/data/site';
import { tagIndex, type RegisterEntry } from '@/lib/blog-derive';
import { slugify } from '@/lib/slugify';

export async function getStaticPaths() {
  const [entries, settings] = await Promise.all([getAllJournalEntries(), getSiteSettings()]);
  if (!getSectionVisibility(settings?.sectionVisibility).journal) return [];

  // The whole group travels as a prop: the route would otherwise re-derive the
  // same 217-way grouping once per page. The whole archive travels too, by
  // reference, for the filter row's counts.
  const all = (entries ?? []) as RegisterEntry[];
  return tagIndex(all, slugify).map((group) => ({
    params: { tag: group.slug },
    props: { label: group.label, entries: group.entries, all },
  }));
}

const { tag } = Astro.params;
const { label, entries, all } = Astro.props as {
  label: string;
  entries: RegisterEntry[];
  all: RegisterEntry[];
};
const siteSettings = await getSiteSettings();

const count = entries.length;
const title = `${label} | Blog | ${site.name}`;
const description = `${count} ${count === 1 ? 'post' : 'posts'} tagged ${label} from First Baptist Church Muncie, newest first.`;

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'Blog', url: `${site.url}/blog` },
    { name: label, url: `${site.url}/blog/tag/${tag}/` },
  ]),
];
---

<BaseLayout {title} {description} {schemas} {siteSettings}>
  <Archive
    eyebrow="Tagged"
    heading={label}
    intro={`${count} ${count === 1 ? 'post' : 'posts'}, newest first.`}
    list={entries}
    allEntries={all}
    page={1}
    paged={false}
    basePath={`/blog/tag/${tag}`}
    exclude={label}
  />
</BaseLayout>
