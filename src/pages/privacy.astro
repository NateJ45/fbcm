---
// Safe to edit by hand
// Privacy policy page. Fetches the privacyPage singleton from Sanity for the
// body and lastUpdated date. When the doc doesn't exist yet (or Sanity isn't
// reachable), a plain-voice fallback policy is rendered so the page is always
// live and accurate.
//
// THE LOOK (2026-09-24, the utility identity pass; rollout plan step 10).
// The same opener as /404 and /give: the brand INDIGO band with the words at
// the gutter and one building glyph drawn large in gold at the right (the
// window: the page is the church letting a visitor see in). The eyebrow is the
// window hero's small gold titling label (its own .pv-label: .hw-label ships
// only with Hero.astro), the h1 is sized by its own length
// (headlineScale), and the last-updated date sits under it in paper. Below,
// the policy stays READABLE LEGAL TEXT on the page surface: one column at the
// gutter, in the measured PROSE_MEASURE, sub-heads in Castoro roman. Nothing
// decorates it.
//
// THE FALLBACK IS THIS CHURCH'S POLICY (CLAUDE.md rule 11). Until this pass
// the no-singleton fallback still carried the starter's client copy: a
// contact form, a newsletter, "studio updates, room ideas, and project
// previews". None of that is true of this site. It now says what
// scripts/pages/privacy.mjs seeds, from the same facts: no form, no account,
// no cookies of its own, the measurement paragraph branched on the real build
// configuration (src/lib/analytics-config.ts), and the linked services named
// from Site settings.
//
// The sub-heads in the fallback are Castoro ROMAN (font-body), never the
// titling face: Castoro Titling is capitals-only. The CSS is in this file's
// <style> block, so it ships on /privacy only (CLAUDE.md rule 20).

import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import PortableTextStatic from '@/components/PortableTextStatic.astro';
import BuildingGlyph from '@/components/church/BuildingGlyph.astro';
import { PROSE_MEASURE } from '@/lib/prose';
import { headlineScale } from '@/lib/headline-scale';
import { getPrivacyPage, getSiteSettings } from '@/lib/queries';

// What this build ACTUALLY ships, read from the same module that decides whether
// each tag renders. The fallback copy below branches on these rather than
// asserting a fixed answer. See src/lib/analytics-config.ts.
import PrivacyDerived from '@/components/privacy/PrivacyDerived.astro';
import { breadcrumbSchema } from '@/lib/schemas';
import { site } from '@/data/site';

const [page, siteSettings] = await Promise.all([getPrivacyPage(), getSiteSettings()]);

const title = page?.seoTitle ?? `Privacy Policy · ${site.name}`;
const description =
  page?.seoDescription ??
  'What this site does and does not do with your information, and where its linked services keep their own privacy policies.';

const heroEyebrow = page?.heroEyebrow ?? 'This site, plainly.';
const heroHeadline = page?.heroHeadline ?? 'Privacy Policy';
const heroSubhead = page?.heroSubhead ?? '';

// Format the lastUpdated date from Sanity or fall back to a static string.
// Sanity's `date` field is a plain "YYYY-MM-DD" with no time zone, and
// `new Date(d)` parses that as UTC midnight. Formatting with the LOCAL time
// zone (toLocaleDateString's default) then rolls it back a calendar day for
// any visitor west of UTC, which is every US time zone: a policy dated
// 2026-09-20 read as "September 19, 2026". UTC getters read back the same
// calendar day that was typed, everywhere.
function formatDate(d?: string): string {
  if (!d) return '';
  const date = new Date(d);
  if (Number.isNaN(date.getTime())) return '';
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });
}
const lastUpdated = formatDate(page?.lastUpdated);

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'Privacy Policy', url: `${site.url}/privacy` },
  ]),
];

// The fallback's facts, from Site settings (never typed here).
const contactEmail = siteSettings?.email ?? `office@${site.domain}`;
const contactPhone = siteSettings?.phone ?? null;
// Only a service whose address is actually set: an unlinked name claiming its
// own privacy policy would be misleading, and Church Center is retired here
// (the church has moved to Church Trac) until and unless its box is filled
// again.
const services = [
  { name: 'Church Center', url: siteSettings?.churchCenterUrl, does: 'holds some older records.' },
  {
    name: 'Church Trac',
    url: siteSettings?.churchTracUrl,
    does: 'holds the church calendar, the connection card, church records and the newsletters.',
  },
  {
    name: 'YouTube',
    url: siteSettings?.youtubeUrl,
    does: 'hosts our livestream and sermon recordings.',
  },
].filter((s) => s.url);

// Whether to use Sanity body content
const hasSanityBody = Boolean(page?.body);
const H2 = 'mt-14 mb-5 font-body text-h2 font-normal text-foreground';
---

<BaseLayout {title} {description} {schemas} {siteSettings} seoImage={page?.seoImage} searchBody>
  {
    /* One region landmark per band, each named by its heading. The opener is
      the h1; the policy is one column at the same gutter (CLAUDE.md rule 17). */
  }
  <section class="pv-open" aria-labelledby="privacy-hero-heading">
    <div class="pv-grid mx-auto max-w-content px-gutter">
      <BuildingGlyph name="window" class="pv-glyph" />
      <div class="pv-words min-w-0">
        {heroEyebrow && <p class="pv-label font-display text-gold uppercase">{heroEyebrow}</p>}
        <SectionHeading
          headline={heroHeadline}
          subhead={heroSubhead}
          headingId="privacy-hero-heading"
          level="h1"
          scale={headlineScale(heroHeadline, { tall: false })}
          align="left"
          tone="band"
          wide
        />
        {lastUpdated && <p class="pv-date font-ui">Last updated {lastUpdated}</p>}
      </div>
    </div>
  </section>

  <section class="bg-background" aria-label="The policy">
    <div class="mx-auto max-w-content px-gutter py-section-lg">
      {
        hasSanityBody ? (
          <>
            <PortableTextStatic value={page!.body} className={`prose-friendly ${PROSE_MEASURE}`} />
            {/* Cookies, measurement, search and the contact line: derived at
              build time, never stored in the document (PrivacyDerived.astro). */}
            <div class={PROSE_MEASURE}>
              <PrivacyDerived email={contactEmail} phone={contactPhone} />
            </div>
          </>
        ) : (
          <div class:list={['space-y-l', PROSE_MEASURE]}>
            <p>
              This site is run by {site.name} to share what is happening at the church. This policy
              explains what the site itself does with information from anyone who visits it.
            </p>

            <div>
              <h2 class={H2}>What this site does not do</h2>
              <ul class="list-disc space-y-1 pl-6 marker:text-gold">
                <li>This site has no contact form, sign-up form or account system of its own.</li>
                <li>It does not ask you to create an account or log in.</li>
              </ul>
            </div>

            <div>
              <h2 class={H2}>Links to other services</h2>
              <p>
                This site links out to a few services the church uses for things this site itself
                does not do.
              </p>
              <ul class="mt-s list-disc space-y-1 pl-6 marker:text-gold">
                {services.map((s) => (
                  <li>
                    {s.url ? (
                      <a
                        href={s.url}
                        class="text-link underline underline-offset-2 hover:text-primary"
                      >
                        {s.name}
                      </a>
                    ) : (
                      s.name
                    )}{' '}
                    {s.does} It has its own privacy policy, separate from this one.
                  </li>
                ))}
              </ul>
            </div>

            <PrivacyDerived email={contactEmail} phone={contactPhone} h2Class={H2} pClass="" />
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .pv-open {
    background: var(--color-band-indigo);
    color: var(--color-white-pure);
    padding-block: clamp(56px, 8vw, 128px);
  }
  .pv-grid {
    display: grid;
    gap: 24px clamp(32px, 5vw, 96px);
    align-items: end;
  }
  .pv-open :global(.pv-glyph) {
    width: 64px;
    color: var(--color-gold);
  }
  @media (min-width: 1024px) {
    .pv-grid {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .pv-words {
      grid-row: 1;
      grid-column: 1;
    }
    .pv-open :global(.pv-glyph) {
      grid-row: 1;
      grid-column: 2;
      width: clamp(130px, 13vw, 200px);
    }
  }
  .pv-label {
    margin: 0 0 0.5em;
    font-size: clamp(26px, 2.4vw, 34px);
    line-height: 1;
    letter-spacing: 0.06em;
  }
  .pv-date {
    margin: clamp(18px, 2.4vw, 28px) 0 0;
    font-size: 1rem;
    color: color-mix(in srgb, var(--color-bg) 85%, transparent);
  }
</style>
