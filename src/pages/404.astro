---
// Safe to edit by hand
// Custom 404. Warm, on-brand, three clear paths back. No search (there isn't one).
//
// Layout: the interior image hero. The photograph is full-bleed under the two
// gradients in HeroBackground with the words on the bottom-left gutter, which
// is what every other hero on this site does, and the header overlays it the
// same way. The photo is sourced from Sanity (the notFoundPage singleton's
// heroImage) and
// pipes through the same SanityImage CDN/transform pipeline as every other
// photo on the site. There is no code-drawn fallback photo any more (rule
// 11: the previous fallback was a leftover Reid Design asset ref, "Studio
// dogs on the sofa", that shipped because nothing in the build ever pointed
// at the placeholder to notice it was somebody else's photo). When the
// singleton has no image, the page simply renders without one.

import BaseLayout from '@/layouts/BaseLayout.astro';
import { getNotFoundPage, getSiteSettings } from '@/lib/queries';
import HeroBackground from '@/components/HeroBackground.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import CtaLink from '@/components/CtaLink.astro';

const [notFoundPage, siteSettings] = await Promise.all([
  getNotFoundPage().catch(() => null),
  getSiteSettings().catch(() => null),
]);

const seoTitle = notFoundPage?.seoTitle ?? 'Page not found';
const seoDescription =
  notFoundPage?.seoDescription ??
  'That page wandered off. Head back to the homepage or get in touch.';

const eyebrow = notFoundPage?.eyebrow ?? '404';
const headline = notFoundPage?.headline ?? 'That page wandered off.';
const body =
  notFoundPage?.body ??
  "It happens. Maybe a link is old, maybe the URL has a typo. Either way, here's where to head next.";

// CtaLink draws every button on the site (CLAUDE.md rule 17: one button
// family). The singleton's three CTA slots are plain label/href strings
// rather than the ctaBlock shape CtaLink resolves references from, so each
// is wrapped as an "external" cta here: resolveHref() just returns
// externalUrl unchanged for that link type, and openInNewTab is forced to
// false because these are same-site paths, not a link off the site.
function asCta(label: string, href: string) {
  return { label, linkType: 'external' as const, externalUrl: href, openInNewTab: false };
}

const primaryCta = asCta(
  notFoundPage?.primaryCtaLabel ?? 'Plan a visit',
  notFoundPage?.primaryCtaHref ?? '/visit',
);
const secondaryCta = asCta(
  notFoundPage?.secondaryCtaLabel ?? 'Read the blog',
  notFoundPage?.secondaryCtaHref ?? '/blog',
);
const tertiaryCta = asCta(
  notFoundPage?.tertiaryCtaLabel ?? 'Contact us',
  notFoundPage?.tertiaryCtaHref ?? '/contact',
);

const photo = notFoundPage?.heroImage ?? null;
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  siteSettings={siteSettings}
  overlayHeader={!!photo}
  noindex
>
  {
    /* THE 404 IS A HERO NOW (art-direction pass, 2026-09-20, task 11).
      It used to be a two-column band: words in a centred column on mobile,
      the tower photograph beside them in a rounded panel, with the caption
      set in an uppercase label under it. So the one page on this site whose
      job is to look like the site looked like nothing else on it.
      It is the interior hero instead: the photograph full-bleed under the
      same two gradients every other hero uses, the words on the bottom-left
      gutter, the headline in the titling capitals. Same component
      (HeroBackground), same gradient, same left edge.

      The caption is dropped with the panel. A credit line over a photograph
      the visitor is reading an apology on is furniture, and the alt text on
      the image still describes it. */
  }
  {
    photo ? (
      <section
        class="relative isolate flex min-h-[72svh] flex-col justify-end overflow-hidden bg-accent-dark text-bg"
        aria-labelledby="not-found-heading"
      >
        <HeroBackground images={[photo]} />

        <div class="relative mx-auto w-full max-w-content px-gutter pt-[clamp(72px,12vh,128px)] pb-[clamp(40px,7vh,72px)]">
          <p class="mb-[clamp(18px,3vh,32px)] inline-flex items-center gap-3.5 font-ui text-ui font-medium">
            <span class="h-px w-11 bg-gold" aria-hidden="true" />
            <span>{eyebrow}</span>
          </p>

          <h1
            id="not-found-heading"
            class="max-w-[12ch] font-display text-h1 leading-none font-normal tracking-[0.01em] text-bg uppercase"
          >
            {headline}
          </h1>

          <p class="lede mt-[clamp(18px,3vh,30px)] max-w-[44ch] font-body text-lede font-normal text-bg italic">
            {body}
          </p>

          <div class="mt-[clamp(26px,4vh,40px)] flex flex-wrap items-center gap-x-[34px] gap-y-[22px]">
            {/* One gold button and two text links: the way back to Sunday is
                the loud one, the other two are quieter and should look it. */}
            <CtaLink cta={primaryCta} variant="gold" onDark />
            <CtaLink cta={secondaryCta} variant="link" onDark />
            <CtaLink cta={tertiaryCta} variant="link" onDark />
          </div>
        </div>
      </section>
    ) : (
      /* No photograph in the singleton: the text hero, drawn by the same
         SectionHeading every other page opener on this site uses. */
      <section class="bg-background" aria-labelledby="not-found-heading">
        <div class="mx-auto flex min-h-[42svh] max-w-content items-end px-gutter py-section-lg md:min-h-[52svh]">
          <div>
            <SectionHeading
              eyebrow={eyebrow}
              headline={headline}
              subhead={body}
              headingId="not-found-heading"
              level="h1"
              tone="church"
            />
            <div class="mt-[clamp(26px,4vh,40px)] flex flex-wrap items-center gap-x-[34px] gap-y-[22px]">
              <CtaLink cta={primaryCta} variant="gold" />
              <CtaLink cta={secondaryCta} variant="link" />
              <CtaLink cta={tertiaryCta} variant="link" />
            </div>
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
