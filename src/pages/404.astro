---
// Safe to edit by hand
// Custom 404. Warm, plain, in the church's own colours, with four doors back
// into the site. No search (there isn't one).
//
// THE LOOK (2026-09-24, the utility identity pass; rollout plan step 10).
// Two bands, the grammar every other page opener on the site now speaks:
//
//   1. The apology on the brand INDIGO band, like the window hero and the
//      journal's opener: "404" as the small gold titling label the window
//      hero uses for its eyebrow, the headline in the titling capitals sized
//      by its own length (headlineScale, so nothing breaks mid-word), the
//      body as the paper lede, and the church's door, the Tudor door glyph,
//      drawn large in gold at the right: the way back in. The header keeps
//      its paper bar above it (a colour, not a picture).
//   2. FOUR DOORS on the page surface: Visit, Who We Are, Blog and Give, each
//      a whole-link door with its building glyph (door, window, rose, basin,
//      by position) over its name in the titling face. A ruled row, not
//      boxed cards (rollout rule 10). The labels and destinations are the
//      notFoundPage singleton's four door fields; a blank one falls back to
//      the same four doors in code, so the page never shows fewer.
//
// NO PHOTOGRAPH. Until this pass the page was the tower photograph full-bleed
// under the hero gradients. That photo is the home hero's first frame and the
// history opener's too, and the rollout does not reuse a photo across pages,
// so the singleton's heroImage is no longer drawn (scripts/pages/
// not-found.mjs stops setting it; the schema field says so). A lost visitor
// needs the doors more than a picture.
//
// The CSS is in this file's <style> block, so it ships on /404 only
// (CLAUDE.md rule 20).

import BaseLayout from '@/layouts/BaseLayout.astro';
import { getNotFoundPage, getSiteSettings } from '@/lib/queries';
import SectionHeading from '@/components/SectionHeading.astro';
import BuildingGlyph from '@/components/church/BuildingGlyph.astro';
import { headlineScale } from '@/lib/headline-scale';

const [notFoundPage, siteSettings] = await Promise.all([
  getNotFoundPage().catch(() => null),
  getSiteSettings().catch(() => null),
]);

type NotFoundDoc = {
  seoTitle?: string | null;
  seoDescription?: string | null;
  eyebrow?: string | null;
  headline?: string | null;
  body?: string | null;
  primaryCtaLabel?: string | null;
  primaryCtaHref?: string | null;
  secondaryCtaLabel?: string | null;
  secondaryCtaHref?: string | null;
  tertiaryCtaLabel?: string | null;
  tertiaryCtaHref?: string | null;
  fourthCtaLabel?: string | null;
  fourthCtaHref?: string | null;
};
const doc = (notFoundPage ?? null) as NotFoundDoc | null;

const seoTitle = doc?.seoTitle || 'Page not found';
const seoDescription =
  doc?.seoDescription || 'That page has moved or never was. Head back to the site or get in touch.';

const eyebrow = doc?.eyebrow || '404';
const headline = doc?.headline || 'That page has moved or never was.';
const body =
  doc?.body ||
  "It happens. If you followed an old link, it may have moved when we rebuilt this site. Here's where to go instead.";

// The four doors. Each slot is the singleton's label and destination when an
// editor filled both, and the site's own door in that position otherwise.
const DOORS = [
  { glyph: 'door', label: 'Visit', href: '/visit' },
  { glyph: 'window', label: 'Who We Are', href: '/who-we-are' },
  { glyph: 'rose', label: 'Blog', href: '/blog' },
  { glyph: 'basin', label: 'Give', href: '/give' },
] as const;
const slots: [string | null | undefined, string | null | undefined][] = [
  [doc?.primaryCtaLabel, doc?.primaryCtaHref],
  [doc?.secondaryCtaLabel, doc?.secondaryCtaHref],
  [doc?.tertiaryCtaLabel, doc?.tertiaryCtaHref],
  [doc?.fourthCtaLabel, doc?.fourthCtaHref],
];
const doors = DOORS.map((fallback, i) => {
  const [label, href] = slots[i];
  return label && href ? { glyph: fallback.glyph, label, href } : fallback;
});
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  siteSettings={siteSettings}
  overlayHeader={false}
  noindex
>
  <section class="nf-open" aria-labelledby="not-found-heading">
    <div class="nf-grid mx-auto max-w-content px-gutter">
      <BuildingGlyph name="door" class="nf-glyph" />
      <div class="nf-words min-w-0">
        {eyebrow && <p class="nf-label font-display text-gold uppercase">{eyebrow}</p>}
        <SectionHeading
          headline={headline}
          headingId="not-found-heading"
          level="h1"
          scale={headlineScale(headline, { tall: false })}
          align="left"
          tone="band"
          wide
        />
        {body && <p class="nf-lede font-body">{body}</p>}
      </div>
    </div>
  </section>

  <nav class="nf-doors" aria-label="Where to go instead">
    <ul class="nf-row mx-auto max-w-content px-gutter">
      {
        doors.map((door) => (
          <li>
            <a class="nf-door" href={door.href}>
              <BuildingGlyph name={door.glyph} class="nf-door-glyph" />
              <span class="nf-door-name font-display">{door.label}</span>
              <span class="nf-door-arrow font-ui" aria-hidden="true">
                &rarr;
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</BaseLayout>

<style>
  .nf-open {
    background: var(--color-band-indigo);
    color: var(--color-white-pure);
    padding-block: clamp(56px, 9vw, 140px);
  }
  .nf-grid {
    display: grid;
    gap: 24px clamp(32px, 5vw, 96px);
    align-items: end;
  }
  .nf-open :global(.nf-glyph) {
    width: 64px;
    color: var(--color-gold);
  }
  @media (min-width: 1024px) {
    .nf-grid {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .nf-words {
      grid-row: 1;
      grid-column: 1;
    }
    .nf-open :global(.nf-glyph) {
      grid-row: 1;
      grid-column: 2;
      width: clamp(150px, 15vw, 230px);
    }
  }
  .nf-label {
    margin: 0 0 0.5em;
    font-size: clamp(26px, 2.4vw, 34px);
    line-height: 1;
    letter-spacing: 0.06em;
  }
  .nf-lede {
    margin: clamp(18px, 2.4vw, 28px) 0 0;
    max-width: 32em;
    font-size: var(--text-lede);
    font-style: italic;
    line-height: 1.45;
    color: color-mix(in srgb, var(--color-bg) 88%, transparent);
  }

  .nf-doors {
    background: var(--color-background);
    padding-block: clamp(48px, 6vw, 96px);
  }
  .nf-row {
    list-style: none;
    margin-block: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 clamp(16px, 3vw, 40px);
  }
  @media (min-width: 1024px) {
    .nf-row {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .nf-door {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 14px 12px;
    min-height: 44px;
    padding-block: clamp(20px, 2.4vw, 28px);
    border-top: 1px solid var(--color-hair-strong);
    color: var(--color-foreground);
    text-decoration: none;
  }
  .nf-door :global(.nf-door-glyph) {
    grid-column: 1 / -1;
    width: clamp(40px, 4vw, 56px);
    color: var(--color-gold-ink);
    transition: transform 0.25s ease;
  }
  .nf-door-name {
    font-size: clamp(1.375rem, 1.1rem + 1vw, 2.125rem);
    line-height: 1.05;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    overflow-wrap: normal;
    word-break: normal;
  }
  .nf-door-arrow {
    font-size: 1.25rem;
    color: var(--color-gold-ink);
    transition: transform 0.25s ease;
  }
  .nf-door:hover .nf-door-name,
  .nf-door:focus-visible .nf-door-name {
    text-decoration: underline;
    text-decoration-color: var(--color-gold);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }
  @media (prefers-reduced-motion: no-preference) {
    .nf-door:hover .nf-door-arrow {
      transform: translateX(4px);
    }
    .nf-door:hover :global(.nf-door-glyph) {
      transform: translateY(-3px);
    }
  }
</style>
