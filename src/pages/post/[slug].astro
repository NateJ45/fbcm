---
// scaffold-file: journal
// Safe to edit by hand for copy + structure changes.
// Blog post detail page. Eyebrow (the category, or "Sermon preview, week of
// <date>" on the 106 weekly previews), title + excerpt, cover image, body
// Portable Text, tag chips, "More from this series" by shared tag, prev/next,
// final CTA. BreadcrumbList + BlogPosting JSON-LD.
//
// Every one of those derived bits comes from src/lib/blog-derive.ts, which
// reads the post's own categories and tags. None of it reads
// journalEntry.featured (CLAUDE.md rule 15).
//
// Static-site routing: getStaticPaths enumerates every journalEntry slug at
// build time. The query is duplicated (once for paths, once for the full doc)
// — Astro caches each call per slug, so the perf hit is just the static map.

// This file lives at /post/[slug] on purpose (Task 6, 2026-09-18): it matches
// the live Wix site's post URLs exactly so all 142 existing post addresses
// survive the migration with no redirects. The listing lives at /blog.
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  getAllJournalEntries,
  getJournalEntryBySlug,
  getJournalPage,
  getSiteSettings,
} from '@/lib/queries';
import { getSectionVisibility } from '@/lib/sectionVisibility';
import { breadcrumbSchema, blogPostingSchema } from '@/lib/schemas';
import { readingTimeFromPortableText, formatReadingTime } from '@/lib/reading-time';
import { entryIsSermonPreview, weekOfEyebrow, seriesByTag, clean } from '@/lib/blog-derive';
import { slugify } from '@/lib/slugify';
import { extractHeadings } from '@/lib/portable-text-headings';
import { site } from '@/data/site';
import { urlFor } from '@/lib/sanity';

import SanityImage from '@/components/SanityImage.astro';
import JournalPortableText from '@/components/JournalPortableText';
import JournalCategoryChip from '@/components/JournalCategoryChip.astro';
import PostGrid from '@/components/blog/PostGrid.astro';
import ReadingProgress from '@/components/ReadingProgress.astro';
import StickyCTAChip from '@/components/StickyCTAChip';
import CaseStudyTOC from '@/components/CaseStudyTOC';
import FinalCta from '@/components/FinalCta.astro';

// Enumerate slugs + carry prev/next refs (newest-first iteration).
// Returns [] when journal is off — no detail pages build and they 404.
export async function getStaticPaths() {
  const [entries, settings] = await Promise.all([
    getAllJournalEntries().catch(() => []),
    getSiteSettings().catch(() => null),
  ]);
  const visible = getSectionVisibility(settings?.sectionVisibility);
  if (!visible.journal) return [];

  if (!Array.isArray(entries) || entries.length === 0) return [];

  return entries
    .map((e, i) => {
      const prev = entries[i - 1] ?? null; // newer post
      const next = entries[i + 1] ?? null; // older post
      return {
        params: { slug: e.slug?.current ?? '' },
        props: {
          prev: prev ? { title: prev.title, slug: prev.slug?.current } : null,
          next: next ? { title: next.title, slug: next.slug?.current } : null,
          // "More from this series" is worked out per post from the shared tag
          // vocabulary, so the whole card list travels with the path rather
          // than being re-derived 142 times.
          series: seriesByTag(e as any, entries as any[], 3),
        },
      };
    })
    .filter((entry) => entry.params.slug);
}

const { slug } = Astro.params;
const { prev, next, series } = Astro.props as {
  prev: { title?: string; slug?: string } | null;
  next: { title?: string; slug?: string } | null;
  series: any[];
};

const [entry, siteSettings, journalPage] = await Promise.all([
  getJournalEntryBySlug(slug as string),
  getSiteSettings().catch(() => null),
  // Pulled here purely so the sticky CTA chip label can come from
  // journalPage.stickyCtaLabel without doubling up the singleton fetch
  // elsewhere. Cached by the GROQ layer across getStaticPaths.
  getJournalPage().catch(() => null),
]);

if (!entry) {
  return Astro.redirect('/404');
}

// Meta
// "Blog" is what this section is called here: the route is /blog and the nav
// says Blog. "Studio Journal" was the starter's name for it and it was riding
// on all 142 titles, og:title, twitter:title and og:image:alt.
const title = entry.seoTitle ?? `${entry.title} · Blog`;
const description = entry.seoDescription ?? entry.excerpt ?? 'A note from the studio.';
const coverOg = entry.coverImage?.asset
  ? urlFor(entry.coverImage).width(1200).height(630).fit('crop').quality(80).format('webp').url()
  : undefined;

// Derived
const readMinutes = readingTimeFromPortableText(entry.body);
// TOC headings: pulled from the body's h2/h3/h4 blocks. When there's nothing
// to show, hasToc=false collapses the body grid to a single article column
// so we don't reserve a phantom 260 px sidebar slot.
const headings = extractHeadings(entry.body);
const hasToc = headings.length > 0;
// THE EYEBROW. A weekly sermon preview says which week it is for; every other
// post says its category. Which of the two it is, is derived from the category
// itself (blog-derive.ts), never from a stored flag.
const isPreview = entryIsSermonPreview(entry as any);
const primaryCategory = (entry.categories ?? [])[0] as any;
const eyebrowLabel = isPreview
  ? weekOfEyebrow(entry.publishedAt)
  : clean(primaryCategory?.title) || 'Blog';

// Tag chips. Each one is a built page (/blog/tag/<slug>/), and the slug is the
// same slugify() the tag route builds its paths with, so a chip cannot point at
// a URL that does not exist.
const tagChips = (((entry as any).tags ?? []) as string[])
  .map((t) => clean(t).trim())
  .filter(Boolean)
  .map((label) => ({ label, slug: slugify(label) }))
  .filter((t) => t.slug);

const dateLabel = entry.publishedAt
  ? new Date(entry.publishedAt).toLocaleDateString('en-US', {
      month: 'long',
      day: 'numeric',
      year: 'numeric',
    })
  : '';
const updatedLabel =
  entry.updatedAt && entry.updatedAt !== entry.publishedAt
    ? new Date(entry.updatedAt).toLocaleDateString('en-US', {
        month: 'long',
        day: 'numeric',
        year: 'numeric',
      })
    : '';

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'Blog', url: `${site.url}/blog` },
    { name: entry.title ?? slug, url: `${site.url}/post/${slug}` },
  ]),
  blogPostingSchema(entry, coverOg ?? null),
];
---

<BaseLayout
  {title}
  {description}
  ogImage={coverOg}
  {schemas}
  {siteSettings}
  ogType="article"
  ogArticle={{ publishedAt: entry.publishedAt, author: entry.author }}
>
  {/* Thin bronze progress bar tracking scroll through the article. */}
  <ReadingProgress />

  {/* ------- 1. Article header --------------------------------------------- */}
  <article>
    <header class="bg-background">
      <div class="mx-auto max-w-3xl px-m pt-section-lg pb-l">
        <p class="mb-s text-xs tracking-widest text-foreground/80 uppercase">
          <a
            href={isPreview || !primaryCategory?.slug?.current
              ? '/blog'
              : `/blog/category/${primaryCategory.slug.current}/`}
            class="transition-colors hover:text-primary-dark">{eyebrowLabel}</a
          >
          {
            /* A preview's eyebrow already names its date, so the date is not
              printed a second time beside it. */
          }
          {!isPreview && dateLabel && <span class="mx-xs">·</span>}
          {!isPreview && dateLabel && <time datetime={entry.publishedAt}>{dateLabel}</time>}
          {readMinutes > 0 && <span class="mx-xs">·</span>}
          {readMinutes > 0 && <span>{formatReadingTime(readMinutes)}</span>}
        </p>
        <h1 class="font-display text-h1 leading-tight text-foreground">{entry.title}</h1>
        {
          entry.excerpt && (
            <p class="mt-m text-xl leading-relaxed text-foreground/80">{entry.excerpt}</p>
          )
        }
        {
          Array.isArray(entry.categories) && entry.categories.length > 0 && (
            <ul class="mt-l flex list-none flex-wrap gap-xs p-0">
              {entry.categories.map((cat: any) => (
                <li>
                  <JournalCategoryChip
                    title={cat.title}
                    href={cat.slug?.current ? `/blog/category/${cat.slug.current}/` : undefined}
                    tooltip={cat.description}
                  />
                </li>
              ))}
            </ul>
          )
        }
        {
          entry.author && (
            <p class="mt-l text-sm text-muted-foreground">
              By <span class="font-semibold text-foreground">{entry.author}</span>
              {updatedLabel && <span> · Updated {updatedLabel}</span>}
            </p>
          )
        }

        {
          /* Tags. This is the ONLY place the 217 tags are offered, and the
            reason they are not a cloud on /blog: here a tag means "more like
            the thing you are already reading", which is a question a reader
            actually has. */
        }
        {
          tagChips.length > 0 && (
            <nav class="mt-l" aria-label="Tags on this post">
              <ul class="flex list-none flex-wrap gap-xs p-0">
                {tagChips.map((tag) => (
                  <li>
                    <JournalCategoryChip title={tag.label} href={`/blog/tag/${tag.slug}/`} />
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
      </div>
    </header>

    {
      /* ------- 2. Cover image ----------------------------------------------
        Same editorial cap as the portfolio hero: max-w-4xl (~896 px) so the
        photo reads as a feature image rather than a billboard. Sanity
        request width matches at 1800 so we're not requesting a 1920 px
        file for a slot that maxes around 900 px even at 2× retina. */
    }
    {
      entry.coverImage?.asset && (
        <figure class="mx-auto max-w-4xl px-m">
          <SanityImage
            source={entry.coverImage}
            width={1800}
            loading="eager"
            sizes="(min-width: 920px) 896px, 100vw"
            class="h-auto w-full rounded-md"
          />
          {entry.coverImage.caption && (
            <figcaption class="mt-s text-center text-sm text-foreground/80 italic">
              {entry.coverImage.caption}
            </figcaption>
          )}
        </figure>
      )
    }

    {
      /* ------- 3. Body + TOC ------------------------------------------------
        Same grid structure as the portfolio case-study body: 260 px TOC
        sidebar on lg+ when the post has h2/h3/h4 headings, single article
        column otherwise. `lg:justify-center` centers the pair within the
        section so empty space splits evenly. The article column is sized
        at minmax(0, 48rem) which matches the previous max-w-3xl reading
        width the posts were written for. */
    }
    <div
      class:list={[
        'mx-auto grid max-w-content grid-cols-1 gap-section-md px-m py-section-lg lg:justify-center',
        hasToc ? 'lg:grid-cols-[260px_minmax(0,48rem)]' : 'lg:grid-cols-[minmax(0,48rem)]',
      ]}
    >
      {hasToc && <CaseStudyTOC client:idle headings={headings} />}

      <div>
        {
          /* `client:visible` defers Sanity client + the journal-specific renderers
            (inline images, before/after slider, source cards, galleries) until
            the visitor scrolls the body into view. The article HTML is still
            server-rendered above the fold, so reading starts immediately. */
        }
        <JournalPortableText client:visible value={entry.body} />

        {
          /* Related project link (if this post walks through a specific portfolio piece).
            Centered on mobile so the cross-link reads as a deliberate "go see
            this project" affordance instead of a stray paragraph clinging to
            the left edge. Desktop keeps left-aligned (still inside the
            article column). */
        }
        {
          entry.relatedProject?.slug?.current && (
            <aside class="mt-section-lg border-t border-border-soft pt-l text-center md:text-left">
              <p class="mb-s text-xs tracking-widest text-foreground/80 uppercase">
                Related project
              </p>
              <a
                href={`/portfolio/${entry.relatedProject.slug.current}`}
                class="group inline-flex items-baseline gap-s text-foreground transition-colors hover:text-primary-dark"
              >
                <span class="font-display text-h3">{entry.relatedProject.title}</span>
                <span
                  aria-hidden="true"
                  class="text-xl transition-transform group-hover:translate-x-1"
                >
                  →
                </span>
              </a>
              {(entry.relatedProject.location || entry.relatedProject.year) && (
                <p class="mt-xs text-sm text-muted-foreground">
                  {entry.relatedProject.location}
                  {entry.relatedProject.location && entry.relatedProject.year && <span> · </span>}
                  {entry.relatedProject.year}
                </p>
              )}
            </aside>
          )
        }
      </div>
    </div>
  </article>

  {
    /* ------- 4. More from this series --------------------------------------
      The three posts sharing the most TAGS with this one, newest first
      (seriesByTag in blog-derive.ts). It renders only when something really
      does share a tag: the band this replaced fell back to "three recent posts
      in the same category", which on 106 sermon previews meant three unrelated
      previews under a heading promising a relationship, and a reader cannot
      tell the two apart. Nothing is better than a claim that is not true. */
  }
  {
    Array.isArray(series) && series.length > 0 && (
      <section class="bg-muted" aria-labelledby="post-series-heading">
        <div class="mx-auto max-w-content px-m py-section-lg">
          <h2 id="post-series-heading" class="mb-l font-display text-h2 text-foreground">
            More from this series
          </h2>
          <PostGrid entries={series} />
        </div>
      </section>
    )
  }

  {/* ------- 5. Next / previous post -------------------------------------- */}
  {
    (prev || next) && (
      <nav class="border-t border-border-soft bg-background" aria-label="More journal posts">
        <div class="mx-auto grid max-w-content grid-cols-1 gap-m px-m py-l md:grid-cols-2">
          {prev ? (
            <a href={`/post/${prev.slug}`} class="group">
              <p class="mb-xs text-xs tracking-widest text-foreground/80 uppercase">Newer post</p>
              <p class="font-display text-h4 text-foreground transition-colors group-hover:text-primary-dark">
                ← {prev.title}
              </p>
            </a>
          ) : (
            <div />
          )}
          {next ? (
            <a href={`/post/${next.slug}`} class="group md:text-right">
              <p class="mb-xs text-xs tracking-widest text-foreground/80 uppercase">Older post</p>
              <p class="font-display text-h4 text-foreground transition-colors group-hover:text-primary-dark">
                {next.title} →
              </p>
            </a>
          ) : (
            <div />
          )}
        </div>
      </nav>
    )
  }

  {/* ------- 6. Final CTA -------------------------------------------------- */}
  {
    /* The closing band is the journalPage singleton's, the same one /blog and
      every archive page carries. It used to be the starter's own studio copy
      hard-coded here, on all 142 posts. */
  }
  <FinalCta
    headline={journalPage?.finalCtaHeadline}
    subhead={journalPage?.finalCtaSubhead}
    cta={journalPage?.finalCta}
    backgroundImage={journalPage?.finalCtaBackgroundImage}
  />

  {
    /* Sticky contextual CTA — appears past 50% scroll on long posts.
      Label is Sanity-editable on journalPage; clearing the field hides the
      chip across every journal post. */
  }
  {
    journalPage?.stickyCtaLabel !== '' && (
      <StickyCTAChip
        client:idle
        label={journalPage?.stickyCtaLabel ?? 'Got a question?'}
        href="/contact"
      />
    )
  }
</BaseLayout>
