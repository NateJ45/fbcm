---
// Safe to edit by hand
// scaffold-file: church
//
// /styleguide/ministries: the COMPOSED Ministries page, before it is seeded
// (2026-09-24, the Ministries identity pass).
//
// The page module (scripts/pages/ministries.mjs) is built read-only by
// `node scripts/page-fixture.mjs ministries` into
// scripts/data/fixtures/ministries.json and rendered here through the same
// SectionRenderer the real route uses. Re-run that script after changing the
// module; this file does not change.
//
// THREE THINGS ARE LIVE, NOT FIXED:
//   - The ministries. A Ministry band stores only a reference; the page query
//     dereferences it (queries.ts, the ministrySection arm), which a fixture
//     file cannot do, so each band borrows the projected ministry from the
//     live /ministries band pointing at the same document.
//   - Their goals, as they WILL be: the `goal` field is not written until
//     scripts/set-ministry-goals.mjs --write runs after the schema deploys, so
//     each ministry takes its answer from scripts/data/ministry-goals.json,
//     the same file that script writes from (null stays null). That is what
//     makes the goal index visible here before the data exists.
//   - The people in "Get involved", borrowed from the live staff band exactly
//     as /styleguide/staff does.
//
// Not for visitors: noindex, and under /styleguide, which astro.config.mjs
// keeps out of the sitemap and src/lib/reservedSlugs.ts keeps from being
// shadowed by a page. It can be deleted once /ministries shows this composition.
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import { getPage, getSiteSettings } from '@/lib/queries';
import { shouldOverlayHeader } from '@/lib/heroOverlay';
import { site } from '@/data/site';
import fixture from '../../../scripts/data/fixtures/ministries.json';
import answers from '../../../scripts/data/ministry-goals.json';

type Ministry = { _id?: string; goal?: string | null };
type Block = {
  _type?: string;
  group?: string;
  members?: unknown;
  ministry?: (Ministry & { _ref?: string }) | null;
};

const [siteSettings, live] = await Promise.all([
  getSiteSettings().catch(() => null),
  getPage('ministries').catch(() => null),
]);
const liveBlocks = ((live as { pageBuilder?: Block[] } | null)?.pageBuilder ?? []) as Block[];
const goalOf = new Map(answers.ministries.map((a) => [a.id, a.goal]));
const ministryFor = (id: string | undefined) => {
  const found = liveBlocks.find(
    (b) => b._type === 'ministrySection' && b.ministry?._id === id,
  )?.ministry;
  return found && id ? { ...found, goal: goalOf.get(id) ?? found.goal ?? null } : null;
};
const membersFor = (group: string | undefined) =>
  liveBlocks.find((b) => b._type === 'staffGridSection' && b.group === group)?.members ?? [];
const sections = (fixture.pageBuilder as Block[]).map((b) =>
  b._type === 'ministrySection'
    ? { ...b, ministry: ministryFor(b.ministry?._ref) }
    : b._type === 'staffGridSection'
      ? { ...b, members: membersFor(b.group) }
      : b,
) as unknown[];
---

<BaseLayout
  title={`Ministries, composed | ${site.name}`}
  description="The composed Ministries page, rendered from its seed module before it is applied. Not for visitors."
  {siteSettings}
  noindex
  overlayHeader={shouldOverlayHeader(sections as Parameters<typeof shouldOverlayHeader>[0])}
>
  <SectionRenderer {sections} idPrefix="page" settings={siteSettings} />
</BaseLayout>
