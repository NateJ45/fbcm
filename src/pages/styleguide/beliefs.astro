---
// Safe to edit by hand
// scaffold-file: church
//
// /styleguide/beliefs: the COMPOSED beliefs page, before it is seeded
// (2026-09-24, the Beliefs identity pass).
//
// scripts/pages/beliefs.mjs is built read-only by
// `node scripts/page-fixture.mjs beliefs` into
// scripts/data/fixtures/beliefs.json, projected the way queries.ts projects a
// page (images dereferenced, each document's file turned into `fileUrl`), and
// rendered here through the same SectionRenderer the real route uses. Re-run
// that script after changing the module; this file does not change.
//
// Not for visitors: noindex, and under /styleguide, which astro.config.mjs
// keeps out of the sitemap and src/lib/reservedSlugs.ts keeps from being
// shadowed by a page. It can be deleted once the beliefs page is seeded and
// /beliefs itself shows this composition.
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import { getSiteSettings } from '@/lib/queries';
import { shouldOverlayHeader } from '@/lib/heroOverlay';
import { site } from '@/data/site';
import fixture from '../../../scripts/data/fixtures/beliefs.json';

const siteSettings = await getSiteSettings().catch(() => null);
const sections = fixture.pageBuilder as unknown[];
---

<BaseLayout
  title={`What we believe, composed | ${site.name}`}
  description="The composed beliefs page, rendered from its seed module before it is applied. Not for visitors."
  {siteSettings}
  noindex
  overlayHeader={shouldOverlayHeader(sections as Parameters<typeof shouldOverlayHeader>[0])}
>
  <SectionRenderer {sections} idPrefix="beliefs" settings={siteSettings} />
</BaseLayout>
