---
// Safe to edit by hand
// scaffold-file: church
//
// /styleguide/give: the COMPOSED Give page, before it is seeded (2026-09-24,
// the utility identity pass).
//
// The page module (scripts/pages/give.mjs) is applied to Sanity only after the
// code that draws it is deployed, so the page it WOULD write is built read-only
// by `node scripts/page-fixture.mjs give` into scripts/data/fixtures/give.json
// and rendered here through the same SectionRenderer the real route uses.
// Re-run that script after changing the module; this file does not change.
//
// Not for visitors: noindex, and under /styleguide, which astro.config.mjs
// keeps out of the sitemap and src/lib/reservedSlugs.ts keeps from being
// shadowed by a page. It can be deleted once /give shows this composition.
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import { getSiteSettings } from '@/lib/queries';
import { shouldOverlayHeader } from '@/lib/heroOverlay';
import { site } from '@/data/site';
import fixture from '../../../scripts/data/fixtures/give.json';

const siteSettings = await getSiteSettings().catch(() => null);
const sections = fixture.pageBuilder as unknown[];
---

<BaseLayout
  title={`Give, composed | ${site.name}`}
  description="The composed Give page, rendered from its seed module before it is applied. Not for visitors."
  {siteSettings}
  noindex
  overlayHeader={shouldOverlayHeader(sections as Parameters<typeof shouldOverlayHeader>[0])}
>
  <SectionRenderer {sections} idPrefix="page" settings={siteSettings} />
</BaseLayout>
