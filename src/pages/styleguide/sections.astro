---
// Foundation, edit with care
//
// THE SECTIONS WALL: one of every page-builder block, rendered through the real
// SectionRenderer with FIXED data (the authoring kit, PORTS.md card 109).
//
// WHAT IT IS FOR. `npm run thumbnails` (scripts/shoot-section-thumbnails.mjs)
// shoots each `[data-section-type]` box below into
// public/section-thumbnails/<type>.jpg, and those pictures are what the
// "+ Add item" menu's grid view shows in the Studio. So the picture the church
// office picks from is the block as this site actually draws it, in the
// church's colours and type, not a generic drawing. Re-run after a redesign.
//
// src/lib/authoring.test.ts fails if a block type in sections.ts,
// richSections.ts or churchSections.ts has no fixture here (it looks for
// `_type: '<name>'`) or no picture on disk, so a new block cannot ship
// without a thumbnail.
//
// Fixed data on purpose (see styleguide.astro). Collection-fed blocks (the
// staff grid, the ministry band, the latest posts, a Church Trac form) get
// their rows inline, already in the shape the GROQ projection produces. The
// images are fake Sanity references; the script answers the CDN request with
// tests/visual/fixtures/layout-hero.jpg, so no network is needed. Not shot by
// the visual suite, and like the other walls: noindex, out of the sitemap
// ('/styleguide' is filtered in astro.config.mjs) and under a reserved slug.

import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import { site } from '@/data/site';

const image = (alt = 'A photo of the church') => ({
  _type: 'image',
  alt,
  asset: {
    _type: 'reference',
    _ref: 'image-0123456789abcdef0123456789abcdef01234567-1600x900-jpg',
  },
});

const para = (key: string, text: string) => ({
  _type: 'block',
  _key: key,
  style: 'normal',
  markDefs: [],
  children: [{ _type: 'span', _key: `${key}-s`, marks: [], text }],
});

const cta = (label: string) => ({
  _type: 'ctaBlock',
  label,
  linkType: 'external',
  externalUrl: '#',
});

/** The Site settings the church blocks read, fixed so the pictures never move. */
