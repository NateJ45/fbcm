---
// Safe to edit by hand
// scaffold-file: church
//
// /styleguide/staff: the COMPOSED staff page, before it is seeded (2026-09-24,
// the Staff identity pass).
//
// The page module (scripts/pages/staff.mjs) cannot be applied to Sanity until
// the schema that carries the staff band's `intro` and the scripture band's
// `heading` and `intro` is deployed (CLAUDE.md rule 1), so the page it WOULD
// write is built read-only by `node scripts/page-fixture.mjs staff` into
// scripts/data/fixtures/staff.json and rendered here through the same
// SectionRenderer the real route uses. Re-run that script after changing the
// module; this file does not change.
//
// ONE THING IS LIVE, NOT FIXED: the people. A staffGridSection's members are
// fetched by the page query itself (queries.ts, the staffGridSection arm),
// which a fixture file cannot run, so each band borrows the members of the
// live /staff page's band for the same group: the same people, in the same
// order, the real page will show.
//
// Not for visitors: noindex, and under /styleguide, which astro.config.mjs
// keeps out of the sitemap and src/lib/reservedSlugs.ts keeps from being
// shadowed by a page. It can be deleted once /staff shows this composition.
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import { getPage, getSiteSettings } from '@/lib/queries';
import { shouldOverlayHeader } from '@/lib/heroOverlay';
import { site } from '@/data/site';
import fixture from '../../../scripts/data/fixtures/staff.json';

type Block = { _type?: string; group?: string; members?: unknown };

const [siteSettings, live] = await Promise.all([
  getSiteSettings().catch(() => null),
  getPage('staff').catch(() => null),
]);
const liveBlocks = ((live as { pageBuilder?: Block[] } | null)?.pageBuilder ?? []) as Block[];
const membersFor = (group: string | undefined) =>
  liveBlocks.find((b) => b._type === 'staffGridSection' && b.group === group)?.members ?? [];
const sections = (fixture.pageBuilder as Block[]).map((b) =>
  b._type === 'staffGridSection' ? { ...b, members: membersFor(b.group) } : b,
) as unknown[];
---

<BaseLayout
  title={`Staff, composed | ${site.name}`}
  description="The composed Staff page, rendered from its seed module before it is applied. Not for visitors."
  {siteSettings}
  noindex
  overlayHeader={shouldOverlayHeader(sections as Parameters<typeof shouldOverlayHeader>[0])}
>
  <SectionRenderer {sections} idPrefix="page" settings={siteSettings} />
</BaseLayout>
