---
// Safe to edit by hand
// scaffold-file: church
//
// /styleguide/home: the COMPOSED home page, before it is seeded (2026-09-23,
// the Home identity plan, Task 5).
//
// The page module (scripts/pages/home.mjs) cannot be applied to Sanity until
// the schema that carries the new hymn-board, goal-glyph and dated-building
// fields is deployed (CLAUDE.md rule 1), so the page it WOULD write is built
// read-only by `node scripts/page-fixture.mjs home` into
// scripts/data/fixtures/home.json, projected the way queries.ts projects a
// page, and rendered here through the same SectionRenderer the real route
// uses. Re-run that script after changing the module; this file does not
// change.
//
// ONE THING IS LIVE, NOT FIXED: the Church Blog rows. A dynamicListSection's
// posts are fetched by the page query itself (queries.ts, the journal arm of
// the sections projection), which a fixture file cannot run, so the rows are
// borrowed from the live home page's own journal list: the same three posts
// the real home page will show.
//
// Not for visitors: noindex, and under /styleguide, which astro.config.mjs
// keeps out of the sitemap and src/lib/reservedSlugs.ts keeps from being
// shadowed by a page. It can be deleted once the home page is seeded and /
// itself shows this composition.
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import { getHomePage, getSiteSettings } from '@/lib/queries';
import { shouldOverlayHeader } from '@/lib/heroOverlay';
import { site } from '@/data/site';
import fixture from '../../../scripts/data/fixtures/home.json';

type Block = { _type?: string; source?: string; items?: unknown };

const [siteSettings, live] = await Promise.all([
  getSiteSettings().catch(() => null),
  getHomePage().catch(() => null),
]);
const liveBlocks = ((live as { pageBuilder?: Block[] } | null)?.pageBuilder ?? []) as Block[];
const liveJournal = liveBlocks.find(
  (b) => b._type === 'dynamicListSection' && b.source === 'journal',
);
const sections = (fixture.pageBuilder as Block[]).map((b) =>
  b._type === 'dynamicListSection' && b.source === 'journal'
    ? { ...b, items: liveJournal?.items ?? [] }
    : b,
) as unknown[];
---

<BaseLayout
  title={`Home, composed | ${site.name}`}
  description="The composed home page, rendered from its seed module before it is applied. Not for visitors."
  {siteSettings}
  noindex
  overlayHeader={shouldOverlayHeader(sections as Parameters<typeof shouldOverlayHeader>[0])}
>
  <SectionRenderer {sections} idPrefix="home" settings={siteSettings} />
</BaseLayout>
