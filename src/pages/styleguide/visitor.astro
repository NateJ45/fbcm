---
// Safe to edit by hand
// scaffold-file: church
//
// /styleguide/visitor: the COMPOSED /visitor page, before it is seeded
// (2026-09-24, feat/the-visitor).
//
// The page module (scripts/pages/visitor.mjs) writes a new `page` document,
// which Nathan applies himself, so the page it WOULD write is built read-only
// by `node scripts/page-fixture.mjs visitor` into
// scripts/data/fixtures/visitor.json, projected the way queries.ts projects a
// page (each issue's file url and size included), and rendered here through
// the same SectionRenderer the real route uses. The covers are the real ones:
// scripts/visitor-covers.mjs draws the fixture's issues on every build.
//
// It is also the Playwright suite's /visitor (tests/visitor.spec.ts): the
// suite's build sets VISITOR_FIXTURE=1, so Home's band and the search read the
// same fixture and point here.
//
// Not for visitors: noindex, and under /styleguide, which astro.config.mjs
// keeps out of the sitemap and src/lib/reservedSlugs.ts keeps from being
// shadowed by a page. It can be deleted, with the fixture, once /visitor is
// published and shows this composition.
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import { getSiteSettings } from '@/lib/queries';
import { site } from '@/data/site';
import fixture from '../../../scripts/data/fixtures/visitor.json';

const siteSettings = await getSiteSettings().catch(() => null);
const sections = fixture.pageBuilder as unknown[];
---

<BaseLayout
  title={`The Visitor, composed | ${site.name}`}
  description="The composed Visitor page, rendered from its seed module before it is applied. Not for visitors."
  {siteSettings}
  noindex
>
  <SectionRenderer {sections} idPrefix="page" settings={siteSettings} />
</BaseLayout>
