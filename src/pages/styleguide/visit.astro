---
// Safe to edit by hand
// scaffold-file: church
//
// /styleguide/visit: the COMPOSED Visit page, before it is seeded
// (2026-09-24, the Visit identity pass, following the Who We Are and Home fixtures).
//
// The page module (scripts/pages/visit.mjs) cannot be applied to Sanity
// until the schema that carries its new church sections is deployed (CLAUDE.md
// rule 1), so the page it WOULD write is built read-only by
// `node scripts/page-fixture.mjs visit` into
// scripts/data/fixtures/visit.json, projected the way queries.ts projects
// a page, and rendered here through the same SectionRenderer the real route
// uses. Re-run that script after changing the module; this file does not
// change.
//
// Not for visitors: noindex, and under /styleguide, which astro.config.mjs
// keeps out of the sitemap and src/lib/reservedSlugs.ts keeps from being
// shadowed by a page. It can be deleted once the page is seeded and
// /visit itself shows this composition.
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import { getSiteSettings } from '@/lib/queries';
import { shouldOverlayHeader } from '@/lib/heroOverlay';
import { site } from '@/data/site';
import fixture from '../../../scripts/data/fixtures/visit.json';

const siteSettings = await getSiteSettings().catch(() => null);
const sections = fixture.pageBuilder as unknown[];
---

<BaseLayout
  title={`Visit, composed | ${site.name}`}
  description="The composed Visit page, rendered from its seed module before it is applied. Not for visitors."
  {siteSettings}
  noindex
  overlayHeader={shouldOverlayHeader(sections as Parameters<typeof shouldOverlayHeader>[0])}
>
  <SectionRenderer {sections} idPrefix="page" settings={siteSettings} />
</BaseLayout>
