---
// Safe to edit by hand
// scaffold-file: church
//
// /styleguide/visit: the COMPOSED /visit page, before it is applied
// (2026-09-25, feat/visit-fixes, the visitor audit).
//
// scripts/pages/visit.mjs now adds "Good to know" and "Your children" and puts
// "Let us know you're coming" on the hero and the closing band. Nathan applies
// the page himself, so the page it WOULD write is built read-only by
// `node scripts/page-fixture.mjs visit` into scripts/data/fixtures/visit.json,
// projected the way queries.ts projects a page, and rendered here through the
// same SectionRenderer the real /visit route uses. tests/visit.spec.ts reads
// it.
//
// Not for visitors: noindex, and under /styleguide, which astro.config.mjs
// keeps out of the sitemap. Delete it, with the fixture and its line in
// tests/routes.ts, once /visit is applied and shows this composition (point
// tests/visit.spec.ts at /visit then).
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import { getSiteSettings } from '@/lib/queries';
import { site } from '@/data/site';
import fixture from '../../../scripts/data/fixtures/visit.json';

const siteSettings = await getSiteSettings().catch(() => null);
const sections = fixture.pageBuilder as unknown[];
---

<BaseLayout
  title={`Plan a visit, composed | ${site.name}`}
  description="The composed Visit page, rendered from its seed module before it is applied. Not for visitors."
  {siteSettings}
  noindex
>
  <SectionRenderer {sections} idPrefix="page" settings={siteSettings} />
</BaseLayout>
