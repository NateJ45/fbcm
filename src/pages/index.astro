---
// Safe to edit by hand for copy + structure changes.
// Home page — section-driven via pageBuilder.
// Edit sections and order in Sanity Studio under the Home Page document.
// When pageBuilder is empty (no Sanity project or unseeded), DEFAULT_HOME_SECTIONS
// renders so the page is never blank.

import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import { getHomePage, getSiteSettings } from '@/lib/queries';
import { site } from '@/data/site';
import { DEFAULT_HOME_SECTIONS } from '@/data/defaultSections';
import { shouldOverlayHeader } from '@/lib/heroOverlay';
import type { SundaySermon } from '@/lib/live-sunday';
import LastSunday from '@/components/home/LastSunday.astro';
import { loadFeedXml, loadLastSunday } from '@/lib/last-sunday';
import {
  comingSunday,
  parseYoutubeFeed,
  upcomingBroadcast,
  upcomingPreacher,
} from '@/lib/youtube-feed';
import { thisSundaySermon } from '@/lib/this-sunday';
import { thisSundayPreacher, type SundayPreacher } from '@/lib/preacher';
// scaffold: church
import VisitorBand from '@/components/home/VisitorBand.astro';
import type { VisitorManifest } from '@/lib/visitor-issues';
import { isDarkRow, visitorGround } from '@/lib/visitor-band';
import { insertIndex } from '@/lib/band-insert';
// scaffold:end
// scaffold: journal
import { getAllJournalEntries } from '@/lib/queries';
import {
  preacherForUpcomingSunday,
  previewForSunday,
  sermonForUpcomingSunday,
} from '@/lib/sunday-sermon';
import type { RegisterEntry } from '@/lib/blog-derive';
// scaffold:end

const [page, siteSettings] = await Promise.all([getHomePage(), getSiteSettings()]);

// THE CHANNEL FEED, read ONCE at build time (src/lib/last-sunday.ts) and
// shared by the hero's dated line and the "Last Sunday" band. null when it
// fails, and then both simply go without it. The deploy workflow rebuilds on
// a schedule so both keep up with the week (deploy.yml).
//
// The test seam: Playwright's build sets LAST_SUNDAY_FIXTURE=1 (the committed
// feed in tests/fixtures/, read at LAST_SUNDAY_NOW) or =unavailable (no feed).
// No deploy sets either. LAST_SUNDAY_NOW is the build's "now" for the hero
// line too, so both halves of the page are decided at one moment.
const fixture = import.meta.env.LAST_SUNDAY_FIXTURE as string | undefined;
const feedXml: string | null =
  fixture === '1'
    ? (await import('../../tests/fixtures/youtube-feed.xml?raw')).default
    : fixture === 'unavailable'
      ? null
      : await loadFeedXml(siteSettings);
const buildNow = import.meta.env.LAST_SUNDAY_NOW
  ? new Date(import.meta.env.LAST_SUNDAY_NOW as string)
  : new Date();

// THIS SUNDAY'S SERMON (2026-09-24). The build's "now", on the church's
// calendar, picks the coming Sunday; the line names that Sunday's sermon
// preview if the church posted one, else the sermon of the broadcast
// scheduled for it on YouTube (src/lib/this-sunday.ts). The upgrade script in
// BaseLayout drops it again when the page outlives that Sunday.
let preview: SundaySermon | null = null;
let previewPreacher: { sunday: string; name: string } | null = null;
// scaffold: journal
const journal = (await getAllJournalEntries()) as RegisterEntry[];
preview = sermonForUpcomingSunday(journal, buildNow);
previewPreacher = preacherForUpcomingSunday(journal, buildNow);
// scaffold:end
const feedEntries = parseYoutubeFeed(feedXml);
const sermon: SundaySermon | null = thisSundaySermon(
  comingSunday(buildNow),
  preview,
  upcomingBroadcast(feedEntries, buildNow),
);
// THIS SUNDAY'S PREACHER (2026-09-25, `feat/preacher-and-feel`): the same two
// sources in the same order (src/lib/preacher.ts), a fourth fact in the hero.
// With neither, the facts row is exactly as it was; with no feed (the deploy
// build's failure), only a preview can name one.
const preacher: SundayPreacher | null = thisSundayPreacher(
  comingSunday(buildNow),
  previewPreacher,
  upcomingPreacher(feedEntries, buildNow),
);

// LAST SUNDAY (2026-09-24, `feat/last-sunday`). The most recent Sunday
// service recording in the same feed; null when the feed fails or holds no
// recording, and then the band is simply not drawn. The scheduled broadcast
// above is never it: a broadcast that has not happened has no views.
const lastSunday = await loadLastSunday(siteSettings, buildNow, {
  xml: feedXml,
  checkThumbnail: fixture === undefined,
});
// When the church posted a sermon preview for that Sunday, the band pairs
// with it (the post's title and reading, and a link to it).
let lastPreview: { href: string; title: string; reading: string } | null = null;
// scaffold: journal
if (lastSunday) lastPreview = previewForSunday(journal, lastSunday.sunday);
// scaffold:end

// THE VISITOR (2026-09-24, `feat/the-visitor`). The newest issue on the
// /visitor page, found by the build step before Astro ran
// (scripts/visitor-covers.mjs); null until that page is published, and then
// the band is simply not drawn. The Playwright build reads the committed
// fixture instead (VISITOR_FIXTURE=1).
let visitor: VisitorManifest | null = null;
// scaffold: church
visitor =
  Object.values(
    import.meta.glob<VisitorManifest>('../data/visitor.generated.json', {
      eager: true,
      import: 'default',
    }),
  )[0] ?? null;
// scaffold:end

const title = page?.seoTitle ?? site.name;
const description =
  page?.seoDescription ??
  "We're a Spirit-led people gathered to join Christ's presence in our community.";

const sections = page?.pageBuilder?.length ? page.pageBuilder : DEFAULT_HOME_SECTIONS;

// Where the code-drawn bands go, once, so the slot and the Visitor's ground
// read the same row (src/lib/band-insert.ts).
const insertBefore = ['dynamicListSection', 'giveBandSection'];

// scaffold: church
// The Visitor's ground, from the band directly above it (visitor-band.ts):
// Last Sunday's indigo when that band is drawn, otherwise the page-builder row
// before the slot (the rows SectionRenderer places it among: every non-empty
// block). Paper under a dark band, indigo under a light one.
const rowTypes = (sections as unknown[])
  .filter((s): s is { _type: string } => !!s && typeof s === 'object' && '_type' in s)
  .map((s) => s._type);
const visitorOn = visitorGround(
  !!lastSunday || isDarkRow(rowTypes[insertIndex(rowTypes, insertBefore) - 1]),
);
// scaffold:end

// The header sits ON the picture when this page opens with an image hero.
// One predicate, shared with [slug].astro, so the two routes cannot disagree.
const overlayHeader = shouldOverlayHeader(sections as any);
---

<BaseLayout
  {title}
  {description}
  {siteSettings}
  {overlayHeader}
  seoImage={page?.seoImage}
  searchBody
>
  {
    /* The band sits before the Church Blog rows: after "Our Building" has
      ended in the present, and next to the journal whose sermon previews it
      pairs with. Before the give band when the blog band is absent. The
      Visitor's band follows it in the same slot: the church's news, between
      last Sunday and the blog. */
  }
  <SectionRenderer
    {sections}
    idPrefix="home"
    settings={siteSettings}
    {sermon}
    {preacher}
    {insertBefore}
  >
    {
      lastSunday && (
        <LastSunday
          slot="insert"
          recording={lastSunday}
          preview={lastPreview}
          headingId="home-last-sunday"
        />
      )
    }
    {/* scaffold: church */}
    {
      visitor?.latest && visitor.listHref && (
        <VisitorBand
          slot="insert"
          issue={visitor.latest}
          previous={visitor.previous ?? []}
          covers={visitor.covers}
          href={visitor.listHref}
          since={visitor.since ?? null}
          now={buildNow}
          ground={visitorOn}
          headingId="home-visitor"
        />
      )
    }
    {/* scaffold:end */}
  </SectionRenderer>
</BaseLayout>
