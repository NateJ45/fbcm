---
// Safe to edit by hand for copy + structure changes.
// Home page — section-driven via pageBuilder.
// Edit sections and order in Sanity Studio under the Home Page document.
// When pageBuilder is empty (no Sanity project or unseeded), DEFAULT_HOME_SECTIONS
// renders so the page is never blank.

import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import { getHomePage, getSiteSettings } from '@/lib/queries';
import { site } from '@/data/site';
import { DEFAULT_HOME_SECTIONS } from '@/data/defaultSections';
import { shouldOverlayHeader } from '@/lib/heroOverlay';
import type { SundaySermon } from '@/lib/live-sunday';
// scaffold: journal
import { getAllJournalEntries } from '@/lib/queries';
import { sermonForUpcomingSunday } from '@/lib/sunday-sermon';
import type { RegisterEntry } from '@/lib/blog-derive';
// scaffold:end

const [page, siteSettings] = await Promise.all([
  getHomePage().catch(() => null),
  getSiteSettings().catch(() => null),
]);

// THIS SUNDAY'S SERMON (2026-09-24). The build's "now", on the church's
// calendar, picks the preview written for the coming Sunday, if the church has
// posted one; the hero's dated line then names it. The upgrade script in
// BaseLayout drops it again when the page outlives that Sunday.
let sermon: SundaySermon | null = null;
// scaffold: journal
const journal = (await getAllJournalEntries().catch(() => [])) as RegisterEntry[];
sermon = sermonForUpcomingSunday(journal, new Date());
// scaffold:end

const title = page?.seoTitle ?? site.name;
const description =
  page?.seoDescription ??
  "We're a Spirit-led people gathered to join Christ's presence in our community.";

const sections = page?.pageBuilder?.length ? page.pageBuilder : DEFAULT_HOME_SECTIONS;

// The header sits ON the picture when this page opens with an image hero.
// One predicate, shared with [slug].astro, so the two routes cannot disagree.
const overlayHeader = shouldOverlayHeader(sections as any);
---

<BaseLayout {title} {description} {siteSettings} {overlayHeader} seoImage={page?.seoImage}>
  <SectionRenderer {sections} idPrefix="home" settings={siteSettings} {sermon} />
</BaseLayout>
