---
// Foundation, edit with care
//
// THE STYLEGUIDE WALL - the fixed-data page the visual-regression suite shoots.
//
// WHY IT EXISTS. Three defects shipped in one afternoon on a repo forked from
// this starter that every automated gate was structurally blind to: the footer
// still carried the FORKED REPO'S logo, so another client's wordmark sat at the
// bottom of every page; a base-layer rule pinned every heading to a token meant
// for dark grounds, so in light mode the whole site had cream headings on
// paper; and a card rule declared before its base rule at equal specificity
// silently lost its background, leaving its heading at 1.15:1. Types passed,
// every unit test passed, axe passed. (A text-shadow makes axe report contrast
// as "incomplete" rather than a violation, and the suite asserts on
// violations.) All three were found by a human looking at the site.
//
// A screenshot diff is the only gate that can see that class of bug, and it
// needs FIXED data or it cries wolf: real pages carry content that changes, so
// shooting them would churn the baseline on words rather than on design.
// Everything below is hardcoded here on purpose. If a pixel moves, the design
// moved.
//
// WHAT BELONGS HERE: anything whose appearance is decided by the design system
// rather than by content. The palette tokens, the type scale on each surface,
// the semantic shadcn pairs, the CTA variants, and the polish-layer utilities.
// The header and footer come free from BaseLayout, which is what would have
// caught the inherited logo.
//
// WHAT DOES NOT: anything time-based, anything read from Sanity, anything that
// grows. A project adding its own signature objects to the wall should give
// them fixed props, right here, and nowhere else.
//
// noindex, and filtered out of the sitemap in astro.config.mjs. It is a real
// route so Playwright can load it from the built output, but it is not for
// visitors, and 'styleguide' is reserved in src/lib/reservedSlugs.ts so a
// custom page cannot shadow it.

import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import CtaLink from '@/components/CtaLink.astro';
import { site } from '@/data/site';
import { surfaceClass } from '@/lib/surfaces';
// scaffold: church
// The eight church blocks (Task 6), fixtured with real church content so a
// pixel diff here means the design moved, not the content. See the fixture
// data block below for why each value is what it is.
import SundayTimes from '@/components/sections/SundayTimes.astro';
import Timeline from '@/components/sections/Timeline.astro';
import StaffGrid from '@/components/sections/StaffGrid.astro';
import FaqBand from '@/components/sections/FaqBand.astro';
import ScriptureBand from '@/components/sections/ScriptureBand.astro';
import HeritageBand from '@/components/sections/HeritageBand.astro';
import GiveBand from '@/components/sections/GiveBand.astro';
import DocumentList from '@/components/sections/DocumentList.astro';
// scaffold:end
// Task 7: temporary hero fixtures (frames, layout, facts). No hero with frames
// exists in the dataset yet (plan 2b seeds one) so these two calls are the
// only way to see the cross-fade and the split layout render before content
// lands. Remove once plan 2b's seeded hero gives the styleguide (and Playwright)
// something real to shoot instead.
import Hero from '@/components/Hero.astro';

/** The brand palette from the `@theme` block in src/styles/globals.css. */
const BRAND_TOKENS = [
  '--color-primary',
  '--color-primary-dark',
  '--color-accent',
  '--color-accent-dark',
  '--color-secondary',
  '--color-tertiary',
  '--color-bg',
  '--color-bg-soft',
  '--color-border-soft',
];

/** The shadcn semantic pairs. These are the ones that must flip with theme. */
const SEMANTIC_TOKENS = [
  '--background',
  '--foreground',
  '--card',
  '--card-foreground',
  '--muted',
  '--muted-foreground',
  '--primary',
  '--primary-foreground',
  '--border',
];

// Written out rather than built from a loop variable: Tailwind's scanner reads
// SOURCE TEXT, so `text-${h}` generates nothing at all and the whole scale
// would render at the base size in a screenshot nobody would question.
const HEADINGS = [
  ['Display h1', 'text-h1'],
  ['Display h2', 'text-h2'],
  ['Display h3', 'text-h3'],
  ['Display h4', 'text-h4'],
  ['Display h5', 'text-h5'],
  ['Display h6', 'text-h6'],
] as const;

/** Fixed CTA stand-ins. Never read from Sanity: that is the whole point. */
const PRIMARY_CTA = { label: 'Book a call', linkType: 'external' as const, externalUrl: '#' };
const SECONDARY_CTA = { label: 'See the work', linkType: 'external' as const, externalUrl: '#' };

// scaffold: church
// =============================================================================
// Church block fixtures (Task 6)
// =============================================================================
// Real church content, never lorem: the words themselves are what a
// visual-regression baseline is defending, so a placeholder string here would
// let a real content-shaped bug (a heading colliding with a long word, a
// button label wrapping) hide behind "it's just lorem ipsum". Every fact below
// is FBCM's own: the Sunday schedule, the three doors, the FAQ answers
// (verbatim from scripts/data/pages/faq-entries.json), Isaiah 12:4, the
// building's 1929 date, the giving URL, and the three real publications.
//
// The one deliberate exception is the staff grid: three SYNTHETIC people
// (never real staff or real photos), because that block's data comes from
// GROQ in production and the styleguide must stay fixed regardless of who is
// actually on staff. NO PHOTO IS SET on any of them, on purpose: the two
// candidates were tried and rejected. The 404 page's own fallback ref
// (src/pages/404.astro) is a leftover from the FORKED starter's demo project
// (CLAUDE.md rule 11, "check for residue") and this repo's real, configured
// Sanity project (7jw947g5) has never heard of it, so it 404s and paints a
// browser's broken-image icon rather than a designed state. Every real asset
// actually IN this project's library was checked by eye (161 assets, all
// imported from the church's own blog) and every one is a photograph of
// identifiable people at a real event, which is wrong to attach to a fake
// name and a fake "Pastor" title even captioned as a fixture. StaffGrid.astro
// already has a real, theme-aware, designed answer for "no photo yet" -- the
// aspect-[4/5] bg-surface-soft box under the gold rule -- so leaving `photo`
// undefined uses the component's own fallback rather than inventing a new one.

/** One-paragraph portable text block, for the two fields typed as rich text. */
function paragraph(key: string, text: string) {
  return [
    {
      _type: 'block',
      _key: key,
      style: 'normal',
      markDefs: [],
      children: [{ _type: 'span', _key: `${key}-s1`, text }],
    },
  ];
}

