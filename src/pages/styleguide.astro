  accentWord: 'proclaim',
};

// A real photo from FBCM's own library (already public: imported from the
// church's own blog), chosen deliberately over the other 160 assets in the
// project because it is the one that actually shows the BUILDING -- the
// sanctuary's arches and its stained glass window -- rather than a close-up
// portrait. The congregation is visible only from behind, which is why this
// one and not another was the right choice: see the fixture-data comment
// above for the two options this ruled out.
const HERITAGE_FIXTURE = {
  eyebrow: 'Our building',
  heading: 'Since 1929',
  body: 'The limestone building on the corner of Adams and Jefferson has been the congregation’s home since 1929.',
  image: {
    asset: { _ref: 'image-e6666c121c6318a9ce9f82798fefbfe16d6ac9d4-4032x1908-jpg' },
    alt: 'Inside the sanctuary, looking toward the stained glass window.',
  },
};

// Task 7: temporary hero fixtures. Three real FBCM photos (from this
// project's own asset library, same source as HERITAGE_FIXTURE above) for the
// full-bleed cross-fade, and one for the split layout with three facts.
const HERO_FULL_FIXTURE = {
  eyebrow: 'Welcome home',
  headline: 'A church for the whole of Muncie',
  subhead: 'Join us this Sunday for worship, fellowship, and a warm welcome.',
  frames: [
    {
      asset: { _ref: 'image-e6666c121c6318a9ce9f82798fefbfe16d6ac9d4-4032x1908-jpg' },
      alt: 'Inside the sanctuary, looking toward the stained glass window.',
    },
    {
      asset: { _ref: 'image-25c93a161fc4fbb25f3b87f80522315e3596ea70-1159x643-jpg' },
      alt: 'A styleguide fixture photo of the church.',
    },
    {
      asset: { _ref: 'image-4a5061d1625f61322237a6950c9bd2d6f819edba-1900x1400-jpg' },
      alt: 'A styleguide fixture photo of the church.',
    },
  ],
};

const HERO_SPLIT_FIXTURE = {
  eyebrow: 'This week',
  headline: 'Come as you are',
  subhead: 'One service, one family, every Sunday morning.',
  frames: [
    {
      asset: { _ref: 'image-25c93a161fc4fbb25f3b87f80522315e3596ea70-1159x643-jpg' },
      alt: 'A styleguide fixture photo of the church.',
    },
  ],
  facts: [
    { _key: 'fact-1', label: 'Sundays', value: '10:45 am' },
    { _key: 'fact-2', label: 'Where', value: '309 E Adams St' },
    { _key: 'fact-3', label: 'Online', value: 'Facebook Live' },
  ],
};

const GIVE_BAND_FIXTURE = {
  heading: 'Give',
  body: 'Give online, in the offering plate on Sunday, or by mail.',
  buttonLabel: 'Give through Church Center',
  buttonUrl: 'https://fbcmuncie.churchcenter.com/giving',
};

const DOCUMENT_LIST_FIXTURE = {
  eyebrow: 'Resources',
  heading: 'Documents',
  docs: [
    { _key: 'doc-1', title: 'The Visitor', year: 2025, note: 'Quarterly newsletter' },
    { _key: 'doc-2', title: 'We Are the Clay', year: 2019 },
    { _key: 'doc-3', title: 'Constitution and bylaws', note: 'Governing documents' },
  ],
};
// scaffold:end
---

<BaseLayout
  title={`Styleguide | ${site.name}`}
  description="Fixed-data design system wall. Not for visitors."
  noindex
>
  <section class="bg-background py-section-lg">
    <div class="mx-auto w-full max-w-content px-6">
      <SectionHeading
        headingId="styleguide-heading"
        level="h1"
        eyebrow="Design system"
        headline="Styleguide"
        subhead="Fixed data. Every pixel below is decided by the design system, so a diff here means the design moved, not the content."
      />

      <h2 class="mt-14 font-display text-h3">Brand palette</h2>
      <ul class="mt-5 grid gap-3 sm:grid-cols-3 lg:grid-cols-5">
        {
          BRAND_TOKENS.map((t) => (
            <li class="rounded-lg border border-border p-3">
              <span
                class="block h-12 w-full rounded border border-foreground/20"
                style={`background: var(${t})`}
              />
              <code class="mt-2 block font-mono text-[0.6875rem] break-all">{t}</code>
            </li>
          ))
        }
      </ul>

      <h2 class="mt-14 font-display text-h3">Semantic tokens</h2>
      <p class="mt-2 max-w-[60ch] text-sm text-muted-foreground">
        These are the pairs that must flip with the theme. A swatch that looks identical in both
        baselines is a token that forgot to.
      </p>
      <ul class="mt-5 grid gap-3 sm:grid-cols-3 lg:grid-cols-5">
        {
          SEMANTIC_TOKENS.map((t) => (
            <li class="rounded-lg border border-border p-3">
              <span
                class="block h-12 w-full rounded border border-foreground/20"
                style={`background: var(${t})`}
              />
              <code class="mt-2 block font-mono text-[0.6875rem] break-all">{t}</code>
            </li>
          ))
        }
      </ul>

      <h2 class="mt-14 font-display text-h3">Type, on the page ground</h2>
      <div class="mt-5">
        {HEADINGS.map(([label, cls]) => <p class={`font-display ${cls}`}>{label}</p>)}
        <p class="mt-3 max-w-[60ch]">
          Body copy on the page ground. The quick brown fox jumps over the lazy dog, twice, so the
          line has enough letters in it for a rasterisation change to show.
        </p>
        <p class="mt-2 text-sm text-muted-foreground">Muted body copy, one step down.</p>
        {
          /* BUG FOUND WHEN TASK 6 ADDED THIS PAGE TO THE AXE SWEEP (it had never
             been route-listed before): both lines below used the FIXED brand-
             mirror tokens (--color-primary / --color-primary-dark), which never
             flip with .dark and exist for text on FIXED grounds (gold, the ink
             band, hover states -- see the comment on --color-primary in
             globals.css). Applied directly to the page ground, which DOES flip,
             they read fine in light and at ~1.1-1.3:1 in dark. The real pattern
             for an eyebrow and a link ON THE PAGE GROUND is the theme-aware
             pair SectionHeading.astro and Footer.astro already use:
             text-foreground/80 and text-link. */
        }
        <p class="mt-4 font-mono text-[0.75rem] tracking-eyebrow text-foreground/80 uppercase">
          Eyebrow, uppercase, tracked
        </p>
        <p class="mt-4">
          A <a class="nav-underline text-link" href="#">link with the nav underline</a> in a sentence,
          so its rule sits against real type.
        </p>
      </div>

      <h2 class="mt-14 font-display text-h3">Type, on a card</h2>
      {
        /* The exact combination that failed elsewhere: a heading inside a card,
           where a base-layer heading colour would otherwise win over the card's
           own foreground token. */
      }
      <div class="card-lift mt-5 max-w-[30rem] rounded-lg border border-border bg-card p-7">
        <h3 class="font-display text-h3 text-card-foreground">Heading on a card</h3>
        <p class="mt-2 text-sm text-card-foreground">Body copy on a card.</p>
        <p class="mt-2 text-sm text-muted-foreground">Muted copy on a card.</p>
      </div>

      <h2 class="mt-14 font-display text-h3">Calls to action</h2>
      <div class="mt-5 flex flex-wrap items-center gap-4">
        <CtaLink cta={PRIMARY_CTA} variant="primary" />
        <CtaLink cta={SECONDARY_CTA} variant="secondary" />
      </div>
    </div>
  </section>

  {
    /* The alternating surface, with a CTA pair on it, so both grounds are shot.
     BUG FOUND IN TASK 1: this section carried `surface-warm` (a gradient-only
     overlay utility, see globals.css) with no `bg-*` class at all, so it never
     painted the muted surface it claims to demonstrate -- it was rendering the
     page background underneath. surfaceClass('muted') is the real class the
     cadence assigns (bg-surface-soft: a taupe tint over cream in light, #262548
     in dark), fixed here rather than relaxed away. */
  }
  <section class={`${surfaceClass('muted')} surface-warm py-section-lg`}>
    <div class="mx-auto w-full max-w-content px-6">
      <SectionHeading
        headingId="styleguide-surface"
        level="h2"
        eyebrow="The other ground"
        headline="Soft paper surface"
        headingAccent="Soft"
        subhead="The alternating band the section cadence puts every other section on."
        align="center"
      />
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <CtaLink cta={PRIMARY_CTA} variant="primary" class="press-tactile" />
        <CtaLink cta={SECONDARY_CTA} variant="secondary" />
      </div>
    </div>
  </section>

  {
    /* A dark panel, because the inverse tone has its own contrast problems and
      they are invisible in a light-only shot. */
  }
  <section class="bg-accent-dark py-section-lg">
    <div class="mx-auto w-full max-w-content px-6">
      <SectionHeading
        headingId="styleguide-inverse"
        level="h2"
        eyebrow="Inverse"
        headline="Type on a dark panel"
        subhead="The closing-CTA ground. Its foreground tokens are separate from the page's."
        tone="inverse"
        align="center"
      />
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <CtaLink cta={PRIMARY_CTA} variant="primary" onDark />
        <CtaLink cta={SECONDARY_CTA} variant="secondary" onDark />
      </div>
    </div>
  </section>

  {/* scaffold: church */}
  <section class="bg-background py-section-lg">
    <div class="mx-auto w-full max-w-content px-6">
      <h2 class="font-display text-h3">Church blocks</h2>
      <p class="mt-2 max-w-[60ch] text-sm text-muted-foreground">
        The eight page-builder blocks the church site adds. Every fixture below is real church
        content, not lorem: the Sunday schedule, the three doors, two FAQ entries verbatim, Isaiah
        12:4, the building's 1929 date and the real giving link. The staff grid is the one exception
        on purpose, three synthetic people, because that block's data comes from Sanity in
        production.
      </p>
    </div>
  </section>

  {/* Task 7: temporary hero fixtures, see the note by the fixture data above. */}
  <Hero
    eyebrow={HERO_FULL_FIXTURE.eyebrow}
    headline={HERO_FULL_FIXTURE.headline}
    subhead={HERO_FULL_FIXTURE.subhead}
    backgroundImages={HERO_FULL_FIXTURE.frames}
    layout="full"
    size="short"
    headingId="styleguide-hero-full"
  />

  <Hero
    eyebrow={HERO_SPLIT_FIXTURE.eyebrow}
    headline={HERO_SPLIT_FIXTURE.headline}
    subhead={HERO_SPLIT_FIXTURE.subhead}
    backgroundImages={HERO_SPLIT_FIXTURE.frames}
    facts={HERO_SPLIT_FIXTURE.facts}
    layout="split"
    size="short"
    headingId="styleguide-hero-split"
  />

  <SundayTimes
    eyebrow={SUNDAY_TIMES_FIXTURE.eyebrow}
    heading={SUNDAY_TIMES_FIXTURE.heading}
    items={SUNDAY_TIMES_FIXTURE.items}
    doors={SUNDAY_TIMES_FIXTURE.doors}
    showMap={SUNDAY_TIMES_FIXTURE.showMap}
    headingId="styleguide-sundaytimes"
  />

  <Timeline
    eyebrow={TIMELINE_FIXTURE.eyebrow}
    heading={TIMELINE_FIXTURE.heading}
    rows={TIMELINE_FIXTURE.rows}
    surface="muted"
    headingId="styleguide-timeline"
  />

  <StaffGrid
    eyebrow={STAFF_GRID_FIXTURE.eyebrow}
    heading={STAFF_GRID_FIXTURE.heading}
    group={STAFF_GRID_FIXTURE.group}
    showBios={STAFF_GRID_FIXTURE.showBios}
    members={STAFF_GRID_FIXTURE.members}
    surface="background"
    headingId="styleguide-staffgrid"
  />

  <FaqBand
    eyebrow={FAQ_FIXTURE.eyebrow}
    heading={FAQ_FIXTURE.heading}
    items={FAQ_FIXTURE.items}
    headingId="styleguide-faq"
  />

  <ScriptureBand
    verse={SCRIPTURE_FIXTURE.verse}
    reference={SCRIPTURE_FIXTURE.reference}
    accentWord={SCRIPTURE_FIXTURE.accentWord}
    headingId="styleguide-scripture"
  />

  <HeritageBand
    eyebrow={HERITAGE_FIXTURE.eyebrow}
    heading={HERITAGE_FIXTURE.heading}
    body={HERITAGE_FIXTURE.body}
    image={HERITAGE_FIXTURE.image}
    headingId="styleguide-heritage"
  />

  <GiveBand
    heading={GIVE_BAND_FIXTURE.heading}
    body={GIVE_BAND_FIXTURE.body}
    buttonLabel={GIVE_BAND_FIXTURE.buttonLabel}
    buttonUrl={GIVE_BAND_FIXTURE.buttonUrl}
    headingId="styleguide-give"
  />

  <DocumentList
    eyebrow={DOCUMENT_LIST_FIXTURE.eyebrow}
    heading={DOCUMENT_LIST_FIXTURE.heading}
    docs={DOCUMENT_LIST_FIXTURE.docs}
    surface="muted"
    headingId="styleguide-documentlist"
  />
  {/* scaffold:end */}
</BaseLayout>
