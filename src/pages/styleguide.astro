      _key: 'st-1',
      label: 'Sunday school',
      big: '9:30 am',
      body: 'Classes for all ages meet before worship.',
    },
    {
      _key: 'st-2',
      label: 'Donut hour',
      big: '10:15 am',
      body: 'Coffee and donuts in the fellowship hall, a relaxed way to meet people before the service.',
    },
    {
