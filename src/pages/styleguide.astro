const STAFF_GRID_FIXTURE = {
  eyebrow: 'Who you will meet',
  heading: 'Staff',
  group: 'all',
  showBios: true,
  members: [
    {
      _id: 'staff-1',
      name: 'First Last',
      slug: 'first-last',
      role: 'Pastor',
      email: 'placeholder@example.com',
      group: 'pastors',
      order: 1,
      bio: paragraph('staff-1-bio', 'Synthetic bio text for the styleguide fixture only.'),
    },
    {
      _id: 'staff-2',
      name: 'First Last',
      slug: 'first-last-2',
      role: 'Church Coordination Team',
      email: 'placeholder@example.com',
      group: 'coordination',
      order: 1,
      bio: paragraph('staff-2-bio', 'Synthetic bio text for the styleguide fixture only.'),
    },
    {
      _id: 'staff-3',
      name: 'First Last',
      slug: 'first-last-3',
      role: 'Volunteer Coordinator',
      email: 'placeholder@example.com',
      group: 'support',
      order: 1,
      bio: paragraph('staff-3-bio', 'Synthetic bio text for the styleguide fixture only.'),
    },
  ],
};

// Verbatim from scripts/data/pages/faq-entries.json (sortOrder 7 and 10).
const FAQ_FIXTURE = {
  eyebrow: 'Questions',
  heading: 'Questions and answers',
  items: [
    {
      _key: 'faq-1',
      question: 'What should I wear?',
      answer: paragraph(
        'faq-1-p1',
        'Casual dress is welcome. People wear a variety of styles of clothes from short sleeves (especially in the summer), to suit jackets and “Sunday dresses.” Please dress comfortably and in a way which allows you to devote attention to worship.',
      ),
