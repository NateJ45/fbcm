node_modules/
dist/
.env
.dev.vars
*.log

# The captured binaries live in ../fbcm-archive/, not in git history. See that
# folder's README and scripts/data/binary-manifest.json, which records every one
# of them with a checksum.
scripts/data/images/
scripts/data/files/
scripts/data/video/

# --- merged from ncs-astro-sanity-starter .gitignore (Task 1) ---
# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# wrangler local cache (Cloudflare adapter)
.wrangler/

# generated artifacts
tmp/
# sanity-lib.mjs asset-id cache (keeps seed uploads idempotent; machine-local)
scripts/.asset-map.json
# scripts/lib/page-images.mjs resize cache (keyed by manifest key; machine-local,
# safe to delete, re-created from the fbcm-archive sibling folder on demand)
scripts/.page-images/
# sanity `schema extract` output, regenerated by `npm run typegen`. The
# COMMITTED artifact is src/lib/sanity.types.ts, which CI guards for staleness.
schema.json
# a standalone `sanity build` output dir, if one is ever needed (never ./dist,
# which would clobber the Astro build)
.studio-dist/
# sanity CLI local state
.sanity/
# Cloudflare Workers runtime secrets for `wrangler dev` (SANITY_TOKEN)
.dev.vars

# transient commit message files
.git-commit-msg.tmp

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# Generated by `npm run generate-types` (wrangler types). Excluded from
# tsconfig too: see src/cloudflare-workers.d.ts.
worker-configuration.d.ts

# Playwright output (npm test).
playwright-report/
test-results/

# Cleaned zone files written by `npm run cutover` next to a registrar export.
# They are a local record of what was imported, not repo source, and they can
# carry a real client's DNS. Never commit one.
*.cleaned.txt
*.cleaned.zone

# Dataset exports left behind by a restore drill. `sanity-backup.yml` writes
# these, and the drill in docs/RESTORE-DRILL.md has you download and decrypt one
# by hand, so they end up sitting in the checkout afterwards. Found 2026-09-18:
# a 28MB export untracked and unignored in a sibling repo, one `git add -A` away
# from a binary nobody can easily remove from history again. They are encrypted,
# which limits the damage but is not a reason to commit one.
sanity-backup-*.tar.gz
sanity-backup-*.tar.gz.enc

# Superpowers skill scratch (brainstorm state, subagent-driven-development
# ledgers under .superpowers/sdd/<plan>/). Local working state, never repo
# source; each SDD run's ledger is deleted once its final review is clean.
.superpowers/

# Share cards: generated from the published content at the start of every
# `npm run build` (scripts/generate-og-pages.mjs), never committed. The
# manifest beside them is the generator's cache.
public/og/
