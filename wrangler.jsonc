{
  // Cloudflare Workers configuration for this project.
  // Cloudflare merged Pages into Workers in early 2026; Workers is the path forward.
  "compatibility_date": "2026-05-26",
  // nodejs_compat (added 2026-08-28 with the Astro 7 / adapter 14 upgrade): the
  // SSR routes' render graph can touch process.env (React internals, the Sanity
  // client, the embedded Studio shell) and without the flag those reads throw at
  // request time. global_fetch_strictly_public predates it.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "name": "fbcm-site",

  // NO CONTACT-FORM BINDINGS. The starter shipped a commented-out D1 database
  // and a send_email binding for its /api/contact endpoint. This site has no
  // form at all: visitors use the church's own Church Center forms (plan 1's
  // decision, and plan 2b task 14 removed the endpoint, the React form and the
  // migration that went with them). The recipe those comments held is not lost;
  // it lives in the starter's wrangler.jsonc and in PORTS.md card 45.

  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    // @astrojs/cloudflare v14 splits the build into dist/client (static assets)
    // + dist/server (the SSR bundle: /studio, /preview/**, /api/draft-mode/*).
    //
    // Deliberately NO "not_found_handling" here (removed 2026-08-28). With
    // "404-page" set, Cloudflare answers NAVIGATION requests (Sec-Fetch-Mode:
    // navigate) that miss the asset store straight from the static 404 page
    // WITHOUT invoking the Worker, which silently 404s every SSR route for real
    // browsers while curl (which sends no Sec-Fetch headers) sees them working.
    // That broke presacademy's Presentation preview in production on 2026-08-26
    // and hid from every command-line probe. Without the field, asset misses
    // invoke the Worker and Astro renders the 404 page itself.
    "directory": "./dist/client",
    "binding": "ASSETS",
  },
  // The church's PDFs (src/pages/files/[name].ts): each is fetched from Sanity
  // once and kept here, so downloads stop costing Sanity bandwidth
  // (2026-09-26). The bucket was created by hand: wrangler r2 bucket create fbcm-files.
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "fbcm-files",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
