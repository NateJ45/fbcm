        {
          "_type": "heritageDate",
          "_key": "date-1859",
          "year": "1859",
          "text": "Twelve Indiana residents, meeting at the county courthouse, founded the first Baptist Church in Muncie."
        },
        {
          "_type": "heritageDate",
          "_key": "date-1862",
          "year": "1862",
          "text": "The tiny congregation moved into their new church building."
        },
        {
          "_type": "heritageDate",
          "_key": "date-1890",
          "year": "1890",
          "text": "The congregation eventually moved into a new building on July 20, 1890."
        },
        {
          "_type": "heritageDate",
          "_key": "date-1929",
          "year": "1929",
          "text": "On May 12, 1929, 1200 people marched from the old church to the new one on the corner of Jefferson and Adams streets."
        },
        {
          "_type": "heritageDate",
          "_key": "date-now",
          "now": true,
