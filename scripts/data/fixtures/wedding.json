    {
      "_type": "richTextSection",
      "_key": "wed-why",
      "heading": "A wedding at First Baptist",
      "body": [
        {
          "_type": "block",
          "_key": "wh-a-1",
          "style": "normal",
          "markDefs": [],
          "children": [
            {
              "_type": "span",
              "_key": "wh-a-1s1",
              "text": "First Baptist Church is a fitting wedding location and the facilities can be reserved for Christian weddings.",
              "marks": []
            }
          ]
        },
        {
          "_type": "block",
          "_key": "wh-b-1",
          "style": "normal",
          "markDefs": [],
          "children": [
            {
              "_type": "span",
              "_key": "wh-b-1s1",
              "text": "Building rentals for this purpose is something we do to share our building with sisters and brothers in Christ in the area so they might celebrate at a reasonable cost. Any associated fees are used exclusively for the cost of utilities, maintaining our building, and accounting for the time of our wedding coordinator, and others, who help make wedding ceremonies possible.",
              "marks": []
            }
          ]
        },
        {
          "_type": "block",
          "_key": "wh-c-1",
          "style": "normal",
          "markDefs": [],
          "children": [
            {
              "_type": "span",
              "_key": "wh-c-1s1",
              "text": "If you are interested, please read the following information and requirements for using our building and decide if our church may be right for your wedding ceremony.",
              "marks": []
            }
          ]
        }
      ]
    },
