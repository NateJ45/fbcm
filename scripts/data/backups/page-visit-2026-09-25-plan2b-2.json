    {
      "_key": "visit-faq",
      "_type": "faqSection",
      "heading": "Frequently asked questions",
      "items": [
        {
          "_key": "q-1",
          "_type": "faqItem",
          "answer": [
            {
              "_key": "a1-1",
              "_type": "block",
              "children": [
                {
                  "_key": "a1-1s1",
                  "_type": "span",
                  "marks": [],
                  "text": "The church is located in downtown Muncie at {address}. Google maps will take you to the correct place. Our parking lot is located on the Adams Street side. The most common doors people use are the Adams Street entrance at our circular drive (wheelchair accessible), the large wooden front doors which go into the sanctuary, or the Jefferson Street side doors which enter our main hallway near the church offices."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ],
          "question": "How do I find the church?"
        },
        {
          "_key": "q-2",
          "_type": "faqItem",
          "answer": [
            {
              "_key": "a2-1",
              "_type": "block",
              "children": [
                {
                  "_key": "a2-1s1",
                  "_type": "span",
                  "marks": [],
                  "text": "Casual dress is welcome. People wear a variety of styles of clothes from short sleeves (especially in the summer), to suit jackets and “Sunday dresses.” Please dress comfortably and in a way which allows you to devote attention to worship."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ],
          "question": "What should I wear?"
        },
        {
          "_key": "q-3",
          "_type": "faqItem",
          "answer": [
            {
              "_key": "a3-1",
              "_type": "block",
              "children": [
                {
                  "_key": "a3-1s1",
                  "_type": "span",
                  "marks": [],
                  "text": "There are. Nursery is available in room 104 for children under three. Greeters will help you check in and direct you. Each child will be given a name tag.  Children up to fifth grade will be dismissed to Children’s Church every week except communion Sunday (first week of the month, nursery care is still available). We also have a “Family Room” with rocking chairs, toys, a changing table, and a live stream of the service, for families and little ones who want to step out of worship at any time."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ],
          "question": "Are there nursery care or children’s worship during service?"
        },
        {
          "_key": "q-4",
          "_type": "faqItem",
          "answer": [
            {
              "_key": "a4-1",
              "_type": "block",
              "children": [
                {
                  "_key": "a4-1s1",
                  "_type": "span",
                  "marks": [],
                  "text": "We have a wheel-chair accessible door, an elevator, two wheelchair-accessible bathrooms, and assisted listening devices available upon request. Our building was built in 1929, and is therefore not officially ADA compliant– though we have made efforts to retrofit our building to make it as accessible as possible. For more information "
                },
                {
                  "_key": "a4-1s2",
                  "_type": "span",
                  "marks": [
                    "a4-1l1"
                  ],
                  "text": "see our accessibility page"
                },
                {
                  "_key": "a4-1s3",
                  "_type": "span",
                  "marks": [],
                  "text": "."
                }
              ],
              "markDefs": [
                {
                  "_key": "a4-1l1",
                  "_type": "link",
                  "href": "https://fbcmuncie.org/accessibility"
                }
              ],
              "style": "normal"
            }
          ],
          "question": "Is your building accessible / ADA compliant?"
        },
        {
          "_key": "q-5",
          "_type": "faqItem",
          "answer": [
            {
              "_key": "a5-1",
              "_type": "block",
              "children": [
                {
                  "_key": "a5-1s1",
                  "_type": "span",
                  "marks": [],
                  "text": "We believe it is the Lord’s table, and all who believe in him and have been baptized may partake. This includes believing Christians, no matter their particular denomination."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ],
          "question": "Am I allowed to take the Lord’s Supper (communion?)"
        },
        {
          "_key": "q-6",
          "_type": "faqItem",
          "answer": [
            {
              "_key": "a6-1",
              "_type": "block",
              "children": [
                {
                  "_key": "a6-1s1",
                  "_type": "span",
                  "marks": [],
                  "text": "It won’t be a problem at all! Anyone is welcome to attend our time of Worship. You may participate (in singing, the prayers, in Sunday Bible study) as you wish. And, if you want to see a service before you attend in-person, "
                },
                {
                  "_key": "a6-1s2",
                  "_type": "span",
                  "marks": [
                    "a6-1l1"
                  ],
                  "text": "check out our live streams"
                },
                {
                  "_key": "a6-1s3",
                  "_type": "span",
                  "marks": [],
                  "text": ". Please know the pastoral staff is always happy to discuss any questions you might have about our faith in God: Father, Son, & Holy Spirit."
                }
              ],
              "markDefs": [
                {
                  "_key": "a6-1l1",
                  "_type": "link",
                  "href": "{sermons}"
                }
              ],
              "style": "normal"
            }
          ],
          "question": "I don’t have a background in the Christian religion / I’m not sure what I believe. Will that be a problem if I want to visit?"
        },
        {
          "_key": "q-7",
          "_type": "faqItem",
          "answer": [
            {
              "_key": "a7-1",
              "_type": "block",
              "children": [
                {
                  "_key": "a7-1s1",
                  "_type": "span",
                  "marks": [],
                  "text": "Please contact the office. "
                },
                {
                  "_key": "a7-1s2",
                  "_type": "span",
                  "marks": [
                    "a7-1l1"
                  ],
                  "text": "You can find our contact form here"
                },
                {
                  "_key": "a7-1s3",
                  "_type": "span",
                  "marks": [],
                  "text": "."
                }
              ],
              "markDefs": [
                {
                  "_key": "a7-1l1",
                  "_type": "link",
                  "href": "{connect}"
                }
              ],
              "style": "normal"
            }
          ],
          "question": "What if I have other questions?"
        }
      ]
    },
