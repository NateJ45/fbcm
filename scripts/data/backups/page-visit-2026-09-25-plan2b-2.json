    {
      "_key": "visit-your-children",
      "_type": "richTextSection",
      "anchor": {
        "_type": "slug",
        "current": "children"
      },
      "body": [
        {
          "_key": "yc-lead-1",
          "_type": "block",
          "children": [
            {
              "_key": "yc-lead-1s1",
              "_type": "span",
              "marks": [],
              "text": "To create a safe environment for our children, FBC Muncie requires that all Children’s Ministry volunteers be background checked and children can only be picked up by a parent/guardian with a matching security tag."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "yc-h1",
          "_type": "block",
          "children": [
            {
              "_key": "yc-h1s1",
              "_type": "span",
              "marks": [],
              "text": "Check-in"
            }
          ],
          "markDefs": [],
          "style": "h3"
        },
        {
          "_key": "yc-a1-1",
          "_type": "block",
          "children": [
            {
              "_key": "yc-a1-1s1",
              "_type": "span",
              "marks": [],
              "text": "We have a check-in station for children at our Welcome Center, located on the first floor hallway just outside the sanctuary. Each child will be given a name tag."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "yc-h2",
          "_type": "block",
          "children": [
            {
              "_key": "yc-h2s1",
              "_type": "span",
              "marks": [],
              "text": "Who cares for them"
            }
          ],
          "markDefs": [],
          "style": "h3"
        },
        {
          "_key": "yc-a2-1",
          "_type": "block",
          "children": [
            {
              "_key": "yc-a2-1s1",
              "_type": "span",
              "marks": [],
              "text": "Each classroom maintains at least two adults at all times. All Children's ministry volunteers are background checked and trained by an FBC Leader."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "yc-h3",
          "_type": "block",
          "children": [
            {
              "_key": "yc-h3s1",
              "_type": "span",
              "marks": [],
              "text": "Pick-up"
            }
          ],
          "markDefs": [],
          "style": "h3"
        },
        {
          "_key": "yc-a3-1",
          "_type": "block",
          "children": [
            {
              "_key": "yc-a3-1s1",
              "_type": "span",
              "marks": [],
              "text": "Parents will get a security tag with a code that matches their child’s; this tag will need to be presented for pick up."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "yc-h4",
          "_type": "block",
          "children": [
            {
              "_key": "yc-h4s1",
              "_type": "span",
              "marks": [],
              "text": "Ages and rooms"
            }
          ],
          "markDefs": [],
          "style": "h3"
        },
        {
          "_key": "yc-a4-1",
          "_type": "block",
          "children": [
            {
              "_key": "yc-a4-1s1",
              "_type": "span",
              "marks": [],
              "text": "Nursery (104): 6 weeks - 3 years. Kickstart Children's Church (102): Preschool - 2nd grade. The Underground Children's Church (B-03): 3rd - 5th grade."
            }
          ],
          "markDefs": [],
          "style": "normal"
        }
      ],
      "heading": "Your children"
    },
    {
      "_key": "visit-getting-in",
      "_type": "sundayTimesSection",
      "anchor": {
        "_type": "slug",
        "current": "accessibility"
      },
      "doors": [
        {
          "_key": "door-1",
          "_type": "door",
          "body": "Our wheelchair accessible entrance is off our circular drive, on the Adams street side of the building. Those wishing to use our automatic door should use the circular drive entrance. The door opener is on the side of our mailbox, close to the door on its right.\n\nOnce inside, there is an elevator which will go to any floor: our lower level (B) which houses our fellowship hall, the first floor (where the sanctuary and offices are) or the second floor (which hosts classrooms and our youth center).",
          "name": "Adams Street circular drive"
        },
        {
          "_key": "door-2",
          "_type": "door",
          "body": "The large wooden front doors which go into the sanctuary.",
          "name": "The wooden front doors"
        },
        {
          "_key": "door-3",
          "_type": "door",
          "body": "The Jefferson Street side doors which enter our main hallway near the church offices.",
          "name": "Jefferson Street side doors"
        }
      ],
      "heading": "Doors, parking and access",
      "items": [
        {
          "_key": "time-2",
          "_type": "timeItem",
          "big": "{short address}",
          "body": "Our parking lot is located on the Adams Street side.",
          "label": "Find us"
        },
        {
          "_key": "time-3",
          "_type": "timeItem",
          "body": "On Sundays, if you would like an assisted listening device, please ask one of our greeters or the Welcome Center and they will be happy to give you one.",
          "label": "Assisted Listening"
        },
        {
          "_key": "time-4",
          "_type": "timeItem",
          "body": "Wheelchair accessible restrooms, which also have baby changing tables, are on the first floor and the lower level (B).",
          "label": "Restrooms"
        }
      ],
      "photos": [
        {
          "_key": "photo-1",
          "_type": "image",
          "alt": "The glass doors at the Adams Street circular drive, the church's wheelchair accessible entrance, set into a carved limestone archway.",
