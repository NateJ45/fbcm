                }
              ],
              "level": 1,
              "listItem": "bullet",
              "markDefs": [],
              "style": "normal"
            },
            {
              "_key": "ss-5",
              "_type": "block",
              "children": [
                {
                  "_key": "ss-5s1",
                  "_type": "span",
                  "marks": [],
                  "text": "6 weeks - 3 years: Nursery (104)"
                }
              ],
              "level": 1,
              "listItem": "bullet",
              "markDefs": [],
              "style": "normal"
            }
          ],
          "marker": "9:30 am",
          "title": "Sunday school and Bible study"
        },
        {
          "_key": "row-2",
          "_type": "timelineRow",
          "body": [
            {
              "_key": "dh-1",
              "_type": "block",
              "children": [
                {
                  "_key": "dh-1s1",
                  "_type": "span",
                  "marks": [],
                  "text": "Between Bible study and Worship, join in a time of fellowship (and, of course, donuts)!"
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ],
          "marker": "10:15 am",
          "title": "Donut hour"
        },
        {
          "_key": "row-3",
          "_type": "timelineRow",
          "body": [
            {
              "_key": "wr-1",
              "_type": "block",
              "children": [
                {
                  "_key": "wr-1s1",
                  "_type": "span",
                  "marks": [],
                  "text": "Students preschool - fifth grade will be dismissed to Children's Church during the service."
                }
              ],
              "markDefs": [],
              "style": "normal"
            },
            {
              "_key": "wrb-1",
              "_type": "block",
              "children": [
                {
                  "_key": "wrb-1s1",
                  "_type": "span",
                  "marks": [],
                  "text": "Nursery Care (104): For children ages 3 and younger, nursery care is available throughout the service."
                }
              ],
              "level": 1,
              "listItem": "bullet",
              "markDefs": [],
              "style": "normal"
            },
            {
              "_key": "wrb-2",
              "_type": "block",
              "children": [
                {
                  "_key": "wrb-2s1",
                  "_type": "span",
                  "marks": [],
                  "text": "Family Room (105): For little ones and parents who need to step out during service, this room provides toys, a live stream, rocking chairs, nursing privacy, and a changing table for all who desire it."
                }
              ],
              "level": 1,
              "listItem": "bullet",
              "markDefs": [],
              "style": "normal"
            },
            {
              "_key": "wrb-3",
              "_type": "block",
              "children": [
                {
                  "_key": "wrb-3s1",
                  "_type": "span",
                  "marks": [],
                  "text": "Kickstart Children's Church (102): Preschool - 2nd grade"
                }
              ],
              "level": 1,
              "listItem": "bullet",
              "markDefs": [],
              "style": "normal"
            },
            {
              "_key": "wrb-4",
              "_type": "block",
