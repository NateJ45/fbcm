                }
              ],
              "level": 1,
              "listItem": "bullet",
              "markDefs": [],
              "style": "normal"
            },
            {
              "_key": "ss-4",
              "_type": "block",
              "children": [
                {
                  "_key": "ss-4s1",
                  "_type": "span",
                  "marks": [],
