    {
      "_key": "wed-why",
      "_type": "richTextSection",
      "body": [
        {
          "_key": "wh-a-1",
          "_type": "block",
          "children": [
            {
              "_key": "wh-a-1s1",
              "_type": "span",
              "marks": [],
              "text": "First Baptist Church is a fitting wedding location and the facilities can be reserved for Christian weddings."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "wh-b-1",
          "_type": "block",
          "children": [
            {
              "_key": "wh-b-1s1",
              "_type": "span",
              "marks": [],
              "text": "Building rentals for this purpose is something we do to share our building with sisters and brothers in Christ in the area so they might celebrate at a reasonable cost. Any associated fees are used exclusively for the cost of utilities, maintaining our building, and accounting for the time of our wedding coordinator, and others, who help make wedding ceremonies possible."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "wh-c-1",
          "_type": "block",
          "children": [
            {
              "_key": "wh-c-1s1",
              "_type": "span",
              "marks": [],
              "text": "If you are interested, please read the following information and requirements for using our building and decide if our church may be right for your wedding ceremony."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "wh-coord",
          "_type": "block",
          "children": [
            {
              "_key": "wh-coords1",
              "_type": "span",
              "marks": [
                "wh-coordl1"
              ],
              "text": "Ella Mae Lemen, Wedding Coordinator"
            }
          ],
          "markDefs": [
            {
              "_key": "wh-coordl1",
              "_type": "link",
              "href": "mailto:wedding@fbcmuncie.org"
            }
          ],
          "style": "normal"
        },
        {
          "_key": "wh-d-1",
          "_type": "block",
          "children": [
            {
              "_key": "wh-d-1s1",
              "_type": "span",
              "marks": [],
              "text": "Ella Mae is a long-time member of First Baptist Church who also serves as our Wedding Coordinator. She is the appropriate person to contact if you are interested in celebrating a Christian wedding ceremony at First Baptist."
            }
          ],
          "markDefs": [],
          "style": "normal"
        }
      ],
