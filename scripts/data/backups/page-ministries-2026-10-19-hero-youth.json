              "children": [
                {
                  "_key": "wrb-4s1",
                  "_type": "span",
                  "marks": [],
                  "text": "The Underground Children's Church (102): 3rd - 5th grade"
                }
              ],
              "level": 1,
              "listItem": "bullet",
              "markDefs": [],
              "style": "normal"
