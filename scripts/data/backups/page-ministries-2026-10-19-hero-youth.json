      "_key": "ministries-children-faq",
      "_type": "faqSection",
      "eyebrow": "Children",
      "heading": "Questions parents ask",
      "items": [
        {
          "_key": "q-4",
          "_type": "faqItem",
          "answer": [
            {
              "_key": "a4-1",
              "_type": "block",
              "children": [
                {
                  "_key": "a4-1s1",
                  "_type": "span",
                  "marks": [],
                  "text": "Absolutely! We encourage it! There are containers in each classroom in which the children can place their offering."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ],
          "question": "Can children bring an offering?"
        },
        {
          "_key": "q-5",
          "_type": "faqItem",
          "answer": [
            {
              "_key": "a5-1",
              "_type": "block",
              "children": [
                {
                  "_key": "a5-1s1",
                  "_type": "span",
                  "marks": [],
                  "text": "No. But they are welcome to if they have their own. In Sunday School and Children’s Church the kids will be looking over passages in the Bible. We will certainly provide a Bible if your child does not have one."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ],
          "question": "Does my child need to bring a Bible?"
        }
      ]
