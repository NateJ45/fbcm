    "body": [
      {
        "_key": "yo-a-1",
        "_type": "block",
        "children": [
          {
            "_key": "yo-a-1s1",
            "_type": "span",
            "marks": [],
            "text": "The Youth Ministry at First Baptist delights in sharing the joy of the Lord with students grades 6-12. In this amazing and formative time in life, students are asking big questions about God, faith, and the world around them. The youth ministry hopes to encourage students to see their life within the great story of God’s faithfulness, love, and salvation in Christ Jesus."
          }
        ],
        "markDefs": [],
        "style": "normal"
      },
      {
        "_key": "yo-h1",
        "_type": "block",
        "children": [
          {
            "_key": "yo-h1s1",
            "_type": "span",
            "marks": [],
            "text": "Large group meeting"
          }
        ],
        "markDefs": [],
        "style": "h3"
      },
      {
        "_key": "yo-b-1",
        "_type": "block",
        "children": [
          {
            "_key": "yo-b-1s1",
            "_type": "span",
            "marks": [],
            "text": "Every Sunday, 9:30-10:15 a.m. (FBCM Youth Center)"
          }
        ],
        "markDefs": [],
        "style": "normal"
      },
      {
        "_key": "yo-c-1",
        "_type": "block",
        "children": [
          {
            "_key": "yo-c-1s1",
            "_type": "span",
            "marks": [],
            "text": "Our main teaching time where students gather at the intersection of God’s work and our lives. Pastor Jonathan and Kendall, alongside a youth volunteer, open up scripture and discuss how God’s work intersects with student’s lives."
          }
        ],
        "markDefs": [],
        "style": "normal"
      },
      {
        "_key": "yo-d-1",
        "_type": "block",
        "children": [
          {
            "_key": "yo-d-1s1",
            "_type": "span",
            "marks": [],
            "text": "After Youth Large Group meetings, students typically attend Donut (Semi) Hour with the whole congregation (10:15-10:45 a.m.)."
          }
        ],
        "markDefs": [],
        "style": "normal"
      },
      {
        "_key": "yo-h2",
        "_type": "block",
