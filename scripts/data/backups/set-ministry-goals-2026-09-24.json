        "children": [
          {
            "_key": "wa-a-1s1",
            "_type": "span",
            "marks": [],
            "text": "The Worship Ministry at FBCM understands that Christian worship is a lifestyle centered around responding to the revealed God of the Bible. Worship is also a series of interconnected actions like prayer, fellowship, giving full attention to the Bible, singing, and observing communion."
          }
        ],
        "markDefs": [],
        "style": "normal"
      },
      {
        "_key": "wa-b-1",
        "_type": "block",
        "children": [
          {
            "_key": "wa-b-1s1",
            "_type": "span",
            "marks": [],
            "text": "When we gather, worship leaders help us by:"
          }
        ],
        "markDefs": [],
        "style": "normal"
      },
