        "children": [
          {
            "_key": "wa-d-1s1",
            "_type": "span",
            "marks": [],
            "text": "Our Praise Team consists of longtime church members, college interns, and newer friends who sing, and play a variety of instruments. Instruments played in worship range from the ukulele to the organ!"
          }
        ],
        "markDefs": [],
        "style": "normal"
      },
      {
        "_key": "wa-e-1",
        "_type": "block",
        "children": [
          {
            "_key": "wa-e-1s1",
            "_type": "span",
            "marks": [],
            "text": "A unique aspect of our church is our hand bell choir, always looking for new members. We believe that music is an important part of our spiritual life and look forward to making beautiful music with you."
          }
        ],
        "markDefs": [],
        "style": "normal"
      }
