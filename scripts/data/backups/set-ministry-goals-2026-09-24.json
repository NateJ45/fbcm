        "_type": "block",
        "children": [
          {
            "_key": "yo-e-1s1",
            "_type": "span",
            "marks": [],
            "text": "Wednesdays during school year, 7:17 - 8:45 p.m. (FBCM Fellowship Hall / Youth Center)"
          }
        ],
        "markDefs": [],
        "style": "normal"
      },
      {
        "_key": "yo-f-1",
        "_type": "block",
        "children": [
          {
            "_key": "yo-f-1s1",
            "_type": "span",
            "marks": [],
            "text": "FBCM is a site for \"City Life!\" All students grades 6 - 12 are welcome."
          }
        ],
        "markDefs": [],
        "style": "normal"
      },
      {
        "_key": "yo-g-1",
        "_type": "block",
        "children": [
          {
            "_key": "yo-g-1s1",
            "_type": "span",
            "marks": [],
            "text": "We begin with a meal at 7:17 p.m. in the fellowship hall."
          }
        ],
        "markDefs": [],
        "style": "normal"
      },
      {
        "_key": "yo-h-1",
        "_type": "block",
        "children": [
          {
            "_key": "yo-h-1s1",
            "_type": "span",
            "marks": [],
            "text": "Then, we have some time for fun and games and end with a Bible study."
          }
        ],
        "markDefs": [],
        "style": "normal"
