{
  "name": "fbcm",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/with-workerd.mjs astro build",
    "build:full": "npm run typegen && npm run build",
    "preview": "wrangler dev -c dist/server/wrangler.json",
    "astro": "astro",
    "deploy": "npm run build && wrangler deploy -c dist/server/wrangler.json",
    "generate-types": "wrangler types",
    "typegen": "sanity schema extract --force && sanity typegen generate",
    "og": "node scripts/generate-og-default.mjs",
    "og:pages": "node scripts/generate-og-pages.mjs",
    "apply-brand": "node scripts/apply-brand.mjs",
    "llms:full": "node scripts/generate-llms-full.mjs",
    "studio:import": "node scripts/import-content.mjs",
    "seed": "node scripts/seed-core.mjs",
    "seed-pages": "node scripts/seed-pages.mjs",
    "parity": "node scripts/page-parity.mjs",
    "parity:capture": "node scripts/page-parity.mjs capture --exclude \"blog/page/**,blog/tag/**,blog/category/**/page/**\"",
    "parity:compare": "node scripts/page-parity.mjs compare --exclude \"blog/page/**,blog/tag/**,blog/category/**/page/**\"",
    "cutover": "node scripts/cutover.mjs",
    "sync-check": "node scripts/sync-check.mjs",
    "free-dist": "node scripts/free-dist.mjs",
    "check": "astro check && npm run lint",
    "check:full": "npm run typegen && npm run build && npm run test:unit && npm run test:scripts",
    "lint": "eslint src/**/*.{ts,tsx,astro} scripts/**/*.mjs",
    "lint:fix": "eslint --fix src/**/*.{ts,tsx,astro} scripts/**/*.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:unit": "node --experimental-strip-types --test src/lib/*.test.ts",
    "test:scripts": "node --test scripts/lib/*.test.mjs",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:visual:update": "playwright test -c playwright.visual.config.ts --update-snapshots=all",
    "links:live": "node scripts/check-live-links.mjs",
    "serve:dist": "node scripts/serve-dist.mjs --port 4321",
    "check:links": "linkinator ./dist/client --recurse --concurrency 25 --retry-errors --retry-errors-count 3 --skip \"^https?://(?!(localhost|127[.]0[.]0[.]1)[:/])\" --skip \"/studio\" --skip \"/preview\" --skip \"/api/\"",
    "favicon": "node scripts/generate-favicons.mjs",
    "scaffold": "node scripts/scaffold.mjs",
    "audit:studio": "node scripts/audit-studio.mjs",
    "verify:redirects": "node scripts/verify-redirects.mjs --follow-script"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.2.4",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/react": "^6.0.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/sofia-sans-semi-condensed": "5.3.0",
    "@fontsource/castoro": "5.3.0",
    "@fontsource/castoro-titling": "5.3.0",
    "@portabletext/block-tools": "5.2.0",
    "@portabletext/react": "^6.2.0",
    "@portabletext/types": "^4.0.2",
    "@sanity/astro": "3.4.2",
    "@sanity/client": "7.26.2",
    "@sanity/icons": "3.8.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/orderable-document-list": "2.0.9",
    "@sanity/preview-url-secret": "4.1.5",
    "@sanity/ui": "3.5.4",
    "@sanity/vision": "6.9.1",
    "@sanity/visual-editing": "5.7.3",
    "@tabler/icons": "^3.44.0",
    "@tabler/icons-react": "^3.44.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lenis": "^1.3.23",
    "lucide-react": "^1.16.0",
    "motion": "^12.40.0",
    "next-themes": "^0.4.6",
    "primereact": "^10.9.8",
    "radix-ui": "^1.4.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-is": "19.2.7",
    "react-photo-album": "^3.6.0",
    "sanity": "6.9.1",
    "sanity-plugin-asset-source-unsplash": "7.0.15",
    "sanity-plugin-media": "5.0.11",
    "shadcn": "^4.8.1",
    "sharp": "^0.35.4",
    "sonner": "^2.0.7",
    "styled-components": "6.4.3",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tw-animate-css": "^1.4.0",
    "wrangler": "~4.110.0",
    "yet-another-react-lightbox": "^3.32.0"
  },
  "overrides": {
    "sanity-plugin-utils": "2.0.6",
    "@sanity/visual-editing": "5.7.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.1",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^10.5.0",
    "eslint-plugin-astro": "^1.7.0",
    "http-server": "^14.1.1",
    "linkinator": "^8.1.0",
    "opentype.js": "^2.0.0",
    "prettier": "^3.8.4",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260826.1": true,
    "workerd@1.20260708.1": true,
    "sharp@0.35.2": true,
    "sharp@0.35.4": true,
    "sharp@0.34.5": true
  }
}
